{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning" }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Servidor 93 — BD TropitoursVDT (servidor, usuario y password reales SOLO en appsettings.Local.json) — todas las tablas del sistema viven en el esquema [Eurovip].
    // El password NO se commitea: ponerlo en appsettings.Local.json (ignorado por git) con la misma clave.
    "DefaultConnection": "data source=__SERVIDOR__;initial catalog=TropitoursVDT;user id=__USUARIO__;password=__PASSWORD__;Encrypt=False;TrustServerCertificate=True"
  },
  "Eurovip": {
    "Esquema": "Eurovip",
    "VuelosObligatorios": false,
    // Carrusel de la Home: misma estructura que BackTiTan (web / tablet = md / móvil = sm).
    // Cambiar aquí si Eurovip usa otra carpeta o dominio de imágenes.
    "Slider": {
      // Carpeta de fotos de Eurovip (sitio fotos.eurovip.com.do = C:\inetpub\wwwroot\photosVacacionalparce)
      "Fisico": "C:\\inetpub\\wwwroot\\photosVacacionalparce\\eurovip\\slider",
      "FisicoMd": "C:\\inetpub\\wwwroot\\photosVacacionalparce\\eurovip\\slider\\md",
      "FisicoSm": "C:\\inetpub\\wwwroot\\photosVacacionalparce\\eurovip\\slider\\sm",
      "Url": "https://fotos.eurovip.com.do/eurovip/slider",
      "UrlMd": "https://fotos.eurovip.com.do/eurovip/slider/md",
      "UrlSm": "https://fotos.eurovip.com.do/eurovip/slider/sm",
      // Carpeta de antes: Herramientas > Fotos > "Pasar las fotos de antes" copia de aquí a la nueva (mismo nombre)
      "Anterior": {
        "Fisico": "C:\\inetpub\\wwwroot\\photosVacacional\\imagenes\\slider\\ES",
        "FisicoMd": "C:\\inetpub\\wwwroot\\photosVacacional\\imagenes\\slider\\ES\\md",
        "FisicoSm": "C:\\inetpub\\wwwroot\\photosVacacional\\imagenes\\slider\\ES\\sm"
      }
    }
  },
  // Fotos de productos (Eurovip.imagen / Eurovip.multimedia, Database/esquema-multimedia.md) y del itinerario de circuito:
  // {CarpetaFisica}/{destinos, paises, hoteles, alojamientos, excursiones, traslados, circuitos…}/… y se ven en {Url}/…
  "Multimedia": {
    "CarpetaFisica": "C:\\inetpub\\wwwroot\\photosVacacionalparce\\eurovip",
    "Url": "https://fotos.eurovip.com.do/eurovip"
  },
  // WhatsApp Cloud API (Meta) para enviar flyers. Los valores reales van SOLO en appsettings.Local.json.
  "WhatsApp": {
    "AccessToken": "",
    "PhoneNumberId": "",
    "BusinessAccountId": "",
    "ApiVersion": "v21.0",
    "Numero": "",
    // Plantilla aprobada en Meta para los flyers (cabecera imagen + {{1}} nombre). La misma de BackTiTan.
    "PlantillaFlyer": "cliente",
    "IdiomaPlantilla": "en"
  }
}
