@model RegisterViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Crear usuario";
}
<section class="lg-card">
    <div class="lg-card-top">
        <span class="ev-chip"><i class="bi bi-person-plus"></i> Nuevo usuario</span>
        <a asp-action="Login" class="ev-chip ghost"><i class="bi bi-arrow-left"></i> Volver</a>
    </div>
    <h1>Crear usuario</h1>
    <p class="sub">Completa tus datos para acceder al BackOffice.</p>

    <form asp-action="Register" method="post" data-loading="Creando…">
        <div asp-validation-summary="ModelOnly" class="lg-summary"></div>

        <div class="lg-grid2">
            <div class="lg-field">
                <label asp-for="Nombre">Nombre</label>
                <div class="lg-input"><i class="bi bi-person"></i><input asp-for="Nombre" placeholder="Nombre" autocomplete="given-name" autofocus /></div>
                <span asp-validation-for="Nombre" class="lg-err"></span>
            </div>
            <div class="lg-field">
                <label asp-for="Apellido">Apellido</label>
                <div class="lg-input"><i class="bi bi-person"></i><input asp-for="Apellido" placeholder="Apellido" autocomplete="family-name" /></div>
                <span asp-validation-for="Apellido" class="lg-err"></span>
            </div>
        </div>

        <div class="lg-field">
            <label asp-for="Email">Correo electrónico</label>
            <div class="lg-input"><i class="bi bi-envelope"></i><input asp-for="Email" type="email" placeholder="tucorreo@dominicanatours.net" autocomplete="email" /></div>
            <span asp-validation-for="Email" class="lg-err"></span>
        </div>

        <div class="lg-grid2">
            <div class="lg-field">
                <label asp-for="UserName">Usuario</label>
                <div class="lg-input"><i class="bi bi-at"></i><input asp-for="UserName" placeholder="nrodriguez" autocomplete="username" maxlength="15" /></div>
                <span asp-validation-for="UserName" class="lg-err"></span>
            </div>
            <div class="lg-field">
                <label asp-for="Telefono">Teléfono</label>
                <div class="lg-input"><i class="bi bi-telephone"></i><input asp-for="Telefono" placeholder="809…" autocomplete="tel" maxlength="15" /></div>
                <span asp-validation-for="Telefono" class="lg-err"></span>
            </div>
        </div>

        <div class="lg-field">
            <label asp-for="Password">Contraseña</label>
            <div class="lg-input">
                <i class="bi bi-lock"></i>
                <input asp-for="Password" placeholder="••••••••" autocomplete="new-password" />
                <button type="button" class="lg-eye" data-eye="Password" aria-label="Mostrar contraseña"><i class="bi bi-eye"></i></button>
            </div>
            <span asp-validation-for="Password" class="lg-err"></span>
        </div>
        <div class="lg-hint"><i class="bi bi-info-circle"></i> Mínimo 8 caracteres, con mayúscula, minúscula, número y símbolo.</div>

        <div class="lg-field">
            <label asp-for="ConfirmarPassword">Confirmar contraseña</label>
            <div class="lg-input">
                <i class="bi bi-lock-fill"></i>
                <input asp-for="ConfirmarPassword" placeholder="••••••••" autocomplete="new-password" />
                <button type="button" class="lg-eye" data-eye="ConfirmarPassword" aria-label="Mostrar contraseña"><i class="bi bi-eye"></i></button>
            </div>
            <span asp-validation-for="ConfirmarPassword" class="lg-err"></span>
        </div>

        <button type="submit" class="ev-btn lg-submit">
            Crear usuario <span class="arrow"><i class="bi bi-check-lg"></i></span>
        </button>
    </form>

    <div class="lg-switch">¿Ya tienes cuenta? <a asp-action="Login">Iniciar sesión</a></div>
</section>
