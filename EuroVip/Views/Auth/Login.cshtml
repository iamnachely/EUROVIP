@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Iniciar sesión";
}
<section class="lg-card">
    <div class="lg-card-top">
        <span class="ev-chip"><i class="bi bi-sun"></i> Bienvenida/o</span>
        <span class="ev-chip ghost"><i class="bi bi-geo-alt"></i> Santo Domingo</span>
    </div>
    <h1>Iniciar sesión</h1>
    <p class="sub">Ingresa con tu correo corporativo.</p>

    @if (TempData["Registrado"] is string ok)
    {
        <div class="lg-ok"><i class="bi bi-check-circle"></i> @ok</div>
    }

    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" data-loading="Entrando…">
        <div asp-validation-summary="ModelOnly" class="lg-summary"></div>

        <div class="lg-field">
            <label asp-for="User">Correo electrónico</label>
            <div class="lg-input">
                <i class="bi bi-envelope"></i>
                <input asp-for="User" type="email" placeholder="tucorreo@dominicanatours.net" autocomplete="username" autofocus />
            </div>
            <span asp-validation-for="User" class="lg-err"></span>
        </div>

        <div class="lg-field">
            <label asp-for="Password">Contraseña</label>
            <div class="lg-input">
                <i class="bi bi-lock"></i>
                <input asp-for="Password" placeholder="••••••••" autocomplete="current-password" />
                <button type="button" class="lg-eye" data-eye="Password" aria-label="Mostrar contraseña"><i class="bi bi-eye"></i></button>
            </div>
            <span asp-validation-for="Password" class="lg-err"></span>
        </div>

        <div class="lg-row">
            <label class="lg-check"><input asp-for="Remember" /> Recordarme</label>
        </div>

        <button type="submit" class="ev-btn lg-submit">
            Entrar <span class="arrow"><i class="bi bi-arrow-right"></i></span>
        </button>
    </form>

    <div class="lg-switch">¿No tienes cuenta? <a asp-action="Register">Crear usuario</a></div>
    <div class="lg-foot"><i class="bi bi-shield-check"></i> Eurovip · Dominicana Tours © @DateTime.Now.Year</div>
</section>
