@* Layout de las pantallas de acceso (Login / Registro): escena caribe animada + marca + titular + cinta de destinos *@
@{
    var ci = System.Globalization.CultureInfo.InvariantCulture;

    // Ola periódica (período fijo) — al desplazar el grupo exactamente 1 período el loop es perfecto.
    string Ola(double y, double amp, int periodo, double fondo = 900)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append(string.Format(ci, "M-400 {0} ", y));
        for (var x = -400; x < 2400; x += periodo)
            sb.Append(string.Format(ci, "q{0} {1} {2} 0 t{2} 0 ", periodo / 4.0, -amp, periodo / 2.0));
        sb.Append(string.Format(ci, "L2400 {0} L-400 {0} Z", fondo));
        return sb.ToString();
    }

    // Copa de palmera: hojas que se curvan y caen en la punta.
    const string Hoja = "M0 0 C 45 -38, 120 -44, 190 6 C 150 -10, 120 -6, 96 0 L 112 14 L 82 4 L 92 20 L 62 6 L 66 20 L 38 6 C 24 6, 10 6, 0 8 Z";
    var angulos = new[] { -52, -22, 8, 34 };

    var destinos = new[] { "Punta Cana", "Bávaro", "Samaná", "La Romana", "Bayahíbe", "Isla Saona", "Puerto Plata", "Cabarete", "Santo Domingo", "Jarabacoa", "Las Terrenas", "Juan Dolio" };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Eurovip</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/eurovip.css" asp-append-version="true" />
    <style>
        html, body { height: 100%; overflow: hidden; background: #BFFBF2; }

        /* ================= ESCENA CARIBE (loop tipo video) ================= */
        .sc { position: fixed; inset: 0; z-index: 0; }
        .sc > svg { width: 100%; height: 100%; display: block; }

        .a-sun      { animation: sunPulse 6s ease-in-out infinite; transform-origin: 470px 500px; }
        .a-glow     { animation: glow 6s ease-in-out infinite; }
        .a-rays     { animation: spin 120s linear infinite; transform-origin: 470px 500px; }
        .a-cloud1   { animation: drift 95s linear infinite; }
        .a-cloud2   { animation: drift 140s linear infinite -60s; }
        .a-cloud3   { animation: drift 120s linear infinite -30s; }
        .a-wave1    { animation: wave 9s linear infinite; }
        .a-wave2    { animation: wave 6.5s linear infinite reverse; }
        .a-wave3    { animation: wave 5s linear infinite; }
        .a-wave4    { animation: wave 3.8s linear infinite reverse; }
        .a-shimmer rect { animation: shimmer 2.6s ease-in-out infinite; }
        .a-shimmer rect:nth-child(2n) { animation-delay: -1.1s; }
        .a-shimmer rect:nth-child(3n) { animation-delay: -1.8s; }
        .a-boat     { animation: sail 80s linear infinite -20s; }
        .a-bob      { animation: bob 3.2s ease-in-out infinite; transform-box: fill-box; transform-origin: center bottom; }
        .a-foam     { animation: foam 4s ease-in-out infinite; }
        .a-foam2    { animation: foam 4s ease-in-out infinite -2s; }
        .a-palm1    { animation: palm 5s ease-in-out infinite; transform-origin: 60px 905px; }
        .a-crown1   { animation: crown 3.4s ease-in-out infinite; transform-origin: 150px 430px; }
        .a-palm2    { animation: palm 6s ease-in-out infinite -2s; transform-origin: -10px 915px; }
        .a-crown2   { animation: crown 3.9s ease-in-out infinite -1s; transform-origin: 30px 590px; }
        .a-palm3    { animation: palm 5.5s ease-in-out infinite -1s; transform-origin: 1560px 915px; }
        .a-crown3   { animation: crown 3.6s ease-in-out infinite -.5s; transform-origin: 1470px 470px; }
        .a-plane    { animation: plane 30s linear infinite -6s; }
        .a-banner   { animation: banner .9s ease-in-out infinite alternate; transform-box: fill-box; transform-origin: right center; }
        .a-gulls    { animation: gulls 40s linear infinite; }
        .a-gull     { animation: flap .55s ease-in-out infinite alternate; transform-box: fill-box; transform-origin: center; }
        .a-gull:nth-child(2) { animation-delay: .2s; }
        .a-gull:nth-child(3) { animation-delay: .35s; }

        @@keyframes sunPulse { 50% { transform: scale(1.05); } }
        @@keyframes glow { 50% { opacity: .75; } }
        @@keyframes spin { to { transform: rotate(360deg); } }
        @@keyframes drift { from { transform: translateX(-500px); } to { transform: translateX(2100px); } }
        @@keyframes wave { to { transform: translateX(-160px); } }
        @@keyframes shimmer { 0%, 100% { opacity: .15; } 50% { opacity: .85; } }
        @@keyframes sail { from { transform: translateX(-300px); } to { transform: translateX(1900px); } }
        @@keyframes bob { 0%, 100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(5px) rotate(2deg); } }
        @@keyframes foam { 0%, 100% { transform: translateY(0); opacity: .9; } 50% { transform: translateY(-10px); opacity: .55; } }
        @@keyframes palm { 0%, 100% { transform: rotate(0deg); } 50% { transform: rotate(1.6deg); } }
        @@keyframes crown { 0%, 100% { transform: rotate(-3deg); } 50% { transform: rotate(4deg); } }
        @@keyframes plane { from { transform: translateX(-700px); } to { transform: translateX(2300px); } }
        @@keyframes banner { from { transform: skewY(-3deg) scaleY(.96); } to { transform: skewY(3deg) scaleY(1.03); } }
        @@keyframes gulls { from { transform: translate(-200px, 0); } 50% { transform: translate(800px, -40px); } to { transform: translate(1900px, 10px); } }
        @@keyframes flap { to { transform: scaleY(.4); } }

        .sc-vignette { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at 35% 45%, transparent 55%, rgba(11,18,21,.22) 100%); }
        .sc-grain {
            position: absolute; inset: -50%; pointer-events: none; opacity: .05;
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
            animation: grain 1.2s steps(6) infinite;
        }
        @@keyframes grain { 0%,100% { transform: translate(0,0); } 25% { transform: translate(-3%,2%); } 50% { transform: translate(2%,-3%); } 75% { transform: translate(3%,3%); } }

        /* ================= UI ================= */
        .lg-brand { position: fixed; z-index: 3; top: 30px; left: 40px; display: flex; align-items: center; gap: 12px; animation: evRise .8s var(--ev-ease) both; }

        .lg-hero {
            position: fixed; z-index: 3; left: clamp(40px, 14vw, 250px); top: 112px; max-width: min(540px, calc(100vw - 880px));
            padding: 26px 30px 24px; border-radius: 28px;
            background: rgba(255,255,255,.42); backdrop-filter: blur(14px) saturate(1.3); -webkit-backdrop-filter: blur(14px) saturate(1.3);
            border: 1px solid rgba(255,255,255,.7);
            animation: evRise .9s var(--ev-ease) .1s both;
        }
        .lg-flag {
            display: inline-flex; align-items: center; gap: 10px;
            background: rgba(255,255,255,.7); backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,.9);
            padding: 7px 14px 7px 8px; border-radius: 99px;
            font-size: 13px; font-weight: 700;
        }
        .lg-flag svg { width: 26px; height: 18px; border-radius: 4px; box-shadow: 0 0 0 1px rgba(11,18,21,.08); }
        .lg-hero h2 {
            font-size: clamp(38px, 4.4vw, 64px); line-height: .98; letter-spacing: -2.4px; font-weight: 800;
            margin: 18px 0 14px; color: var(--ev-ink);
        }
        .lg-hero h2 em {
            font-style: normal;
            background: linear-gradient(100deg, #0E8F86, #0B1215 70%);
            -webkit-background-clip: text; background-clip: text; color: transparent;
        }
        .lg-hero p { margin: 0; font-size: 16px; font-weight: 500; color: #1E3A37; max-width: 42ch; }
        .lg-stats { display: flex; gap: 26px; margin-top: 22px; }
        .lg-stats div b { display: block; font-size: 24px; font-weight: 800; letter-spacing: -.8px; }
        .lg-stats div small { font-size: 12px; font-weight: 600; color: #2D524E; }

        /* Cinta de destinos */
        .lg-ticker {
            position: fixed; z-index: 3; left: 0; right: 0; bottom: 18px;
            overflow: hidden;
            -webkit-mask: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
                    mask: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
        }
        .lg-ticker-track { display: flex; width: max-content; animation: ticker 45s linear infinite; }
        .lg-ticker span {
            display: inline-flex; align-items: center; gap: 10px;
            margin-right: 12px; padding: 9px 16px;
            background: rgba(255,255,255,.62); backdrop-filter: blur(8px);
            border: 1px solid rgba(255,255,255,.85);
            border-radius: 99px; font-size: 13px; font-weight: 700; color: var(--ev-ink); white-space: nowrap;
        }
        .lg-ticker span i { color: #CE1126; }
        @@keyframes ticker { to { transform: translateX(-50%); } }

        .lg-wrap {
            position: relative; z-index: 4; height: 100%; overflow-y: auto;
            display: flex; align-items: center; justify-content: flex-end;
            padding: 24px clamp(24px, 6vw, 110px) 80px;
        }
        .lg-card {
            width: min(430px, 100%);
            padding: 38px 36px 30px;
            border-radius: 32px;
            background: rgba(255,255,255,.78);
            backdrop-filter: blur(22px) saturate(1.4);
            -webkit-backdrop-filter: blur(22px) saturate(1.4);
            border: 1px solid rgba(255,255,255,.9);
            box-shadow: 0 40px 100px -30px rgba(11,18,21,.5), inset 0 1px 0 #fff;
            animation: cardIn .9s var(--ev-ease) .2s both;
        }
        @@keyframes cardIn { from { opacity: 0; transform: translateY(24px) scale(.98); } to { opacity: 1; transform: none; } }
        .lg-card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
        .lg-card h1 { font-size: 32px; font-weight: 800; letter-spacing: -1.2px; margin: 0 0 6px; }
        .lg-card .sub { color: var(--ev-muted); margin: 0 0 24px; font-weight: 500; font-size: 14.5px; }

        .lg-field { margin-bottom: 16px; }
        .lg-field label { display: block; font-size: 13px; font-weight: 700; margin-bottom: 8px; }
        .lg-input {
            display: flex; align-items: center; gap: 12px;
            border: 1.5px solid rgba(11,18,21,.08); background: rgba(255,255,255,.9);
            border-radius: 16px; padding: 0 16px;
            transition: border-color .2s, box-shadow .2s, background .2s;
        }
        .lg-input:focus-within { border-color: var(--ev-teal); background: #fff; box-shadow: 0 0 0 5px rgba(116,242,230,.4); }
        .lg-input i { color: var(--ev-muted); font-size: 18px; }
        .lg-input input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font: 500 15px var(--ev-font); color: var(--ev-text); padding: 15px 0; }
        .lg-eye { border: 0; background: transparent; cursor: pointer; color: var(--ev-muted); padding: 4px; }
        .lg-err { color: #D92D20; font-size: 12.5px; font-weight: 600; margin-top: 6px; display: block; }
        .lg-summary { background: #FEF3F2; color: #B42318; border-radius: 14px; padding: 12px 14px; font-size: 13.5px; font-weight: 600; margin-bottom: 16px; }
        .lg-summary ul { margin: 0; padding-left: 18px; }
        .validation-summary-valid { display: none; }

        .lg-row { display: flex; align-items: center; margin: 4px 0 22px; font-size: 13.5px; font-weight: 600; color: var(--ev-muted); }
        .lg-check { display: inline-flex; align-items: center; gap: 10px; cursor: pointer; }
        .lg-check input { width: 18px; height: 18px; accent-color: var(--ev-ink); }

        .lg-submit { width: 100%; justify-content: center; padding: 16px; font-size: 15px; border-radius: 16px; position: relative; overflow: hidden; }
        .lg-submit::before {
            content: ""; position: absolute; top: 0; left: -60%; width: 40%; height: 100%;
            background: linear-gradient(100deg, transparent, rgba(116,242,230,.35), transparent);
            animation: shine 3.5s ease-in-out infinite;
        }
        @@keyframes shine { 0%, 55% { left: -60%; } 100% { left: 130%; } }
        .lg-submit .arrow { width: 28px; height: 28px; border-radius: 9px; display: grid; place-items: center; background: var(--ev-aqua); color: var(--ev-ink); transition: transform .3s var(--ev-ease); }
        .lg-submit:hover .arrow { transform: translateX(4px); }
        .lg-submit[disabled] { opacity: .8; cursor: progress; }

        .lg-card { margin: auto 0; }
        .lg-grid2 { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 12px; }
        .lg-grid2 > * { min-width: 0; }
        @@media (max-width: 480px) { .lg-grid2 { grid-template-columns: 1fr; gap: 0; } }
        .lg-hint { font-size: 12px; color: var(--ev-muted); margin: -6px 0 16px; display: flex; gap: 6px; align-items: flex-start; }
        .lg-switch { margin-top: 18px; text-align: center; font-size: 14px; font-weight: 600; color: var(--ev-muted); }
        .lg-switch a { color: var(--ev-ink); font-weight: 800; border-bottom: 2px solid var(--ev-aqua); padding-bottom: 1px; }
        .lg-switch a:hover { color: var(--ev-deep); }
        .lg-ok { background: #ECFDF3; color: #067647; border-radius: 14px; padding: 12px 14px; font-size: 13.5px; font-weight: 600; margin-bottom: 16px; }
        .lg-foot { margin-top: 22px; font-size: 12.5px; color: var(--ev-muted); display: flex; align-items: center; gap: 8px; justify-content: center; }
        .lg-foot i { color: var(--ev-deep); }

        @@media (max-width: 1240px) { .lg-hero { display: none; } .lg-wrap { justify-content: center; } }
        @@media (max-width: 600px) {
            .lg-brand { left: 50%; transform: translateX(-50%); top: 20px; }
            .lg-card { padding: 30px 22px 24px; }
        }
        @@media (prefers-reduced-motion: reduce) {
            .sc *, .lg-card, .lg-submit::before, .lg-ticker-track, .sc-grain { animation: none !important; }
        }
    </style>
</head>
<body>
    <!-- ======================= ESCENA ======================= -->
    <div class="sc" aria-hidden="true">
        <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice">
            <defs>
                <linearGradient id="gSky" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#C9FFF7" />
                    <stop offset=".55" stop-color="#B3FFF3" />
                    <stop offset=".86" stop-color="#E9FFF6" />
                    <stop offset="1" stop-color="#FFF0D6" />
                </linearGradient>
                <linearGradient id="gSea" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#5FE3D6" />
                    <stop offset=".35" stop-color="#2BD4C4" />
                    <stop offset="1" stop-color="#0E8F86" />
                </linearGradient>
                <linearGradient id="gSand" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#FFF3D9" />
                    <stop offset="1" stop-color="#F3DDAE" />
                </linearGradient>
                <radialGradient id="gSun">
                    <stop offset="0" stop-color="#FFFFFF" />
                    <stop offset=".45" stop-color="#FFF7E4" />
                    <stop offset="1" stop-color="#FFF7E4" stop-opacity="0" />
                </radialGradient>
                <linearGradient id="gTrunk" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0" stop-color="#0B1215" />
                    <stop offset="1" stop-color="#1F3330" />
                </linearGradient>
                <clipPath id="clipSea"><rect x="0" y="560" width="1600" height="340" /></clipPath>
            </defs>

            <!-- Cielo y sol -->
            <rect width="1600" height="600" fill="url(#gSky)" />
            <g class="a-rays" opacity=".35">
                @for (var r = 0; r < 24; r++)
                {
                    <path d="M470 500 L455 -400 L485 -400 Z" fill="#FFFFFF" transform="rotate(@(r * 15) 470 500)" />
                }
            </g>
            <circle class="a-glow" cx="470" cy="500" r="190" fill="url(#gSun)" />
            <circle class="a-sun" cx="470" cy="500" r="66" fill="#FFFDF5" />

            <!-- Nubes -->
            <g class="a-cloud1" fill="#fff" opacity=".9">
                <ellipse cx="200" cy="150" rx="110" ry="24" /><ellipse cx="250" cy="132" rx="62" ry="30" /><ellipse cx="170" cy="138" rx="44" ry="22" />
            </g>
            <g class="a-cloud2" fill="#fff" opacity=".7">
                <ellipse cx="700" cy="250" rx="90" ry="16" /><ellipse cx="735" cy="238" rx="44" ry="20" />
            </g>
            <g class="a-cloud3" fill="#fff" opacity=".85">
                <ellipse cx="1100" cy="110" rx="130" ry="26" /><ellipse cx="1160" cy="90" rx="70" ry="34" /><ellipse cx="1060" cy="98" rx="50" ry="24" />
            </g>

            <!-- Avioneta con pancarta -->
            <g class="a-plane">
                <g transform="translate(0 205)">
                    <line x1="-14" y1="2" x2="-60" y2="6" stroke="#0B1215" stroke-width="1.5" />
                    <g class="a-banner">
                        <rect x="-330" y="-12" width="270" height="34" rx="4" fill="#FFFFFF" stroke="#0B1215" stroke-width="1.5" />
                        <rect x="-330" y="-12" width="10" height="34" fill="#002D62" />
                        <rect x="-320" y="-12" width="10" height="34" fill="#CE1126" />
                        <text x="-195" y="10" text-anchor="middle" font-family="Plus Jakarta Sans, sans-serif" font-size="15" font-weight="800" fill="#0B1215">EUROVIP · República Dominicana</text>
                    </g>
                    <g fill="#0B1215">
                        <path d="M-14 -3 L30 -4 Q 44 0 30 6 L-14 5 Z" />
                        <path d="M6 -2 L-4 -22 L6 -22 L18 -2 Z" />
                        <path d="M6 4 L-4 22 L6 22 L18 4 Z" />
                        <path d="M-12 -2 L-20 -12 L-14 -12 L-6 -2 Z" />
                        <circle cx="38" cy="1" r="2" fill="#74F2E6" />
                    </g>
                </g>
            </g>

            <!-- Gaviotas -->
            <g class="a-gulls">
                <g transform="translate(0 300)" fill="none" stroke="#0B1215" stroke-width="2.2" stroke-linecap="round">
                    <path class="a-gull" d="M0 10 Q 8 0 16 10 Q 24 0 32 10" />
                    <path class="a-gull" d="M44 -8 Q 50 -15 56 -8 Q 62 -15 68 -8" />
                    <path class="a-gull" d="M70 22 Q 76 15 82 22 Q 88 15 94 22" />
                </g>
            </g>

            <!-- Isla Saona en el horizonte -->
            <g fill="#4FBFB4">
                <path d="M880 562 C 930 540, 1010 536, 1080 546 C 1140 552, 1200 548, 1260 562 Z" />
                <path d="M960 545 l3 -22 l3 22z M1020 541 l3 -26 l3 26z M1110 547 l3 -20 l3 20z" fill="#3AA79C" />
                <path d="M955 524 q 8 -6 16 0 M1015 516 q 8 -6 16 0 M1105 528 q 8 -6 16 0" stroke="#3AA79C" stroke-width="3" fill="none" />
            </g>

            <!-- Mar -->
            <rect y="558" width="1600" height="342" fill="url(#gSea)" />
            <g class="a-shimmer" fill="#FFFFFF">
                <rect x="430" y="570" width="80" height="3" rx="2" /><rect x="400" y="584" width="140" height="3" rx="2" />
                <rect x="445" y="600" width="60" height="3" rx="2" /><rect x="380" y="618" width="180" height="3" rx="2" />
                <rect x="420" y="640" width="100" height="3" rx="2" /><rect x="360" y="664" width="220" height="4" rx="2" />
                <rect x="430" y="690" width="80" height="4" rx="2" />
            </g>
            <g clip-path="url(#clipSea)">
                <g class="a-wave1"><path d="@Ola(612, 5, 160)" fill="#43DCCE" opacity=".55" /></g>
                <g class="a-wave2"><path d="@Ola(660, 7, 160)" fill="#2BD4C4" opacity=".55" /></g>
                <g class="a-wave3"><path d="@Ola(712, 8, 160)" fill="#1CB8AA" opacity=".6" /></g>
                <g class="a-wave4"><path d="@Ola(760, 9, 160)" fill="#159E93" opacity=".55" /></g>
            </g>

            <!-- Velero -->
            <g class="a-boat">
                <g transform="translate(0 600)">
                    <g class="a-bob">
                        <path d="M-34 0 L34 0 L24 12 L-24 12 Z" fill="#0B1215" />
                        <path d="M0 -2 L0 -70" stroke="#0B1215" stroke-width="2.5" />
                        <path d="M3 -66 L3 -6 L40 -6 Z" fill="#FFFFFF" />
                        <path d="M-3 -58 L-3 -6 L-30 -6 Z" fill="#E8FFFB" />
                        <path d="M0 -70 L14 -66 L0 -62 Z" fill="#CE1126" />
                    </g>
                </g>
            </g>

            <!-- Espuma y arena -->
            <path class="a-foam" d="M-20 790 C 260 760, 520 820, 820 812 S 1300 800, 1620 822" stroke="#FFFFFF" stroke-width="8" fill="none" stroke-linecap="round" opacity=".9" />
            <path class="a-foam2" d="M-20 806 C 280 780, 560 834, 860 826 S 1320 816, 1620 836" stroke="#E9FFFB" stroke-width="5" fill="none" stroke-linecap="round" />
            <path d="M-20 812 C 280 788, 560 842, 860 834 S 1320 826, 1620 846 L1620 900 L-20 900 Z" fill="#E9D3A2" opacity=".55" />
            <path d="M-20 822 C 300 800, 580 852, 880 844 S 1330 836, 1620 856 L1620 900 L-20 900 Z" fill="url(#gSand)" />

            <!-- Sombrilla (colores bandera) + reposeras -->
            <g transform="translate(640 860)">
                <ellipse cx="0" cy="14" rx="90" ry="8" fill="#0B1215" opacity=".08" />
                <line x1="0" y1="14" x2="-10" y2="-70" stroke="#0B1215" stroke-width="3" />
                <path d="M-75 -62 Q -10 -120 55 -78 Z" fill="#FFFFFF" />
                <path d="M-75 -62 Q -55 -98 -30 -100 L-10 -72 Z" fill="#002D62" />
                <path d="M-10 -72 L-30 -100 Q -2 -106 20 -96 Z" fill="#FFFFFF" />
                <path d="M-10 -72 L20 -96 Q 42 -90 55 -78 Z" fill="#CE1126" />
                <path d="M-70 8 L-20 8 L-10 -6" stroke="#0B1215" stroke-width="3" fill="none" stroke-linecap="round" />
                <path d="M20 10 L70 10 L80 -4" stroke="#0B1215" stroke-width="3" fill="none" stroke-linecap="round" />
            </g>
            <!-- Estrella de mar y coco -->
            <path transform="translate(880 872) scale(.9)" d="M0 -14 L4 -4 L14 -4 L6 3 L9 13 L0 7 L-9 13 L-6 3 L-14 -4 L-4 -4 Z" fill="#FF8A65" />
            <circle cx="300" cy="884" r="9" fill="#5B3A1E" /><circle cx="314" cy="888" r="7" fill="#6E4826" />

            <!-- Palmera grande (izquierda) -->
            <g class="a-palm1">
                <path d="M60 905 C 70 760, 92 580, 150 430" stroke="url(#gTrunk)" stroke-width="20" fill="none" stroke-linecap="round" />
                <path d="M60 905 C 70 760, 92 580, 150 430" stroke="#2E4642" stroke-width="20" fill="none" stroke-dasharray="3 11" />
                <g class="a-crown1">
                    <g transform="translate(150 430) scale(.85)" fill="#0E3B37">
                        @foreach (var a in angulos) { <path d="@Hoja" transform="rotate(@a)" /> }
                        @foreach (var a in angulos) { <path d="@Hoja" transform="scale(-1 1) rotate(@a)" /> }
                        <path d="@Hoja" transform="rotate(-88) scale(.75)" />
                        <circle cx="-6" cy="10" r="9" fill="#5B3A1E" /><circle cx="8" cy="12" r="8" fill="#6E4826" />
                    </g>
                </g>
            </g>

            <!-- Palmera chica (izquierda, atrás) -->
            <g class="a-palm2" opacity=".95">
                <path d="M-10 915 C -8 810, 4 690, 30 590" stroke="url(#gTrunk)" stroke-width="14" fill="none" stroke-linecap="round" />
                <path d="M-10 915 C -8 810, 4 690, 30 590" stroke="#2E4642" stroke-width="14" fill="none" stroke-dasharray="3 9" />
                <g class="a-crown2">
                    <g transform="translate(30 590) scale(.6)" fill="#124A45">
                        @foreach (var a in angulos) { <path d="@Hoja" transform="rotate(@a)" /> }
                        @foreach (var a in angulos) { <path d="@Hoja" transform="scale(-1 1) rotate(@a)" /> }
                        <path d="@Hoja" transform="rotate(-92) scale(.75)" />
                    </g>
                </g>
            </g>

            <!-- Palmera derecha -->
            <g class="a-palm3">
                <path d="M1560 915 C 1550 780, 1520 600, 1470 470" stroke="url(#gTrunk)" stroke-width="16" fill="none" stroke-linecap="round" />
                <path d="M1560 915 C 1550 780, 1520 600, 1470 470" stroke="#2E4642" stroke-width="16" fill="none" stroke-dasharray="3 10" />
                <g class="a-crown3">
                    <g transform="translate(1470 470) scale(.85)" fill="#0E3B37">
                        @foreach (var a in angulos) { <path d="@Hoja" transform="rotate(@a)" /> }
                        @foreach (var a in angulos) { <path d="@Hoja" transform="scale(-1 1) rotate(@a)" /> }
                        <path d="@Hoja" transform="rotate(-90) scale(.75)" />
                    </g>
                </g>
            </g>
        </svg>
        <div class="sc-vignette"></div>
        <div class="sc-grain"></div>
    </div>

    <!-- ======================= MARCA + TITULAR ======================= -->
    <div class="lg-brand">
        <div class="ev-brand-mark">EV</div>
        <div>
            <div class="ev-brand-name">Euro<span>vip</span></div>
            <div class="ev-brand-sub">BackOffice · Dominicana Tours</div>
        </div>
    </div>

    <section class="lg-hero">
        <span class="lg-flag">
            <svg viewBox="0 0 30 20" aria-hidden="true">
                <rect width="30" height="20" fill="#fff" />
                <rect x="0" y="0" width="13" height="8" fill="#002D62" /><rect x="17" y="0" width="13" height="8" fill="#CE1126" />
                <rect x="0" y="12" width="13" height="8" fill="#CE1126" /><rect x="17" y="12" width="13" height="8" fill="#002D62" />
            </svg>
            República Dominicana
        </span>
        <h2>Vende el <em>Caribe</em><br />en minutos.</h2>
        <p>Hoteles, excursiones, traslados y circuitos por toda la isla, cargados desde un solo lugar.</p>
        <div class="lg-stats">
            <div><b>+30</b><small>destinos</small></div>
            <div><b>365</b><small>días de sol</small></div>
            <div><b>1</b><small>BackOffice</small></div>
        </div>
    </section>

    <!-- ======================= TARJETA (Login / Registro) ======================= -->
    <main class="lg-wrap">
        @RenderBody()
    </main>

    <!-- ======================= CINTA DE DESTINOS ======================= -->
    <div class="lg-ticker" aria-hidden="true">
        <div class="lg-ticker-track">
            @for (var vuelta = 0; vuelta < 2; vuelta++)
            {
                foreach (var d in destinos)
                {
                    <span><i class="bi bi-geo-alt-fill"></i> @d</span>
                }
            }
        </div>
    </div>

    <script>
        // Ojo de contraseña (cualquier botón con data-eye="idDelInput")
        document.querySelectorAll('[data-eye]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const inp = document.getElementById(btn.dataset.eye);
                const ver = inp.type === 'password';
                inp.type = ver ? 'text' : 'password';
                btn.innerHTML = ver ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
            });
        });
        // Botón en estado "cargando" al enviar
        document.querySelectorAll('form[data-loading]').forEach(function (f) {
            f.addEventListener('submit', function () {
                const b = f.querySelector('button[type=submit]');
                b.disabled = true;
                b.innerHTML = f.dataset.loading + ' <span class="arrow"><i class="bi bi-hourglass-split"></i></span>';
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


