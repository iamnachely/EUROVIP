    // ══════════════════════════════════════════════════════════════════════════
    // MODELO TAB
    // ══════════════════════════════════════════════════════════════════════════
    var flyerHero      = document.getElementById('flyerHero');
    var flyerTitleEl   = document.getElementById('flyerTitleEl');
    var flyerHotelesEl = document.getElementById('flyerHoteles');

    function scaleFlyer() {
        var stage = document.getElementById('fbStage');
        var wrap  = document.getElementById('flyerScaleWrap');
        var flyer = document.getElementById('flyerTemplate');
        if (!stage) return;
        var avail = stage.clientWidth - 32;
        var scale = Math.min(1, avail / 900);
        wrap.style.transform    = 'scale(' + scale + ')';
        wrap.style.marginBottom = (flyer.offsetHeight * scale - flyer.offsetHeight) + 'px';
    }
    scaleFlyer();
    window.addEventListener('resize', function () { scaleFlyer(); scaleFlyerEditor(); });

    function buildHotelRows(hoteles) {
        return hoteles.map(function (h, i) {
            var pos     = i + 1;
            var precio  = h.precio_Final || h.Precio_Final || 0;
            var nombre  = h.nombre_Hotel || h.Nombre_Hotel || h.nombre_Destino || '';
            var regimen = h.regimen || h.Regimen || '';
            var priceColor = pos === 1 ? colorRank1 : colorOtros;
            var posColor   = getColorForPos(pos);
            return '<div class="fh-row' + (pos === 1 ? ' best' : '') + '" data-precio="' + precio + '">' +
                '<div class="fh-pos" style="color:' + posColor + '">' + pos + '</div>' +
                '<div class="fh-sep"></div>' +
                '<div class="fh-info">' +
                    '<div class="fh-name" contenteditable="true" spellcheck="false">' + nombre + '</div>' +
                    '<div class="fh-meta" contenteditable="true" spellcheck="false" style="color:' + colorRegimen + '">' + regimen + '</div>' +
                    (pos === 1 ? '<div class="fh-best-tag"><i class="bi bi-star-fill" style="font-size:.85rem;"></i> Mejor precio</div>' : '') +
                '</div>' +
                '<div class="fh-price' + (pos === 1 ? ' rank1' : '') + '" style="color:' + priceColor + '">' +
                    '<span class="precio-sym">RD$&nbsp;</span>' +
                    '<span class="precio-val" contenteditable="true" spellcheck="false">' + precio + '</span>' +
                '</div>' +
                '<button class="btn-hide-hotel" title="Ocultar hotel" type="button"><i class="bi bi-eye-slash"></i></button>' +
            '</div>';
        }).join('');
    }

    function renumerarHotelesModelo() {
        var rows = flyerHotelesEl.querySelectorAll('.fh-row');
        rows.forEach(function (row, i) {
            var num   = i + 1;
            var posEl = row.querySelector('.fh-pos');
            var tagEl = row.querySelector('.fh-best-tag');
            var precEl= row.querySelector('.fh-price');
            if (posEl) { posEl.textContent = num; posEl.className = 'fh-pos'; posEl.style.color = getColorForPos(num); }
            if (num === 1) {
                row.classList.add('best');
                if (precEl) { precEl.classList.add('rank1'); precEl.style.color = colorRank1; }
                if (tagEl)  tagEl.style.display = '';
            } else {
                row.classList.remove('best');
                if (precEl) { precEl.classList.remove('rank1'); precEl.style.color = colorOtros; }
                if (tagEl)  tagEl.style.display = 'none';
            }
        });
    }

    function ordenarHotelesModelo() {
        var rows = Array.from(flyerHotelesEl.querySelectorAll('.fh-row'));
        rows.sort(function (a, b) {
            var pa = parseFloat((a.querySelector('.precio-val') || {}).textContent) || 0;
            var pb = parseFloat((b.querySelector('.precio-val') || {}).textContent) || 0;
            return pa - pb;
        });
        rows.forEach(function (r) { flyerHotelesEl.appendChild(r); });
        renumerarHotelesModelo();
        setTimeout(scaleFlyer, 50);
    }

    function ocultarHotelModelo(row) {
        var nombre = (row.querySelector('.fh-name') || {}).textContent || 'Hotel';
        hotelesOcultosModeloList.push({ el: row, nombre: nombre });
        row.remove();
        renumerarHotelesModelo();
        actualizarPanelOcultosModelo();
        setTimeout(scaleFlyer, 50);
    }
    window.restaurarHotelModelo = function (idx) {
        var item = hotelesOcultosModeloList[idx];
        if (!item) return;
        hotelesOcultosModeloList.splice(idx, 1);
        flyerHotelesEl.appendChild(item.el);
        ordenarHotelesModelo();
        actualizarPanelOcultosModelo();
        setTimeout(scaleFlyer, 50);
    };
    function actualizarPanelOcultosModelo() {
        var panel = document.getElementById('ocultosPanelModelo');
        if (!panel) return;
        if (!hotelesOcultosModeloList.length) { panel.style.display = 'none'; return; }
        panel.style.display = '';
        panel.innerHTML = '<div class="ocultos-title"><i class="bi bi-eye-slash-fill me-1"></i>Hoteles ocultos</div>' +
            hotelesOcultosModeloList.map(function (item, i) {
                return '<div class="oculto-item"><span>' + item.nombre + '</span>' +
                    '<button class="btn-restaurar" onclick="restaurarHotelModelo(' + i + ')"><i class="bi bi-eye-fill me-1"></i>Mostrar</button></div>';
            }).join('');
    }

    flyerHotelesEl.addEventListener('click', function (e) {
        var btn = e.target.closest('.btn-hide-hotel');
        if (btn) { var row = btn.closest('.fh-row'); if (row) ocultarHotelModelo(row); }
    });
    flyerHotelesEl.addEventListener('input', function (e) {
        if (e.target.classList.contains('precio-val')) {
            clearTimeout(modeloSortTimer);
            modeloSortTimer = setTimeout(ordenarHotelesModelo, 700);
        }
    });

    function renderDestino(idDestino) {
        var d = todosDestinos.find(function (x) { return x.id_Destino === idDestino || x.Id_Destino === idDestino; });
        if (!d) return;
        var nombre = d.nombre_Destino || d.Nombre_Destino || idDestino;
        flyerTitleEl.textContent = nombre;
        var urlFondoModelo = fondosPorDestino[nombre] || '';
        flyerHero.style.background =
            'linear-gradient(to bottom, rgba(0,30,42,.15) 0%, rgba(0,30,42,.72) 100%), ' +
            "url('" + urlFondoModelo + "') center/cover no-repeat";
        hotelesOcultosModeloList = [];
        actualizarPanelOcultosModelo();
        var hoteles = d.hoteles || d.Hoteles || [];
        flyerHotelesEl.innerHTML = hoteles.length
            ? buildHotelRows(hoteles)
            : '<div class="flyer-empty-hint"><i class="bi bi-geo-alt"></i><p>Sin hoteles para este destino.</p></div>';
        setTimeout(scaleFlyer, 100);
    }

    var destinoSelect = document.getElementById('destinoSelect');
    if (destinoSelect) {
        destinoSelect.addEventListener('change', function () {
            renderDestino(this.value);
            // [2026-08-05] Refrescar el input del nombre de archivo con el destino nuevo,
            // salvo que el usuario ya lo haya editado manualmente.
