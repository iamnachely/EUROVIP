@model EuroVip.Models.FlyerEditorModelo
@* Editor de Flyer Editar (clientes): copia del editor de Flyer Cliente de BackTiTan (FlyerCliente/Editor.cshtml)
   con los datos y la marca de Eurovip: destinos tipo «Cliente», hoteles de Solo Hotel y Paquetes, fondos de
   uploads/flyers/fondos, logo Eurovip Travel, eurovip.com.do y precios en RD$. Lo que se guarda va a la galería de Flyer Editar. *@
@{
    ViewData["Title"] = "Flyer Editar — Editor";
    var hayDatos = Model.Destinos.Any();
    var primer   = Model.Destinos.FirstOrDefault();
    var fondosDict = Model.Fondos;
    string heroImgUrl = primer != null && fondosDict.TryGetValue(primer.Nombre_Destino, out var fondoUrl0)
        ? fondoUrl0
        : "";
    var heroBg = !string.IsNullOrEmpty(heroImgUrl)
        ? $"background: linear-gradient(to bottom, rgba(0,30,42,.15) 0%, rgba(0,30,42,.72) 100%), url('{heroImgUrl}') center/cover no-repeat;"
        : "background: linear-gradient(155deg, #003d52 0%, #00647a 55%, #003d52 100%);";
    var primerNombre    = primer?.Nombre_Destino ?? "Destino";
    var posInitColors   = new[] { "#f5a623", "#6ec6f5", "#e07b39", "#cbd5e1", "#cbd5e1" };
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500;600&family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet" />

<style>
.flyerpage { padding: 28px 24px 60px; }

/* ── Tab switcher ── */
.tab-switcher { display: flex; gap: 4px; background: #f1f5f9; border-radius: 12px; padding: 4px; width: fit-content; }
.tab-btn { padding: 9px 24px; border: none; border-radius: 9px; font-size: .88rem; font-weight: 700; cursor: pointer; background: transparent; color: #64748b; transition: all .2s; }
.tab-btn.active { background: #fff; color: #0a3d3d; box-shadow: 0 2px 8px rgba(0,0,0,.1); }
.tab-pane { display: none; }
.tab-pane.active { display: block; }

/* ── Style toolbar ── */
.style-toolbar { display: flex; align-items: center; gap: 10px; padding: 8px 14px; background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; flex-wrap: wrap; margin: 8px 0 4px; }
.st-sep { width: 1px; height: 20px; background: #e2e8f0; flex-shrink: 0; }
.st-btn { background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 8px; padding: 6px 14px; font-size: .82rem; font-weight: 600; cursor: pointer; color: #334155; white-space: nowrap; transition: background .15s, border-color .15s; display: inline-flex; align-items: center; gap: 6px; }
.st-btn:hover { background: #f1f5f9; border-color: #94a3b8; }
.st-btn.active { background: #eff6ff; border-color: #93c5fd; color: #1d4ed8; }
.st-color-preview { display: inline-flex; gap: 4px; align-items: center; }
.st-dot { width: 13px; height: 13px; border-radius: 50%; border: 2px solid rgba(0,0,0,.1); display: inline-block; flex-shrink: 0; }

/* ── Color modal backdrop ── */
.c-backdrop { position: fixed; inset: 0; z-index: 10000; background: rgba(15,23,42,.55); backdrop-filter: blur(6px); display: flex; align-items: center; justify-content: center; padding: 16px; }
.c-modal { background: #fff; border-radius: 22px; width: 580px; max-width: 100%; box-shadow: 0 40px 100px rgba(0,0,0,.28), 0 0 0 1px rgba(255,255,255,.05); overflow: hidden; animation: cModalIn .2s cubic-bezier(.34,1.3,.64,1); }
@@keyframes cModalIn { from { opacity:0; transform:scale(.93) translateY(-12px); } to { opacity:1; transform:none; } }

.c-header { display: flex; align-items: center; justify-content: space-between; padding: 20px 24px 18px; background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 100%); }
.c-header-title { font-size: 1rem; font-weight: 800; color: #fff; display: flex; align-items: center; gap: 10px; }
.c-header-sub { font-size: .75rem; color: rgba(255,255,255,.5); font-weight: 400; margin-top: 2px; }
.c-close { background: rgba(255,255,255,.12); border: none; border-radius: 9px; width: 34px; height: 34px; color: rgba(255,255,255,.8); cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: .85rem; transition: background .15s; flex-shrink: 0; }
.c-close:hover { background: rgba(255,255,255,.22); color: #fff; }

.c-body { padding: 22px 24px 8px; display: flex; gap: 18px; }
.c-col { flex: 1; min-width: 0; }
.c-col-label { font-size: .68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; color: #94a3b8; margin-bottom: 10px; display: flex; align-items: center; gap: 7px; }
.c-col-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; transition: background .2s; }
.c-palette { display: grid; grid-template-columns: repeat(6,1fr); gap: 7px; margin-bottom: 12px; }
.c-swatch { aspect-ratio: 1; border-radius: 9px; border: 2.5px solid transparent; cursor: pointer; transition: transform .12s, border-color .12s, box-shadow .12s; position: relative; }
.c-swatch:hover { transform: scale(1.18); box-shadow: 0 4px 12px rgba(0,0,0,.25); }
.c-swatch.sel { border-color: #0f172a; transform: scale(1.12); box-shadow: 0 4px 14px rgba(0,0,0,.22); }
.c-swatch.sel::after { content: '✓'; position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: .6rem; font-weight: 900; color: #fff; text-shadow: 0 1px 4px rgba(0,0,0,.6); }
.c-swatch[data-color="#ffffff"].sel::after { color: #334155; text-shadow: none; }
.c-preview-box { background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); border: 1px solid #e2e8f0; border-radius: 11px; padding: 12px 14px; text-align: center; }
.c-preview-price { font-family: Arial,sans-serif; font-size: 1.7rem; font-weight: 800; transition: color .18s; }
.c-preview-euro { font-size: 1.1rem; font-weight: 400; opacity: .75; }
.c-preview-lbl { font-size: .7rem; color: #94a3b8; margin-top: 4px; }
.c-divider { width: 1px; background: #f1f5f9; flex-shrink: 0; margin: 0 2px; }

.c-footer { padding: 14px 24px 20px; border-top: 1px solid #f1f5f9; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.c-custom-wrap { display: flex; align-items: center; gap: 8px; flex: 1; }
.c-custom-lbl { font-size: .78rem; font-weight: 600; color: #64748b; white-space: nowrap; }
.c-custom-input { width: 34px; height: 34px; border: 2px solid #e2e8f0; border-radius: 8px; padding: 1px; cursor: pointer; background: none; }
.c-apply { font-size: .76rem; font-weight: 700; padding: 5px 10px; border: 1.5px solid #e2e8f0; border-radius: 7px; background: #f8fafc; color: #334155; cursor: pointer; white-space: nowrap; transition: all .12s; }
.c-apply:hover { background: #f1f5f9; border-color: #94a3b8; }
.c-done { padding: 8px 22px; background: linear-gradient(135deg, #0f172a, #1e3a5f); color: #fff; border: none; border-radius: 10px; font-size: .85rem; font-weight: 700; cursor: pointer; transition: opacity .15s; }
.c-done:hover { opacity: .85; }

/* ── Layout ── */
.fb-layout { display: grid; grid-template-columns: 320px 1fr; gap: 24px; align-items: start; }
@@media (max-width: 900px) { .fb-layout { grid-template-columns: 1fr; } }
.fb-controls { display: flex; flex-direction: column; gap: 14px; position: sticky; top: 20px; min-width: 0; }
.fb-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 18px 20px; box-shadow: 0 2px 12px rgba(0,0,0,.05); min-width: 0; max-width: 100%; }
.fb-card-title { font-size: .7rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #94a3b8; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
.fb-card-title i { font-size: .9rem; }
.dest-select { width: 100%; padding: 10px 14px; border: 1.5px solid #e2e8f0; border-radius: 10px; font-size: .9rem; font-weight: 500; background: #f8fafc; cursor: pointer; transition: border-color .15s; }
.dest-select:focus { outline: none; border-color: #0d7377; }

/* ── Buttons ── */
.btn-tp { display: inline-flex; align-items: center; gap: 7px; padding: 10px 20px; border: none; border-radius: 10px; font-size: .85rem; font-weight: 600; cursor: pointer; transition: background .15s, transform .1s; text-decoration: none; width: 100%; justify-content: center; }
.btn-tp + .btn-tp { margin-top: 8px; }
.btn-tp:active { transform: scale(.97); }
.btn-tp.teal  { background: #0d7377; color: #fff; }
.btn-tp.teal:hover  { background: #0a5254; }
.btn-tp.green { background: #2eb5a0; color: #fff; }
.btn-tp.green:hover { background: #23907e; }
.btn-tp.ghost { background: #f8fafc; color: #334155; border: 1.5px solid #e2e8f0; }
.btn-tp.ghost:hover { background: #f1f5f9; }
.btn-tp.dark  { background: #0f172a; color: #fff; }
.btn-tp.dark:hover  { background: #1e293b; }
.btn-tp:disabled { opacity: .5; cursor: not-allowed; pointer-events: none; }
.btn-tp .spin { animation: tspin .7s linear infinite; display: inline-block; }
@@keyframes tspin { to { transform: rotate(360deg); } }

.saved-bar { display: none; margin-top: 12px; padding: 10px 14px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px; font-size: .8rem; color: #15803d; align-items: center; gap: 8px; }
.saved-bar.show { display: flex; }
.saved-bar a { font-weight: 700; color: #15803d; }
.status-dot  { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #22c55e; margin-right: 6px; vertical-align: middle; }
.status-label { font-size: .83rem; color: #334155; font-weight: 600; }
.status-date  { font-size: .76rem; color: #94a3b8; margin-top: 4px; }

/* ── Hoteles ocultos ── */
.ocultos-panel { background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 10px; padding: 10px 14px; }
.ocultos-title { font-size: .7rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #94a3b8; margin-bottom: 8px; }
.oculto-item { display: flex; align-items: center; justify-content: space-between; padding: 5px 0; border-bottom: 1px solid #e2e8f0; font-size: .82rem; }
.oculto-item:last-child { border-bottom: none; }
.oculto-item span { color: #334155; font-weight: 500; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 8px; }
.btn-restaurar { background: none; border: 1px solid #cbd5e1; border-radius: 6px; font-size: .75rem; padding: 3px 8px; cursor: pointer; color: #64748b; white-space: nowrap; transition: border-color .15s, color .15s; flex-shrink: 0; }
.btn-restaurar:hover { border-color: #0f172a; color: #0f172a; }

/* ── Flyer template ── */
.fb-stage { display: flex; justify-content: center; padding: 4px 0 40px; }
.fb-scale-wrap { transform-origin: top center; }
.flyer { width: 900px; min-height: 1200px; background: #fff; font-family: Arial, sans-serif; position: relative; overflow: hidden; box-shadow: 0 32px 80px rgba(0,61,82,.26); display: flex; flex-direction: column; }
.flyer-accent { height: 9px; background: linear-gradient(90deg, #e76f51, #f4a261, #f9c74f, #f4a261, #e76f51); flex-shrink: 0; }
.flyer-hero { background-color: #003d52; background-size: cover; background-position: center; min-height: 100px; padding: 16px 66px; flex-shrink: 0; position: relative; overflow: visible; display: flex; flex-direction: column; justify-content: flex-end; }
.flyer-hero::before { content: ''; position: absolute; top: -90px; right: -90px; width: 390px; height: 390px; border-radius: 50%; background: rgba(249,199,79,.06); pointer-events: none; }
.flyer-hero::after  { content: ''; position: absolute; bottom: -75px; left: -60px; width: 300px; height: 300px; border-radius: 50%; background: rgba(231,111,81,.06); pointer-events: none; }
.flyer-title    { font-family: 'Playfair Display', serif; font-weight: 900; font-size: var(--tam-titulo,6.5rem); line-height: 1; color: #fff; margin: 0 0 12px; letter-spacing: -.5px; text-shadow: 0 2px 18px rgba(0,0,0,.35); }
.flyer-subtitle { font-size: var(--tam-subtitulo,1.1rem); color: rgba(255,255,255,.5); letter-spacing: .5px; margin-bottom: 36px; }
.flyer-section-title { font-size: .88rem; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: #e76f51; padding: 26px 66px 18px; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; gap: 14px; }
.flyer-section-title::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, #f1f5f9, transparent); }
.flyer-hotels { flex: 1; }
.fh-row { display: flex; align-items: flex-start; gap: 10px; padding: 20px 50px 20px 20px; border-bottom: 1px solid #f8fafc; border-left: 3px solid transparent; position: relative; }
.fh-row:last-child { border-bottom: none; }
.fh-row.best { background: linear-gradient(90deg, rgba(245,158,11,.06) 0%, transparent 55%); border-left: 3px solid #f59e0b; padding-left: 17px; }
.fh-pos { font-family: Arial, sans-serif; font-size: 2.1rem; font-weight: 900; min-width: 52px; text-align: center; color: #cbd5e1; }
.fh-pos.gold   { color: #f5a623; text-shadow: 0 0 12px rgba(245,166,35,.45); }
.fh-pos.silver { color: #6ec6f5; text-shadow: 0 0 12px rgba(110,198,245,.35); }
.fh-pos.bronze { color: #e07b39; text-shadow: 0 0 12px rgba(224,123,57,.35); }
.fh-sep  { width: 1px; height: 56px; background: #e2e8f0; flex-shrink: 0; }
.fh-info { flex: 1; min-width: 0; }
.fh-name { font-size: var(--tam-nombre,2.1rem); font-weight: 700; color: #0f172a; white-space: normal; overflow: visible; }
.fh-meta { font-size: var(--tam-regimen,1.85rem); font-weight: 700; color: #e07b39; margin-top: 4px; }
.fh-best-tag { display: inline-flex; align-items: center; gap: 4px; font-size: .95rem; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: #f59e0b; margin-top: 5px; }
.fh-price { font-family: Arial, sans-serif; font-weight: 700; font-size: var(--tam-precio,2.75rem); color: #003d52; white-space: nowrap; text-align: right; align-self: flex-end; margin-top: auto; padding-top: 3.5rem; }
.fh-price.rank1 { color: #f59e0b; }
.precio-sym { font-size: 1.6rem; font-weight: 400; opacity: .75; margin-right: 2px; }
.precio-val[contenteditable="true"] { cursor: text; min-width: 40px; display: inline-block; }
.precio-val[contenteditable="true"]:focus { outline: 1.5px solid rgba(0,119,182,.3); border-radius: 4px; background: rgba(0,119,182,.05); }

/* ── Hide hotel button ── */
.btn-hide-hotel { position: absolute; top: 8px; right: 10px; background: none; border: none; cursor: pointer; color: #cbd5e1; font-size: 1rem; padding: 4px 7px; border-radius: 6px; transition: color .15s, background .15s; opacity: 0; }
.fh-row:hover .btn-hide-hotel { opacity: 1; }
.btn-hide-hotel:hover { color: #64748b; background: #f1f5f9; }

/* ── Contenteditable focus ── */
.flyer-title[contenteditable="true"]:focus,
.flyer-subtitle[contenteditable="true"]:focus { outline: 2px dashed rgba(255,255,255,.35); border-radius: 4px; }
.flyer-section-title[contenteditable="true"]:focus,
.ff-url[contenteditable="true"]:focus,
.ff-tag[contenteditable="true"]:focus,
.fh-name[contenteditable="true"]:focus,
.fh-meta[contenteditable="true"]:focus { outline: 1.5px solid rgba(0,119,182,.25); border-radius: 4px; background: rgba(0,119,182,.04); }
[contenteditable="true"] { outline: none; }

.flyer-footer { padding: 24px 66px; display: flex; align-items: center; gap: 26px; background: #fff; border-top: 1px solid #f1f5f9; flex-shrink: 0; font-size: var(--tam-footer, 1rem); }
.ff-line  { flex: 1; height: 1px; background: linear-gradient(90deg, transparent, #00647a 40%, transparent); }
.ff-brand { display: flex; flex-direction: column; align-items: center; }
.ff-url   { font-family: Arial, sans-serif; font-size: .6em; font-weight: 700; color: #003d52; letter-spacing: .5px; white-space: nowrap; }
.ff-tag   { font-size: .86em; color: #94a3b8; letter-spacing: 1.5px; text-transform: uppercase; margin-top: 2px; }
.logo-panel { display: flex; flex-direction: column; gap: 12px; min-width: 0; width: 100%; }
.logo-preview-box { min-height: 122px; padding: 14px; border-radius: 12px; border: 1px dashed #cbd5e1; background: #f8fafc; display: flex; align-items: center; justify-content: center; }
.logo-preview-box img { max-width: 100%; max-height: 96px; object-fit: contain; display: block; }
.logo-actions { display: flex; flex-wrap: wrap; gap: 8px; }
.logo-actions .btn-tp { width: auto; flex: 1 1 132px; margin-top: 0 !important; }
.logo-hint { font-size: .76rem; color: #64748b; line-height: 1.35; overflow-wrap: break-word; word-break: break-all; max-width: 100%; }
.flyer-empty-hint { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 40px; text-align: center; }
.flyer-empty-hint i { font-size: 2.8rem; color: #cbd5e1; display: block; margin-bottom: 14px; }
.flyer-empty-hint p { font-size: .95rem; color: #94a3b8; }

/* ── Editor panel ── */
.hc-row { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
.hc-num { font-size: .8rem; font-weight: 800; color: #0f172a; min-width: 18px; text-align: center; }
.hc-row .ts-wrapper { flex: 1; min-width: 0; }
.hc-del { background: none; border: none; color: #dc2626; cursor: pointer; font-size: 1rem; padding: 5px 7px; border-radius: 7px; transition: background .15s; flex-shrink: 0; }
.hc-del:hover { background: #fee2e2; }
.dest-group + .dest-group { padding-top: 12px; margin-top: 4px; border-top: 1px solid #f1f5f9; }
.dest-group-hdr { display: flex; align-items: center; gap: 6px; margin-bottom: 8px; }
.dest-group-hdr .ts-wrapper { flex: 1; min-width: 0; }
.dest-group-del { background: none; border: none; color: #94a3b8; cursor: pointer; font-size: 1rem; padding: 4px 6px; border-radius: 6px; flex-shrink: 0; transition: color .15s, background .15s; }
.dest-group-del:hover { color: #dc2626; background: #fee2e2; }
.btn-add-hotel-sm { display: flex; align-items: center; justify-content: center; gap: 5px; padding: 5px 12px; border: 1px dashed #cbd5e1; border-radius: 8px; font-size: .78rem; font-weight: 600; color: #64748b; background: none; cursor: pointer; width: 100%; margin-top: 4px; transition: border-color .15s, color .15s, background .15s; }
.btn-add-hotel-sm:hover:not(:disabled) { border-color: #0f172a; color: #0f172a; background: #f8fafc; }
.btn-add-hotel-sm:disabled { opacity: .4; cursor: not-allowed; }

/* ── Template strip ── */
.tpl-strip { display:flex; gap:6px; align-items:center; padding:8px 0 4px; flex-wrap:wrap; }

/* ── Diseños (los mismos 5 de /Agencia). Clásica = sin clase. Solo CSS: el flyer, la edición y la descarga no cambian ── */
.st-dis { display: inline-flex; align-items: center; gap: 6px; flex-wrap: wrap; font-size: .82rem; font-weight: 700; color: #334155; }
.st-dis button { border: 1.5px solid #e2e8f0; border-radius: 8px; padding: 5px 10px 5px 6px; background: #f8fafc; font-size: .8rem; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; color: #334155; }
.st-dis button i { width: 18px; height: 18px; border-radius: 5px; display: inline-block; }
.st-dis button.on { border-color: #FF8A3D; background: #FFF7F0; box-shadow: 0 0 0 2px rgba(255,138,61,.2); }
/* Postal: tarjetas blancas sobre gris, precio en etiqueta naranja, pie azul */
.flyer.sk-postal .flyer-accent { background: #FF8A3D; }
.flyer.sk-postal .flyer-section-title { color: #fff; background: #FF8A3D; margin: 22px 40px 6px; border-radius: 99px; padding: 10px 22px; border: 0; align-self: flex-start; }
.flyer.sk-postal .flyer-section-title::after { display: none; }
.flyer.sk-postal .flyer-hotels { background: #F6F8FA; padding: 10px 40px 20px; }
.flyer.sk-postal .fh-row { background: #fff; border-radius: 20px; margin-bottom: 12px; border: 0; box-shadow: 0 10px 26px -14px rgba(0,40,60,.35); padding: 18px 26px 18px 14px; }
.flyer.sk-postal .fh-row.best { background: linear-gradient(135deg, #003d52, #00647a); border: 0; }
.flyer.sk-postal .fh-row.best .fh-name { color: #fff !important; }
.flyer.sk-postal .fh-row.best .fh-meta, .flyer.sk-postal .fh-row.best .fh-best-tag { color: #FFD08A !important; }
.flyer.sk-postal .fh-sep { display: none; }
.flyer.sk-postal .fh-price { background: #FF8A3D; color: #fff !important; border-radius: 14px; padding: 8px 16px; align-self: center; margin-top: 0; }
.flyer.sk-postal .flyer-footer { background: #003d52; border: 0; }
.flyer.sk-postal .ff-url { color: #fff !important; } .flyer.sk-postal .ff-tag { color: #9FD3DC !important; } .flyer.sk-postal .ff-line { background: rgba(255,255,255,.25); }
/* Elegante: azul noche y dorado */
.flyer.sk-elegante { background: radial-gradient(circle at 20% 0%, #13365a 0%, #0A1A30 60%); }
.flyer.sk-elegante .flyer-accent { background: linear-gradient(90deg, transparent, #D4AF37, transparent); height: 3px; }
.flyer.sk-elegante .flyer-hero { margin: 18px 40px 0; border-radius: 26px; border: 2px solid rgba(212,175,55,.55); }
.flyer.sk-elegante .flyer-section-title { color: #D4AF37; border-color: rgba(212,175,55,.25); justify-content: center; }
.flyer.sk-elegante .flyer-section-title::after { display: none; }
.flyer.sk-elegante .fh-row, .flyer.sk-elegante .fh-row.best { background: transparent; border-left-color: transparent; border-bottom: 1px solid rgba(212,175,55,.2); }
.flyer.sk-elegante .fh-pos { color: #D4AF37 !important; text-shadow: none; }
.flyer.sk-elegante .fh-sep { background: rgba(212,175,55,.35); }
.flyer.sk-elegante .fh-name { color: #fff !important; }
.flyer.sk-elegante .fh-meta { color: #C9B98F !important; }
.flyer.sk-elegante .fh-best-tag { color: #D4AF37 !important; }
.flyer.sk-elegante .fh-price { color: #D4AF37 !important; }
.flyer.sk-elegante .flyer-footer { background: transparent; border-top: 1px solid rgba(212,175,55,.3); }
.flyer.sk-elegante .ff-url { color: #D4AF37 !important; } .flyer.sk-elegante .ff-tag { color: #C9B98F !important; } .flyer.sk-elegante .ff-line { background: linear-gradient(90deg, transparent, rgba(212,175,55,.6), transparent); }
/* Minimal: blanco, líneas finas, números grises, precios negros */
.flyer.sk-minimal .flyer-accent { display: none; }
.flyer.sk-minimal .flyer-hero { margin: 28px 40px 0; border-radius: 8px; }
.flyer.sk-minimal .flyer-section-title { color: #64748B; letter-spacing: 4px; }
.flyer.sk-minimal .fh-row, .flyer.sk-minimal .fh-row.best { background: transparent; border-left-color: transparent; border-bottom: 1px solid #E2E8F0; }
.flyer.sk-minimal .fh-pos { color: #94A3B8 !important; text-shadow: none; font-size: 1.6rem; }
.flyer.sk-minimal .fh-sep { display: none; }
.flyer.sk-minimal .fh-meta { color: #64748B !important; }
.flyer.sk-minimal .fh-best-tag { color: #E25A00 !important; }
.flyer.sk-minimal .fh-price { color: #0F172A !important; }
.flyer.sk-minimal .fh-price.rank1 { color: #E25A00 !important; }
.flyer.sk-minimal .ff-url { color: #0F172A !important; } .flyer.sk-minimal .ff-line { background: #E2E8F0; }
/* Vibrante: degradado naranja-rosa, filas blancas y precio en etiqueta oscura */
.flyer.sk-vibrante { background: linear-gradient(170deg, #FF8A3D 0%, #FF5E3A 45%, #E0306B 100%); }
.flyer.sk-vibrante .flyer-accent { background: #FFE14D; }
.flyer.sk-vibrante .flyer-hero { margin: 22px 36px 0; border-radius: 30px; border: 6px solid rgba(255,255,255,.85); }
.flyer.sk-vibrante .flyer-section-title { color: #fff; border: 0; }
.flyer.sk-vibrante .flyer-section-title::after { background: rgba(255,255,255,.4); }
.flyer.sk-vibrante .flyer-hotels { padding: 0 36px 16px; }
.flyer.sk-vibrante .fh-row, .flyer.sk-vibrante .fh-row.best { background: #fff; border-radius: 20px; margin-bottom: 12px; border: 0; padding: 16px 22px 16px 12px; box-shadow: 0 8px 20px -10px rgba(0,0,0,.35); }
.flyer.sk-vibrante .fh-pos { color: #E25A00 !important; text-shadow: none; }
.flyer.sk-vibrante .fh-sep { display: none; }
.flyer.sk-vibrante .fh-price { background: #1F2937; color: #FFE14D !important; border-radius: 12px; padding: 8px 14px; align-self: center; margin-top: 0; }
.flyer.sk-vibrante .flyer-footer { background: transparent; border: 0; }
.flyer.sk-vibrante .ff-url { color: #fff !important; } .flyer.sk-vibrante .ff-tag { color: #FFE14D !important; } .flyer.sk-vibrante .ff-line { background: rgba(255,255,255,.4); }
.tpl-tab { display:inline-flex; align-items:center; gap:7px; padding:7px 14px; border:1.5px solid #e2e8f0; border-radius:9px; background:#fff; font-size:.82rem; font-weight:600; color:#64748b; cursor:pointer; transition:all .15s; user-select:none; }
.tpl-tab:hover { border-color:#94a3b8; background:#f8fafc; }
.tpl-tab.active { border-color:#0d7377; background:#f0fdfa; color:#0d7377; }
.tpl-name { outline:none; min-width:50px; max-width:120px; cursor:text; }
.tpl-del { background:none; border:none; color:#94a3b8; cursor:pointer; font-size:.8rem; padding:0 2px; transition:color .15s; line-height:1; flex-shrink:0; }
.tpl-del:hover { color:#dc2626; }
.btn-nueva-tpl { display:inline-flex; align-items:center; gap:6px; padding:7px 14px; border:1.5px dashed #cbd5e1; border-radius:9px; background:none; font-size:.82rem; font-weight:600; color:#64748b; cursor:pointer; transition:all .15s; }
.btn-nueva-tpl:hover { border-color:#0d7377; color:#0d7377; background:#f0fdfa; }

/* ── Mini swatches (extended color modal) ── */
.c-mini-sec { padding:0 24px 16px; border-top:1px solid #f1f5f9; }
.c-mini-header { font-size:.65rem; font-weight:800; text-transform:uppercase; letter-spacing:2px; color:#94a3b8; margin:14px 0 10px; }
.c-mini-grid { display:flex; gap:8px; flex-wrap:wrap; }
.c-mini-col { flex:1; min-width:80px; }
.c-mini-lbl { font-size:.7rem; font-weight:700; color:#64748b; margin-bottom:6px; display:flex; align-items:center; gap:5px; }
.c-mini-dot { width:9px; height:9px; border-radius:50%; flex-shrink:0; transition:background .2s; }
.c-mini-pal { display:grid; grid-template-columns:repeat(5,1fr); gap:4px; }
.c-mini-sw { aspect-ratio:1; border-radius:5px; border:2px solid transparent; cursor:pointer; transition:transform .12s, border-color .12s; }
.c-mini-sw:hover { transform:scale(1.2); }
.c-mini-sw.sel { border-color:#0f172a; }
.c-mini-prev { height:14px; border-radius:4px; margin-top:4px; border:1px solid #e2e8f0; transition:background .15s; }

/* ── Tipografía modal ── */
.tam-row { display:flex; align-items:center; gap:12px; padding:10px 0; border-bottom:1px solid #f1f5f9; }
.tam-row:last-child { border-bottom:none; }
.tam-label { font-size:.8rem; font-weight:600; color:#334155; min-width:120px; flex-shrink:0; }
.tam-slider { flex:1; accent-color:#0d7377; }
.tam-val { font-size:.8rem; font-weight:700; color:#0d7377; min-width:50px; text-align:right; white-space:nowrap; }

/* ── Fondo gallery modal ── */
.fondo-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; padding:12px 20px; max-height:270px; overflow-y:auto; }
.fondo-item { position:relative; border-radius:10px; overflow:hidden; cursor:pointer; border:2.5px solid transparent; transition:border-color .15s, box-shadow .15s; background:#e2e8f0; aspect-ratio:3/4; }
.fondo-item:hover { border-color:#0d7377; box-shadow:0 4px 14px rgba(0,0,0,.15); }
.fondo-item.sel { border-color:#f59e0b; }
.fondo-item img { width:100%; height:100%; object-fit:cover; display:block; }
.fondo-item-name { position:absolute; bottom:0; left:0; right:0; background:rgba(0,0,0,.65); padding:5px 7px; font-size:.7rem; color:#fff; font-weight:600; outline:none; }
.fondo-empty { padding:36px 20px; text-align:center; color:#94a3b8; font-size:.88rem; }

/* ── Toast ── */
.flyer-toast { position: fixed; bottom: 28px; right: 28px; padding: 13px 20px; border-radius: 10px; font-size: .84rem; font-weight: 600; color: #fff; box-shadow: 0 8px 30px rgba(0,0,0,.2); z-index: 9999; opacity: 0; transform: translateY(10px); transition: opacity .3s, transform .3s; pointer-events: none; }
.flyer-toast.show { opacity: 1; transform: none; }
.flyer-toast.ok   { background: #16a34a; }
.flyer-toast.err  { background: #dc2626; }
.flyer-toast.info { background: #0d7377; }
/* utilidades de Bootstrap que usa el editor (Eurovip solo carga bootstrap-reboot) */
.me-1 { margin-right: .25rem; } .ms-auto { margin-left: auto; } .mt-2 { margin-top: .5rem; } .mt-3 { margin-top: 1rem; } .mb-0 { margin-bottom: 0; }
.small { font-size: .875em; } .text-muted { color: #64748b; } .d-none { display: none !important; }
.ev-nav-editor { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-bottom: 14px; padding: 12px 16px; border-radius: 16px; background: #fff; border: 1px solid #e2e8f0; }
.ev-nav-editor a { color: #0d7377; font-weight: 700; text-decoration: none; font-size: .9rem; }
.ev-nav-editor a.ir { padding: 7px 14px; border-radius: 10px; background: #0d7377; color: #fff; }
.ev-nav-editor b { font-size: 1rem; }
</style>

<div class="flyerpage">

    @Html.AntiForgeryToken()
    <div class="ev-nav-editor">
        <a href="/Flyer/Hub"><i class="bi bi-arrow-left"></i> Centro de Flyers</a>
        <b><i class="bi bi-person-check-fill"></i> Flyer Editar · Editor</b>
        <span style="flex:1"></span>
        <a href="/Flyer/Editar" class="ir"><i class="bi bi-images"></i> Galería, contactos y envío</a>
    </div>

    <!-- ── Tabs ── -->
    <div class="tab-switcher mb-0">
        <button class="tab-btn active" data-tab="modelo" onclick="switchTab('modelo',this)">
            <i class="bi bi-layout-text-sidebar-reverse me-1"></i> Modelo
        </button>
        <button class="tab-btn" data-tab="editor" onclick="switchTab('editor',this)">
            <i class="bi bi-pencil-square me-1"></i> Editor
        </button>
    </div>

    <!-- ── Shared toolbar ── -->
    <div class="style-toolbar">
        <button id="btnAbrirColores" class="st-btn">
            <i class="bi bi-palette-fill"></i> Colores
            <span class="st-color-preview">
                <span class="st-dot" id="dotBtnRank1" style="background:#f59e0b;"></span>
                <span class="st-dot" id="dotBtnOtros" style="background:#003d52;"></span>
            </span>
        </button>
        <span class="st-sep"></span>
        <button id="btnAbrirTipografia" class="st-btn"><i class="bi bi-fonts"></i> Tipografía</button>
        <span class="st-sep"></span>
        <button id="btnAbrirFondo" class="st-btn"><i class="bi bi-image-fill"></i> Fondos</button>
        <span class="st-sep"></span>
        <button id="btnToggleLogo" class="st-btn"><i class="bi bi-image"></i> Logo</button>
        <span class="st-sep"></span>
        <span class="st-dis" id="stDisenos" title="Diseño del flyer: los mismos de Flyer Agencia. Se usa al guardar y descargar.">Diseño:</span>
        <span class="st-sep"></span>
        <span id="stMoneda"></span>
        <div id="stColores" hidden style="flex-basis:100%;border-top:1px dashed #e2e8f0;padding-top:8px"></div>
    </div>

    <!-- ══════════════════════════════════
         TAB: MODELO
    ══════════════════════════════════ -->
    <div id="tab-modelo" class="tab-pane active mt-3">
        <div class="fb-layout">
            <div class="fb-controls">
                <div class="fb-card">
                    <div class="fb-card-title"><i class="bi bi-geo-alt-fill"></i> Destino</div>
                    <select id="destinoSelect" class="dest-select">
                        @if (!Model.Destinos.Any())
                        {
                            <option value="">— Sin datos disponibles —</option>
                        }
                        @foreach (var d in Model.Destinos)
                        {
                            <option value="@d.Id_Destino" data-nombre="@d.Nombre_Destino">@d.Nombre_Destino</option>
                        }
                    </select>
                    @if (!Model.Configs.Any())
                    {
                        <div class="mt-2 small text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            Sin configuraciones de tipo Cliente.
                            <a href="/Flyer/Editar" style="color:#0d7377;">Agregar</a>
                        </div>
                    }
                </div>

                <div class="fb-card">
                    <div class="fb-card-title"><i class="bi bi-info-circle"></i> Estado</div>
                    <div class="status-label">
                        <span class="status-dot"></span>
                        @(Model.UltimaActualizacion.HasValue ? "Datos disponibles" : "Sin datos")
                    </div>
                    @if (Model.UltimaActualizacion.HasValue)
                    {
                        <div class="status-date">Última actualización: @Model.UltimaActualizacion.Value.ToString("dd/MM/yyyy HH:mm")</div>
                    }
                </div>

                <div id="ocultosPanelModelo" class="ocultos-panel" style="display:none;"></div>

                <div class="fb-card">
                    <div class="fb-card-title"><i class="bi bi-lightning-fill"></i> Acciones</div>
                    <button id="btnActualizar" class="btn-tp teal" onclick="actualizarDestino()">
                        <i class="bi bi-arrow-clockwise"></i> Actualizar precios
                    </button>

                    @* [2026-08-05] Nombre editable del flyer — el input siempre visible muestra
                       el nombre con que se guardará el archivo del destino actualmente seleccionado.
                       Validación en vivo: debe contener el nombre de un destino de configuración. *@
                    <div style="margin-top:10px;">
                        <label for="nombreArchivoInput" style="display:block;font-size:.75rem;font-weight:700;color:#334155;letter-spacing:.4px;text-transform:uppercase;margin-bottom:4px;">
                            <i class="bi bi-file-earmark-image"></i> Nombre del flyer
                        </label>
                        <input id="nombreArchivoInput" type="text"
                               style="width:100%;padding:8px 10px;border:1.5px solid #cbd5e1;border-radius:8px;font-size:.82rem;font-family:'SF Mono',Consolas,monospace;color:#0f172a;background:#f8fafc;"
                               placeholder="cliente_DESTINO_p1_YYYYMMDD.png"
                               autocomplete="off" />
                        <div id="nombreArchivoHint" style="margin-top:4px;font-size:.72rem;color:#64748b;line-height:1.35;">
                            Debe contener un destino de configuración.
                        </div>
                    </div>

                    <button id="btnGuardar" class="btn-tp green" onclick="guardarImagen()" style="margin-top:8px;">
                        <i class="bi bi-download"></i> Guardar flyer
                    </button>
                    <a href="/Flyer/Editar" class="btn-tp dark" style="margin-top:8px;background:linear-gradient(135deg,#0d7377,#065f46);">
                        <i class="bi bi-whatsapp"></i> Ir a envío WhatsApp
                    </a>
                    <a href="/Flyer/Editar" class="btn-tp ghost" style="margin-top:8px;">
                        <i class="bi bi-images"></i> Ver flyers guardados
                    </a>
                    <div id="savedBar" class="saved-bar">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Guardado: <a id="savedLink" href="#" target="_blank">ver imagen</a></span>
                    </div>
                </div>

                @if (Model.Configs.Any())
                {
                    <div class="fb-card">
                        <div class="fb-card-title"><i class="bi bi-sliders2"></i> Configuraciones</div>
                        @foreach (var cfg in Model.Configs)
                        {
                            <div style="display:flex;align-items:center;justify-content:space-between;padding:6px 0;border-bottom:1px solid #f1f5f9;">
                                <span style="font-size:.82rem;font-weight:600;color:#334155;">@(cfg.Nombre_Config ?? cfg.Nombre_Destino ?? cfg.Id_Destino)</span>
                                <button class="btn-tp teal" style="width:auto;padding:4px 12px;font-size:.75rem;" onclick="actualizarConfig(@cfg.Id)">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Flyer Modelo -->
            <div>
                <div class="fb-stage" id="fbStage">
                    <div id="flyerScaleWrap" class="fb-scale-wrap">
                        <div class="flyer" id="flyerTemplate">
                            <div class="flyer-accent"></div>
                            <div class="flyer-hero" id="flyerHero" style="@heroBg">
                                <div id="logoWrapModelo" style="position:absolute;top:-18px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:14px;white-space:nowrap;">
                                    <div style="width:70px;height:1.5px;background:linear-gradient(90deg,transparent,rgba(249,199,79,.7));"></div>
                                    <div style="border:1.5px solid rgba(249,199,79,.45);border-radius:10px;padding:4px 10px;background:rgba(0,40,60,.35);backdrop-filter:blur(6px);">
                                        <img src="@Model.Logo" alt="Eurovip Travel" style="height:100px;object-fit:contain;display:block;">
                                    </div>
                                    <div style="width:70px;height:1.5px;background:linear-gradient(90deg,rgba(249,199,79,.7),transparent);"></div>
                                </div>
                                <div style="height:260px;flex-shrink:0;"></div>
                                <div class="flyer-title" id="flyerTitleEl" contenteditable="true" spellcheck="false">@primerNombre</div>
                                <div class="flyer-subtitle" id="flyerSubtitleModelo" contenteditable="true" spellcheck="false">Oferta especial · Todo incluido · Salida Madrid</div>
                                <div style="height:33px;"></div>
                            </div>

                            <div class="flyer-section-title" id="flyerSeccionModelo" contenteditable="true" spellcheck="false">Top hoteles más económicos</div>

                            <div class="flyer-hotels" id="flyerHoteles">
                                @if (!hayDatos)
                                {
                                    <div class="flyer-empty-hint">
                                        <i class="bi bi-geo-alt"></i>
                                        <p>Haz clic en <strong>Actualizar precios</strong> para cargar datos del destino.</p>
                                    </div>
                                }
                                else
                                {
                                    var dest = primer!;
                                    for (int i = 0; i < dest.Hoteles.Count; i++)
                                    {
                                        var h        = dest.Hoteles[i];
                                        var pos      = i + 1;
                                        var posColor = i < posInitColors.Length ? posInitColors[i] : "#cbd5e1";
                                        <div class="fh-row @(pos==1?"best":"")" data-precio="@h.Precio_Final">
                                            <div class="fh-pos" style="color:@posColor">@pos</div>
                                            <div class="fh-sep"></div>
                                            <div class="fh-info">
                                                <div class="fh-name" contenteditable="true" spellcheck="false">@h.Nombre_Hotel</div>
                                                <div class="fh-meta" contenteditable="true" spellcheck="false" style="color:#e07b39">@h.Regimen</div>
                                                @if (pos == 1) { <div class="fh-best-tag"><i class="bi bi-star-fill" style="font-size:.85rem;"></i> Mejor precio</div> }
                                            </div>
                                            <div class="fh-price @(pos==1?"rank1":"")">
                                                <span class="precio-sym">RD$&nbsp;</span><span class="precio-val" contenteditable="true" spellcheck="false">@h.Precio_Final</span>
                                            </div>
                                            <button class="btn-hide-hotel" title="Ocultar hotel" type="button"><i class="bi bi-eye-slash"></i></button>
                                        </div>
                                    }
                                }
                            </div>

                            <div class="flyer-footer">
                                <div class="ff-line"></div>
                                <div class="ff-brand">
                                    <div class="ff-url" id="footerUrlModelo" contenteditable="true" spellcheck="false">@Model.WebTexto</div>
                                    <div class="ff-tag" id="footerTagModelo" contenteditable="true" spellcheck="false">tu agencia de confianza</div>
                                </div>
                                <div class="ff-line"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════
         TAB: EDITOR
    ══════════════════════════════════ -->
    <div id="tab-editor" class="tab-pane mt-3">
        <div class="fb-layout">
            <div class="fb-controls">
                <div class="fb-card">
                    <div class="fb-card-title"><i class="bi bi-geo-alt-fill"></i> Destinos y Hoteles</div>
                    <div id="destGroupsContainer"></div>
                    <button id="btnAgregarDestino" class="btn-tp dark" style="margin-top:10px;">
                        <i class="bi bi-plus-circle"></i> Agregar otro destino
                    </button>
                </div>

                <div id="ocultosPanelEditor" class="ocultos-panel" style="display:none;"></div>

                <div class="fb-card">
                    <div class="fb-card-title"><i class="bi bi-badge-ad"></i> Logo y enlace</div>
                    <div class="logo-panel">
                        <div class="logo-preview-box">
                            <img id="logoPreviewEditor" src="@Model.Logo" alt="Logo actual">
                        </div>
                        <div class="logo-actions">
                            <input type="file" id="logoFileInputEditor" accept="image/png" style="display:none">
                            <button type="button" class="btn-tp ghost" id="btnCargarLogoEditor">
                                <i class="bi bi-upload"></i> Cargar logo
                            </button>
                            <button type="button" class="btn-tp ghost" id="btnRestaurarLogoEditor">
                                <i class="bi bi-arrow-counterclockwise"></i> Logo por defecto
                            </button>
                            <button type="button" class="btn-tp teal" id="btnEditarLinkOferta">
                                <i class="bi bi-link-45deg"></i> Link del botón
                            </button>
                        </div>
                        <div style="display:flex;align-items:center;gap:8px;margin-top:6px;">
                            <span style="font-size:.75rem;color:#64748b;white-space:nowrap;flex-shrink:0;"><i class="bi bi-arrows-expand"></i> Tamaño logo:</span>
                            <input type="range" id="logoAlturaSlider" min="40" max="220" step="5" value="100" style="flex:1;accent-color:#0d7377;cursor:pointer;">
                            <span id="logoAlturaVal" style="font-size:.75rem;font-weight:700;color:#0d7377;min-width:44px;text-align:right;">100px</span>
                        </div>
                        <div class="logo-hint" id="logoHintEditor">El logo y el link se guardan por plantilla y se restauran al volver a abrir el editor.</div>
                    </div>
                </div>

                <div class="fb-card">
                    <div class="fb-card-title"><i class="bi bi-download"></i> Exportar</div>
                    <button id="btnDescargar" class="btn-tp teal">
                        <i class="bi bi-file-earmark-image"></i> Descargar PNG
                    </button>

                    @* [2026-08-05] Nombre editable del flyer (tab Editor) — mismo control que
                       en el tab Modelo. El auto-name se refresca usando el nombre del primer
                       grupo/destino del editor si el usuario no ha editado el input. *@
                    <div style="margin-top:10px;">
                        <label for="nombreArchivoInputEditor" style="display:block;font-size:.75rem;font-weight:700;color:#334155;letter-spacing:.4px;text-transform:uppercase;margin-bottom:4px;">
                            <i class="bi bi-file-earmark-image"></i> Nombre del flyer
                        </label>
                        <input id="nombreArchivoInputEditor" type="text"
                               style="width:100%;padding:8px 10px;border:1.5px solid #cbd5e1;border-radius:8px;font-size:.82rem;font-family:'SF Mono',Consolas,monospace;color:#0f172a;background:#f8fafc;"
                               placeholder="cliente_DESTINO_p1_YYYYMMDD.png"
                               autocomplete="off" />
                        <div id="nombreArchivoHintEditor" style="margin-top:4px;font-size:.72rem;color:#64748b;line-height:1.35;">
                            Debe contener un destino de configuración.
                        </div>
                    </div>

                    <button id="btnGuardarEditor" class="btn-tp green" style="margin-top:8px;">
                        <i class="bi bi-cloud-upload"></i> Guardar PNG
                    </button>
                    <a href="/Flyer/Editar" class="btn-tp dark" style="margin-top:8px;background:linear-gradient(135deg,#0d7377,#065f46);">
                        <i class="bi bi-whatsapp"></i> Ir a envío WhatsApp
