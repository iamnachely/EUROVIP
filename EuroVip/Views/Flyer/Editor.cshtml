    };

    // ── Mini palette for extended color modal ─────────────────────────────────
    var MINI_PAL = [
        '#f59e0b','#f5a623','#fbbf24','#d97706','#ef4444',
        '#f97316','#e76f51','#dc2626','#ec4899','#d946ef',
        '#a855f7','#8b5cf6','#0ea5e9','#3b82f6','#06b6d4',
        '#0d7377','#10b981','#22c55e','#003d52','#6ec6f5',
        '#e07b39','#cbd5e1','#94a3b8','#0f172a','#ffffff'
    ];

    function buildMiniPal(cid, getC, setC, dotId, pvId) {
        var con = document.getElementById(cid);
        if (!con) return;
        con.innerHTML = '';
        MINI_PAL.forEach(function (col) {
            var sw = document.createElement('div');
            sw.className = 'c-mini-sw' + (col.toLowerCase() === getC().toLowerCase() ? ' sel' : '');
            sw.style.background = col;
            if (col === '#ffffff') sw.style.border = '2px solid #e2e8f0';
            sw.addEventListener('mouseover', function () { document.getElementById(pvId).style.background = col; });
            sw.addEventListener('mouseout',  function () { document.getElementById(pvId).style.background = getC(); });
            sw.addEventListener('click', function () {
                setC(col);
                document.getElementById(dotId).style.background = col;
                document.getElementById(pvId).style.background = col;
                con.querySelectorAll('.c-mini-sw').forEach(function (s) { s.classList.remove('sel'); });
                sw.classList.add('sel');
            });
            con.appendChild(sw);
        });
    }

