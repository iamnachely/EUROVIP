        buildMiniPal('mpPos1',    function(){return colorPos1;},    function(c){colorPos1=c; aplicarColoresPosicion();}, 'dotPos1','pvPos1');
        buildMiniPal('mpPos2',    function(){return colorPos2;},    function(c){colorPos2=c; aplicarColoresPosicion();}, 'dotPos2','pvPos2');
        buildMiniPal('mpPos3',    function(){return colorPos3;},    function(c){colorPos3=c; aplicarColoresPosicion();}, 'dotPos3','pvPos3');
        buildMiniPal('mpPos45',   function(){return colorPos45;},   function(c){colorPos45=c; aplicarColoresPosicion();}, 'dotPos45','pvPos45');
