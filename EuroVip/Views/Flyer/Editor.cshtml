@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"
        integrity="sha512-BNaRQnYJYiPSqHHDb58B0yaPfCu+Wgds8Gp/gU33kqBtgNS4tSPHuGibyoeqMV/TJlSKda6FXzoEyYGjTe+vXA=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<link rel="stylesheet" href="~/css/eurovip-flyer-disenos.css" asp-append-version="true" />
<script src="~/js/eurovip-flyer-disenos.js" asp-append-version="true"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
(function () {
    // ── Diseños del flyer: la Clásica (la de siempre), 4 pieles (Postal, Elegante, Minimal, Vibrante) y 6 modernos con colores
    //    a elegir (EVDisenos, eurovip-flyer-disenos.js). Se aplican a #flyerTemplate y #flyerTemplateEditor; el HTML no cambia. ──
    (function () {
        var DIS = [['clasica', 'Clásica', 'linear-gradient(180deg,#003d52 0 45%,#fff 45%)'], ['postal', 'Postal', 'linear-gradient(180deg,#5b8fa8 0 55%,#F6F8FA 55%)'],
                   ['elegante', 'Elegante', 'linear-gradient(180deg,#0A1A30,#13365a)'], ['minimal', 'Minimal', 'linear-gradient(180deg,#fff 0 60%,#E2E8F0 60%)'],
                   ['vibrante', 'Vibrante', 'linear-gradient(170deg,#FF8A3D,#E0306B)']]
            .concat(window.EVDisenos ? EVDisenos.LISTA.map(function (d) { return [d.id, d.nombre, d.mini, true]; }) : []);
        var actual = 'clasica';
        try { actual = localStorage.getItem('fe-diseno') || 'clasica'; } catch (e) { }
        if (!DIS.some(function (d) { return d[0] === actual; })) actual = 'clasica';
        var flyers = function () { return ['flyerTemplate', 'flyerTemplateEditor'].map(function (id) { return document.getElementById(id); }).filter(Boolean); };
        function aplicar() {
            flyers().forEach(function (f) {
                DIS.forEach(function (d) { f.classList.remove('sk-' + d[0]); });
                if (window.EVDisenos) EVDisenos.aplicar(f, actual);   // los modernos (o los quita)
                if (actual !== 'clasica' && !(window.EVDisenos && EVDisenos.es(actual))) f.classList.add('sk-' + actual);
            });
            var caja = document.getElementById('stDisenos');
            if (caja) caja.querySelectorAll('button[data-dis]').forEach(function (b) { b.classList.toggle('on', b.dataset.dis === actual); });
            if (window.EVDisenos) EVDisenos.panelColores(document.getElementById('stColores'), actual, aplicar);
        }
        // símbolo de la moneda en su sitio y 🏆 en el precio más bajo (se repite al pintar, ocultar o editar hoteles)
        function moneda() { if (window.EVDisenos) flyers().forEach(function (f) { EVDisenos.aplicarMoneda(f); EVDisenos.marcarMasBarato(f); }); }
        document.addEventListener('DOMContentLoaded', function () {
            var caja = document.getElementById('stDisenos'); if (!caja) return;
            DIS.forEach(function (d) {
                var b = document.createElement('button'); b.type = 'button'; b.dataset.dis = d[0];
                b.innerHTML = '<i style="background:' + d[2] + '"></i>' + d[1] + (d[3] ? ' <small style="color:#FF8A3D;font-weight:900">✦</small>' : '');
                b.title = d[3] ? 'Diseño profesional: puedes cambiarle los colores' : 'Diseño ' + d[1];
                b.addEventListener('click', function () { actual = d[0]; try { localStorage.setItem('fe-diseno', actual); } catch (e) { } aplicar(); });
                caja.appendChild(b);
            });
            aplicar();
            if (window.EVDisenos) EVDisenos.panelMoneda(document.getElementById('stMoneda'), moneda);
            moneda();
            // los hoteles se vuelven a pintar al cambiar de destino o de plantilla: el símbolo se coloca de nuevo
            var obs = new MutationObserver(function () { obs.disconnect(); moneda(); observar(); });
            function observar() { ['flyerHoteles', 'flyerHotelesEditor'].forEach(function (id) { var c = document.getElementById(id); if (c) obs.observe(c, { childList: true, subtree: true }); }); }
            observar();
            // al escribir un precio a mano
            flyers().forEach(function (f) { f.addEventListener('input', function (e) { if (e.target.closest && e.target.closest('.precio-val')) { obs.disconnect(); EVDisenos.marcarMasBarato(f); observar(); } }); });
        });
    })();


    // Eurovip valida el token antiforgery en todos los POST: se agrega solo a los fetch de esta pantalla
    var _tokenEv = (document.querySelector('input[name="__RequestVerificationToken"]') || {}).value || '';
    var _fetchEv = window.fetch.bind(window);
    window.fetch = function (url, opts) {
        opts = opts || {};
        if (opts.method && opts.method.toUpperCase() !== 'GET' && typeof url === 'string' && url.charAt(0) === '/') {
            var h = new Headers(opts.headers || {}); h.set('RequestVerificationToken', _tokenEv); opts.headers = h;
        }
        return _fetchEv(url, opts);
    };

    var todosDestinos     = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Destinos));
    var allConfigs        = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Configs));
    var fondosPorDestino  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(fondosDict));

    // ── Toast ──────────────────────────────────────────────────────────────────
    var toast = document.getElementById('flyerToast');
    function showToast(msg, type) {
        toast.textContent = msg;
        toast.className = 'flyer-toast show ' + type;
        setTimeout(function () { toast.className = 'flyer-toast ' + type; }, 3500);
    }

    // ── Shared state ───────────────────────────────────────────────────────────
    var colorRank1  = '#f59e0b';
    var colorOtros  = '#003d52';
    var colorRegimen= '#e07b39';
    var colorPos1   = '#f5a623';
    var colorPos2   = '#6ec6f5';
    var colorPos3   = '#e07b39';
    var colorPos45  = '#cbd5e1';
    var tamTitulo   = 6.5;
    var tamSubtitulo= 1.1;
    var tamNombre   = 2.1;
    var tamPrecio   = 2.75;
    var tamRegimen  = 1.85;
    var tamFooter   = 1.0;
    var tabActivo   = 'modelo';
    var fondosGaleria = []; // {url, nombre}
    var modeloSortTimer = null;
    var editorSortTimer = null;
    var hotelesOcultosModeloList = [];
    var editorOcultosList = [];

    // ── Prevent Enter key in all flyer contenteditable elements ───────────────
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && e.target.getAttribute('contenteditable') === 'true') {
            if (e.target.closest('.flyer')) {
                e.preventDefault();
            }
        }
    });

    // ── Tamaños via CSS custom properties ─────────────────────────────────────
    function aplicarTamanos() {
        var r = document.documentElement.style;
        r.setProperty('--tam-titulo',    tamTitulo    + 'rem');
        r.setProperty('--tam-subtitulo', tamSubtitulo + 'rem');
        r.setProperty('--tam-nombre',    tamNombre    + 'rem');
        r.setProperty('--tam-precio',    tamPrecio    + 'rem');
        r.setProperty('--tam-regimen',   tamRegimen   + 'rem');
        r.setProperty('--tam-footer',    tamFooter    + 'rem');
    }

    // ── Colores ────────────────────────────────────────────────────────────────
    function getColorForPos(num) {
        if (num === 1) return colorPos1;
        if (num === 2) return colorPos2;
        if (num === 3) return colorPos3;
        return colorPos45;
    }

    function aplicarColores() {
        document.querySelectorAll('#flyerHoteles .fh-price.rank1, #flyerHotelesEditor .fh-price.rank1').forEach(function (el) {
            el.style.color = colorRank1;
        });
        document.querySelectorAll('#flyerHoteles .fh-price:not(.rank1), #flyerHotelesEditor .fh-price:not(.rank1)').forEach(function (el) {
            el.style.color = colorOtros;
        });
        document.querySelectorAll('#flyerHoteles .fh-meta, #flyerHotelesEditor .fh-meta').forEach(function (el) {
            el.style.color = colorRegimen;
        });
    }

    function aplicarColoresPosicion() {
        [document.getElementById('flyerHoteles'), document.getElementById('flyerHotelesEditor')].forEach(function (c) {
            if (!c) return;
            c.querySelectorAll('.fh-row').forEach(function (row, i) {
                var p = row.querySelector('.fh-pos');
                if (p) p.style.color = getColorForPos(i + 1);
            });
        });
    }

    // ── Tab switching ──────────────────────────────────────────────────────────
    window.switchTab = function (tab, btn) {
        tabActivo = tab;
        document.querySelectorAll('.tab-btn').forEach(function (b) { b.classList.remove('active'); });
        document.querySelectorAll('.tab-pane').forEach(function (p) { p.classList.remove('active'); });
        if (btn) btn.classList.add('active');
        document.getElementById('tab-' + tab).classList.add('active');
        if (tab === 'modelo') setTimeout(scaleFlyer, 50);
        if (tab === 'editor') setTimeout(scaleFlyerEditor, 50);
    };

    // ── Logo toggle ────────────────────────────────────────────────────────────
    var logoVisible = true;
    document.getElementById('btnToggleLogo').addEventListener('click', function () {
        logoVisible = !logoVisible;
        document.getElementById('logoWrapModelo').style.display = logoVisible ? '' : 'none';
        document.getElementById('logoWrapEditor').style.display = logoVisible ? '' : 'none';
        this.innerHTML = logoVisible
            ? '<i class="bi bi-image"></i> Logo'
            : '<i class="bi bi-image-fill"></i> Logo <small style="color:#64748b">(oculto)</small>';
        this.classList.toggle('active', !logoVisible);
        scheduleSaveEditorState();
    });

    // ══════════════════════════════════════════════════════════════════════════
    // COLOR MODAL
    // ══════════════════════════════════════════════════════════════════════════
    var PALETA = [
        '#f59e0b','#fbbf24','#fcd34d','#f5a623','#d97706','#b45309',
        '#ef4444','#f97316','#e76f51','#dc2626','#c2410c','#ea580c',
        '#ec4899','#d946ef','#a855f7','#8b5cf6','#db2777','#7c3aed',
        '#0ea5e9','#3b82f6','#06b6d4','#0d7377','#0369a1','#1d4ed8',
        '#10b981','#22c55e','#003d52','#0f172a','#334155','#ffffff'
    ];

    function buildPalette(containerId, target) {
        var container = document.getElementById(containerId);
        var previewId = target === 'rank1' ? 'previewPriceRank1' : 'previewPriceOtros';
        var dotId     = target === 'rank1' ? 'dotRank1' : 'dotOtros';
        var btnDotId  = target === 'rank1' ? 'dotBtnRank1' : 'dotBtnOtros';
        var current   = target === 'rank1' ? colorRank1 : colorOtros;

        container.innerHTML = '';
        PALETA.forEach(function (color) {
            var sw = document.createElement('div');
            sw.className = 'c-swatch' + (color.toLowerCase() === current.toLowerCase() ? ' sel' : '');
            sw.dataset.color = color;
            sw.style.background = color;
            if (color === '#ffffff') sw.style.border = '2.5px solid #e2e8f0';

            sw.addEventListener('mouseover', function () {
                document.getElementById(previewId).style.color = color;
            });
            sw.addEventListener('mouseout', function () {
                var c = target === 'rank1' ? colorRank1 : colorOtros;
                document.getElementById(previewId).style.color = c;
            });
            sw.addEventListener('click', function () {
                if (target === 'rank1') colorRank1 = color;
                else colorOtros = color;

                document.getElementById(previewId).style.color = color;
                document.getElementById(dotId).style.background = color;
                document.getElementById(btnDotId).style.background = color;
                container.querySelectorAll('.c-swatch').forEach(function (s) { s.classList.remove('sel'); });
                sw.classList.add('sel');
                aplicarColores();
            });
            container.appendChild(sw);
        });
    }

    window.aplicarColorPersonalizado = function (target) {
        var color = document.getElementById('customColorPicker').value;
        if (target === 'rank1') colorRank1 = color;
        else colorOtros = color;
        document.getElementById(target === 'rank1' ? 'previewPriceRank1' : 'previewPriceOtros').style.color = color;
        document.getElementById(target === 'rank1' ? 'dotRank1' : 'dotOtros').style.background = color;
        document.getElementById(target === 'rank1' ? 'dotBtnRank1' : 'dotBtnOtros').style.background = color;
        // remove sel from all, mark closest swatch if exists
        ['paletteRank1','paletteOtros'].forEach(function (pid) {
            document.getElementById(pid).querySelectorAll('.c-swatch').forEach(function (s) {
                if (target === 'rank1' ? pid === 'paletteRank1' : pid === 'paletteOtros') s.classList.remove('sel');
            });
        });
