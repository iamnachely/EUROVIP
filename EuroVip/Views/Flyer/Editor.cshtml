        });
        if (destinoSelect.value) renderDestino(destinoSelect.value);
    }

    // ═════════════════════════════════════════════════════════════════
    // [2026-08-05] Nombre editable del flyer + validación de destino
    // - El input siempre está visible y muestra el nombre con que se
    //   guardará el archivo del destino actualmente seleccionado.
    // - Si el usuario edita, la bandera nombreArchivoEditado se activa
    //   y el input deja de auto-refrescarse al cambiar destino.
    // - Validación en vivo: el valor debe contener el nombre de un
    //   destino de configuración (allConfigs). Si no, borde rojo y
    //   se deshabilita el botón "Guardar flyer".
    // - Al guardar (loop existente), la CURRENT destino usa el nombre
    //   custom si el usuario lo editó y es válido; los OTROS destinos
    //   del loop mantienen su nombre automático (comportamiento previo).
    // ═════════════════════════════════════════════════════════════════
    var nombreArchivoInput = document.getElementById('nombreArchivoInput');
    var nombreArchivoHint  = document.getElementById('nombreArchivoHint');
    var nombreArchivoEditado = false;

    // [2026-08-05] Contraparte del tab Editor — mismo control, misma validación,
    // botón Guardar (btnGuardarEditor) se habilita/deshabilita según validación.
    var nombreArchivoInputEditor = document.getElementById('nombreArchivoInputEditor');
    var nombreArchivoHintEditor  = document.getElementById('nombreArchivoHintEditor');
    var nombreArchivoEditadoEditor = false;

    function normalizarNombreFilename(s) {
        return (s || '')
            .toString()
            .toLowerCase()
            .normalize('NFD')
            .replace(/[̀-ͯ]/g, '')
            .replace(/[^a-z0-9]+/g, '');
    }
    function sanearParaFilename(s) {
        return (s || '')
            .toString()
            .normalize('NFD')
            .replace(/[̀-ͯ]/g, '')
            .replace(/[^A-Za-z0-9]+/g, '_')
            .replace(/^_+|_+$/g, '');
    }
    function nombresDestinosConfig() {
        return (allConfigs || [])
            .map(function (c) { return c.Nombre_Destino || c.nombre_Destino || c.Id_Destino || c.id_Destino || ''; })
            .filter(function (n) { return !!n; });
    }
    function timestampNombre() {
        var d = new Date();
        var pad = function (n) { return (n < 10 ? '0' + n : '' + n); };
        return d.getFullYear() + pad(d.getMonth() + 1) + pad(d.getDate())
             + '_' + pad(d.getHours()) + pad(d.getMinutes()) + pad(d.getSeconds());
    }
    function nombreAutoParaDestino(nombreDestino) {
        var safe = sanearParaFilename(nombreDestino || 'destino');
        return 'cliente_' + safe + '_p1_' + timestampNombre() + '.png';
    }
    window.nombreAutoParaDestino = nombreAutoParaDestino; // usado por guardarImagen

    function validarNombreArchivo(valor) {
        var v = normalizarNombreFilename(valor);
        if (!v) return { ok: false, motivo: 'Escribe un nombre.' };
        var destinos = nombresDestinosConfig().map(normalizarNombreFilename).filter(function (d) { return d.length > 0; });
        if (destinos.length === 0) return { ok: false, motivo: 'No hay destinos configurados.' };
        var match = destinos.some(function (d) { return v.indexOf(d) !== -1; });
        return match
            ? { ok: true, motivo: '' }
            : { ok: false, motivo: 'Debe contener un destino de configuración (' + nombresDestinosConfig().slice(0, 4).join(', ') + (nombresDestinosConfig().length > 4 ? '…' : '') + ').' };
    }
    function aplicarEstadoValidacion() {
        var val = nombreArchivoInput ? nombreArchivoInput.value : '';
        var res = validarNombreArchivo(val);
        var btn = document.getElementById('btnGuardar');
        if (res.ok) {
            if (nombreArchivoInput) nombreArchivoInput.style.borderColor = '#10b981';
            if (nombreArchivoHint) {
                nombreArchivoHint.textContent = '✓ Contiene un destino de configuración.';
                nombreArchivoHint.style.color = '#059669';
            }
            if (btn) { btn.disabled = false; btn.style.opacity = ''; btn.style.cursor = ''; }
        } else {
            if (nombreArchivoInput) nombreArchivoInput.style.borderColor = '#ef4444';
            if (nombreArchivoHint) {
                nombreArchivoHint.textContent = '✗ ' + res.motivo;
                nombreArchivoHint.style.color = '#b91c1c';
            }
            if (btn) { btn.disabled = true; btn.style.opacity = '.55'; btn.style.cursor = 'not-allowed'; }
        }
    }

    // [2026-08-05] Validación equivalente para el input del tab Editor — habilita/deshabilita btnGuardarEditor.
    function aplicarEstadoValidacionEditor() {
        var val = nombreArchivoInputEditor ? nombreArchivoInputEditor.value : '';
        var res = validarNombreArchivo(val);
        var btn = document.getElementById('btnGuardarEditor');
        if (res.ok) {
            if (nombreArchivoInputEditor) nombreArchivoInputEditor.style.borderColor = '#10b981';
            if (nombreArchivoHintEditor) {
                nombreArchivoHintEditor.textContent = '✓ Contiene un destino de configuración.';
                nombreArchivoHintEditor.style.color = '#059669';
            }
            if (btn) { btn.disabled = false; btn.style.opacity = ''; btn.style.cursor = ''; }
        } else {
            if (nombreArchivoInputEditor) nombreArchivoInputEditor.style.borderColor = '#ef4444';
            if (nombreArchivoHintEditor) {
                nombreArchivoHintEditor.textContent = '✗ ' + res.motivo;
                nombreArchivoHintEditor.style.color = '#b91c1c';
            }
            if (btn) { btn.disabled = true; btn.style.opacity = '.55'; btn.style.cursor = 'not-allowed'; }
        }
    }

    // Genera un nombre auto para el editor usando el primer grupo/destino que el usuario haya
    // añadido en el tab Editor (misma fuente que usa btnGuardarEditor para nombreDestino).
    window.refrescarNombreArchivoAutoEditor = function () {
        if (!nombreArchivoInputEditor || nombreArchivoEditadoEditor) { aplicarEstadoValidacionEditor(); return; }
        var nombre = 'editor';
        try {
            var primerGrupo = (typeof groupOrder !== 'undefined' && groupOrder.length > 0 && typeof groups !== 'undefined')
                ? groups[groupOrder[0]] : null;
            if (primerGrupo && primerGrupo.groupNombre && primerGrupo.groupNombre.trim()) {
                nombre = primerGrupo.groupNombre.trim();
            } else if (typeof flyerTitleEditor !== 'undefined' && flyerTitleEditor && flyerTitleEditor.textContent.trim()) {
                nombre = flyerTitleEditor.textContent.trim();
            }
        } catch { /* usa 'editor' */ }
        nombreArchivoInputEditor.value = nombreAutoParaDestino(nombre);
        aplicarEstadoValidacionEditor();
    };
    if (nombreArchivoInputEditor) {
        nombreArchivoInputEditor.addEventListener('input', function () {
            nombreArchivoEditadoEditor = true;
            // [2026-08-05] Persistir en la plantilla activa para que cada plantilla
            // recuerde su propio nombre al cambiar entre pestañas de plantilla.
            if (typeof plantillas !== 'undefined' && plantillas[plantillaActiva]) {
                plantillas[plantillaActiva].nombreArchivo        = this.value;
                plantillas[plantillaActiva].nombreArchivoEditado = true;
            }
            aplicarEstadoValidacionEditor();
            if (typeof scheduleSaveEditorState === 'function') scheduleSaveEditorState();
        });
        // Init: si no hay grupos aún el auto-name usa 'editor' — sin destino → botón deshabilitado
        // hasta que el usuario agregue un grupo o edite el nombre con un destino válido.
        window.refrescarNombreArchivoAutoEditor();
    }
    window.refrescarNombreArchivoAuto = function () {
        if (!nombreArchivoInput || nombreArchivoEditado) { aplicarEstadoValidacion(); return; }
        var sel = destinoSelect;
        var idDest = sel ? sel.value : '';
        var opt = sel && sel.selectedOptions[0];
        var nombre = opt ? (opt.getAttribute('data-nombre') || opt.textContent || idDest) : idDest;
        nombreArchivoInput.value = nombreAutoParaDestino(nombre);
        aplicarEstadoValidacion();
    };
    if (nombreArchivoInput) {
        nombreArchivoInput.addEventListener('input', function () {
            nombreArchivoEditado = true;
            aplicarEstadoValidacion();
        });
        // Init: prellenar con el destino actualmente seleccionado
        window.refrescarNombreArchivoAuto();
    }

    window.actualizarDestino = async function () {
        var id  = destinoSelect ? destinoSelect.value : '';
        var cfg = allConfigs.find(function (c) { return (c.id_Destino || c.Id_Destino) === id; });
        if (!cfg && allConfigs.length > 0) cfg = allConfigs[0];
        if (!cfg) { showToast('No hay configuraciones disponibles.', 'err'); return; }
        var btn = document.getElementById('btnActualizar');
        btn.disabled = true;
        btn.innerHTML = '<span class="spin bi bi-arrow-clockwise"></span> Actualizando…';
        showToast('Actualizando precios…', 'info');
        var res  = await fetch('/Flyer/ActualizarDestino?id=' + (cfg.Id ?? cfg.id) + '&_=' + Date.now(), { method: 'POST' });
        var data = await res.json().catch(function () { return null; });
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-arrow-clockwise"></i> Actualizar precios';
        if (data && data.success) {
            showToast('✓ ' + data.mensaje, 'ok');
            todosDestinos = await fetch('/Flyer/ObtenerDatos').then(function (r) { return r.json(); }).catch(function () { return []; });
            if (destinoSelect && destinoSelect.value) renderDestino(destinoSelect.value);
        } else {
            showToast('✗ ' + (data ? data.mensaje : 'Error'), 'err');
        }
    };

    window.actualizarConfig = async function (cfgId) {
        showToast('Actualizando…', 'info');
        var res  = await fetch('/Flyer/ActualizarDestino?id=' + cfgId, { method: 'POST' });
        var data = await res.json().catch(function () { return null; });
        if (data && data.success) {
            showToast('✓ ' + data.mensaje, 'ok');
            todosDestinos = await fetch('/Flyer/ObtenerDatos').then(function (r) { return r.json(); }).catch(function () { return []; });
            if (destinoSelect && destinoSelect.value) renderDestino(destinoSelect.value);
        } else {
            showToast('✗ ' + (data ? data.mensaje : 'Error'), 'err');
        }
    };

    function hideHideBtns(templateId) {
        return Array.from(document.querySelectorAll('#' + templateId + ' .btn-hide-hotel')).map(function (b) {
            b.style.visibility = 'hidden'; return b;
        });
    }
    function showHideBtns(btns) { btns.forEach(function (b) { b.style.visibility = ''; }); }

    window.guardarImagen = async function () {
        if (!todosDestinos || todosDestinos.length === 0) {
            showToast('No hay destinos con datos. Actualiza primero los precios.', 'err');
            return;
        }
        // [2026-08-05] Bloquear si el nombre editado no es válido (no contiene destino de config).
        if (nombreArchivoInput && nombreArchivoEditado) {
            var vRes = validarNombreArchivo(nombreArchivoInput.value);
            if (!vRes.ok) {
                showToast('Nombre inválido: ' + vRes.motivo, 'err');
                return;
            }
        }
        var btn = document.getElementById('btnGuardar');
        btn.disabled = true;
        var idOriginal = destinoSelect ? destinoSelect.value : '';
        var saved = 0, errors = 0;

        // [2026-08-05] Sólo el destino ACTUALMENTE seleccionado usa el nombre custom
        // (si el usuario lo editó); los demás siguen con el nombre automático de
        // siempre. Así se conserva el comportamiento multi-destino existente.
        var idDestActual = destinoSelect ? destinoSelect.value : '';
        var nombreCustom = (nombreArchivoInput && nombreArchivoEditado) ? nombreArchivoInput.value.trim() : '';

        for (var i = 0; i < todosDestinos.length; i++) {
            var d      = todosDestinos[i];
            var idDest = d.Id_Destino || d.id_Destino || '';
            var nombre = d.Nombre_Destino || d.nombre_Destino || idDest;

            btn.innerHTML = '<span class="spin bi bi-arrow-clockwise"></span> Guardando ' + (i + 1) + '/' + todosDestinos.length + '…';
            showToast('Generando: ' + nombre + '…', 'info');

            renderDestino(idDest);
            await new Promise(function (r) { setTimeout(r, 700); });

            var btns = hideHideBtns('flyerTemplate');
            try {
                var canvas    = await html2canvas(document.getElementById('flyerTemplate'), { scale: 2, useCORS: true });
                var imageData = canvas.toDataURL('image/png');
                var payload = { imageData: imageData, nombreDestino: nombre };
                if (nombreCustom && idDest === idDestActual) payload.nombreArchivo = nombreCustom;
                var res  = await fetch('/Flyer/GuardarImagen', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                var data = await res.json().catch(function () { return null; });
                if (data && data.success) saved++;
                else errors++;
            } catch (e) {
                errors++;
            }
            showHideBtns(btns);
        }

        if (idOriginal && destinoSelect) {
            destinoSelect.value = idOriginal;
            renderDestino(idOriginal);
        }

        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-download"></i> Guardar flyer';

        if (errors === 0) {
            showToast('✓ ' + saved + ' flyer(s) guardados en Galería', 'ok');
        } else {
            showToast('✓ ' + saved + ' guardados, ✗ ' + errors + ' con error', 'err');
        }
        document.getElementById('savedBar').classList.add('show');
    };

    // window.enviarMasivo — movido a /Flyer/Contactos (2026-07-21).

    // ══════════════════════════════════════════════════════════════════════════
    // EDITOR TAB
    // ══════════════════════════════════════════════════════════════════════════
    var DEFAULT_LOGO_SRC = '@Model.Logo';
    var STORE_KEY = 'FlyerClienteEditorState_v1';
    var saveTimer = null;
    var restoreMode = false;
    var savedGruposState = null;

    var groups       = {};
    var groupOrder   = [];
    var tomSelects   = {};
    var groupCounter = 0;
    var slotCounter  = 0;

    var flyerHotelesEditor  = document.getElementById('flyerHotelesEditor');
    var destGroupsContainer = document.getElementById('destGroupsContainer');
    var flyerHeroEditor     = document.getElementById('flyerHeroEditor');
    var flyerTemplateEditor = document.getElementById('flyerTemplateEditor');
    var flyerTitleEditor    = document.getElementById('flyerTitleEditor');
    var flyerLogoEditor     = document.getElementById('flyerLogoEditor');
    var logoPreviewEditor   = document.getElementById('logoPreviewEditor');
    var logoHintEditor      = document.getElementById('logoHintEditor');
    var logoFileInputEditor = document.getElementById('logoFileInputEditor');
    var btnCargarLogoEditor = document.getElementById('btnCargarLogoEditor');
    var btnRestaurarLogoEditor = document.getElementById('btnRestaurarLogoEditor');
    var btnEditarLinkOferta = document.getElementById('btnEditarLinkOferta');
    var emptyHint           = document.getElementById('flyerEmptyHint');
    var tamFooter           = 1.0;

    function scaleFlyerEditor() {
        var stage = document.getElementById('fbStageEditor');
        var wrap  = document.getElementById('flyerScaleWrapEditor');
        var flyer = document.getElementById('flyerTemplateEditor');
        if (!stage) return;
        var avail = stage.clientWidth - 32;
        var scale = Math.min(1, avail / 900);
        wrap.style.transform    = 'scale(' + scale + ')';
        wrap.style.marginBottom = (flyer.offsetHeight * scale - flyer.offsetHeight) + 'px';
    }
    scaleFlyerEditor();

    function normalizarTextoEditor(value) {
        return (value || '')
            .toLowerCase()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .replace(/[^a-z0-9]+/g, ' ')
            .replace(/\s+/g, ' ')
            .trim();
    }

    function getPlantillaActivaEditor() {
        return (plantillas && plantillas[plantillaActiva]) ? plantillas[plantillaActiva] : (plantillas && plantillas[0] ? plantillas[0] : null);
    }

    function getLogoSrcEditor(p) {
        return p && p.logoSrc ? p.logoSrc : DEFAULT_LOGO_SRC;
    }

    function aplicarLogoEditor(p) {
        var src = getLogoSrcEditor(p);
        var h   = (p && p.logoHeight) ? p.logoHeight : 100;
        if (flyerLogoEditor) { flyerLogoEditor.src = src; flyerLogoEditor.style.height = h + 'px'; }
        if (logoPreviewEditor) logoPreviewEditor.src = src;
        var _sl = document.getElementById('logoAlturaSlider');
        var _vl = document.getElementById('logoAlturaVal');
        if (_sl) _sl.value = h;
        if (_vl) _vl.textContent = h + 'px';
    }

    function actualizarLinkHintEditor(p) {
        if (!logoHintEditor) return;
        var link = p && p.linkOferta ? p.linkOferta : '';
        if (link) {
            var display = link.length > 42 ? link.substring(0, 39) + '…' : link;
            logoHintEditor.textContent = display;
            logoHintEditor.title       = link;
            logoHintEditor.style.color = '#15803d';
        } else {
            logoHintEditor.textContent = 'El logo y el link se guardan por plantilla.';
            logoHintEditor.title       = '';
            logoHintEditor.style.color = '';
        }
    }

    function scheduleSaveEditorState() {
        if (restoreMode) return;
        clearTimeout(saveTimer);
        saveTimer = setTimeout(function () {
            saveEditorState();
        }, 250);
    }

    function saveEditorState() {
        if (restoreMode) return;
        try {
            guardarEstadoPlantilla(plantillaActiva);
            var state = {
                version: 1,
                tabActivo: tabActivo,
                tamTitulo: tamTitulo,
                tamSubtitulo: tamSubtitulo,
                tamNombre: tamNombre,
                tamPrecio: tamPrecio,
                tamRegimen: tamRegimen,
                tamFooter: tamFooter,
                colorRank1: colorRank1,
                colorOtros: colorOtros,
                colorRegimen: colorRegimen,
                colorPos1: colorPos1,
                colorPos2: colorPos2,
                colorPos3: colorPos3,
                colorPos45: colorPos45,
                logoVisible: logoVisible,
                plantillaActiva: plantillaActiva,
                plantillas: (plantillas || []).map(function (p) {
                    return {
                        nombre: p.nombre || '',
                        titulo: p.titulo || '',
                        subtitulo: p.subtitulo || '',
                        seccion: p.seccion || '',
                        footerUrl: p.footerUrl || '',
                        footerTag: p.footerTag || '',
                        heroBg: p.heroBg || '',
                        hotelHtml: p.hotelHtml || '',
                        ocultos: (p.ocultos || []).map(function (o) {
                            return { html: o.html || '', nombre: o.nombre || '' };
                        }),
                        logoSrc: p.logoSrc || DEFAULT_LOGO_SRC,
                        linkOferta: p.linkOferta || '',
                        logoHeight: p.logoHeight || 100,
                        // [2026-08-05] Persistir el nombre de archivo por plantilla en localStorage.
                        nombreArchivo:        p.nombreArchivo || '',
                        nombreArchivoEditado: !!p.nombreArchivoEditado
                    };
                }),
                gruposState: buildGruposState()
            };
            localStorage.setItem(STORE_KEY, JSON.stringify(state));
        } catch (e) {}
    }

    if (flyerTemplateEditor) {
        flyerTemplateEditor.addEventListener('input', function (e) {
            if (e.target && e.target.isContentEditable) scheduleSaveEditorState();
        });
        flyerTemplateEditor.addEventListener('blur', function (e) {
            if (e.target && e.target.isContentEditable) scheduleSaveEditorState();
        }, true);
    }

    function updateHeroEditor(nombre) {
        var urlFondoEditor = fondosPorDestino[nombre] || '';
        flyerHeroEditor.style.background =
            'linear-gradient(to bottom, rgba(0,30,42,.15) 0%, rgba(0,30,42,.72) 100%), ' +
            "url('" + urlFondoEditor + "') center/cover no-repeat";
        flyerTitleEditor.textContent = nombre;
        scheduleSaveEditorState();
        setTimeout(scaleFlyerEditor, 50);
    }

    function getSugerenciaLinkOfertaEditor(titulo) {
        var t = normalizarTextoEditor(titulo || '');
        if (t.indexOf('super oferta de verano') !== -1 || t.indexOf('oferta de verano') !== -1 || t.indexOf('super oferta') !== -1) {
            return '@(Model.Web)/';
        }
        return '';
    }

    async function editarLinkOfertaEditor() {
        var p = getPlantillaActivaEditor();
        if (!p) return;
        var titulo = p.titulo || (flyerTitleEditor ? flyerTitleEditor.textContent : '');
        var sugerido = p.linkOferta || getSugerenciaLinkOfertaEditor(titulo) || '@(Model.Web)/';
        var r = await Swal.fire({
            title: 'Link del botón',
            input: 'text',
            inputValue: sugerido,
            inputPlaceholder: '@(Model.Web)/',
            showCancelButton: true,
            confirmButtonText: 'Guardar',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#0d7377'
        });
        if (!r.isConfirmed) return;
        p.linkOferta = (r.value || '').trim();
        actualizarLinkHintEditor(p);
        scheduleSaveEditorState();
    }

    function restaurarLogoDefaultEditor() {
        var p = getPlantillaActivaEditor();
        if (!p) return;
        p.logoSrc    = DEFAULT_LOGO_SRC;
        p.logoHeight = 100;
        aplicarLogoEditor(p);
        scheduleSaveEditorState();
    }

    if (btnCargarLogoEditor && logoFileInputEditor) {
        btnCargarLogoEditor.addEventListener('click', function () {
            logoFileInputEditor.click();
        });
        logoFileInputEditor.addEventListener('change', function () {
            var file = this.files && this.files[0];
            if (!file) return;
            if (file.type !== 'image/png') {
                showToast('âœ— Solo se aceptan imÃ¡genes PNG', 'err');
                this.value = '';
                return;
            }
            var reader = new FileReader();
            reader.onload = function () {
                var p = getPlantillaActivaEditor();
                if (!p) return;
                p.logoSrc = reader.result;
                aplicarLogoEditor(p);
                scheduleSaveEditorState();
            };
            reader.readAsDataURL(file);
            this.value = '';
        });
    }
    if (btnRestaurarLogoEditor) {
        btnRestaurarLogoEditor.addEventListener('click', restaurarLogoDefaultEditor);
    }
    (function () {
        var sl = document.getElementById('logoAlturaSlider');
        var vl = document.getElementById('logoAlturaVal');
        if (!sl) return;
        sl.addEventListener('input', function () {
            var h = parseInt(this.value) || 100;
            var p = getPlantillaActivaEditor();
            if (p) p.logoHeight = h;
            if (flyerLogoEditor) flyerLogoEditor.style.height = h + 'px';
            if (vl) vl.textContent = h + 'px';
            scheduleSaveEditorState();
        });
    })();
    if (btnEditarLinkOferta) {
        btnEditarLinkOferta.addEventListener('click', editarLinkOfertaEditor);
    }

    function renumerarHotelesEditor() {
        var rows = flyerHotelesEditor.querySelectorAll('.fh-row');
        rows.forEach(function (row, i) {
            var num   = i + 1;
            var posEl = row.querySelector('.fh-pos');
            var tagEl = row.querySelector('.fh-best-tag');
            var precEl= row.querySelector('.fh-price');
            if (posEl) { posEl.textContent = num; posEl.className = 'fh-pos'; posEl.style.color = getColorForPos(num); }
            if (num === 1) {
                row.classList.add('best');
                if (precEl) { precEl.classList.add('rank1'); precEl.style.color = colorRank1; }
                if (tagEl)  tagEl.style.display = '';
            } else {
                row.classList.remove('best');
                if (precEl) { precEl.classList.remove('rank1'); precEl.style.color = colorOtros; }
                if (tagEl)  tagEl.style.display = 'none';
            }
        });
        if (emptyHint) emptyHint.style.display = rows.length ? 'none' : '';
    }

    function ordenarHotelesEditor() {
        var rows = Array.from(flyerHotelesEditor.querySelectorAll('.fh-row'));
        rows.sort(function (a, b) {
            var pa = parseFloat((a.querySelector('.precio-val') || {}).textContent) || 0;
            var pb = parseFloat((b.querySelector('.precio-val') || {}).textContent) || 0;
            return pa - pb;
        });
        rows.forEach(function (r) { flyerHotelesEditor.appendChild(r); });
        renumerarHotelesEditor();
        scheduleSaveEditorState();
        setTimeout(scaleFlyerEditor, 50);
    }

    function ocultarHotelEditor(row) {
        var nombre = (row.querySelector('.fh-name') || {}).textContent || 'Hotel';
        editorOcultosList.push({ html: row.outerHTML, nombre: nombre });
        row.remove();
        renumerarHotelesEditor();
        actualizarPanelOcultosEditor();
        scheduleSaveEditorState();
        setTimeout(scaleFlyerEditor, 50);
    }
    window.restaurarHotelEditor = function (idx) {
        var item = editorOcultosList[idx];
        if (!item) return;
        editorOcultosList.splice(idx, 1);
        var temp = document.createElement('div');
        temp.innerHTML = item.html;
        flyerHotelesEditor.appendChild(temp.firstElementChild);
        ordenarHotelesEditor();
        actualizarPanelOcultosEditor();
        scheduleSaveEditorState();
        setTimeout(scaleFlyerEditor, 50);
    };
    function actualizarPanelOcultosEditor() {
        var panel = document.getElementById('ocultosPanelEditor');
        if (!panel) return;
        if (!editorOcultosList.length) { panel.style.display = 'none'; return; }
        panel.style.display = '';
        panel.innerHTML = '<div class="ocultos-title"><i class="bi bi-eye-slash-fill me-1"></i>Hoteles ocultos</div>' +
            editorOcultosList.map(function (item, i) {
                return '<div class="oculto-item"><span>' + item.nombre + '</span>' +
                    '<button class="btn-restaurar" onclick="restaurarHotelEditor(' + i + ')"><i class="bi bi-eye-fill me-1"></i>Mostrar</button></div>';
            }).join('');
    }

    flyerHotelesEditor.addEventListener('click', function (e) {
        var btn = e.target.closest('.btn-hide-hotel');
        if (btn) { var row = btn.closest('.fh-row'); if (row) ocultarHotelEditor(row); }
    });
    flyerHotelesEditor.addEventListener('keydown', function (e) {
        if (!e.target.classList.contains('precio-val')) return;
        if (e.key === 'Enter') {
            e.preventDefault();
            e.stopPropagation();
            e.target.blur();
            ordenarHotelesEditor();
            scheduleSaveEditorState();
        }
    });
    flyerHotelesEditor.addEventListener('input', function (e) {
        if (e.target.classList.contains('precio-val')) {
            scheduleSaveEditorState();
        }
    });

    function agregarHotelAlFlyer(gid, slotId, hotelNombre, regimen, precio) {
        var existing = flyerHotelesEditor.querySelector('.fh-row[data-slot="' + slotId + '"]');
        if (existing) existing.remove();
        var fila = document.createElement('div');
        fila.className    = 'fh-row';
        fila.dataset.slot = slotId;
        fila.dataset.gid  = gid;
        fila.innerHTML =
            '<div class="fh-pos"></div>' +
            '<div class="fh-sep"></div>' +
            '<div class="fh-info">' +
                '<div class="fh-name" contenteditable="true" spellcheck="false">' + hotelNombre + '</div>' +
                '<div class="fh-meta" contenteditable="true" spellcheck="false">' + regimen + '</div>' +
                '<div class="fh-best-tag" style="display:none;"><i class="bi bi-star-fill" style="font-size:.85rem;"></i> Mejor precio</div>' +
            '</div>' +
            '<div class="fh-price">' +
                '<span class="precio-sym">RD$&nbsp;</span>' +
                '<span class="precio-val" contenteditable="true" spellcheck="false">' + precio + '</span>' +
            '</div>' +
            '<button class="btn-hide-hotel" title="Ocultar hotel" type="button"><i class="bi bi-eye-slash"></i></button>';
        flyerHotelesEditor.appendChild(fila);
        ordenarHotelesEditor();
    }

    function crearGrupo() {
        var gid = 'g' + (++groupCounter);
        groups[gid] = { groupDestinoId: null, groupNombre: '', slots: {} };
        groupOrder.push(gid);

        var groupEl = document.createElement('div');
        groupEl.className   = 'dest-group';
        groupEl.dataset.gid = gid;

        var hdr = document.createElement('div');
        hdr.className = 'dest-group-hdr';

        var destSel = document.createElement('select');
        destSel.id        = 'dest_' + gid;
        destSel.className = 'form-control form-control-sm';

        var delBtn = document.createElement('button');
        delBtn.type      = 'button';
        delBtn.className = 'dest-group-del';
        delBtn.innerHTML = '<i class="bi bi-x-lg"></i>';
        delBtn.onclick   = function () { eliminarGrupo(gid, groupEl); };

        hdr.appendChild(destSel);
        hdr.appendChild(delBtn);
        groupEl.appendChild(hdr);

        var slotsContainer = document.createElement('div');
        slotsContainer.id = 'slots_' + gid;
        groupEl.appendChild(slotsContainer);

        var addBtn = document.createElement('button');
        addBtn.type      = 'button';
        addBtn.className = 'btn-add-hotel-sm';
        addBtn.innerHTML = '<i class="bi bi-plus-circle"></i> Agregar hotel';
        addBtn.onclick   = function () { crearSlot(gid, slotsContainer); };
        groupEl.appendChild(addBtn);

        destGroupsContainer.appendChild(groupEl);

        var ts = new TomSelect(destSel, {
            valueField: 'value', labelField: 'text', searchField: 'text',
            placeholder: 'Buscar destino…',
            load: function (query, callback) {
                if (!query.length) return callback();
                fetch('/Flyer/BuscarDestinos?term=' + encodeURIComponent(query))
                    .then(function (r) { return r.json(); }).then(callback).catch(function () { callback(); });
            },
            onChange: function (val) {
                var opt = ts.options[val];
                if (opt) {
                    var destinoAnterior = groups[gid].groupDestinoId || '';
                    groups[gid].groupDestinoId      = val;
                    groups[gid].groupNombre         = opt.text;
                    groups[gid].groupPaisDestinoId  = opt.id_pais || '';
                    if (!restoreMode && groupOrder[0] === gid) {
                        updateHeroEditor(opt.text);
                        // [2026-08-05] Refrescar el nombre auto del archivo (tab Editor)
                        // cuando cambia el destino del primer grupo (que es el que se usa
                        // como nombreDestino al guardar).
                        if (typeof window.refrescarNombreArchivoAutoEditor === 'function')
                            window.refrescarNombreArchivoAutoEditor();
                    }

                    // Si el destino realmente cambió, limpiar las opciones cacheadas del TomSelect
                    // de cada slot de hotel del grupo. La próxima vez que el usuario abra el dropdown,
                    // se re-cargará la lista correcta del nuevo destino. La selección actual se mantiene
                    // (no se borra el hotel ya elegido) para no sorprender al usuario.
                    if (!restoreMode && destinoAnterior && destinoAnterior !== val) {
                        Object.keys(groups[gid].slots).forEach(function (slotId) {
                            var tsH = tomSelects['hotel_' + slotId];
                            if (tsH) {
                                var currentVal = tsH.getValue();
                                var currentOpt = currentVal ? tsH.options[currentVal] : null;
                                tsH.clearOptions();
                                // re-añadir la option actual para que se siga viendo el hotel seleccionado
                                if (currentOpt) { tsH.addOption(currentOpt); tsH.refreshOptions(false); }
                            }
                        });
                    }
                }
            }
        });
        tomSelects['dest_' + gid] = ts;
        crearSlot(gid, slotsContainer);
    }

    function crearSlot(gid, container) {
        var slotId = 'slot_' + (++slotCounter);
        groups[gid].slots[slotId] = true;

        var row = document.createElement('div');
        row.className    = 'hc-row';
        row.dataset.slot = slotId;
        row.dataset.gid  = gid;

        var numEl = document.createElement('span');
        numEl.className   = 'hc-num';
        numEl.textContent = '•';

        var sel = document.createElement('select');
        sel.id        = 'hotel_' + slotId;
        sel.className = 'form-control form-control-sm';

        var delBtn = document.createElement('button');
        delBtn.type      = 'button';
        delBtn.className = 'hc-del';
        delBtn.innerHTML = '<i class="bi bi-x-lg"></i>';
        delBtn.onclick   = function () { eliminarSlot(gid, slotId, row); };

        row.appendChild(numEl);
        row.appendChild(sel);
        row.appendChild(delBtn);
        container.appendChild(row);

        var ts = new TomSelect(sel, {
            valueField: 'value', labelField: 'text', searchField: 'text',
            placeholder: 'Buscar hotel…', maxOptions: 30,
            load: function (query, callback) {
                var destId  = groups[gid].groupDestinoId || '';
                var paisId  = groups[gid].groupPaisDestinoId || '';
                // Si tenemos destino y país → usamos fnAlojamientoDestino (solo hoteles con precio).
                // Sin término de búsqueda y con destino válido también pedimos la lista (precio_web ASC).
                if (paisId && destId) {
                    fetch('/Flyer/BuscarHoteles?term=' + encodeURIComponent(query || '') +
                          '&idDestino=' + encodeURIComponent(destId) +
                          '&idPaisDestino=' + encodeURIComponent(paisId))
                        .then(function (r) { return r.json(); }).then(callback).catch(function () { callback(); });
                    return;
                }
                if (!query.length) return callback();
                fetch('/Flyer/BuscarHoteles?term=' + encodeURIComponent(query) + '&idDestino=' + encodeURIComponent(destId))
                    .then(function (r) { return r.json(); }).then(callback).catch(function () { callback(); });
            },
            onChange: async function (val) {
                if (!val || restoreMode) return;
                var opt = ts.options[val];
                // Si el option ya trae precio_web (vino de fnAlojamientoDestino), úsalo directo.
                if (opt && opt.precio_web != null) {
                    agregarHotelAlFlyer(gid, slotId, opt.text, opt.regimen || '', opt.precio_web || 0);
                    return;
                }
                // Fallback: comportamiento original (PrecioBarato) si no tenemos precio en el option.
                var r = await fetch('/Flyer/PrecioBarato?idAlojamiento=' + val);
                var d = await r.json().catch(function () { return {}; });
                if (d.error) { showToast(d.error, 'err'); return; }
                agregarHotelAlFlyer(gid, slotId, d.nombre_hotel || opt.text, d.regimen || d.nombre_habitacion || '', d.precio_final || 0);
            }
        });
        tomSelects['hotel_' + slotId] = ts;
    }

    function eliminarGrupo(gid, el) {
        flyerHotelesEditor.querySelectorAll('.fh-row[data-gid="' + gid + '"]').forEach(function (r) { r.remove(); });
        delete groups[gid];
        groupOrder = groupOrder.filter(function (g) { return g !== gid; });
        el.remove();
        renumerarHotelesEditor();
        scheduleSaveEditorState();
        setTimeout(scaleFlyerEditor, 50);
    }

    function eliminarSlot(gid, slotId, row) {
        delete groups[gid].slots[slotId];
        var fila = flyerHotelesEditor.querySelector('.fh-row[data-slot="' + slotId + '"]');
        if (fila) fila.remove();
        row.remove();
        renumerarHotelesEditor();
        scheduleSaveEditorState();
        setTimeout(scaleFlyerEditor, 50);
    }

    function buildGruposState() {
        return groupOrder.map(function (gid) {
            var g = groups[gid];
            return {
                gid: gid,
                destinoId: g.groupDestinoId || '',
                destinoNombre: g.groupNombre || '',
                paisDestinoId: g.groupPaisDestinoId || '',
                slots: Object.keys(g.slots).map(function (slotId) {
                    var ts  = tomSelects['hotel_' + slotId];
                    var val = ts ? ts.getValue() : '';
                    var opt = (ts && val) ? ts.options[val] : null;
                    return { slotId: slotId, hotelId: val || '', hotelNombre: opt ? opt.text : '' };
                })
            };
        });
    }

    function restaurarGruposEstado(savedGroups) {
        Array.from(destGroupsContainer.querySelectorAll('.dest-group')).forEach(function (el) { el.remove(); });
        Object.keys(tomSelects).forEach(function (k) { try { tomSelects[k].destroy(); } catch (e) {} });
        groups = {}; groupOrder = []; tomSelects = {}; groupCounter = 0; slotCounter = 0;

        if (!savedGroups || !savedGroups.length) { crearGrupo(); return; }

        restoreMode = true;
        savedGroups.forEach(function (sg) {
            crearGrupo();
            var gid      = groupOrder[groupOrder.length - 1];
            var tsDest   = tomSelects['dest_' + gid];
            if (tsDest && sg.destinoId && sg.destinoNombre) {
                tsDest.addOption({ value: sg.destinoId, text: sg.destinoNombre, id_pais: sg.paisDestinoId || '' });
                tsDest.setValue(sg.destinoId, true);
                groups[gid].groupDestinoId      = sg.destinoId;
                groups[gid].groupPaisDestinoId  = sg.paisDestinoId || '';
                groups[gid].groupNombre    = sg.destinoNombre;
            }
            var slotsContainer  = document.getElementById('slots_' + gid);
            var existingSlotIds = Object.keys(groups[gid].slots);
            (sg.slots || []).forEach(function (slotState, idx) {
                var slotId;
                if (idx === 0 && existingSlotIds.length > 0) {
                    slotId = existingSlotIds[0];
                } else {
                    crearSlot(gid, slotsContainer);
                    slotId = 'slot_' + slotCounter;
                }
                if (slotState.hotelId && slotState.hotelNombre) {
                    var tsH = tomSelects['hotel_' + slotId];
                    if (tsH) {
                        tsH.addOption({ value: slotState.hotelId, text: slotState.hotelNombre });
                        tsH.setValue(slotState.hotelId, true);
                    }
                }
            });
        });
        restoreMode = false;
    }

    document.getElementById('btnAgregarDestino').addEventListener('click', crearGrupo);

    // ── Descargar PNG ──────────────────────────────────────────────────────────
    document.getElementById('btnDescargar').addEventListener('click', async function () {
        var btn = this;
        btn.disabled = true;
        btn.innerHTML = '<span class="spin bi bi-arrow-clockwise"></span> Generando…';
        var btns = hideHideBtns('flyerTemplateEditor');
        try {
            var canvas = await html2canvas(document.getElementById('flyerTemplateEditor'), { scale: 2, useCORS: true });
            var a = document.createElement('a');
            a.href     = canvas.toDataURL('image/png');
            a.download = 'flyer_editor_' + Date.now() + '.png';
            a.click();
        } catch (e) { showToast('✗ ' + e.message, 'err'); }
        finally { btn.disabled = false; btn.innerHTML = '<i class="bi bi-file-earmark-image"></i> Descargar PNG'; showHideBtns(btns); }
    });

    // ── Guardar PNG ────────────────────────────────────────────────────────────
    document.getElementById('btnGuardarEditor').addEventListener('click', async function () {
        var btn = this;
        // [2026-08-05] Bloquear si el nombre editado (o autogenerado) no contiene un destino
        // de configuración. Esta validación es exactamente la misma que en el tab Modelo.
        if (nombreArchivoInputEditor) {
            var vRes = validarNombreArchivo(nombreArchivoInputEditor.value);
            if (!vRes.ok) {
                showToast('Nombre inválido: ' + vRes.motivo, 'err');
                return;
            }
        }
        btn.disabled = true;
        btn.innerHTML = '<span class="spin bi bi-arrow-clockwise"></span> Guardando…';
        showToast('Guardando imagen…', 'info');
        // Usar nombre del primer destino para que el worker identifique el link correcto
        var primerGrupo = groupOrder.length > 0 ? groups[groupOrder[0]] : null;
        var nombre = (primerGrupo && primerGrupo.groupNombre && primerGrupo.groupNombre.trim())
            ? primerGrupo.groupNombre.trim()
            : (flyerTitleEditor ? flyerTitleEditor.textContent.trim() : 'editor');
        var pActiva = getPlantillaActivaEditor();
        guardarEstadoPlantilla(plantillaActiva);
        scheduleSaveEditorState();
        var btns   = hideHideBtns('flyerTemplateEditor');
        // [2026-08-05] Enviar el nombre del input (custom si el usuario lo editó, auto si no).
        // Server-side revalida contra Flyer_Config y rechaza si el filename no tiene destino.
        var nombreArchivoFinal = nombreArchivoInputEditor ? nombreArchivoInputEditor.value.trim() : '';
        try {
            var canvas = await html2canvas(document.getElementById('flyerTemplateEditor'), { scale: 2, useCORS: true });
            var blob   = await new Promise(function (r) { canvas.toBlob(r, 'image/png'); });
            var reader = new FileReader();
            reader.onload = async function () {
                var payload = {
                    imageData: reader.result,
                    nombreDestino: nombre,
                    plantilla: plantillaActiva + 1,
                    linkOferta: pActiva && pActiva.linkOferta ? pActiva.linkOferta : ''
                };
                if (nombreArchivoFinal) payload.nombreArchivo = nombreArchivoFinal;
                var res  = await fetch('/Flyer/GuardarImagen', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                var data = await res.json().catch(function () { return null; });
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-cloud-upload"></i> Guardar PNG';
                showHideBtns(btns);
                if (data && data.success) showToast('✓ Guardado en galería', 'ok');
                else showToast('✗ ' + (data && data.mensaje ? data.mensaje : 'Error al guardar'), 'err');
            };
            reader.readAsDataURL(blob);
        } catch (e) {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-cloud-upload"></i> Guardar PNG';
            showHideBtns(btns);
            showToast('✗ ' + e.message, 'err');
        }
    });

    // ══════════════════════════════════════════════════════════════════════════
    // TIPOGRAFÍA MODAL
    // ══════════════════════════════════════════════════════════════════════════
    function sincSlider(id, valId, key) {
        var sl = document.getElementById(id);
        var vl = document.getElementById(valId);
        if (!sl) return;
        sl.addEventListener('input', function () {
            var v = parseFloat(this.value);
            if (key === 'titulo')    tamTitulo    = v;
            if (key === 'subtitulo') tamSubtitulo = v;
            if (key === 'nombre')    tamNombre    = v;
            if (key === 'precio')    tamPrecio    = v;
            if (key === 'regimen')   tamRegimen   = v;
            if (key === 'footer')    tamFooter    = v;
            vl.textContent = v.toFixed(key === 'titulo' ? 1 : 2) + 'rem';
            aplicarTamanos();
            scheduleSaveEditorState();
        });
    }
    sincSlider('slTitulo',    'vTitulo',    'titulo');
    sincSlider('slSubtitulo', 'vSubtitulo', 'subtitulo');
    sincSlider('slNombre',    'vNombre',    'nombre');
    sincSlider('slPrecio',    'vPrecio',    'precio');
    sincSlider('slRegimen',   'vRegimen',   'regimen');
    sincSlider('slFooter',    'vFooter',    'footer');

    document.getElementById('btnAbrirTipografia').addEventListener('click', function () {
        document.getElementById('slTitulo').value    = tamTitulo;
        document.getElementById('slSubtitulo').value = tamSubtitulo;
        document.getElementById('slNombre').value    = tamNombre;
        document.getElementById('slPrecio').value    = tamPrecio;
        document.getElementById('slRegimen').value   = tamRegimen;
        document.getElementById('slFooter').value    = tamFooter;
        document.getElementById('vTitulo').textContent    = tamTitulo.toFixed(1)    + 'rem';
        document.getElementById('vSubtitulo').textContent = tamSubtitulo.toFixed(2) + 'rem';
        document.getElementById('vNombre').textContent    = tamNombre.toFixed(2)    + 'rem';
        document.getElementById('vPrecio').textContent    = tamPrecio.toFixed(2)    + 'rem';
        document.getElementById('vRegimen').textContent   = tamRegimen.toFixed(2)   + 'rem';
        document.getElementById('vFooter').textContent    = tamFooter.toFixed(2)    + 'rem';
        document.getElementById('tamModal').style.display = 'flex';
    });
    document.getElementById('btnCerrarTamTop').addEventListener('click', function () { document.getElementById('tamModal').style.display = 'none'; });
    document.getElementById('btnCerrarTamBot').addEventListener('click', function () { document.getElementById('tamModal').style.display = 'none'; });
    document.getElementById('tamModal').addEventListener('click', function (e) { if (e.target === this) this.style.display = 'none'; });

    // ══════════════════════════════════════════════════════════════════════════
    // FONDOS MODAL
    // ══════════════════════════════════════════════════════════════════════════
    // Pre-populate from destinos
    todosDestinos.forEach(function (d) {
        var n = d.nombre_Destino || d.Nombre_Destino || '';
        if (!n) return;
        var url = fondosPorDestino[n];
        if (!url) return;   // en Eurovip solo se listan los destinos que tienen fondo subido
        fondosGaleria.push({ url: url, nombre: n });
    });

    function renderFondosGaleria() {
        var grid = document.getElementById('fondoGrid');
        if (!fondosGaleria.length) {
            grid.innerHTML = '<div class="fondo-empty"><i class="bi bi-image" style="font-size:2rem;display:block;margin-bottom:8px;"></i>Sube una imagen PNG para comenzar</div>';
            return;
        }
        grid.innerHTML = fondosGaleria.map(function (f, i) {
            return '<div class="fondo-item" data-idx="' + i + '">' +
                '<img src="' + f.url + '" alt="" onerror="this.style.opacity=\'.3\'">' +
                '<div class="fondo-item-name" contenteditable="true" spellcheck="false" ' +
                    'onclick="event.stopPropagation()" ' +
                    'onblur="fondosGaleria[' + i + '].nombre=this.textContent.trim()">' + f.nombre + '</div>' +
            '</div>';
        }).join('');
        grid.querySelectorAll('.fondo-item').forEach(function (el) {
            el.addEventListener('click', function () {
                var idx = parseInt(this.dataset.idx);
                aplicarFondoGaleria(idx);
                grid.querySelectorAll('.fondo-item').forEach(function (x) { x.classList.remove('sel'); });
                this.classList.add('sel');
            });
        });
    }

    function aplicarFondoGaleria(idx) {
        var f = fondosGaleria[idx];
        if (!f) return;
        var bg = 'linear-gradient(to bottom, rgba(0,30,42,.15) 0%, rgba(0,30,42,.72) 100%), url(' + f.url + ') center/cover no-repeat';
        if (tabActivo === 'modelo') {
            flyerHero.style.background = bg;
            setTimeout(scaleFlyer, 50);
        } else {
            flyerHeroEditor.style.background = bg;
            setTimeout(scaleFlyerEditor, 50);
        }
        showToast('✓ Fondo aplicado', 'ok');
    }

    document.getElementById('btnAbrirFondo').addEventListener('click', function () {
        renderFondosGaleria();
        document.getElementById('fondoModal').style.display = 'flex';
    });
    document.getElementById('btnCerrarFondoTop').addEventListener('click', function () { document.getElementById('fondoModal').style.display = 'none'; });
    document.getElementById('btnCerrarFondoBot').addEventListener('click', function () { document.getElementById('fondoModal').style.display = 'none'; });
    document.getElementById('fondoModal').addEventListener('click', function (e) { if (e.target === this) this.style.display = 'none'; });

    // ── Subir PNG — solo PNG ───────────────────────────────────────────────────
    document.getElementById('fondoFileInput').addEventListener('change', function () {
        var file = this.files[0];
        if (!file) return;
        if (file.type !== 'image/png') {
            showToast('✗ Solo se aceptan imágenes PNG', 'err');
            this.value = '';
            return;
        }
        var url    = URL.createObjectURL(file);
        var nombre = file.name.replace(/\.png$/i, '').replace(/_/g, ' ');
        fondosGaleria.push({ url: url, nombre: nombre });
        renderFondosGaleria();
        aplicarFondoGaleria(fondosGaleria.length - 1);
        var fd = new FormData();
        fd.append('archivo', file);
        fd.append('nombreDestino', nombre);
        fetch('/Flyer/SubirImagenFondo', { method: 'POST', body: fd })
            .then(function (r) { return r.json(); })
            .then(function (d) { if (d && d.success && d.url) fondosGaleria[fondosGaleria.length - 1].url = d.url; })
            .catch(function () {});
        this.value = '';
    });

    // ══════════════════════════════════════════════════════════════════════════
    // PLANTILLAS (Editor tab)
    // ══════════════════════════════════════════════════════════════════════════
    var plantillas = [{
        nombre: 'Plantilla 1', titulo: '', subtitulo: '', seccion: '',
        footerUrl: '', footerTag: '', heroBg: '', hotelHtml: '', ocultos: [],
        logoSrc: DEFAULT_LOGO_SRC, linkOferta: '', logoHeight: 100,
        // [2026-08-05] Cada plantilla lleva su propio nombre de archivo. Se muestra
        // en el input "Nombre del flyer" del tab Editor cuando la plantilla está
        // activa; al cambiar de plantilla el input refleja SU nombre. El flag
        // nombreArchivoEditado se persiste para no perder el estado "el usuario
        // ya editó este nombre" al alternar entre plantillas.
        nombreArchivo: '', nombreArchivoEditado: false
    }];
    var plantillaActiva = 0;
    var tplStripBound = false;

    function guardarEstadoPlantilla(idx) {
        var p = plantillas[idx];
        p.titulo     = flyerTitleEditor    ? flyerTitleEditor.textContent    : '';
        p.subtitulo  = document.getElementById('flyerSubtitleEditor') ? document.getElementById('flyerSubtitleEditor').textContent : '';
        p.seccion    = document.getElementById('flyerSeccionEditor')  ? document.getElementById('flyerSeccionEditor').textContent  : '';
        p.footerUrl  = document.getElementById('footerUrlEditor')     ? document.getElementById('footerUrlEditor').textContent     : '';
        p.footerTag  = document.getElementById('footerTagEditor')     ? document.getElementById('footerTagEditor').textContent     : '';
        p.heroBg     = flyerHeroEditor ? flyerHeroEditor.style.background : '';
        p.hotelHtml  = flyerHotelesEditor ? Array.from(flyerHotelesEditor.querySelectorAll('.fh-row')).map(function(r){return r.outerHTML;}).join('') : '';
        p.ocultos    = editorOcultosList.slice();
        p.logoSrc    = flyerLogoEditor ? flyerLogoEditor.src : getLogoSrcEditor(p);
        p.logoHeight = flyerLogoEditor ? (parseInt(flyerLogoEditor.style.height) || 100) : 100;
        // [2026-08-05] Guardar también el nombre de archivo específico de esta plantilla
        // y si el usuario lo editó — así se conserva al cambiar entre plantillas.
        if (nombreArchivoInputEditor) {
            p.nombreArchivo         = nombreArchivoInputEditor.value;
            p.nombreArchivoEditado  = nombreArchivoEditadoEditor;
        }
    }

    function cargarEstadoPlantilla(idx) {
        var p = plantillas[idx];
        var els = {
            titulo:    document.getElementById('flyerTitleEditor'),
            subtitulo: document.getElementById('flyerSubtitleEditor'),
            seccion:   document.getElementById('flyerSeccionEditor'),
            footerUrl: document.getElementById('footerUrlEditor'),
            footerTag: document.getElementById('footerTagEditor')
        };
        if (els.titulo    && p.titulo)    els.titulo.textContent    = p.titulo;
        if (els.subtitulo && p.subtitulo) els.subtitulo.textContent = p.subtitulo;
        if (els.seccion   && p.seccion)   els.seccion.textContent   = p.seccion;
        if (els.footerUrl && p.footerUrl) els.footerUrl.textContent = p.footerUrl;
        if (els.footerTag && p.footerTag) els.footerTag.textContent = p.footerTag;
        if (flyerHeroEditor && p.heroBg) flyerHeroEditor.style.background = p.heroBg;
        aplicarLogoEditor(p);
        actualizarLinkHintEditor(p);
        if (flyerHotelesEditor) {
            flyerHotelesEditor.innerHTML = p.hotelHtml ||
                '<div class="flyer-empty-hint" id="flyerEmptyHint"><i class="bi bi-geo-alt"></i><p>Selecciona un <strong>destino</strong> y agrega hoteles.</p></div>';
            emptyHint = document.getElementById('flyerEmptyHint');
        }
        editorOcultosList = p.ocultos.slice();
        actualizarPanelOcultosEditor();
        renumerarHotelesEditor();
        aplicarColores();
        aplicarColoresPosicion();
        setTimeout(scaleFlyerEditor, 50);

        // [2026-08-05] Cargar el nombre de archivo específico de esta plantilla en el input
        // del tab Editor. Si nunca se guardó (p.nombreArchivo vacío) y el usuario no lo ha
        // editado, se autogenera con el primer destino disponible.
        if (nombreArchivoInputEditor) {
            nombreArchivoEditadoEditor = !!p.nombreArchivoEditado;
            if (p.nombreArchivo) {
                nombreArchivoInputEditor.value = p.nombreArchivo;
                aplicarEstadoValidacionEditor();
            } else if (typeof window.refrescarNombreArchivoAutoEditor === 'function') {
                window.refrescarNombreArchivoAutoEditor();
            }
        }
    }

    function renderTemplateStrip() {
        var strip = document.getElementById('tplStrip');
        if (!strip) return;
        strip.innerHTML = plantillas.map(function (p, i) {
            return '<div class="tpl-tab' + (i === plantillaActiva ? ' active' : '') + '" data-idx="' + i + '">' +
                '<span class="tpl-name" contenteditable="' + (i === plantillaActiva ? 'true' : 'false') + '" spellcheck="false">' + (p.nombre || 'Plantilla ' + (i+1)) + '</span>' +
                (plantillas.length > 1 ? '<button class="tpl-del" title="Eliminar" onclick="window.eliminarPlantilla(' + i + ');event.stopPropagation();"><i class="bi bi-x"></i></button>' : '') +
            '</div>';
        }).join('') +
        '<button class="btn-nueva-tpl" onclick="window.nuevaPlantilla()"><i class="bi bi-plus"></i> Nueva</button>';

        strip.querySelectorAll('.tpl-name').forEach(function (el) {
            var i = parseInt(el.closest('.tpl-tab').dataset.idx);
            el.addEventListener('blur', function () {
                plantillas[i].nombre = this.textContent.trim() || ('Plantilla ' + (i+1));
                scheduleSaveEditorState();
            });
            el.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); this.blur(); } });
        });

        if (!tplStripBound) {
            strip.addEventListener('mousedown', function (e) {
                var tab = e.target.closest('.tpl-tab');
                if (!tab) return;
                var idx = parseInt(tab.dataset.idx);
                if (idx === plantillaActiva) return;
                if (e.target.closest('.tpl-del')) return;
                e.preventDefault();
                guardarEstadoPlantilla(plantillaActiva);
                plantillaActiva = idx;
                cargarEstadoPlantilla(idx);
                renderTemplateStrip();
                scheduleSaveEditorState();
            }, true);
            tplStripBound = true;
        }
    }

    // Init plantilla 0 from DOM
    (function () {
        var p = plantillas[0];
        p.titulo    = flyerTitleEditor    ? flyerTitleEditor.textContent    : '';
        p.subtitulo = document.getElementById('flyerSubtitleEditor') ? document.getElementById('flyerSubtitleEditor').textContent : '';
        p.seccion   = document.getElementById('flyerSeccionEditor')  ? document.getElementById('flyerSeccionEditor').textContent  : '';
        p.footerUrl = document.getElementById('footerUrlEditor')     ? document.getElementById('footerUrlEditor').textContent     : '';
        p.footerTag = document.getElementById('footerTagEditor')     ? document.getElementById('footerTagEditor').textContent     : '';
        p.heroBg    = flyerHeroEditor ? flyerHeroEditor.style.background : '';
    })();
    renderTemplateStrip();

    // Apply colors + sizes on load
    aplicarColores();
    aplicarColoresPosicion();

    function restoreEditorState() {
        try {
            var raw = localStorage.getItem(STORE_KEY);
            if (!raw) return false;
            var state = JSON.parse(raw);
            if (state && Array.isArray(state.plantillas) && state.plantillas.length) {
                plantillas = state.plantillas.map(function (p, i) {
                    return {
                        nombre: p.nombre || ('Plantilla ' + (i + 1)),
                        titulo: p.titulo || '',
                        subtitulo: p.subtitulo || '',
                        seccion: p.seccion || '',
                        footerUrl: p.footerUrl || '',
                        footerTag: p.footerTag || '',
                        heroBg: p.heroBg || '',
                        hotelHtml: p.hotelHtml || '',
                        ocultos: (p.ocultos || []).map(function (o) {
                            return { html: o.html || '', nombre: o.nombre || '' };
                        }),
                        logoSrc: p.logoSrc || DEFAULT_LOGO_SRC,
                        linkOferta: p.linkOferta || '',
                        logoHeight: p.logoHeight || 100,
                        // [2026-08-05] Restaurar nombre de archivo por plantilla (retro-compatible
                        // con estados anteriores donde no existía este campo).
                        nombreArchivo:        p.nombreArchivo || '',
                        nombreArchivoEditado: !!p.nombreArchivoEditado
                    };
                });
            }
            if (typeof state.plantillaActiva === 'number') {
                plantillaActiva = Math.max(0, Math.min(state.plantillaActiva, plantillas.length - 1));
            }
            if (typeof state.tamTitulo === 'number') tamTitulo = state.tamTitulo;
            if (typeof state.tamSubtitulo === 'number') tamSubtitulo = state.tamSubtitulo;
            if (typeof state.tamNombre === 'number') tamNombre = state.tamNombre;
            if (typeof state.tamPrecio === 'number') tamPrecio = state.tamPrecio;
            if (typeof state.tamRegimen === 'number') tamRegimen = state.tamRegimen;
            if (typeof state.tamFooter === 'number') tamFooter = state.tamFooter;
            if (typeof state.colorRank1 === 'string') colorRank1 = state.colorRank1;
            if (typeof state.colorOtros === 'string') colorOtros = state.colorOtros;
            if (typeof state.colorRegimen === 'string') colorRegimen = state.colorRegimen;
            if (typeof state.colorPos1 === 'string') colorPos1 = state.colorPos1;
            if (typeof state.colorPos2 === 'string') colorPos2 = state.colorPos2;
            if (typeof state.colorPos3 === 'string') colorPos3 = state.colorPos3;
            if (typeof state.colorPos45 === 'string') colorPos45 = state.colorPos45;
            if (typeof state.logoVisible === 'boolean') logoVisible = state.logoVisible;
            if (typeof state.tabActivo === 'string') tabActivo = state.tabActivo;
            if (Array.isArray(state.gruposState)) savedGruposState = state.gruposState;
            return true;
        } catch (e) {
            return false;
        }
    }

    function activarEstadoEditor() {
        renderTemplateStrip();
        cargarEstadoPlantilla(plantillaActiva);
        if (savedGruposState) {
            restaurarGruposEstado(savedGruposState);
        } else if (!groupOrder.length) {
            crearGrupo();
        }
        aplicarTamanos();
        aplicarColores();
        aplicarColoresPosicion();
        document.getElementById('logoWrapModelo').style.display = logoVisible ? '' : 'none';
        document.getElementById('logoWrapEditor').style.display = logoVisible ? '' : 'none';
        var btnLogo = document.getElementById('btnToggleLogo');
        if (btnLogo) {
            btnLogo.innerHTML = logoVisible
                ? '<i class="bi bi-image"></i> Logo'
                : '<i class="bi bi-image-fill"></i> Logo <small style="color:#64748b">(oculto)</small>';
            btnLogo.classList.toggle('active', !logoVisible);
        }
        var activeBtn = document.querySelector('.tab-btn[data-tab="' + tabActivo + '"]');
        if (tabActivo === 'editor') {
            switchTab('editor', activeBtn);
        } else {
            switchTab('modelo', activeBtn);
        }
        scheduleSaveEditorState();
    }

    window.nuevaPlantilla = function () {
        guardarEstadoPlantilla(plantillaActiva);
        var base = plantillas[plantillaActiva] || plantillas[0] || {};
        plantillas.push({
            nombre: 'Plantilla ' + (plantillas.length + 1),
            titulo: base.titulo || '',
            subtitulo: base.subtitulo || 'Oferta especial · Todo incluido · Salida Madrid',
            seccion: base.seccion || 'Top hoteles más económicos',
            footerUrl: base.footerUrl || '@Model.WebTexto',
            footerTag: base.footerTag || 'tu agencia de confianza',
            heroBg: base.heroBg || '',
            hotelHtml: base.hotelHtml || '',
            ocultos: (base.ocultos || []).map(function (o) { return { html: o.html || '', nombre: o.nombre || '' }; }),
            logoSrc: base.logoSrc || DEFAULT_LOGO_SRC,
            linkOferta: base.linkOferta || '',
            logoHeight: base.logoHeight || 100,
            // [2026-08-05] Plantilla nueva arranca sin nombre de archivo — cargarEstadoPlantilla
            // dispara refrescarNombreArchivoAutoEditor y genera uno basado en el destino actual.
            nombreArchivo: '', nombreArchivoEditado: false
        });
        plantillaActiva = plantillas.length - 1;
        renderTemplateStrip();
        cargarEstadoPlantilla(plantillaActiva);
        scheduleSaveEditorState();
    };

    window.eliminarPlantilla = function (idx) {
        if (plantillas.length <= 1) return;
        plantillas.splice(idx, 1);
        if (plantillaActiva >= plantillas.length) plantillaActiva = plantillas.length - 1;
        renderTemplateStrip();
        cargarEstadoPlantilla(plantillaActiva);
        scheduleSaveEditorState();
    };

    if (!restoreEditorState()) {
        guardarEstadoPlantilla(plantillaActiva);
        crearGrupo();
    }
    activarEstadoEditor();

    window.addEventListener('beforeunload', function () {
        saveEditorState();
    });

})();
</script>
}
