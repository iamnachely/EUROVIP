@* Centro de Flyers (como /Flyer/Hub de BackTiTan): dos módulos, Flyer Agencia y Flyer Editar (clientes). *@
@{
    ViewData["Title"] = "Centro de Flyers";
}

@section Styles {
<link rel="stylesheet" href="~/css/eurovip-ui.css" asp-append-version="true" />
<style>
    .hb { max-width: 980px; margin: 0 auto; padding: 18px 0 40px; }
    .hb-cab { text-align: center; margin-bottom: 34px; }
    .hb-cab .pill { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 99px; background: var(--ev-surface-2); border: 1px solid var(--ev-line);
                    font: 800 11.5px var(--ev-font); letter-spacing: .14em; text-transform: uppercase; color: var(--ev-deep); }
    .hb-cab h1 { margin: 14px 0 6px; font-size: clamp(28px, 4vw, 40px); font-weight: 800; letter-spacing: -1.4px; }
    .hb-cab p { margin: 0; color: var(--ev-muted); font-weight: 600; }
    .hb-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: 24px; }
    .hb-card { position: relative; overflow: hidden; border-radius: 30px; padding: 34px 30px 30px; background: var(--ev-surface); border: 1px solid var(--ev-line);
               display: flex; flex-direction: column; gap: 14px; text-decoration: none; color: var(--ev-text); isolation: isolate;
               transition: transform .3s var(--ev-ease), box-shadow .3s, border-color .3s; }
    .hb-card::before { content: ""; position: absolute; inset: 0; z-index: -1; opacity: .9;
                       background: radial-gradient(420px 220px at 110% -10%, var(--hb-c1), transparent 65%), radial-gradient(300px 180px at -10% 120%, var(--hb-c2), transparent 60%); }
    .hb-card:hover { transform: translateY(-6px); box-shadow: var(--ev-shadow-lg); border-color: var(--hb-borde); }
    .hb-card:focus-visible { outline: 3px solid var(--ev-teal); outline-offset: 3px; }
    .hb-ico { width: 74px; height: 74px; border-radius: 22px; display: grid; place-items: center; font-size: 34px; background: var(--hb-ico-bg); color: var(--hb-ico); }
    .hb-card h2 { margin: 0; font-size: 24px; font-weight: 800; letter-spacing: -.6px; }
    .hb-card p { margin: 0; color: var(--ev-muted); font-weight: 600; line-height: 1.55; }
    .hb-card ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 7px; }
    .hb-card li { display: flex; gap: 9px; align-items: flex-start; font-weight: 600; font-size: 14px; }
    .hb-card li i { color: var(--hb-ico); margin-top: 2px; }
    .hb-ir { margin-top: auto; align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; padding: 12px 22px; border-radius: 14px;
             background: var(--ev-ink); color: #fff; font-weight: 800; transition: gap .25s; }
    .hb-card:hover .hb-ir { gap: 14px; }
    .hb-ag { --hb-c1: rgba(255,106,0,.18); --hb-c2: rgba(11,42,111,.12); --hb-borde: #FF8A3D; --hb-ico-bg: #FFF1E6; --hb-ico: #E25A00; }
    .hb-cl { --hb-c1: rgba(43,212,196,.30); --hb-c2: rgba(179,255,243,.35); --hb-borde: var(--ev-teal); --hb-ico-bg: var(--ev-mint); --hb-ico: var(--ev-deep); }
    @@media (prefers-reduced-motion: reduce) { .hb-card, .hb-ir { transition: none; } .hb-card:hover { transform: none; } }
</style>
}

<div class="hb ev-rise">
    <div class="hb-cab">
        <span class="pill"><i class="bi bi-layers-fill"></i> Módulos de flyers</span>
        <h1>Centro de Flyers</h1>
        <p>Elige con qué quieres trabajar.</p>
    </div>
    <div class="hb-grid">
        <a class="hb-card hb-ag" href="/Agencia/Index">
            <span class="hb-ico"><i class="bi bi-building-fill"></i></span>
            <h2>Flyer Agencia</h2>
            <p>Flyers para las agencias, con un link único a su propio editor y envío por WhatsApp.</p>
            <ul>
                <li><i class="bi bi-check2-circle"></i> Hoteles más baratos de cada destino, listos en imagen</li>
                <li><i class="bi bi-check2-circle"></i> Lista de agencias y links únicos (su logo, sus precios)</li>
                <li><i class="bi bi-check2-circle"></i> Envío masivo con costo previo, monitor y reporte</li>
            </ul>
            <span class="hb-ir">Abrir Flyer Agencia <i class="bi bi-arrow-right"></i></span>
        </a>
        <a class="hb-card hb-cl" href="/Flyer/Editor">
            <span class="hb-ico"><i class="bi bi-person-check-fill"></i></span>
            <h2>Flyer Editar</h2>
            <p>Flyers para tus clientes: diseña, ajusta precios, descarga y envía por WhatsApp a tus contactos.</p>
            <ul>
                <li><i class="bi bi-check2-circle"></i> Editor: varios destinos, hoteles con precio, textos, colores, logo</li>
                <li><i class="bi bi-check2-circle"></i> Plantillas de flyer y fondos por destino</li>
                <li><i class="bi bi-check2-circle"></i> Galería, descarga en PNG o ZIP</li>
                <li><i class="bi bi-check2-circle"></i> Contactos y envío por WhatsApp (con o sin botón a la web)</li>
            </ul>
            <span class="hb-ir">Abrir Flyer Editar <i class="bi bi-arrow-right"></i></span>
        </a>
    </div>
</div>
