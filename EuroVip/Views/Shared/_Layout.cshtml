@{
    var nombre = Context.Session.GetString("NombreUsuario") ?? User.Identity?.Name ?? "Usuario";
    nombre = new System.Globalization.CultureInfo("es-ES").TextInfo.ToTitleCase(nombre.ToLowerInvariant());
    var rol = Context.Session.GetString("Rol");
    var foto = Context.Session.GetString("Imagen");
    var iniciales = string.Concat(nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    string Activo(string c) => string.Equals(controlador, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Eurovip</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap-reboot.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/eurovip.css" asp-append-version="true" />
    <script>
        try { var t = localStorage.getItem('ev-theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) { }
    </script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="ev-shell">
        <aside class="ev-sidebar" id="evSidebar">
            <a asp-controller="Home" asp-action="Index" class="ev-brand">
                <div class="ev-brand-mark">EV</div>
                <div>
                    <div class="ev-brand-name">Euro<span>vip</span></div>
                    <div class="ev-brand-sub">BackOffice</div>
                </div>
            </a>

            <nav class="ev-sidebar-scroll" id="evNavScroll" aria-label="Menú principal">
                <ul class="ev-nav">
                    <li><a asp-controller="Home" asp-action="Index" class="@Activo("Home")"><i class="bi bi-grid-1x2-fill"></i> Inicio</a></li>
                </ul>

                <div class="ev-grupo" data-grupo="cargas">
                    <button type="button" class="ev-nav-label" aria-expanded="true"><span>Cargas</span><i class="bi bi-chevron-down"></i></button>
                    <ul class="ev-nav">
                        <li><a asp-controller="Hoteles" asp-action="Index" class="@Activo("Hoteles")"><i class="bi bi-building"></i> Hoteles</a></li>
                        <li><a asp-controller="Ofertas" asp-action="Index" class="@(Activo("Ofertas") != "" || Activo("CargaManual") != "" ? "active" : "")"><i class="bi bi-pencil-square"></i> Carga manual</a></li>
                        <li><a asp-controller="Circuitos" asp-action="Index" class="@(Activo("Circuitos") != "" || Activo("CargaCircuitos") != "" ? "active" : "")"><i class="bi bi-signpost-split"></i> Circuitos</a></li>
                        <li><a href="#" class="pronto"><i class="bi bi-compass"></i> Excursiones <span class="ev-pill">PRONTO</span></a></li>
                        <li><a href="#" class="pronto"><i class="bi bi-car-front"></i> Traslados <span class="ev-pill">PRONTO</span></a></li>
                    </ul>
                </div>

                <div class="ev-grupo" data-grupo="web">
                    <button type="button" class="ev-nav-label" aria-expanded="true"><span>Web</span><i class="bi bi-chevron-down"></i></button>
                    <ul class="ev-nav">
                        <li><a asp-controller="HomeWeb" asp-action="Index" class="@Activo("HomeWeb")"><i class="bi bi-window-sidebar"></i> Home de la web</a></li>
                        <li><a href="/HomeWeb/Index#carrusel"><i class="bi bi-images"></i> Carrusel (slider)</a></li>
                        <li><a asp-controller="ConsultarOferta" asp-action="Index" class="@Activo("ConsultarOferta")"><i class="bi bi-search-heart"></i> Consultar ofertas</a></li>
                        <li><a asp-controller="Flyer" asp-action="Hub" class="@Activo("Flyer")"><i class="bi bi-file-earmark-richtext"></i> Flyers</a></li>
                    </ul>
                </div>

                <div class="ev-grupo" data-grupo="admin">
                    <button type="button" class="ev-nav-label" aria-expanded="true"><span>Administración</span><i class="bi bi-chevron-down"></i></button>
                    <ul class="ev-nav">
                        <li><a asp-controller="Herramientas" asp-action="Index" class="@Activo("Herramientas")"><i class="bi bi-tools"></i> Herramientas</a></li>
                        <li><a href="#" class="pronto"><i class="bi bi-people"></i> Usuarios <span class="ev-pill">PRONTO</span></a></li>
                        <li><a href="#" class="pronto"><i class="bi bi-shield-lock"></i> Accesos <span class="ev-pill">PRONTO</span></a></li>
                    </ul>
                </div>
            </nav>

            <div class="ev-sidebar-foot">
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    <button type="submit" class="ev-logout"><i class="bi bi-box-arrow-left"></i> Cerrar sesión</button>
                </form>
            </div>
        </aside>

        <main class="ev-main">
            <header class="ev-topbar">
                <button class="ev-icon-btn ev-menu-btn" type="button" onclick="document.body.classList.toggle('ev-menu-open')" aria-label="Menú">
                    <i class="bi bi-list"></i>
                </button>
                <nav class="ev-tabs">
                    <a asp-controller="Home" asp-action="Index" class="@(Activo("Cargas") == "" && Activo("Reportes") == "" ? "active" : "")">Resumen</a>
                    <a asp-controller="Cargas" asp-action="Index" class="@Activo("Cargas")">Cargas</a>
                    <a asp-controller="Reportes" asp-action="Index" class="@Activo("Reportes")">Reportes</a>
                </nav>
                <label class="ev-search">
                    <i class="bi bi-search"></i>
                    <input type="search" placeholder="Buscar hotel, destino, circuito…" />
                    <kbd>Ctrl K</kbd>
                </label>
                <button class="ev-icon-btn" type="button" id="evTheme" aria-label="Cambiar tema"><i class="bi bi-moon-stars"></i></button>
                <div class="ev-pop-wrap">
                    <button class="ev-icon-btn" type="button" id="evBell" aria-label="Notificaciones" aria-haspopup="true" aria-expanded="false">
                        <i class="bi bi-bell"></i><span class="ev-badge" id="evBellN" hidden>0</span>
                    </button>
                    <div class="ev-pop ev-notif" id="evNotif" role="dialog" aria-label="Notificaciones" hidden>
                        <div class="ev-pop-h">
                            <b>Notificaciones</b>
                            <div class="ev-seg" id="evNotifFiltro"><button type="button" class="on" data-f="">Todas</button><button type="button" data-f="nl">No leídas</button></div>
                        </div>
                        <div class="ev-notif-lista" id="evNotifLista"><div class="ev-notif-vacio"><span class="ev-spin"></span> Cargando…</div></div>
                        <div class="ev-pop-f"><button type="button" id="evNotifLeer"><i class="bi bi-check2-all"></i> Marcar todo como leído</button><a href="/Cargas/Index">Ver cargas <i class="bi bi-arrow-right"></i></a></div>
                    </div>
                </div>
                <div class="ev-pop-wrap">
                    <button class="ev-user" type="button" id="evUser" aria-haspopup="true" aria-expanded="false">
                        <span class="ev-avatar" id="evAvatar">@if (!string.IsNullOrEmpty(foto)) { <img src="@foto" alt="" /> } else { @iniciales }</span>
                        <span class="ev-user-text">
                            <b id="evNombre">@nombre</b>
                            <small>@(string.IsNullOrWhiteSpace(rol) ? "Eurovip" : rol)</small>
                        </span>
                        <i class="bi bi-chevron-down ev-user-chev"></i>
                    </button>
                    <div class="ev-pop ev-menu-user" id="evUserMenu" role="menu" hidden>
                        <div class="ev-mu-head">
                            <span class="ev-avatar xl" id="evAvatarXl">@if (!string.IsNullOrEmpty(foto)) { <img src="@foto" alt="" /> } else { @iniciales }</span>
                            <div><b>@nombre</b><small>@(User.Identity?.Name) · @(string.IsNullOrWhiteSpace(rol) ? "Eurovip" : rol)</small></div>
                        </div>
                        <a href="/Perfil/Index" role="menuitem"><i class="bi bi-person-circle"></i> Mi perfil</a>
                        <a href="/Perfil/Index#foto" role="menuitem"><i class="bi bi-camera"></i> Cambiar mi foto</a>
                        <button type="button" role="menuitem" onclick="document.getElementById('evTheme').click()"><i class="bi bi-circle-half"></i> Cambiar tema</button>
                        <form asp-controller="Auth" asp-action="Logout" method="post">
                            <button type="submit" role="menuitem" class="salir"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</button>
                        </form>
                    </div>
                </div>
            </header>

            @RenderBody()
        </main>
    </div>

    <script src="~/js/eurovip.js" asp-append-version="true"></script>
    <script src="~/js/eurovip-top.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
