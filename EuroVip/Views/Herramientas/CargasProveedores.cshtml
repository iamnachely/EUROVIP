    /* =====================================================================================================================
       20/11/2026 · logos, cronograma de 5 días, chats encargados, cards de cargas, simulación de la web y cuentas.
       ===================================================================================================================== */
    .sg-av.logo { background: #fff; overflow: hidden; padding: 2px; } .sg-av.logo img { width: 100%; height: 100%; object-fit: contain; border-radius: 50%; }
    .sg-sla { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; border-radius: 99px; font-size: 12px; font-weight: 800; white-space: nowrap; }
    .sg-sla.verde { background: #DCFCE7; color: #067647; } .sg-sla.ama { background: #FEF0C7; color: #B54708; } .sg-sla.rojo { background: #FEE4E2; color: #B42318; }
    .sg-barra-sla { display: flex; height: 14px; border-radius: 99px; overflow: hidden; background: #EEF2F1; margin: 8px 0; } .sg-barra-sla span { min-width: 4px; }
    .sg-rend { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin: 10px 0; }
    .sg-rend div { background: #F5FBFA; border-radius: 14px; padding: 10px 12px; } .sg-rend b { display: block; font-size: 22px; letter-spacing: -.5px; } .sg-rend small { color: var(--ev-muted); font-weight: 700; font-size: 12px; }
    .sg-tabla { width: 100%; border-collapse: collapse; font-size: 13px; } .sg-tabla th { text-align: left; color: var(--ev-muted); font-size: 11.5px; text-transform: uppercase; letter-spacing: .05em; padding: 6px 4px; } .sg-tabla td { padding: 7px 4px; border-top: 1px dashed var(--ev-line); }

    /* Cards de las cargas (pestaña «Todas las cargas») */
    #hpLista { grid-template-columns: repeat(auto-fill, minmax(420px, 1fr)); gap: 16px; }
    .sg-lc { text-align: left; border: 1px solid var(--ev-line); border-radius: 24px; background: #fff; box-shadow: var(--ev-shadow); overflow: hidden; cursor: pointer; font: inherit; color: inherit; display: grid; grid-template-columns: 150px minmax(0, 1fr); transition: transform .18s, box-shadow .18s; animation: sgEntra .35s ease both; position: relative; padding: 0; }
