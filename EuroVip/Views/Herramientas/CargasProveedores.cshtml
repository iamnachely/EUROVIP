    .sg-chat .l3 { font-size: 11.5px; color: #0E8F86; font-weight: 800; }
    .sg-badge { min-width: 20px; height: 20px; padding: 0 6px; border-radius: 99px; display: grid; place-items: center; background: #25D366; color: #fff; font-size: 11.5px; font-weight: 800; }
