    .sg-pal-res { max-height: 52vh; overflow: auto; padding: 6px; } .sg-pal-res h5 { margin: 8px 12px 2px; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--ev-muted); }
