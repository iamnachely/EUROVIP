        } catch { return null; }
    }
    async function tickets() {
        await cargarEquipo();
        const q = new URLSearchParams({ q: $('#tkQ').value.trim(), categoria: $('#tkCat').value, asignado: $('#tkMias').checked ? yo : '' });
        let r; try { r = await EV.api('/Herramientas/ProveedorTickets?' + q); } catch { return; }
        tkDatos = r; $('#tkAviso').hidden = r.activo !== false; if (r.activo === false) { $('#tkCols').innerHTML = ''; $('#tkKpis').innerHTML = ''; return; }
        const s = r.resumen || {}; resumenTickets();
        $('#tkCols').innerHTML = TK_COL.map(([k, tit, ic, col, estados]) => {
            const l = r.items.filter(x => estados.includes(x.estado));
            const cards = l.map((x, i) => { const c = TK_CAT[x.categoria] || TK_CAT.otro, abierto = !['RESUELTO', 'CERRADO'].includes(x.estado);
                return '<button type="button" class="tkb-card p' + x.prioridad + '" style="--c:' + col + ';animation-delay:' + Math.min(i, 8) * 30 + 'ms" data-tk="' + x.id_Ticket + '">'
                    + '<div class="sg-card-top">' + av(x.cuenta, 0, x.id_Cuenta) + '<div><span class="cod">' + esc(x.codigo) + '</span><b>' + esc(x.asunto) + '</b><small>' + esc(x.cuenta || '') + '</small></div>' + (x.ultimo_Tipo === 'PROVEEDOR' && abierto ? '<span class="sg-punto" title="El proveedor escribió"></span>' : '') + '</div>'
                    + '<div class="sg-card-pies"><span class="sg-chip"><i class="bi ' + c[0] + '"></i> ' + c[1] + '</span>' + (x.prioridad >= 2 ? '<span class="sg-chip ' + (x.prioridad === 3 ? 'rojo' : 'ama') + '"><i class="bi bi-flag-fill"></i> ' + TK_PRI[x.prioridad] + '</span>' : '') + (x.asignado_A ? '<span class="sg-chip azul"><i class="bi bi-person-check"></i> ' + esc(nombreDe(x.asignado_A)) + '</span>' : '') + (x.calificacion ? '<span class="sg-chip ama"><i class="bi bi-star-fill"></i> ' + x.calificacion + '</span>' : '') + '</div>'
                    + '<div class="sg-card-pies">' + (abierto ? slaChip(x.creado_En) : '') + '<small>actualizado hace ' + hace(x.actualizado_En) + ' · ' + x.mensajes + ' msj</small></div></button>'; }).join('');
            return '<div class="tkb-col" style="--c:' + col + '"><div class="sg-col-cab"><span class="ic"><i class="bi ' + ic + '"></i></span><b>' + tit + '</b><span class="n">' + l.length + '</span></div><div class="sg-col-cuerpo">' + (cards || '<div class="sg-vacio">Nada aquí.</div>') + '</div></div>';
        }).join('');
    }
    $('#tkQ').addEventListener('input', EV.debounce(tickets, 250)); $('#tkCat').addEventListener('change', tickets); $('#tkMias').addEventListener('change', tickets);
    $('#tkCols').addEventListener('click', e => { const b = e.target.closest('[data-tk]'); if (b) abrirTicket(+b.dataset.tk); });

    async function abrirTicket(id) {
        tkId = id; tkArchivos = []; tkModo = 'msg'; $('#tkVer').hidden = false; $('#tkMsgs').innerHTML = '<div class="sg-main-vacio"><i class="bi bi-hourglass-split"></i></div>';
        await cargarTicket();
    }
    async function cargarTicket() {
        let r; try { r = await EV.api('/Herramientas/ProveedorTicket?id=' + tkId); } catch { $('#tkVer').hidden = true; return; }
        tkDet = r; const t = r.ticket, c = TK_CAT[t.categoria] || TK_CAT.otro, cerrado = ['RESUELTO', 'CERRADO'].includes(t.estado);
        $('#tkAv').outerHTML = av(t.cuenta, 1, t.id_Cuenta).replace('<span class="sg-av g', '<span id="tkAv" class="sg-av g');
        $('#tkTit').textContent = t.codigo + ' · ' + t.asunto; $('#tkSub').textContent = (t.cuenta || '') + ' · ' + c[1] + ' · creado ' + fh(t.creado_En);
        let ultimoDia = '';
        $('#tkMsgs').innerHTML = r.mensajes.map(m => { const dia = diaTxt(m.creado_En), sep = dia !== ultimoDia ? '<div class="sg-dia">' + dia + '</div>' : ''; ultimoDia = dia;
            if (m.tipo === 'SISTEMA') return sep + '<div class="sg-sis">' + esc(nombreDe(m.autor)) + ' · ' + esc(m.texto) + ' · ' + hm(m.creado_En) + '</div>';
            let adj = []; try { adj = m.adjuntos ? JSON.parse(m.adjuntos) : []; } catch { }
            const adjH = adj.length ? '<div class="tkb-adj">' + adj.map(a => { const u = '/Herramientas/ProveedorTicketArchivo?id=' + tkId + '&archivo=' + a.archivo; return ['png', 'jpg', 'jpeg', 'webp'].includes(a.tipo) ? '<a class="img" href="' + u + '" target="_blank" rel="noopener"><img src="' + u + '" alt="' + esc(a.nombre) + '"></a>' : '<a class="doc" href="' + u + '" download="' + esc(a.nombre) + '"><i class="bi ' + (ICO_ARCH[a.tipo] || 'bi-file-earmark') + '"></i><span><b>' + esc(a.nombre) + '</b><small>' + bytesTxt(a.bytes) + '</small></span><i class="bi bi-download"></i></a>'; }).join('') + '</div>' : '';
            if (m.tipo === 'NOTA') return sep + '<div class="sg-msg NOTA"><div class="qn"><i class="bi bi-lock-fill"></i> Nota interna · ' + esc(nombreDe(m.autor)) + '</div>' + esc(m.texto || '') + adjH + '<div class="tm">' + hm(m.creado_En) + '</div></div>';
            const eur = m.tipo === 'EUROVIP';
            return sep + '<div class="sg-msg ' + m.tipo + '"><div class="qn">' + esc(eur ? nombreDe(m.autor) + ' · Eurovip' : m.autor) + '</div>' + esc(m.texto || '') + adjH + '<div class="tm">' + hm(m.creado_En) + (eur ? ' <i class="bi bi-check2-all ok"></i>' : '') + '</div></div>'; }).join('');
        const ms = $('#tkMsgs'); ms.scrollTop = ms.scrollHeight;
        const opcionesEq = [...new Set([...equipoFull.map(x => x.userName), t.asignado_A].filter(Boolean))];
        $('#tkLado').innerHTML = '<div><h4>Estado</h4><div class="tkb-est">' + ['ABIERTO', 'EN_PROCESO', 'ESPERANDO', 'RESUELTO'].map(e => '<button type="button" data-tke="' + e + '" class="' + (t.estado === e ? 'on' : '') + '">' + TK_EST[e] + '</button>').join('') + '</div></div>'
            + '<div><h4>Prioridad</h4><select class="ui-input" id="tkPri">' + TK_PRI.map((p, i) => '<option value="' + i + '" ' + (t.prioridad === i ? 'selected' : '') + '>' + p + '</option>').join('') + '</select></div>'
            + '<div><h4>Lo atiende</h4><div style="display:flex;gap:6px"><select class="ui-input" id="tkAsig"><option value="">Sin asignar</option>' + opcionesEq.map(u => '<option value="' + esc(u) + '" ' + (u === t.asignado_A ? 'selected' : '') + '>' + esc(nombreDe(u)) + (u === yo ? ' (tú)' : '') + '</option>').join('') + '</select>' + (t.asignado_A === yo ? '' : '<button type="button" class="ev-btn ghost sm" id="tkMia">Mío</button>') + '</div></div>'
            + '<div><h4>Plazo de respuesta</h4>' + (cerrado ? '<span class="sg-sla verde"><i class="bi bi-check2-circle"></i> Resuelto' + (t.resuelto_En ? ' ' + fh(t.resuelto_En) : '') + '</span>' : slaChip(t.creado_En)) + '<small style="display:block;color:var(--ev-muted);margin-top:4px">' + (t.primera_Respuesta_En ? 'Primera respuesta: ' + fh(t.primera_Respuesta_En) : 'Todavía sin primera respuesta') + '</small></div>'
            + (t.codigo_Carga ? '<div><h4>Carga relacionada</h4><a class="ev-btn ghost sm" href="/Herramientas/CargasProveedores?tab=lista&carga=' + t.id_Carga + '"><i class="bi bi-box-arrow-up-right"></i> ' + esc(t.codigo_Carga) + '</a></div>' : '')
            + '<div><h4>Lo que contó el proveedor</h4><div class="tkb-desc">' + esc(t.descripcion) + '</div></div>'
            + (t.calificacion ? '<div><h4>Calificación del proveedor</h4>' + estrellasHtml(t.calificacion) + (t.calificacion_Texto ? '<div class="tkb-desc" style="margin-top:6px">' + esc(t.calificacion_Texto) + '</div>' : '') + '</div>' : '');
        pintarArch(); modoTk();
    }
    function pintarArch() { $('#tkArchLista').innerHTML = tkArchivos.map((f, i) => '<span>' + esc(f.name) + ' · ' + bytesTxt(f.size) + '<button type="button" data-quitar="' + i + '" aria-label="Quitar">×</button></span>').join(''); }
    function modoTk() { document.querySelectorAll('[data-tkm]').forEach(b => b.classList.toggle('on', b.dataset.tkm === tkModo)); $('#tkCaja').classList.toggle('nota', tkModo === 'nota'); $('#tkTexto').placeholder = tkModo === 'msg' ? 'Escribe al proveedor… (Ctrl+Enter envía)' : 'Escribe una nota para tu equipo (el proveedor no la ve)…'; }
    document.querySelectorAll('[data-tkm]').forEach(b => b.addEventListener('click', () => { tkModo = b.dataset.tkm; modoTk(); }));
    $('#tkAdjBtn').addEventListener('click', () => $('#tkArch').click());
    $('#tkArch').addEventListener('change', e => { tkArchivos = [...tkArchivos, ...e.target.files].slice(0, 5); e.target.value = ''; pintarArch(); });
    $('#tkArchLista').addEventListener('click', e => { const b = e.target.closest('[data-quitar]'); if (b) { tkArchivos.splice(+b.dataset.quitar, 1); pintarArch(); } });
    async function enviarTicket() {
        const texto = $('#tkTexto').value.trim(); if (!texto && !tkArchivos.length) { $('#tkTexto').focus(); return; }
        const fd = new FormData(); fd.append('id', tkId); fd.append('texto', texto); fd.append('nota', tkModo === 'nota'); tkArchivos.forEach(f => fd.append('archivos', f));
        try { await EV.post('/Herramientas/ProveedorTicketMensaje', fd); } catch { return; }
        $('#tkTexto').value = ''; tkArchivos = []; await cargarTicket(); tickets();
    }
    $('#tkEnviar').addEventListener('click', enviarTicket);
    $('#tkTexto').addEventListener('keydown', e => { if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); enviarTicket(); } });
    async function gestionTicket(c) { try { await EV.post('/Herramientas/ProveedorTicketGestion', { id: tkId, ...c }); } catch { return; } await cargarTicket(); tickets(); }
    $('#tkLado').addEventListener('click', e => { const b = e.target.closest('[data-tke]'); if (b) gestionTicket({ estado: b.dataset.tke }); if (e.target.closest('#tkMia')) gestionTicket({ asignado: yo, cambiaAsignado: true }); });
    $('#tkLado').addEventListener('change', e => { if (e.target.id === 'tkPri') gestionTicket({ prioridad: +e.target.value }); if (e.target.id === 'tkAsig') gestionTicket({ asignado: e.target.value, cambiaAsignado: true }); });
    $('#tkCerrar').addEventListener('click', () => { $('#tkVer').hidden = true; });
    $('#tkVer').addEventListener('mousedown', e => { if (e.target === $('#tkVer')) $('#tkVer').hidden = true; });
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && !$('#tkVer').hidden) $('#tkVer').hidden = true; });

    // ---------------- control de calidad ----------------
    let calActual = null, navIds = [];
    async function calidad(c) {
        const box = document.getElementById('sgCal'); if (!box) return; calActual = null;
        box.innerHTML = '<div class="sg-cal-cab"><i class="bi bi-hourglass-split"></i><div><b>Revisando la carga…</b><small>Reglas, precios, textos y hoteles</small></div></div>';
        try {
            const r = await EV.api('/Herramientas/ProveedorRevision?id=' + c.id); calActual = r;
            const tit = { verde: ['bi-shield-check', 'Todo en orden', 'El control de calidad no encontró nada raro.'], ama: ['bi-shield-exclamation', 'Revisa estos puntos', 'Nada impide aprobarla, pero conviene mirar.'], rojo: ['bi-shield-x', 'Hay problemas que arreglar', 'Así no se debería publicar.'] }[r.riesgo];
            box.className = 'sg-cal ' + r.riesgo;
            box.innerHTML = `<div class="sg-cal-cab"><i class="bi ${tit[0]}"></i><div><b>${tit[1]}</b><small>${tit[2]}</small></div></div>${r.puntos.length ? `<ul>${r.puntos.map(p => `<li class="${p.nivel}"><i class="bi ${p.nivel === 'rojo' ? 'bi-x-octagon-fill' : 'bi-exclamation-triangle-fill'}"></i><div><b>${esc(p.titulo)}</b>${p.detalle ? `<span>${esc(p.detalle)}</span>` : ''}</div></li>`).join('')}</ul>` : ''}`;
        } catch { box.innerHTML = ''; }
    }
    // ---------------- anterior / siguiente ----------------
    function abrirDesde(el, id) {
        const cont = el.closest('.sg-col-cuerpo, #hpLista, .sg-panel, .sg-provs');
        navIds = cont ? [...cont.querySelectorAll('[data-carga],[data-id]')].map(x => +(x.dataset.carga || x.dataset.id)).filter((v, i, a) => v && a.indexOf(v) === i) : [id];
        abrir(id);
    }
    function navUI(id) {
        const i = navIds.indexOf(id); $('#hpVerPos').textContent = i >= 0 && navIds.length > 1 ? (i + 1) + ' / ' + navIds.length : '';
        $('#hpVerPrev').disabled = !(i > 0); $('#hpVerNext').disabled = !(i >= 0 && i < navIds.length - 1);
    }
    $('#hpVerPrev').addEventListener('click', () => { const i = navIds.indexOf(actual?.carga?.id); if (i > 0) abrir(navIds[i - 1]); });
    $('#hpVerNext').addEventListener('click', () => { const i = navIds.indexOf(actual?.carga?.id); if (i >= 0 && i < navIds.length - 1) abrir(navIds[i + 1]); });
    document.addEventListener('keydown', e => { if (!$('#hpVer').classList.contains('open') && !visor.abierto()) return; if (e.target.matches('input,textarea,select')) return; if (e.key === 'ArrowLeft') $('#hpVerPrev').click(); if (e.key === 'ArrowRight') $('#hpVerNext').click(); });

    // ---------------- buscador general (Ctrl+K) y atajos ----------------
    const pal = $('#sgPal'); let palT = 0;
    const abrirPal = () => { pal.hidden = false; $('#sgPalQ').value = ''; $('#sgPalRes').innerHTML = ''; $('#sgPalQ').focus(); buscarPal(''); };
    const cerrarPal = () => { pal.hidden = true; };
    async function buscarPal(q) {
        q = q.trim().toLowerCase(); const mi = ++palT; let cs = [];
        try { cs = (await EV.api('/Herramientas/ProveedoresCargas?' + new URLSearchParams({ estado: '', q, tam: 8, pagina: 1 }))).items; } catch { }
        if (!fichas.length) { try { fichas = (await EV.api('/Herramientas/ProveedorFichas')).items; } catch { } }
        if (mi !== palT) return;
        const ps = fichas.filter(p => !q || `${p.nombre} ${p.email || ''} ${p.proveedor || ''}`.toLowerCase().includes(q)).slice(0, 5);
        const ch = chats.filter(x => q && `${x.cuenta} ${x.codigo} ${x.ultimo_Texto}`.toLowerCase().includes(q)).slice(0, 4);
        $('#sgPalRes').innerHTML = (cs.length ? '<h5>Cargas</h5>' + cs.map(c => `<button type="button" class="sg-fila" data-pal-carga="${c.id}">${av(c.cuenta)}<div><b>${esc(c.codigo)}${c.titulo ? ' · ' + esc(c.titulo) : ''}</b><small>${esc(c.cuenta || '')} · ${UNO[c.estado] || esc(c.estado)}</small></div></button>`).join('') : '')
            + (ps.length ? '<h5>Proveedores</h5>' + ps.map(p => `<button type="button" class="sg-fila" data-pal-prov="${esc(p.nombre)}">${av(p.nombre)}<div><b>${esc(p.nombre)}</b><small>${esc(p.email || '')} · ${p.cargas} cargas</small></div></button>`).join('') : '')
            + (ch.length ? '<h5>Mensajes</h5>' + ch.map(x => `<button type="button" class="sg-fila" data-pal-chat="${x.id}">${av(x.cuenta)}<div><b>${esc(x.cuenta)} · ${esc(x.codigo)}</b><small>${esc(corto(x.ultimo_Texto, 70))}</small></div></button>`).join('') : '') || '<div class="sg-vacio" style="margin:10px">No encontré nada.</div>';
    }
    $('#sgPalQ').addEventListener('input', EV.debounce(() => buscarPal($('#sgPalQ').value), 220));
    $('#sgPalQ').addEventListener('keydown', e => { if (e.key === 'Enter') { const b = $('#sgPalRes button'); if (b) b.click(); } });
    pal.addEventListener('mousedown', e => { if (e.target === pal) cerrarPal(); });
    $('#sgPalRes').addEventListener('click', e => { const b = e.target.closest('button'); if (!b) return; cerrarPal();
        if (b.dataset.palCarga) { navIds = [+b.dataset.palCarga]; abrir(+b.dataset.palCarga); }
        else if (b.dataset.palProv) { $('#sgPQ').value = b.dataset.palProv; pestana('prov'); pintarProv(); }
        else if (b.dataset.palChat) { pestana('chats'); setTimeout(() => abrirChat(+b.dataset.palChat), 400); } });
    $('#sgBuscar').addEventListener('click', abrirPal);
    document.addEventListener('keydown', e => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); pal.hidden ? abrirPal() : cerrarPal(); return; }
        if (e.key === 'Escape' && !pal.hidden) { cerrarPal(); return; }
        if (e.target.matches('input,textarea,select') || e.ctrlKey || e.altKey || e.metaKey || !pal.hidden) return;
        const tabs = ['hoy', 'tablero', 'lista', 'chats', 'tickets', 'prov', 'sol']; const n = +e.key;
        if (n >= 1 && n <= 7 && !$('#hpVer').classList.contains('open')) pestana(tabs[n - 1]); else if (e.key === '/') { e.preventDefault(); abrirPal(); }
    });

    // ---------------- exportar lo que se ve (Excel) ----------------
    $('#sgCsv').addEventListener('click', () => {
        const tab = document.querySelector('#sgTabs .on')?.dataset.tab;
        let filas = tab === 'tablero' && kdatos ? Object.values(kdatos).flatMap(x => x.items || []) : items;
        if (!filas.length) { EV.toast('No hay cargas para exportar en esta vista.', 'err'); return; }
        const cab = ['Código', 'Título', 'Proveedor', 'Módulo', 'Estado', 'Productos', 'Desde', 'Moneda', 'Enviada', 'Revisada', 'Revisó', 'Sale en la web', 'En la web desde', 'Responsable', 'Prioridad'];
        const cel = v => '"' + String(v ?? '').replace(/"/g, '""') + '"';
        const csv = [cab, ...filas.map(c => { const g = gest[c.id] || {}; return [c.codigo, c.titulo, c.cuenta, (modulos[c.modulo] || {}).nombre || c.modulo, UNO[c.estado] || c.estado, c.productos, c.precio_Desde, c.moneda, c.fecha_Solicitud, c.fecha_Revision, c.revisado_Por, c.activar_En, c.fecha_Activacion, g.asignado_A, ['Normal', 'Alta', 'Urgente'][g.prioridad || 0]]; })].map(r => r.map(cel).join(';')).join('\r\n');
        const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8' })); a.download = 'cargas-proveedores-' + new Date().toISOString().slice(0, 10) + '.csv'; a.click(); URL.revokeObjectURL(a.href);
        EV.toast('Descargado: ' + filas.length + ' cargas.');
    });

    // ---------------- arranque ----------------
    $('#hpRecargar').addEventListener('click', () => { kdatos = null; fichas = []; const t = document.querySelector('#sgTabs .on')?.dataset.tab || 'hoy'; pestana(t, false); cargarChats(); solicitudes(); listar(true); });
    setInterval(() => { if (!document.hidden) cargarChats(); }, 60000);
    cargarLogos().then(() => { if (document.querySelector('#tab-lista.on, #tab-tablero.on')) { pintarLista(); } });
    cargarChats(); resumenTickets();
    resumen.then(() => pestana(params.get('tab') && document.getElementById('tab-' + params.get('tab')) ? params.get('tab') : 'hoy', false));

    // Abrir directo (campana: /Herramientas/CargasProveedores?carga=12)
    const carga = +params.get('carga');
    listar(true);
    if (carga) resumen.then(() => abrir(carga));
})();
</script>
}
