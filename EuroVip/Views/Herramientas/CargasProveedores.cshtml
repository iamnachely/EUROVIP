    /* Mensajes: filtros y encargado */
    .sg-filtros { display: flex; gap: 6px; flex-wrap: wrap; }
    .sg-filtros button { border: 1.5px solid var(--ev-line); background: #fff; border-radius: 99px; padding: 5px 12px; font: inherit; font-weight: 800; font-size: 12.5px; color: var(--ev-muted); cursor: pointer; }
