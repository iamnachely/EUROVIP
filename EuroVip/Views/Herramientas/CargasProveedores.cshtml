    /* ---------- Proveedores ---------- */
    .sg-provs { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 14px; }
    .sg-prov { background: #fff; border: 1px solid var(--ev-line); border-radius: 24px; padding: 16px; box-shadow: var(--ev-shadow); display: grid; gap: 12px; animation: sgEntra .35s ease both; }
