    .sg-dia { align-self: center; margin: 10px 0 6px; padding: 4px 12px; border-radius: 10px; background: #fff; color: #54656F; font-size: 12px; font-weight: 700; box-shadow: 0 1px 1px rgba(11,18,21,.12); }
