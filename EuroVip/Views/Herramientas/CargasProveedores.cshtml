@{
    // CAMBIO 141 · Pantalla propia para revisar las cargas de PROVEEDORES y sus flyers (antes solo era una pestaña de Herramientas).
    // Pedido de la usuaria: «una vista nueva para revisar las cargas de proveedores y sus flyers […] comentar (conversación
    // que ve el proveedor), aprobar, rechazar con motivo, devolver al proveedor para que cambie algo con instrucciones,
    // aprobar y programar con fecha y hora de un calendario, o aprobar y activar ya. Solo los usuarios del BackEurovip
    // activan en la web. El proveedor puede sugerir la fecha; aquí se acepta o se pone otra».
    // Misma bandeja que Herramientas (estilos compartidos en wwwroot/css/eurovip-proveedores.css) y los mismos endpoints
    // de HerramientasController (/Herramientas/Proveedor*), más ProveedorCargaDevolver y ProveedorCargaComentar.
    ViewData["Title"] = "Cargas de proveedores";
}

@section Styles {
<link rel="stylesheet" href="~/css/eurovip-ui.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/eurovip-proveedores.css" asp-append-version="true" />
<style>
    .hp-est.DEVUELTA { background: #FCE7F3; color: #9D174D; }
    .hp-sug { display: flex; gap: 10px; align-items: center; padding: 12px 14px; border-radius: 16px; background: #F0FDF4; border: 1.5px solid #86EFAC; margin-bottom: 12px; font-weight: 700; font-size: 13.5px; }
    .hp-sug i { font-size: 20px; color: #16A34A; }
    .hp-acciones { display: grid; gap: 10px; }
    .hp-accion { border: 1px solid var(--ev-line); border-radius: 18px; background: var(--ev-surface); overflow: hidden; }
    .hp-accion > summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 10px; padding: 12px 14px; font-weight: 800; font-size: 14px; }
    .hp-accion > summary::-webkit-details-marker { display: none; }
    .hp-accion > summary i:first-child { width: 34px; height: 34px; border-radius: 11px; display: grid; place-items: center; background: var(--ev-surface-2); font-size: 16px; }
    .hp-accion > summary small { display: block; color: var(--ev-muted); font-weight: 600; font-size: 12px; }
    .hp-accion[open] > summary { border-bottom: 1px solid var(--ev-line); }
    .hp-accion .cuerpo { padding: 12px 14px 14px; display: grid; gap: 10px; }
    .hp-accion.verde > summary i:first-child { background: #DCFCE7; color: #166534; }
    .hp-accion.azul > summary i:first-child { background: #E0E7FF; color: #3730A3; }
    .hp-accion.rosa > summary i:first-child { background: #FCE7F3; color: #9D174D; }
    .hp-accion.rojo > summary i:first-child { background: #FEE4E2; color: #B42318; }
    .hp-chat { display: grid; gap: 10px; max-height: 380px; overflow: auto; padding: 4px 2px; }
    .hp-msg { max-width: 88%; padding: 10px 12px; border-radius: 16px; font-size: 13.5px; line-height: 1.45; white-space: pre-line; }
    .hp-msg small { display: block; font-size: 11.5px; font-weight: 800; opacity: .75; margin-bottom: 3px; white-space: normal; }
    .hp-msg.EUROVIP { justify-self: end; background: var(--ev-ink); color: #fff; border-bottom-right-radius: 4px; }
    .hp-msg.PROVEEDOR { justify-self: start; background: var(--ev-surface-2); border: 1px solid var(--ev-line); border-bottom-left-radius: 4px; }
    .hp-escribir { display: flex; gap: 8px; align-items: flex-end; margin-top: 10px; }
    .hp-escribir textarea { flex: 1; min-height: 44px; }
    .hp-sec { margin: 18px 0 8px; font-weight: 800; font-size: 15px; display: flex; gap: 8px; align-items: center; }

    /* ===== Detalle de la carga (20/11/2026: más claro y más bonito) ===== */
    #hpVer { background: #F6FBFA; }
    #hpVer .ui-dh { background: linear-gradient(120deg, #E6FFFA 0%, #D3F8F2 55%, #C4F3EC 100%); border-bottom: 1px solid #CDEBE6; padding: 22px 32px 20px; align-items: flex-start; gap: 16px; }
    #hpVer .ui-dh .ev-module-icon { width: 58px !important; height: 58px !important; border-radius: 18px; font-size: 26px; box-shadow: 0 10px 24px -10px rgba(14,143,134,.7); background: var(--ev-ink); color: var(--ev-aqua); }
    #hpVer .ui-dh h2 { font-size: 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
    #hpVer .ui-dh h2 .hp-est { font-size: 11.5px; padding: 5px 12px; box-shadow: 0 2px 6px rgba(11,18,21,.08); }
    .hp-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .hp-chips span { display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,.75); border: 1px solid rgba(14,143,134,.2); border-radius: 99px; padding: 4px 11px; font-size: 12.5px; font-weight: 700; color: #20413D; }
    .hp-chips i { color: var(--ev-deep); }
    #hpVer .ui-dh .x { background: #fff; }
    #hpVer .ui-db { padding: 22px 32px 34px; }

    /* Avisos */
    #hpVer .hp-aviso { align-items: flex-start; border: 1px solid transparent; border-radius: 16px; padding: 13px 16px; box-shadow: 0 1px 2px rgba(11,18,21,.04); }
    #hpVer .hp-aviso > i { font-size: 18px; margin-top: 1px; }
    #hpVer .hp-aviso.rojo { border-color: #FDA29B; } #hpVer .hp-aviso.ama { border-color: #FDE68A; } #hpVer .hp-aviso.azul { border-color: #C7D2FE; } #hpVer .hp-aviso.verde { border-color: #ABEFC6; }

    /* Línea de tiempo: 4 pasos con su punto */
    #hpVer .hp-linea { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; margin: 0 0 22px; background: #fff; border: 1px solid var(--ev-line); border-radius: 20px; padding: 16px 8px 14px; box-shadow: var(--ev-shadow); position: relative; }
    #hpVer .hp-linea div { border: 0; padding: 28px 14px 0; position: relative; min-width: 0; font-size: 12px; line-height: 1.35; color: var(--ev-muted); }
    #hpVer .hp-linea div::before { content: ""; position: absolute; top: 2px; left: 14px; width: 16px; height: 16px; border-radius: 50%; background: #fff; border: 3px solid #D3E3E0; z-index: 1; }
    #hpVer .hp-linea div::after { content: ""; position: absolute; top: 8px; left: 30px; right: -14px; height: 3px; background: #E2EFED; }
    #hpVer .hp-linea div:last-child::after { display: none; }
    #hpVer .hp-linea div.ok { color: var(--ev-text); }
    #hpVer .hp-linea div.ok::before { background: var(--ev-teal); border-color: #fff; box-shadow: 0 0 0 3px rgba(43,212,196,.35); }
    #hpVer .hp-linea div.ok::after { background: linear-gradient(90deg, var(--ev-teal), #CFF5F0); }
    #hpVer .hp-linea b { font-size: 13px; color: var(--ev-text); margin-bottom: 1px; }

    /* Columnas y secciones como tarjetas */
    #hpVer .hp-det { grid-template-columns: minmax(0, 1fr) 420px; gap: 24px; }
    #hpVer.max { width: calc(100vw - 8px) !important; } #hpVer.max .hp-det { grid-template-columns: minmax(0, 1fr) 520px; }
    #hpVer .sg-hilo-det { height: 640px; }
    #hpVer .hp-det > div:last-child { position: sticky; top: 0; display: grid; gap: 14px; align-content: start; }
    #hpVer .hp-sec { margin: 22px 0 10px; font-size: 15.5px; letter-spacing: -.2px; }
    #hpVer .hp-sec > i { width: 30px; height: 30px; border-radius: 10px; display: grid; place-items: center; background: var(--ev-ink); color: var(--ev-aqua); font-size: 14px; }
    #hpVer .hp-sec[style*="margin-top:0"] { margin-top: 0 !important; }

    /* Tabla de productos */
    #hpVer .ui-table-wrap { background: #fff; border: 1px solid var(--ev-line); border-radius: 18px; overflow: hidden; box-shadow: var(--ev-shadow); }
    #hpVer .ui-table thead th { background: #EEF8F6; color: #3C5B57; font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase; padding: 11px 14px; }
    #hpVer .ui-table tbody td { padding: 13px 14px; border-top: 1px solid #EDF4F3; font-size: 13.5px; }
    #hpVer .ui-table tbody tr:hover td { background: #F5FCFB; }
    #hpVer .ui-table tbody td:first-child { color: var(--ev-muted); font-weight: 800; width: 44px; }
    #hpVer .ui-table td.num { font-weight: 800; white-space: nowrap; }

    /* Conversación */
    #hpVer .hp-chat { background: #fff; border: 1px solid var(--ev-line); border-radius: 20px; padding: 16px; gap: 12px; box-shadow: var(--ev-shadow); min-height: 96px; }
    #hpVer .hp-msg { box-shadow: 0 2px 8px -4px rgba(11,18,21,.25); }
    #hpVer .hp-msg.EUROVIP { background: linear-gradient(135deg, #0B1215, #1B262B); }
    #hpVer .hp-escribir { background: #fff; border: 1px solid var(--ev-line); border-radius: 18px; padding: 10px; box-shadow: var(--ev-shadow); align-items: stretch; }
    #hpVer .hp-escribir textarea { border: 0; background: #F5FBFA; border-radius: 12px; resize: vertical; }
    #hpVer .hp-escribir .ev-btn { align-self: flex-end; min-height: 44px; }
    #hpVer details > summary { outline: none; }

    /* Flyer */
    #hpVer .hp-flyer { background: #fff; border-radius: 22px; box-shadow: var(--ev-shadow); padding: 12px 12px 4px; }
    #hpVer .hp-flyer .tit { display: flex; align-items: center; gap: 8px; font-weight: 800; font-size: 14px; padding: 2px 4px 10px; }
    #hpVer .hp-flyer .tit i { color: var(--ev-deep); }
    #hpVer .hp-flyer img { border-radius: 14px; box-shadow: 0 8px 24px -12px rgba(11,18,21,.45); background: #EEF8F6; min-height: 120px; }
    #hpVer .hp-flyer .acc { padding: 12px 0 8px; }
    #hpVer .hp-flyer .roto { display: grid; place-items: center; gap: 6px; text-align: center; padding: 26px 14px; border-radius: 14px; background: #F5FBFA; border: 1.5px dashed #BFE0DB; color: var(--ev-muted); font-weight: 700; font-size: 13px; }
    #hpVer .hp-flyer .roto i { font-size: 30px; color: var(--ev-deep); }

    /* Acciones de revisión */
    #hpVer .hp-sug { border-radius: 16px; }
    #hpVer .hp-accion { border-radius: 18px; box-shadow: var(--ev-shadow); border: 1px solid var(--ev-line); transition: box-shadow .2s, transform .2s; }
    #hpVer .hp-accion:hover { box-shadow: 0 14px 30px -14px rgba(14,143,134,.4); }
    #hpVer .hp-accion > summary { padding: 14px 16px; font-size: 14.5px; }
    #hpVer .hp-accion > summary i:first-child { width: 38px; height: 38px; border-radius: 12px; font-size: 18px; flex: none; }
    #hpVer .hp-accion.verde { border-color: #A6E9C2; }
    #hpVer .hp-accion.verde[open] { background: linear-gradient(180deg, #F3FFF8, #fff); }
    #hpVer .hp-accion .cuerpo .ev-btn { min-height: 46px; font-size: 14.5px; border-radius: 14px; }
    #hpVer .hp-accion.verde .cuerpo .ev-btn { background: linear-gradient(135deg, #0B1215, #1B262B); color: #fff; box-shadow: 0 10px 22px -10px rgba(11,18,21,.6); }
    #hpVer pre { border-radius: 14px; }

    /* Solicitudes de datos de los proveedores (20/11/2026) */
    .hp-sol { margin: 0 0 18px; background: #fff; border: 1px solid var(--ev-line); border-radius: 20px; box-shadow: var(--ev-shadow); overflow: hidden; }
    .hp-sol > summary { list-style: none; display: flex; align-items: center; gap: 12px; padding: 14px 18px; cursor: pointer; font-weight: 800; }
    .hp-sol > summary::-webkit-details-marker { display: none; }
    .hp-sol > summary .ico { width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; background: var(--ev-ink); color: var(--ev-aqua); font-size: 18px; }
    .hp-sol > summary small { display: block; font-weight: 600; color: var(--ev-muted); }
    .hp-sol > summary .n { margin-left: auto; min-width: 28px; height: 28px; padding: 0 9px; border-radius: 99px; display: grid; place-items: center; background: #F79009; color: #fff; font-size: 13px; }
    .hp-sol > summary .n.cero { background: #12B76A; }
    .hp-sol-lista { display: grid; gap: 10px; padding: 0 18px 18px; }
    .hp-sol-fila { display: grid; grid-template-columns: auto minmax(0,1fr) auto; gap: 12px; align-items: center; padding: 12px 14px; border-radius: 16px; background: #F5FBFA; border: 1px solid #DCEFEC; }
    .hp-sol-fila.APROBADA { background: #F3FFF8; border-color: #ABEFC6; } .hp-sol-fila.RECHAZADA { background: #FEF3F2; border-color: #FDA29B; }
    .hp-sol-fila .ico { width: 40px; height: 40px; border-radius: 13px; display: grid; place-items: center; background: #fff; color: var(--ev-deep); font-size: 19px; }
    .hp-sol-fila b { display: block; } .hp-sol-fila small { color: var(--ev-muted); }
    .hp-sol-fila .acc { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
    .hp-sol-datos { margin-top: 4px; font-size: 12.5px; color: #3C5B57; }
    @@media (max-width: 700px) { .hp-sol-fila { grid-template-columns: auto minmax(0,1fr); } .hp-sol-fila .acc { grid-column: 1 / -1; justify-content: flex-start; } }
    @@media (max-width: 1100px) { #hpVer.max .hp-det, #hpVer .hp-det { grid-template-columns: 1fr; } #hpVer .hp-det > div:last-child { position: static; } }
    @@media (max-width: 640px) {
        #hpVer .ui-dh { padding: 18px 16px 16px; } #hpVer .ui-db { padding: 16px 14px 28px; }
        #hpVer .hp-linea { grid-template-columns: 1fr 1fr; row-gap: 14px; } #hpVer .hp-linea div::after { display: none; }
        #hpVer .ui-dh h2 { font-size: 20px; }
    }

    /* =====================================================================================================================
       20/11/2026 · Centro de cargas: pestañas, Hoy, tablero, mensajes tipo WhatsApp, proveedores. Prefijo sg-.
       ===================================================================================================================== */
    .sg-tabs { display: flex; gap: 6px; flex-wrap: wrap; padding: 6px; margin: 0 0 16px; background: #fff; border: 1px solid var(--ev-line); border-radius: 20px; box-shadow: var(--ev-shadow); position: sticky; top: 8px; z-index: 20; }
    .sg-tabs button { display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border: 0; border-radius: 14px; background: transparent; font: inherit; font-weight: 800; font-size: 14px; color: var(--ev-muted); cursor: pointer; transition: all .15s; }
    .sg-tabs button:hover { background: #F0FAF8; color: var(--ev-text); }
    .sg-tabs button.on { background: var(--ev-ink); color: #fff; box-shadow: 0 10px 20px -12px rgba(11,18,21,.8); }
    .sg-tabs button.on i { color: var(--ev-aqua); }
    .sg-n { min-width: 22px; height: 22px; padding: 0 7px; border-radius: 99px; display: inline-grid; place-items: center; background: #F04438; color: #fff; font-size: 12px; }
    .sg-sec { display: none; } .sg-sec.on { display: block; animation: sgEntra .3s ease both; }
    @@keyframes sgEntra { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
    .sg-vacio { padding: 26px 14px; text-align: center; color: var(--ev-muted); font-weight: 600; font-size: 13.5px; border: 2px dashed var(--ev-line); border-radius: 16px; }
    .sg-av { --h: 180; width: 40px; height: 40px; border-radius: 50%; flex: none; display: grid; place-items: center; font-weight: 800; font-size: 14px; color: hsl(var(--h) 55% 22%); background: hsl(var(--h) 70% 88%); border: 2px solid #fff; box-shadow: 0 2px 8px -3px rgba(11,18,21,.35); }
    .sg-av.g { width: 54px; height: 54px; font-size: 18px; }

    /* ---------- Hoy ---------- */
    .sg-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 16px; }
    .sg-kpi { text-align: left; border: 1px solid var(--ev-line); border-radius: 20px; padding: 14px 16px; background: #fff; box-shadow: var(--ev-shadow); position: relative; overflow: hidden; font: inherit; color: inherit; }
    button.sg-kpi { cursor: pointer; transition: transform .15s; } button.sg-kpi:hover { transform: translateY(-3px); }
    .sg-kpi i { position: absolute; right: 12px; top: 10px; font-size: 26px; opacity: .18; }
    .sg-kpi b { display: block; font-size: 30px; font-weight: 800; letter-spacing: -1px; line-height: 1.1; }
    .sg-kpi small { color: var(--ev-muted); font-weight: 700; font-size: 12.5px; }
    .sg-kpi.rojo { background: linear-gradient(135deg, #FEF3F2, #fff); border-color: #FDA29B; } .sg-kpi.rojo b { color: #B42318; }
    .sg-kpi.ama { background: linear-gradient(135deg, #FFFAEB, #fff); border-color: #FEDF89; } .sg-kpi.ama b { color: #B54708; }
    .sg-kpi.verde { background: linear-gradient(135deg, #ECFDF3, #fff); border-color: #ABEFC6; } .sg-kpi.verde b { color: #067647; }
    .sg-kpi.azul { background: linear-gradient(135deg, #EFF8FF, #fff); border-color: #B2DDFF; } .sg-kpi.azul b { color: #175CD3; }
    .sg-hoy { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .sg-panel { background: #fff; border: 1px solid var(--ev-line); border-radius: 22px; padding: 16px 18px; box-shadow: var(--ev-shadow); min-width: 0; }
    .sg-panel > h3 { margin: 0 0 10px; font-size: 15.5px; font-weight: 800; display: flex; align-items: center; gap: 8px; }
    .sg-panel > h3 i { width: 30px; height: 30px; border-radius: 10px; display: grid; place-items: center; background: var(--ev-ink); color: var(--ev-aqua); font-size: 14px; }
    .sg-panel.ancho { grid-column: 1 / -1; }
    .sg-fila { display: flex; align-items: center; gap: 12px; width: 100%; text-align: left; padding: 10px 8px; border: 0; background: transparent; border-radius: 14px; font: inherit; color: inherit; cursor: pointer; }
    .sg-fila:hover { background: #F0FAF8; }
    .sg-fila > div { flex: 1; min-width: 0; display: grid; }
    .sg-fila b { font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .sg-fila small { color: var(--ev-muted); font-size: 12.5px; }
    .sg-fila .cuando { font-size: 12px; font-weight: 800; color: #B54708; background: #FEF0C7; padding: 3px 10px; border-radius: 99px; white-space: nowrap; }
    .sg-fila .cuando.v { color: #5925DC; background: #F4EBFF; } .sg-fila .cuando.g { color: #067647; background: #DCFCE7; }
    .sg-mov { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; max-height: 460px; overflow: auto; }
    .sg-mov li { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 12px; align-items: flex-start; padding: 10px 6px; border-bottom: 1px dashed var(--ev-line); cursor: pointer; }
    .sg-mov li:hover { background: #F7FCFB; }
    .sg-mov .pt { width: 34px; height: 34px; border-radius: 12px; display: grid; place-items: center; font-size: 15px; background: #EEF2F6; color: #475467; }
    .sg-mov .pt.ok { background: #DCFCE7; color: #067647; } .sg-mov .pt.mal { background: #FEE4E2; color: #B42318; } .sg-mov .pt.az { background: #E0EAFF; color: #3538CD; } .sg-mov .pt.ama { background: #FEF0C7; color: #B54708; } .sg-mov .pt.vio { background: #F4EBFF; color: #6941C6; }
    .sg-mov b { font-size: 13.5px; } .sg-mov span { display: block; color: var(--ev-muted); font-size: 12.5px; overflow-wrap: anywhere; }
    .sg-mov time { font-size: 12px; font-weight: 700; color: var(--ev-muted); white-space: nowrap; text-align: right; }

    /* ---------- Tablero ---------- */
    .sg-barra { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 14px; }
    .sg-barra .ui-input { width: auto; min-width: 170px; }
    .sg-barra .q { flex: 1; min-width: 220px; }
    .sg-check { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13.5px; padding: 8px 14px; border: 1.5px solid var(--ev-line); border-radius: 14px; background: #fff; cursor: pointer; }
    .sg-check input { accent-color: #0E8F86; }
    .sg-kan { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(280px, 1fr); gap: 14px; overflow-x: auto; padding-bottom: 12px; scroll-snap-type: x proximity; align-items: start; }
    .sg-col { background: #EAF5F3; border-radius: 22px; padding: 10px; scroll-snap-align: start; min-width: 0; }
    .sg-col-cab { display: flex; align-items: center; gap: 10px; padding: 6px 8px 10px; }
    .sg-col-cab .ic { width: 34px; height: 34px; border-radius: 11px; display: grid; place-items: center; background: #fff; color: var(--c, #0E8F86); font-size: 16px; }
    .sg-col-cab b { flex: 1; font-size: 14.5px; } .sg-col-cab b small { display: block; font-weight: 600; font-size: 11.5px; color: var(--ev-muted); }
    .sg-col-cab .n { min-width: 28px; height: 28px; padding: 0 9px; border-radius: 99px; display: grid; place-items: center; background: var(--c, #0E8F86); color: #fff; font-size: 13px; font-weight: 800; }
    .sg-col-cuerpo { display: grid; gap: 10px; max-height: 70vh; overflow: auto; padding: 2px; }
    .sg-card { text-align: left; border: 1px solid var(--ev-line); border-left: 5px solid var(--c, #0E8F86); border-radius: 18px; background: #fff; padding: 12px 14px; display: grid; gap: 8px; cursor: pointer; font: inherit; color: inherit; box-shadow: 0 1px 2px rgba(11,18,21,.05); transition: transform .15s, box-shadow .15s; animation: sgEntra .35s ease both; }
    .sg-card:hover { transform: translateY(-3px); box-shadow: 0 16px 28px -18px var(--c, #0E8F86); }
    .sg-card.u1 { border-color: #FEDF89; border-left-color: #F79009; } .sg-card.u2 { border-color: #FDA29B; border-left-color: #F04438; background: #FFFBFA; }
    .sg-card-top { display: flex; gap: 10px; align-items: center; }
    .sg-card-top > div { min-width: 0; display: grid; flex: 1; }
    .sg-card-top b { font-size: 13.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .sg-card-top small { color: var(--ev-muted); font-size: 12px; }
    .sg-card .av { width: 34px; height: 34px; font-size: 12px; }
    .sg-card-pies { display: flex; flex-wrap: wrap; gap: 6px; }
