    .sg-prov-pie { display: flex; gap: 8px; flex-wrap: wrap; }

    /* Seguimiento dentro de la carga */
    .sg-seg { background: #fff; border: 1px solid var(--ev-line); border-radius: 18px; padding: 12px 14px; display: grid; gap: 10px; box-shadow: var(--ev-shadow); }
    .sg-seg h4 { margin: 0; font-size: 14px; font-weight: 800; display: flex; gap: 8px; align-items: center; }
    .sg-seg label { font-size: 12px; font-weight: 800; color: var(--ev-muted); display: block; margin-bottom: 4px; }
    .sg-prio { display: flex; gap: 6px; } .sg-prio button { flex: 1; border: 1.5px solid var(--ev-line); background: #fff; border-radius: 12px; padding: 7px 6px; font: inherit; font-weight: 800; font-size: 12.5px; cursor: pointer; }
    .sg-prio button.on[data-p="0"] { background: #EEF2F6; border-color: #98A2B3; } .sg-prio button.on[data-p="1"] { background: #FEF0C7; border-color: #F79009; color: #B54708; } .sg-prio button.on[data-p="2"] { background: #FEE4E2; border-color: #F04438; color: #B42318; }
    .sg-hilo-det { height: 560px; border: 1px solid var(--ev-line); border-radius: 20px; overflow: hidden; box-shadow: var(--ev-shadow); }

    /* Control de calidad de la carga */
    .sg-cal { border-radius: 18px; padding: 12px 14px; border: 1.5px solid var(--ev-line); background: #fff; box-shadow: var(--ev-shadow); display: grid; gap: 8px; }
    .sg-cal.verde { background: linear-gradient(135deg, #ECFDF3, #fff); border-color: #ABEFC6; } .sg-cal.ama { background: linear-gradient(135deg, #FFFAEB, #fff); border-color: #FEDF89; } .sg-cal.rojo { background: linear-gradient(135deg, #FEF3F2, #fff); border-color: #FDA29B; }
    .sg-cal-cab { display: flex; gap: 12px; align-items: center; } .sg-cal-cab > i { font-size: 30px; } .sg-cal.verde .sg-cal-cab > i { color: #12B76A; } .sg-cal.ama .sg-cal-cab > i { color: #F79009; } .sg-cal.rojo .sg-cal-cab > i { color: #F04438; }
