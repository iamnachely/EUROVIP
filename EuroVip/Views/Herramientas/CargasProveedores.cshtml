    .sg-cuidar .sg-fila { cursor: default; } .sg-cuidar .pt { width: 34px; height: 34px; border-radius: 12px; display: grid; place-items: center; flex: none; }
    .sg-cuidar .pt.rojo { background: #FEE4E2; color: #B42318; } .sg-cuidar .pt.ama { background: #FEF0C7; color: #B54708; } .sg-cuidar .pt.info { background: #E0EAFF; color: #3538CD; }
    .sg-nav { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 800; color: var(--ev-muted); }
    .sg-pal { position: fixed; inset: 0; z-index: 2000; background: rgba(11,18,21,.5); backdrop-filter: blur(4px); display: flex; justify-content: center; align-items: flex-start; padding-top: 12vh; }
    .sg-pal[hidden] { display: none; }
    .sg-pal-caja { width: min(640px, calc(100vw - 24px)); background: #fff; border-radius: 22px; box-shadow: 0 40px 90px -20px rgba(11,18,21,.7); overflow: hidden; }
