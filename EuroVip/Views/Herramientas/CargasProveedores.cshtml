    .sg-dock { position: fixed; right: 22px; bottom: 96px; z-index: 901; width: min(400px, calc(100vw - 24px)); height: min(620px, calc(100vh - 120px)); background: #fff; border-radius: 24px; border: 1px solid var(--ev-line); box-shadow: 0 30px 70px -20px rgba(11,18,21,.6); display: none; flex-direction: column; overflow: hidden; }
