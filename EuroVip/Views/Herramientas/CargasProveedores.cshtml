@section Scripts {
<script src="~/js/eurovip-ui.js" asp-append-version="true"></script>
<script>
(() => {
    const $ = s => document.querySelector(s), esc = EV.esc;
    const EST = {
        PENDIENTE: ['Por revisar', 'bi-hourglass-split'], PROGRAMADA: ['Programadas', 'bi-calendar-check'], DEVUELTA: ['Devueltas', 'bi-arrow-return-left'],
        RECHAZADA: ['Rechazadas', 'bi-x-octagon'], ACTIVA: ['En la web', 'bi-globe2'], BORRADOR: ['Borradores', 'bi-pencil'], '': ['Todas', 'bi-collection']
    };
    const UNO = { PENDIENTE: 'Por revisar', PROGRAMADA: 'Programada', DEVUELTA: 'Devuelta', RECHAZADA: 'Rechazada', ACTIVA: 'En la web', BORRADOR: 'Borrador' };
    const TABLAS = { SERVICIO: 'Oferta / salida', EXCURSION: 'Excursión', TRASLADO: 'Traslado', CRUCERO: 'Crucero' };
    // Las fechas del BackEurovip ya son hora de República Dominicana (sin zona): se muestran tal cual
    const fh = d => d ? new Date(d).toLocaleString('es-ES', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—';
    const local = d => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}T${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
    const params = new URLSearchParams(location.search);
    let modulos = {}, conteo = {}, filtro = 'PENDIENTE', pagina = 1, total = 0, items = [], actual = null;

    const resumen = EV.api('/Herramientas/ProveedoresResumen').then(r => {
        modulos = Object.fromEntries(r.modulos.map(m => [m.clave, m]));
        $('#hpModulo').insertAdjacentHTML('beforeend', r.modulos.map(m => `<option value="${esc(m.clave)}">${esc(m.nombre)}</option>`).join(''));
        pintarConteo(r.conteo);
        const pr = $('#hpProgramador');
        pr.hidden = r.publicaProgramadas;
        pr.innerHTML = '<i class="bi bi-info-circle"></i><span>En esta copia el <b>alta programada está apagada</b> (Eurovip:Proveedores:Publicar): las programadas se activan solas solo en el servidor. Aquí puedes activarlas a mano.</span>';
        return r;
    }).catch(() => ({ modulos: [] }));
    EV.api('/Herramientas/ProveedoresCuentas').then(r => {
        $('#hpCuenta').insertAdjacentHTML('beforeend', r.cuentas.map(x => `<option value="${x.id}">${esc(x.nombre)}</option>`).join(''));
    }).catch(() => {});

    function pintarConteo(c) {
        conteo = c || {};
        const todas = Object.values(conteo).reduce((s, x) => s + x, 0);
        $('#hpKpis').innerHTML = ['PENDIENTE', 'PROGRAMADA', 'DEVUELTA', 'RECHAZADA', 'ACTIVA', 'BORRADOR', ''].map(e =>
            `<button type="button" class="hp-kpi ${filtro === e ? 'on' : ''}" data-est="${e}"><b>${EV.fmt(e ? conteo[e] || 0 : todas)}</b><small><i class="bi ${EST[e][1]}"></i> ${EST[e][0]}</small></button>`).join('');
    }
    $('#hpKpis').addEventListener('click', e => { const b = e.target.closest('[data-est]'); if (!b) return; filtro = b.dataset.est; pintarConteo(conteo); listar(true); });

    async function listar(reset) {
        if (reset) { pagina = 1; items = []; }
        const q = new URLSearchParams({ estado: filtro, modulo: $('#hpModulo').value, cuenta: $('#hpCuenta').value, q: $('#hpQ').value.trim(), pagina, tam: 24 });
        try {
            const r = await EV.api('/Herramientas/ProveedoresCargas?' + q);
            items = items.concat(r.items); total = r.total;
            pintarConteo(r.conteo); pintarLista();
        } catch (er) { $('#hpLista').innerHTML = `<div class="ui-empty" style="grid-column:1/-1"><h3>No se pudo cargar</h3><p>${esc(er.message)}</p></div>`; }
    }
    const fechaDe = c => c.estado === 'PENDIENTE' ? `Enviada ${fh(c.fecha_Solicitud)}` : c.estado === 'PROGRAMADA' ? `Sale ${fh(c.activar_En)}`
        : c.estado === 'ACTIVA' ? `En la web ${fh(c.fecha_Activacion)}` : c.estado === 'RECHAZADA' || c.estado === 'DEVUELTA' ? `Revisada ${fh(c.fecha_Revision)}` : `Creada ${fh(c.creado_En)}`;

    function pintarLista() {
        if (!items.length) {
            $('#hpLista').innerHTML = `<div class="ui-empty" style="grid-column:1/-1"><i class="bi bi-inbox big"></i><h3>${filtro === 'PENDIENTE' ? '¡Nada por revisar!' : 'No hay cargas'}</h3>
                <p>${filtro === 'PENDIENTE' ? 'Cuando un proveedor envíe una carga a revisión aparecerá aquí y te avisará la campana.' : 'Prueba con otro filtro.'}</p></div>`;
        } else {
            $('#hpLista').innerHTML = items.map((c, k) => {
                const m = modulos[c.modulo] || { nombre: c.modulo, icono: 'bi-box' };
                return `<button type="button" class="hp-card" data-id="${c.id}" style="animation-delay:${Math.min(k, 12) * 35}ms">
                    <span class="fl" style="${c.flyer ? `background-image:url('${esc(c.flyer)}')` : ''}">${c.flyer ? '' : `<i class="bi ${esc(m.icono)}"></i>`}</span>
                    <div style="min-width:0;padding-right:74px">
                        <h4>${esc(c.codigo)}${c.titulo ? ' · ' + esc(c.titulo) : ''}</h4>
                        <div class="sub"><i class="bi ${esc(m.icono)}"></i> ${esc(m.nombre)} · ${esc(c.cuenta || '')}</div>
                        <div class="meta"><span>${EV.fmt(c.productos)} producto${c.productos === 1 ? '' : 's'}</span>${c.precio_Desde ? `<span>desde ${EV.dinero(c.precio_Desde, c.moneda)}</span>` : ''}<span>${fechaDe(c)}</span>
                            ${c.activar_Sugerido && c.estado === 'PENDIENTE' ? `<span title="Fecha que sugiere el proveedor"><i class="bi bi-calendar-heart"></i> sugiere ${fh(c.activar_Sugerido)}</span>` : ''}</div>
                        ${c.error ? `<div class="err"><i class="bi bi-exclamation-octagon"></i> ${esc(c.error.length > 120 ? c.error.slice(0, 120) + '…' : c.error)}</div>` : ''}
                    </div>
                    <span class="hp-est ${esc(c.estado)}">${UNO[c.estado] || esc(c.estado)}</span></button>`;
            }).join('');
        }
        $('#hpMas').hidden = items.length >= total;
    }
    $('#hpLista').addEventListener('click', e => { const b = e.target.closest('[data-id]'); if (b) abrir(+b.dataset.id); });
    $('#hpMas').addEventListener('click', () => { pagina++; listar(false); });
    $('#hpQ').addEventListener('input', EV.debounce(() => listar(true), 300));
    $('#hpModulo').addEventListener('change', () => listar(true));
    $('#hpCuenta').addEventListener('change', () => listar(true));
    $('#hpRecargar').addEventListener('click', () => listar(true));

    // ---------------- detalle ----------------
    const visor = EV.drawer($('#hpVer'));
    $('#hpVerCerrar').addEventListener('click', () => visor.cerrar());
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && visor.abierto()) visor.cerrar(); });

    async function abrir(id) {
        try { actual = await EV.api('/Herramientas/ProveedorCarga?id=' + id); }
        catch (er) { EV.toast(er.message, 'err'); return; }
        pintarDetalle(); visor.abrir();
        const u = new URL(location.href); u.searchParams.set('carga', id); history.replaceState(null, '', u);
    }

    function chat(lista) {
        return lista.length ? lista.map(x => `<div class="hp-msg ${esc(x.autor)}"><small>${x.autor === 'EUROVIP' ? 'Eurovip · ' : ''}${esc(x.nombre)} · ${fh(x.fecha)}</small>${esc(x.texto)}</div>`).join('')
            : '<p style="color:var(--ev-muted);font-weight:600;font-size:13px;margin:0">Todavía no hay mensajes. Escribe al proveedor si necesitas algo: lo verá en su carga.</p>';
    }

    function pintarDetalle() {
        const { carga: c, productos, items: pub, datos, comentarios = [] } = actual;
        const m = modulos[c.modulo] || { nombre: c.modulo, icono: 'bi-box' };
        $('#hpVerIco').className = 'bi ' + m.icono;
        $('#hpVerTitulo').innerHTML = `Carga ${esc(c.codigo)} <span class="hp-est ${esc(c.estado)}" style="vertical-align:middle">${UNO[c.estado] || esc(c.estado)}</span>`;
        $('#hpVerSub').innerHTML = `<div class="hp-chips"><span><i class="bi ${esc(m.icono)}"></i> ${esc(m.nombre)}</span><span><i class="bi bi-person-badge"></i> ${esc(c.cuenta || '')}</span>${c.email ? `<span><i class="bi bi-envelope"></i> ${esc(c.email)}</span>` : ''}${(c.proveedor || c.id_Proveedor) ? `<span><i class="bi bi-building"></i> Proveedor ${esc(c.proveedor || c.id_Proveedor)}</span>` : ''}${c.titulo ? `<span><i class="bi bi-tag"></i> ${esc(c.titulo)}</span>` : ''}</div>`;
        const avisos = [];
        if (c.error) avisos.push(`<div class="hp-aviso rojo"><i class="bi bi-exclamation-octagon"></i><span><b>No se pudo publicar:</b> ${esc(c.error)}</span></div>`);
        if (c.estado === 'RECHAZADA') avisos.push(`<div class="hp-aviso ama"><i class="bi bi-x-octagon"></i><span><b>Rechazada</b> por ${esc(c.revisado_Por || '')} el ${fh(c.fecha_Revision)}. <b>Motivo:</b> ${esc(c.motivo || '')}${c.instrucciones ? ` · <b>Qué hacer:</b> ${esc(c.instrucciones)}` : ''}</span></div>`);
        if (c.estado === 'DEVUELTA') avisos.push(`<div class="hp-aviso ama"><i class="bi bi-arrow-return-left"></i><span><b>Devuelta al proveedor</b> por ${esc(c.revisado_Por || '')} el ${fh(c.fecha_Revision)}: ${esc(c.instrucciones || '')}</span></div>`);
        if (c.estado === 'PROGRAMADA') avisos.push(`<div class="hp-aviso azul"><i class="bi bi-calendar-check"></i><span>Se activa sola en la web el <b>${fh(c.activar_En)}</b> (hora de República Dominicana). Programada por ${esc(c.revisado_Por || '')}.</span></div>`);
        if (c.estado === 'ACTIVA') avisos.push(`<div class="hp-aviso verde"><i class="bi bi-globe2"></i><span>En la web desde el <b>${fh(c.fecha_Activacion)}</b>. Revisó: ${esc(c.revisado_Por || '')}.</span></div>`);
        const paso = (ok, t, d) => `<div class="${ok ? 'ok' : ''}"><b>${t}</b>${d}</div>`;
        const linea = `<div class="hp-linea">${paso(true, 'Creada', fh(c.creado_En))}${paso(!!c.fecha_Solicitud, 'Enviada a revisión', fh(c.fecha_Solicitud))}${paso(!!c.fecha_Revision, 'Revisada', c.fecha_Revision ? `${fh(c.fecha_Revision)} · ${esc(c.revisado_Por || '')}` : '—')}${paso(!!c.fecha_Activacion, 'En la web', fh(c.fecha_Activacion))}</div>`;
        const tablaProd = productos.length ? `<div class="ui-table-wrap"><table class="ui-table"><thead><tr><th>#</th><th>Producto</th><th>Destino</th><th>Detalle</th><th class="num">Desde</th></tr></thead><tbody>${
            productos.map(p => `<tr><td>${p.indice}</td><td><b>${esc(p.nombre)}</b></td><td>${esc(p.destino || '—')}</td><td>${esc(p.detalle || '')}</td><td class="num">${p.precio != null ? EV.dinero(p.precio, p.moneda) : '—'}</td></tr>`).join('')
        }</tbody></table></div>` : '<div class="ui-empty"><p>La carga no tiene productos que se puedan leer.</p></div>';
        const tablaPub = pub.length ? `<div class="hp-sec"><i class="bi bi-globe2"></i> Publicado en la web (${pub.length})</div><div class="ui-table-wrap"><table class="ui-table"><thead><tr><th>Tipo</th><th>N.º</th><th>Nombre</th><th class="num">Precio</th><th>A la venta</th></tr></thead><tbody>${
            pub.map(x => `<tr><td>${TABLAS[x.tabla] || esc(x.tabla)}</td><td>${x.id_Registro}</td><td>${esc(x.nombre || '')}</td><td class="num">${x.precio != null ? EV.dinero(x.precio, x.moneda) : '—'}</td><td>${x.activo === true ? '<i class="bi bi-check-circle-fill" style="color:#16A34A"></i> Sí' : x.activo === false ? 'Desactivado' : 'Ya no existe'}</td></tr>`).join('')
        }</tbody></table></div>` : '';
        const flyer = c.flyer ? `<div class="hp-flyer"><div class="tit"><i class="bi bi-image"></i> Flyer de la carga</div><a href="${esc(c.flyer)}" target="_blank" rel="noopener"><img src="${esc(c.flyer)}?v=${encodeURIComponent(c.actualizado_En || '')}" alt="" data-flyer-img></a>
            <div class="acc"><a class="ev-btn ghost sm" href="${esc(c.flyer)}" target="_blank" rel="noopener"><i class="bi bi-arrows-fullscreen"></i> Verlo grande</a><a class="ev-btn ghost sm" href="${esc(c.flyer)}" download><i class="bi bi-download"></i> Descargar</a><button type="button" class="ev-btn ghost sm" data-acc="flyer"><i class="bi bi-arrow-repeat"></i> Regenerar</button></div>
            ${c.flyer_Datos ? '<div style="padding:0 10px 10px;font-size:12px;font-weight:700;color:var(--ev-muted)"><i class="bi bi-pencil"></i> El proveedor editó este flyer.</div>' : ''}</div>`
            : `<div class="ui-empty"><i class="bi bi-image big"></i><p>${c.estado === 'BORRADOR' ? 'El flyer se genera cuando el proveedor envía la carga a revisión.' : 'Sin flyer.'}</p>${c.estado !== 'BORRADOR' ? '<button type="button" class="ev-btn ghost sm" data-acc="flyer"><i class="bi bi-magic"></i> Generar flyer</button>' : ''}</div>`;

        const revisar = c.estado === 'PENDIENTE' || c.estado === 'PROGRAMADA';
        const manana = new Date(Date.now() + 86400000); manana.setHours(9, 0, 0, 0);
        const sug = c.activar_Sugerido ? new Date(c.activar_Sugerido) : null;
        const sugFutura = sug && sug > new Date();
        const fechaIni = c.activar_En ? String(c.activar_En).slice(0, 16) : sugFutura ? local(sug) : local(manana);
        const sugerencia = sug ? `<div class="hp-sug"><i class="bi bi-calendar-heart"></i><span>El proveedor sugiere salir en la web el <b>${fh(c.activar_Sugerido)}</b>${sugFutura ? '' : ' <em>(esa fecha ya pasó)</em>'}.</span></div>` : '';
        const acciones = revisar ? `<div class="hp-sec"><i class="bi bi-clipboard-check"></i> Revisión</div>${sugerencia}<div class="hp-acciones">
            ${sugFutura && c.estado === 'PENDIENTE' ? `<details class="hp-accion verde" open><summary><i class="bi bi-hand-thumbs-up"></i><span>Aprobar con su fecha<small>Se activa sola el ${fh(c.activar_Sugerido)}</small></span></summary>
                <div class="cuerpo"><button type="button" class="ev-btn" data-acc="aprobar-sug" style="justify-content:center"><i class="bi bi-check2-circle"></i> Aprobar para el ${fh(c.activar_Sugerido)}</button></div></details>` : ''}
            <details class="hp-accion verde" ${sugFutura && c.estado === 'PENDIENTE' ? '' : 'open'}><summary><i class="bi bi-rocket-takeoff"></i><span>Aprobar y activar ya<small>Se crea en la web en este momento</small></span></summary>
                <div class="cuerpo"><button type="button" class="ev-btn" data-acc="aprobar" style="justify-content:center"><i class="bi bi-check2-circle"></i> Aprobar y activar ya</button></div></details>
            <details class="hp-accion azul"><summary><i class="bi bi-calendar-event"></i><span>Aprobar y programar<small>Elige la fecha y la hora en el calendario</small></span></summary>
                <div class="cuerpo"><div class="ui-f"><label for="hpFecha">Fecha y hora <em>República Dominicana</em></label><input class="ui-input" type="datetime-local" id="hpFecha" min="${local(new Date())}" value="${fechaIni}"></div>
                ${sug ? `<button type="button" class="ev-btn ghost sm" data-acc="usar-sug"><i class="bi bi-calendar-heart"></i> Usar la que sugiere</button>` : ''}
                <button type="button" class="ev-btn" data-acc="programar" style="justify-content:center"><i class="bi bi-calendar-check"></i> ${c.estado === 'PROGRAMADA' ? 'Cambiar la fecha' : 'Aprobar y programar'}</button></div></details>
            <details class="hp-accion rosa"><summary><i class="bi bi-arrow-return-left"></i><span>Devolver al proveedor<small>Para que cambie algo y la vuelva a enviar</small></span></summary>
                <div class="cuerpo"><div class="ui-f"><label for="hpDev">Qué tiene que cambiar *</label><textarea class="ui-input" id="hpDev" rows="3" maxlength="1000" placeholder="Ej.: sube el precio del traslado privado a 95 USD y agrega cuántas maletas incluye"></textarea></div>
                <button type="button" class="ev-btn ghost" data-acc="devolver" style="justify-content:center"><i class="bi bi-arrow-return-left"></i> Devolver</button></div></details>
            <details class="hp-accion rojo"><summary><i class="bi bi-x-octagon"></i><span>Rechazar<small>Hay un problema: con el motivo</small></span></summary>
                <div class="cuerpo"><div class="ui-f"><label for="hpMotivo">Motivo *</label><textarea class="ui-input" id="hpMotivo" rows="3" maxlength="1000" placeholder="Qué está mal (lo verá el proveedor)"></textarea></div>
                <div class="ui-f"><label for="hpInstr">Qué hacer <em>opcional</em></label><textarea class="ui-input" id="hpInstr" rows="2" maxlength="1000"></textarea></div>
                <button type="button" class="ev-btn red" data-acc="rechazar" style="justify-content:center"><i class="bi bi-x-lg"></i> Rechazar</button></div></details>
            </div>` : (c.estado === 'PROGRAMADA' ? '' : sugerencia);

        $('#hpVerCuerpo').innerHTML = `${avisos.join('')}${linea}
            <div class="hp-det">
                <div style="min-width:0">
                    <div class="hp-sec" style="margin-top:0"><i class="bi bi-box-seam"></i> Productos (${productos.length})</div>${tablaProd}${tablaPub}
                    <div class="hp-sec"><i class="bi bi-chat-left-text"></i> Conversación y notas internas</div>
                    <div class="sg-hilo-det" id="sgHiloDet"></div>
                    <details style="margin-top:16px"><summary style="cursor:pointer;font-weight:700;color:var(--ev-muted)">Ver los datos tal como los envió el proveedor (JSON)</summary>
                        <pre style="max-height:360px;overflow:auto;background:var(--ev-surface-2);border:1px solid var(--ev-line);border-radius:14px;padding:12px;font-size:12px">${esc(JSON.stringify(datos, null, 2))}</pre></details>
                </div>
                <div><div class="sg-seg" id="sgSegCarga"></div>${flyer}${acciones}</div>
            </div>`;
        montarHilo($('#sgHiloDet'), c.id, { cab: false, alCambiar: cargarChats }); seguimientoCarga(c);
        // Si la imagen del flyer no carga (archivo borrado o movido), un aviso claro en vez del texto suelto
        document.querySelectorAll('[data-flyer-img]').forEach(im => im.addEventListener('error', () => {
            const a = im.closest('a'); if (a) a.outerHTML = '<div class="roto"><i class="bi bi-image-alt"></i><span>No se pudo mostrar el flyer.<br>Pulsa «Regenerar» para crearlo de nuevo.</span></div>';
        }, { once: true }));
    }

    $('#hpVerCuerpo').addEventListener('click', async e => {
        const b = e.target.closest('[data-acc]'); if (!b || !actual) return;
        const c = actual.carga, acc = b.dataset.acc;
        try {
            if (acc === 'usar-sug') { $('#hpFecha').value = String(c.activar_Sugerido).slice(0, 16); return; }
            if (acc === 'comentar') {
                const texto = $('#hpTexto').value.trim();
                if (!texto) { $('#hpTexto').focus(); return; }
                const r = await EV.post('/Herramientas/ProveedorCargaComentar', { id: c.id, texto });
                actual.comentarios = r.comentarios; $('#hpChat').innerHTML = chat(r.comentarios); $('#hpChat').scrollTop = 1e9; $('#hpTexto').value = '';
                EV.toast(r.mensaje); return;
            }
            if (acc === 'aprobar') {
                if (!await EV.confirmar({ titulo: '¿Aprobar y activar ya?', si: 'Sí, activar', icono: 'rocket-takeoff',
                    texto: `Los ${c.productos} producto(s) de la carga <b>${esc(c.codigo)}</b> de <b>${esc(c.cuenta || '')}</b> se crean en la web en este momento.` })) return;
                const r = await EV.post('/Herramientas/ProveedorCargaAprobar', { id: c.id });
                EV.toast(r.mensaje); EV.confeti();
            } else if (acc === 'aprobar-sug' || acc === 'programar') {
                const f = acc === 'aprobar-sug' ? String(c.activar_Sugerido).slice(0, 16) : $('#hpFecha').value;
                if (!f) { EV.toast('Elige la fecha y la hora del alta.', 'err'); return; }
                const r = await EV.post('/Herramientas/ProveedorCargaProgramar', { id: c.id, fecha: f });
                EV.toast(r.mensaje);
            } else if (acc === 'devolver') {
                const instrucciones = $('#hpDev').value.trim();
                if (!instrucciones) { EV.toast('Escribe qué tiene que cambiar el proveedor.', 'err'); $('#hpDev').focus(); return; }
                const r = await EV.post('/Herramientas/ProveedorCargaDevolver', { id: c.id, instrucciones });
                EV.toast(r.mensaje);
            } else if (acc === 'rechazar') {
                const motivo = $('#hpMotivo').value.trim();
                if (!motivo) { EV.toast('Escribe el motivo del rechazo.', 'err'); $('#hpMotivo').focus(); return; }
                if (!await EV.confirmar({ titulo: '¿Rechazar la carga?', si: 'Sí, rechazar', peligro: true, icono: 'x-octagon',
                    texto: 'El proveedor verá el motivo y lo que tiene que hacer, y podrá corregirla y volver a enviarla.' })) return;
                const r = await EV.post('/Herramientas/ProveedorCargaRechazar', { id: c.id, motivo, instrucciones: $('#hpInstr').value.trim() });
                EV.toast(r.mensaje);
            } else if (acc === 'flyer') {
                const r = await EV.post('/Herramientas/ProveedorCargaFlyer', { id: c.id });
                EV.toast(r.mensaje);
            }
        } catch { /* EV.api ya mostró el aviso */ }
        try { actual = await EV.api('/Herramientas/ProveedorCarga?id=' + c.id); pintarDetalle(); } catch { }
        listar(true);
    });

    // ---------- Solicitudes de datos (hotel, destino, aeropuerto, habitación que el proveedor pidió crear) ----------
    const SOL = { hotel: ['bi-building', 'Hotel'], destino: ['bi-geo-alt', 'Destino'], aeropuerto: ['bi-airplane-engines', 'Aeropuerto'], habitacion: ['bi-door-open', 'Habitación'] };
    const SOL_EST = { PENDIENTE: 'Por revisar', APROBADA: 'Aprobada', RECHAZADA: 'Rechazada' };
    const SOL_CAT = { hotel: 'alojamientos', destino: 'destinos', aeropuerto: 'estaciones', habitacion: 'habitaciones' };
    async function solicitudes() {
        let r;
        try { r = await EV.api('/Herramientas/ProveedorSolicitudes'); } catch { return; }
        const pend = (r.conteo && r.conteo.PENDIENTE) || 0;
        const n = $('#hpSolN'); n.textContent = pend; n.classList.toggle('cero', pend === 0); const nb = $('#sgNSol'); nb.textContent = pend; nb.hidden = !pend;
        const caja = $('#hpSolLista');
        if (!r.items.length) { caja.innerHTML = '<div class="ui-empty"><i class="bi bi-inbox big"></i><p>Los proveedores todavía no pidieron crear ningún dato.</p></div>'; return; }
        if (pend > 0) $('#hpSol').open = true;
        caja.innerHTML = r.items.map(s => {
            const [ico, nombre] = SOL[s.tipo] || ['bi-box', s.tipo];
            let datos = '';
            try { const d = JSON.parse(s.datos || '{}'); datos = Object.entries(d).filter(([k, v]) => v !== '' && v !== null && k !== 'activo').map(([k, v]) => esc(k.replace(/^id_/, '').replace('_', ' ')) + ': ' + esc(v)).join(' · '); } catch { }
            const acc = s.estado === 'PENDIENTE'
                ? `<button type="button" class="ev-btn sm" data-sol="ok" data-id="${s.id_Solicitud}"><i class="bi bi-check2-circle"></i> Aprobar</button>
                   <button type="button" class="ev-btn ghost sm" data-sol="no" data-id="${s.id_Solicitud}"><i class="bi bi-x-circle"></i> Rechazar</button>
                   <a class="ev-btn ghost sm" href="/Herramientas/Catalogo/${SOL_CAT[s.tipo]}" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i> Abrir en Herramientas</a>`
                : `<small>${esc(SOL_EST[s.estado] || s.estado)}${s.revisado_Por ? ' por ' + esc(s.revisado_Por) : ''}</small>`;
            return `<div class="hp-sol-fila ${esc(s.estado)}"><span class="ico"><i class="bi ${ico}"></i></span>
                <div><b>${esc(nombre)}: ${esc(s.nombre)}</b><small>${esc(s.cuenta || '')} · ${fh(s.creado_En)}${s.motivo ? ' · Motivo: ' + esc(s.motivo) : ''}</small>
                ${datos ? `<div class="hp-sol-datos">${datos}</div>` : ''}</div><div class="acc">${acc}</div></div>`;
        }).join('');
    }
    $('#hpSolLista').addEventListener('click', async e => {
        const b = e.target.closest('[data-sol]'); if (!b) return;
        const id = +b.dataset.id;
        try {
            if (b.dataset.sol === 'ok') {
                const r = await EV.post('/Herramientas/ProveedorSolicitudAprobar', { id }); EV.toast(r.mensaje, 'ok');
            } else {
                const motivo = prompt('¿Por qué lo rechazas? El proveedor lo verá.'); if (!motivo) return;
                const r = await EV.post('/Herramientas/ProveedorSolicitudRechazar', { id, motivo }); EV.toast(r.mensaje, 'ok');
            }
            solicitudes();
        } catch { /* EV.post ya mostró el aviso */ }
    });
    solicitudes();

    // =====================================================================================================================
    // Centro de cargas (20/11/2026): pestañas, Hoy, tablero, mensajes tipo WhatsApp (con notas internas), ventana flotante y fichas.
    // =====================================================================================================================
    const hm = d => d ? new Date(d).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }) : '';
    const diaTxt = d => { const x = new Date(d), h = new Date(); const a = new Date(h.getFullYear(), h.getMonth(), h.getDate()), b = new Date(x.getFullYear(), x.getMonth(), x.getDate()); const n = Math.round((a - b) / 864e5);
        return n === 0 ? 'Hoy' : n === 1 ? 'Ayer' : x.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }); };
    const hace = d => { const m = Math.max(0, Math.round((Date.now() - new Date(d)) / 60000)); return m < 1 ? 'ahora' : m < 60 ? `${m} min` : m < 1440 ? `${Math.floor(m / 60)} h` : `${Math.floor(m / 1440)} d`; };
    const corto = (t, n = 70) => { t = String(t || ''); return t.length > n ? t.slice(0, n) + '…' : t; };
    const iniciales = n => (String(n || '?').trim().split(/\s+/).slice(0, 2).map(p => p[0]).join('') || '?').toUpperCase();
    const av = (n, g) => { let h = 0; for (const c of String(n || '?')) h = (h * 31 + c.charCodeAt(0)) % 360; return `<span class="sg-av${g ? ' g' : ''}" style="--h:${h}">${esc(iniciales(n))}</span>`; };
    const COL = { PENDIENTE: '#F79009', DEVUELTA: '#D444A0', RECHAZADA: '#F04438', PROGRAMADA: '#7A5AF8', ACTIVA: '#12B76A', BORRADOR: '#98A2B3' };
    const pk = (o, k) => o?.[k] ?? o?.[k[0].toLowerCase() + k.slice(1)] ?? 0;
    let gest = {}, equipo = [], yo = '', segActivo = true, chats = [], fichas = [], visto = {};
    try { visto = JSON.parse(localStorage.getItem('hpVisto') || '{}'); } catch { }
    const marcarVisto = (id, fecha) => { if (!fecha) return; visto[id] = fecha; try { localStorage.setItem('hpVisto', JSON.stringify(visto)); } catch { } };
    const sinLeer = c => c.ultimo_Autor === 'PROVEEDOR' && (!visto[c.id] || new Date(c.ultima_Fecha) > new Date(visto[c.id]));

    // ---------------- pestañas ----------------
    const cargadas = {};
    function pestana(t, empujar = true) {
        document.querySelectorAll('#sgTabs [data-tab]').forEach(b => b.classList.toggle('on', b.dataset.tab === t));
        document.querySelectorAll('.sg-sec').forEach(s => s.classList.toggle('on', s.id === 'tab-' + t));
        if (empujar) { const u = new URL(location.href); u.searchParams.set('tab', t); history.replaceState(null, '', u); }
        if (t === 'hoy') pintarHoy(); else if (t === 'tablero') tablero(); else if (t === 'chats') bandeja(); else if (t === 'prov') proveedores();
        else if (t === 'lista' && !cargadas.lista) { cargadas.lista = 1; }
    }
    $('#sgTabs').addEventListener('click', e => { const b = e.target.closest('[data-tab]'); if (b) pestana(b.dataset.tab); });

    // ---------------- Hoy ----------------
    const EV_TXT = { CREADA: ['creó la carga', 'bi-plus-circle', ''], ENVIADA: ['la envió a revisión', 'bi-send', 'az'], PENDIENTE: ['la envió a revisión', 'bi-send', 'az'], RECHAZADA: ['la rechazó', 'bi-x-octagon', 'mal'], DEVUELTA: ['la devolvió', 'bi-arrow-return-left', 'ama'],
        PROGRAMADA: ['la aprobó y programó', 'bi-calendar-check', 'vio'], ACTIVA: ['la aprobó', 'bi-check2-circle', 'ok'], EN_WEB: ['Publicada en la web', 'bi-globe2', 'ok'], MENSAJE_PROVEEDOR: ['escribió', 'bi-chat-left-text', 'az'], MENSAJE_EUROVIP: ['respondió', 'bi-reply', ''] };
    async function pintarHoy() {
        let r;
        try { r = await EV.api('/Herramientas/ProveedorDia'); } catch { $('#sgHoyKpis').innerHTML = ''; $('#sgHoy').innerHTML = '<div class="sg-vacio sg-panel ancho">No se pudo cargar el seguimiento del día.</div>'; return; }
        const n = r.numeros || {}, g = k => pk(n, k);
        const k = (cls, ic, num, txt, tab) => `<${tab ? 'button type="button" data-ir="' + tab + '"' : 'div'} class="sg-kpi ${cls}"><i class="bi ${ic}"></i><b>${EV.fmt(num)}</b><small>${txt}</small></${tab ? 'button' : 'div'}>`;
        $('#sgHoyKpis').innerHTML = k(g('PorRevisar') ? 'ama' : '', 'bi-hourglass-split', g('PorRevisar'), 'Por revisar', 'tablero') + k(g('Atrasadas') ? 'rojo' : '', 'bi-alarm', g('Atrasadas'), 'Esperando más de 24 h', 'tablero')
            + k('azul', 'bi-send', g('EnviadasHoy'), 'Enviadas hoy') + k('verde', 'bi-check2-circle', g('RevisadasHoy'), 'Revisadas hoy') + k('verde', 'bi-globe2', g('ActivadasHoy'), 'Activadas hoy')
            + k('azul', 'bi-calendar-check', g('SalenHoy'), 'Salen hoy') + k('', 'bi-calendar-plus', g('SalenManana'), 'Salen mañana')
            + k(g('ConError') ? 'rojo' : '', 'bi-exclamation-octagon', g('ConError'), 'Con error al publicar') + k(r.datosPendientes ? 'ama' : '', 'bi-plus-square-dotted', r.datosPendientes, 'Datos pedidos', 'sol');
        const fila = (c, cuando, cls) => `<button type="button" class="sg-fila" data-carga="${c.id}">${av(c.cuenta)}<div><b>${esc(c.codigo)}${c.titulo ? ' · ' + esc(c.titulo) : ''}</b><small>${esc(c.cuenta || '')} · ${esc((modulos[c.modulo] || {}).nombre || c.modulo)}</small></div><span class="cuando ${cls || ''}">${cuando}</span></button>`;
        const lista = (arr, f, vacio) => arr.length ? arr.map(f).join('') : `<div class="sg-vacio">${vacio}</div>`;
        const mov = r.actividad.map(e => { const t = EV_TXT[e.tipo] || [e.tipo, 'bi-dot', '']; const quien = e.tipo === 'EN_WEB' ? '' : esc(e.quien || e.cuenta || '');
            return `<li data-carga="${e.id_Carga}"><span class="pt ${t[2]}"><i class="bi ${t[1]}"></i></span><div><b>${quien} ${e.tipo === 'EN_WEB' ? t[0] : t[0]}</b><span>${esc(e.codigo)} · ${esc(e.cuenta || '')}${e.texto ? ' · “' + esc(corto(e.texto, 90)) + '”' : ''}</span></div><time>${diaTxt(e.fecha)}<br>${hm(e.fecha)}</time></li>`; }).join('');
        $('#sgHoy').innerHTML = `
            <div class="sg-panel"><h3><i class="bi bi-alarm"></i> Por revisar (las más antiguas primero)</h3>${lista(r.atrasadas, c => fila(c, 'hace ' + hace(c.fecha)), '¡Nada pendiente! Todo está revisado.')}</div>
            <div class="sg-panel"><h3><i class="bi bi-chat-left-dots"></i> Mensajes sin responder</h3>${lista(r.sinResponder, c => fila(c, 'hace ' + hace(c.fecha), 'g'), 'Todos los mensajes están respondidos.')}</div>
            <div class="sg-panel"><h3><i class="bi bi-calendar-check"></i> Salen pronto en la web</h3>${lista(r.salen, c => fila(c, fh(c.fecha), 'v'), 'No hay cargas programadas.')}</div>
            <div class="sg-panel"><h3><i class="bi bi-activity"></i> Movimiento reciente</h3><ul class="sg-mov">${mov || '<div class="sg-vacio">Todavía no hay movimiento.</div>'}</ul></div>`;
    }
    document.addEventListener('click', e => {
        const ir = e.target.closest('[data-ir]'); if (ir) { pestana(ir.dataset.ir); return; }
        const c = e.target.closest('[data-carga]'); if (c && c.closest('#tab-hoy, #sgKan, #sgProvs')) abrir(+c.dataset.carga);
    });

    // ---------------- Tablero ----------------
    const KCOLS = [['PENDIENTE', 'Por revisar', 'Esperan a Eurovip', 'bi-hourglass-split', ['PENDIENTE']], ['DEVUELTA', 'Con el proveedor', 'Devueltas o rechazadas', 'bi-arrow-return-left', ['DEVUELTA', 'RECHAZADA']],
        ['PROGRAMADA', 'Programadas', 'Aprobadas, salen solas', 'bi-calendar-check', ['PROGRAMADA']], ['ACTIVA', 'En la web', 'Las más recientes', 'bi-globe2', ['ACTIVA']], ['BORRADOR', 'Borradores', 'Aún sin enviar', 'bi-pencil', ['BORRADOR']]];
    let kdatos = null;
    async function tablero(recargar) {
        if (!kdatos || recargar) {
            const pide = (e, tam) => EV.api('/Herramientas/ProveedoresCargas?' + new URLSearchParams({ estado: e, tam, pagina: 1 })).catch(() => ({ items: [], total: 0 }));
            const [a, b, c, d, e, f, g] = await Promise.all([pide('PENDIENTE', 100), pide('DEVUELTA', 50), pide('RECHAZADA', 50), pide('PROGRAMADA', 100), pide('ACTIVA', 30), pide('BORRADOR', 30), EV.api('/Herramientas/ProveedorGestiones').catch(() => ({ items: [], equipo: [], activo: false }))]);
            kdatos = { PENDIENTE: a, DEVUELTA: b, RECHAZADA: c, PROGRAMADA: d, ACTIVA: e, BORRADOR: f };
            gest = Object.fromEntries((g.items || []).map(x => [x.id_Carga, x])); equipo = g.equipo || []; yo = g.yo || ''; segActivo = !!g.activo;
            $('#sgAvisoSeg').hidden = segActivo;
            if (!$('#sgKModulo').dataset.ok) { $('#sgKModulo').dataset.ok = 1; $('#sgKModulo').insertAdjacentHTML('beforeend', Object.values(modulos).map(m => `<option value="${esc(m.clave)}">${esc(m.nombre)}</option>`).join('')); }
            if (!$('#sgKCuenta').dataset.ok) { $('#sgKCuenta').dataset.ok = 1; EV.api('/Herramientas/ProveedoresCuentas').then(r => $('#sgKCuenta').insertAdjacentHTML('beforeend', r.cuentas.map(x => `<option value="${x.id}">${esc(x.nombre)}</option>`).join(''))).catch(() => { }); }
        }
        pintarTablero();
    }
    function pintarTablero() {
        const q = $('#sgKQ').value.trim().toLowerCase(), mod = $('#sgKModulo').value, cu = $('#sgKCuenta').value, mias = $('#sgKMias').checked;
        const ok = c => (!mod || c.modulo === mod) && (!cu || String(c.id_Cuenta) === cu) && (!q || `${c.codigo} ${c.titulo || ''} ${c.cuenta || ''}`.toLowerCase().includes(q)) && (!mias || (gest[c.id] || {}).asignado_A === yo);
        $('#sgKan').innerHTML = KCOLS.map(([clave, tit, sub, ic, estados]) => {
            const todas = estados.flatMap(e => (kdatos[e] || {}).items || []).filter(ok);
            const total = estados.reduce((s, e) => s + ((kdatos[e] || {}).total || 0), 0);
            todas.sort((x, y) => ((gest[y.id] || {}).prioridad || 0) - ((gest[x.id] || {}).prioridad || 0) || new Date(x.fecha_Solicitud || x.creado_En) - new Date(y.fecha_Solicitud || y.creado_En));
            const cards = todas.map((c, i) => {
                const g = gest[c.id] || {}, m = modulos[c.modulo] || { nombre: c.modulo, icono: 'bi-box' }, chat = chats.find(x => x.id === c.id);
                const desde = c.estado === 'PENDIENTE' ? `<span class="sg-chip ${Date.now() - new Date(c.fecha_Solicitud) > 864e5 ? 'rojo' : 'ama'}"><i class="bi bi-clock"></i> hace ${hace(c.fecha_Solicitud)}</span>`
                    : c.estado === 'PROGRAMADA' ? `<span class="sg-chip vio"><i class="bi bi-calendar-check"></i> ${fh(c.activar_En)}</span>` : c.estado === 'ACTIVA' ? `<span class="sg-chip verde"><i class="bi bi-globe2"></i> ${fh(c.fecha_Activacion)}</span>`
                    : `<span class="sg-chip"><i class="bi bi-clock-history"></i> ${hace(c.actualizado_En || c.creado_En)}</span>`;
                return `<button type="button" class="sg-card u${g.prioridad || 0}" style="--c:${COL[c.estado]};animation-delay:${Math.min(i, 8) * 30}ms" data-carga="${c.id}">
                    <div class="sg-card-top">${av(c.cuenta)}<div><b>${esc(c.codigo)}${c.titulo ? ' · ' + esc(c.titulo) : ''}</b><small>${esc(c.cuenta || '')}</small></div>${chat && sinLeer(chat) ? '<span class="sg-punto" title="Mensaje sin leer"></span>' : ''}</div>
                    <div class="sg-card-pies"><span class="sg-chip"><i class="bi ${esc(m.icono)}"></i> ${esc(m.nombre)}</span><span class="sg-chip">${EV.fmt(c.productos)} prod.</span>${c.precio_Desde ? `<span class="sg-chip">desde ${EV.dinero(c.precio_Desde, c.moneda)}</span>` : ''}
                        ${c.estado === 'DEVUELTA' ? '<span class="sg-chip ama">Devuelta</span>' : c.estado === 'RECHAZADA' ? '<span class="sg-chip rojo">Rechazada</span>' : ''}${c.error ? '<span class="sg-chip rojo"><i class="bi bi-exclamation-octagon"></i> error</span>' : ''}</div>
                    <div class="sg-card-pies">${desde}${g.prioridad === 2 ? '<span class="sg-chip rojo"><i class="bi bi-flag-fill"></i> Urgente</span>' : g.prioridad === 1 ? '<span class="sg-chip ama"><i class="bi bi-flag-fill"></i> Alta</span>' : ''}${g.asignado_A ? `<span class="sg-chip azul"><i class="bi bi-person-check"></i> ${esc(g.asignado_A)}</span>` : ''}</div></button>`;
            }).join('');
            return `<div class="sg-col" style="--c:${COL[estados[0]]}"><div class="sg-col-cab"><span class="ic"><i class="bi ${ic}"></i></span><b>${tit}<small>${sub}</small></b><span class="n">${total}</span></div>
                <div class="sg-col-cuerpo">${cards || '<div class="sg-vacio">Nada aquí.</div>'}</div></div>`;
        }).join('');
    }
    ['#sgKQ'].forEach(s => $(s).addEventListener('input', EV.debounce(pintarTablero, 200)));
    ['#sgKModulo', '#sgKCuenta', '#sgKMias'].forEach(s => $(s).addEventListener('change', pintarTablero));

    // ---------------- Hilo de mensajes (WhatsApp) ----------------
    const RAPIDAS = ['Gracias, la estamos revisando.', 'Falta el precio de algunas fechas.', 'Por favor confirma las fechas de salida.', '¿Puedes enviar mejores fotos?', 'Aprobada, sale en la web en la fecha indicada.'];
    async function montarHilo(el, id, op = {}) {
        let st = { carga: null, coms: [], notas: [], activo: true, yo: '' }, modo = 'msg';
        const cargar = async () => {
            const [d, n] = await Promise.all([EV.api('/Herramientas/ProveedorCarga?id=' + id), EV.api('/Herramientas/ProveedorNotas?id=' + id).catch(() => ({ items: [], activo: false, yo: '' }))]);
            st = { carga: d.carga, coms: d.comentarios || [], notas: n.items || [], activo: n.activo, yo: n.yo };
            const ult = st.coms.filter(x => x.autor === 'PROVEEDOR').pop(); if (ult) marcarVisto(id, ult.fecha);
            pintar();
        };
        const items = () => {
            const c = st.carga, a = [];
            a.push({ t: 'sis', f: c.creado_En, x: `Carga creada por ${c.cuenta || 'el proveedor'}` });
            if (c.fecha_Solicitud) a.push({ t: 'sis', f: c.fecha_Solicitud, x: 'Enviada a revisión' });
            if (c.fecha_Revision) a.push({ t: 'sis', f: c.fecha_Revision, x: `${UNO[c.estado] || c.estado} · revisó ${c.revisado_Por || 'Eurovip'}` });
            if (c.fecha_Activacion) a.push({ t: 'sis', f: c.fecha_Activacion, x: 'Publicada en la web' });
            st.coms.forEach(m => a.push({ t: 'msg', f: m.fecha, m }));
            st.notas.forEach(n => a.push({ t: 'nota', f: n.creado_En, n }));
            return a.sort((x, y) => new Date(x.f) - new Date(y.f));
        };
        const pintar = () => {
            const c = st.carga, m = modulos[c.modulo] || { nombre: c.modulo, icono: 'bi-box' }; let ultimoDia = '';
            const cuerpo = items().map(i => {
                const dia = diaTxt(i.f), sep = dia !== ultimoDia ? `<div class="sg-dia">${dia}</div>` : ''; ultimoDia = dia;
                if (i.t === 'sis') return `${sep}<div class="sg-sis">${esc(i.x)} · ${hm(i.f)}</div>`;
                if (i.t === 'nota') { const n = i.n; return `${sep}<div class="sg-msg NOTA${n.fijada ? ' fij' : ''}"><div class="qn"><i class="bi bi-lock-fill"></i> Nota interna · ${esc(n.autor)}${n.fijada ? ' · <i class="bi bi-pin-angle-fill"></i>' : ''}</div>${esc(n.texto)}<div class="tm">${hm(n.creado_En)}</div>
                    <div class="acc"><button type="button" data-fijar="${n.id}" data-v="${n.fijada ? 0 : 1}" title="${n.fijada ? 'Soltar' : 'Fijar'}"><i class="bi bi-pin-angle"></i></button>${n.autor === st.yo ? `<button type="button" data-borrar="${n.id}" title="Borrar"><i class="bi bi-trash"></i></button>` : ''}</div></div>`; }
                const x = i.m, eur = x.autor === 'EUROVIP';
                return `${sep}<div class="sg-msg ${esc(x.autor)}"><div class="qn">${esc(x.nombre)}${eur ? ' · Eurovip' : ''}</div>${esc(x.texto)}<div class="tm">${hm(x.fecha)}${eur ? ' <i class="bi bi-check2-all ok"></i>' : ''}</div></div>`;
            }).join('');
            const fij = st.notas.filter(n => n.fijada).pop();
            el.innerHTML = `<div class="sg-hilo">
                ${op.cab ? `<div class="sg-hilo-cab">${op.atras ? '<button type="button" class="ui-ibtn" data-atras aria-label="Volver"><i class="bi bi-arrow-left"></i></button>' : ''}${av(c.cuenta)}<div><b>${esc(c.cuenta || '')}</b><small>${esc(c.codigo)}${c.titulo ? ' · ' + esc(c.titulo) : ''} · ${esc(m.nombre)} · ${UNO[c.estado] || esc(c.estado)}</small></div>
                    <button type="button" class="ev-btn ghost sm" data-abrir="${c.id}"><i class="bi bi-box-arrow-up-right"></i> Abrir carga</button></div>` : ''}
                ${fij ? `<div class="sg-fijada"><i class="bi bi-pin-angle-fill"></i><span>${esc(fij.texto)}</span></div>` : ''}
                <div class="sg-msgs" data-msgs>${cuerpo}</div>
                <div class="sg-comp"><div class="sg-modo"><button type="button" data-modo="msg" class="${modo === 'msg' ? 'on' : ''}"><i class="bi bi-chat-text"></i> Responder al proveedor</button><button type="button" data-modo="nota" class="${modo === 'nota' ? 'on' : ''}"><i class="bi bi-lock"></i> Nota interna</button></div>
                    ${modo === 'msg' ? `<div class="sg-rapidas">${RAPIDAS.map(r => `<button type="button" data-rapida="${esc(r)}">${esc(corto(r, 38))}</button>`).join('')}</div>` : '<div class="sg-sis" style="align-self:flex-start;margin:0">🔒 Solo la ve el equipo de Eurovip. El proveedor nunca la ve.</div>'}
                    <div class="sg-caja ${modo === 'nota' ? 'nota' : ''}"><textarea rows="1" data-texto maxlength="2000" placeholder="${modo === 'msg' ? 'Escribe al proveedor… (Enter envía, Shift+Enter nueva línea)' : 'Escribe una nota para tu equipo…'}"></textarea>
                    <button type="button" class="sg-enviar" data-enviar aria-label="Enviar"><i class="bi bi-send-fill"></i></button></div></div></div>`;
            const ms = el.querySelector('[data-msgs]'); ms.scrollTop = ms.scrollHeight;
        };
        const enviar = async () => {
            const ta = el.querySelector('[data-texto]'), texto = ta.value.trim(); if (!texto) { ta.focus(); return; }
            try {
                if (modo === 'msg') { const r = await EV.post('/Herramientas/ProveedorCargaComentar', { id, texto }); st.coms = r.comentarios; }
                else { const r = await EV.post('/Herramientas/ProveedorNotaCrear', { id, texto }); st.notas = r.items; }
            } catch { return; }
            pintar(); el.querySelector('[data-texto]').focus(); op.alCambiar?.();
        };
        el.onclick = async e => {
            const b = e.target.closest('button, a'); if (!b) return;
            if (b.dataset.modo) { modo = b.dataset.modo; const t = el.querySelector('[data-texto]').value; pintar(); el.querySelector('[data-texto]').value = t; }
            else if (b.dataset.rapida) { const ta = el.querySelector('[data-texto]'); ta.value = b.dataset.rapida; ta.focus(); }
            else if (b.dataset.enviar !== undefined) enviar();
            else if (b.dataset.abrir) { op.abrir ? op.abrir(+b.dataset.abrir) : abrir(+b.dataset.abrir); }
            else if (b.dataset.atras !== undefined) op.atras?.();
            else if (b.dataset.fijar) { try { const r = await EV.post(`/Herramientas/ProveedorNotaFijar?id=${b.dataset.fijar}&carga=${id}&fijada=${b.dataset.v === '1'}`, {}); st.notas = r.items; pintar(); } catch { } }
            else if (b.dataset.borrar) { if (await EV.confirmar({ titulo: '¿Borrar la nota?', si: 'Sí, borrar', peligro: true, icono: 'trash', texto: 'Se borra para todo el equipo.' })) try { const r = await EV.post(`/Herramientas/ProveedorNotaBorrar?id=${b.dataset.borrar}&carga=${id}`, {}); st.notas = r.items; pintar(); } catch { } }
        };
        el.onkeydown = e => { if (e.target.matches('[data-texto]') && e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); enviar(); } };
        el.innerHTML = '<div class="sg-main-vacio"><i class="bi bi-hourglass-split"></i></div>';
        try { await cargar(); } catch (er) { el.innerHTML = `<div class="sg-main-vacio"><i class="bi bi-exclamation-triangle"></i><p>${esc(er.message || 'No se pudo abrir la conversación.')}</p></div>`; }
    }

    // ---------------- bandeja de mensajes ----------------
    const listaChats = (q, activo) => {
        q = (q || '').trim().toLowerCase();
        const l = chats.filter(c => !q || `${c.codigo} ${c.titulo || ''} ${c.cuenta || ''} ${c.ultimo_Texto || ''}`.toLowerCase().includes(q));
        return l.length ? l.map(c => { const nu = sinLeer(c), m = modulos[c.modulo] || { nombre: c.modulo };
            return `<button type="button" class="sg-chat ${nu ? 'nuevo' : ''} ${activo === c.id ? 'on' : ''}" data-chat="${c.id}">${av(c.cuenta, 1)}<div><div class="l1"><b>${esc(c.cuenta || '')}</b><time>${diaTxt(c.ultima_Fecha) === 'Hoy' ? hm(c.ultima_Fecha) : diaTxt(c.ultima_Fecha)}</time></div>
                <div class="l2"><span>${c.ultimo_Autor === 'EUROVIP' ? '<i class="bi bi-check2-all" style="color:#53BDEB"></i> ' : ''}${esc(corto(c.ultimo_Texto, 60))}</span>${nu ? '<b class="sg-badge">●</b>' : ''}</div>
                <div class="l3">${esc(c.codigo)} · ${esc(m.nombre)} · ${UNO[c.estado] || esc(c.estado)}</div></div></button>`; }).join('')
            : '<div class="sg-vacio" style="margin:14px">Todavía no hay conversaciones. Escribe desde una carga y aparecerá aquí.</div>';
    };
    async function cargarChats() {
        try { const r = await EV.api('/Herramientas/ProveedorChats'); chats = r.items || []; yo = r.yo || yo; } catch { }
        const n = chats.filter(sinLeer).length;
        [['#sgNChats', n], ['#sgFabN', n]].forEach(([s, v]) => { const x = $(s); x.textContent = v; x.hidden = !v; });
        $('#sgChatLista').innerHTML = listaChats($('#sgChatQ').value, chatActivo);
        if (dockAbierto && !dockHilo) $('#sgDockLista') && ($('#sgDockLista').innerHTML = listaChats($('#sgDockQ')?.value));
    }
    let chatActivo = null;
    async function bandeja() { await cargarChats(); }
    function abrirChat(id) {
        chatActivo = id; $('#sgSplit').classList.add('hilo'); $('#sgChatLista').innerHTML = listaChats($('#sgChatQ').value, id);
        montarHilo($('#sgChatMain'), id, { cab: true, atras: () => { $('#sgSplit').classList.remove('hilo'); }, alCambiar: cargarChats, abrir: n => abrir(n) }).then(cargarChats);
    }
    $('#sgChatLista').addEventListener('click', e => { const b = e.target.closest('[data-chat]'); if (b) abrirChat(+b.dataset.chat); });
    $('#sgChatQ').addEventListener('input', EV.debounce(() => { $('#sgChatLista').innerHTML = listaChats($('#sgChatQ').value, chatActivo); }, 150));

    // ---------------- ventana flotante ----------------
    let dockAbierto = false, dockHilo = null;
    function dockLista() {
        dockHilo = null; $('#sgDockAtras').hidden = true; $('#sgDockTit').innerHTML = '<i class="bi bi-chat-dots"></i> Mensajes';
        $('#sgDockCuerpo').innerHTML = `<div class="sg-lado"><div class="sg-lado-cab"><input class="ui-input" id="sgDockQ" type="search" placeholder="Buscar proveedor o código…" aria-label="Buscar"></div><div class="sg-lado-lista" id="sgDockLista">${listaChats('')}</div></div>`;
        $('#sgDockQ').addEventListener('input', EV.debounce(() => { $('#sgDockLista').innerHTML = listaChats($('#sgDockQ').value); }, 150));
    }
    $('#sgFab').addEventListener('click', async () => { dockAbierto = !dockAbierto; $('#sgDock').classList.toggle('on', dockAbierto); if (dockAbierto) { dockLista(); await cargarChats(); $('#sgDockLista').innerHTML = listaChats(''); } });
    $('#sgDockCerrar').addEventListener('click', () => { dockAbierto = false; $('#sgDock').classList.remove('on'); });
    $('#sgDockGrande').addEventListener('click', () => $('#sgDock').classList.toggle('grande'));
    $('#sgDockAtras').addEventListener('click', () => { dockLista(); });
    $('#sgDockCuerpo').addEventListener('click', e => { const b = e.target.closest('[data-chat]'); if (!b) return; const id = +b.dataset.chat; dockHilo = id; $('#sgDockAtras').hidden = false; const c = chats.find(x => x.id === id);
        $('#sgDockTit').textContent = c ? c.cuenta : 'Conversación'; const cont = $('#sgDockCuerpo'); cont.innerHTML = '<div class="sg-main" style="flex:1;min-height:0"></div>';
        montarHilo(cont.firstChild, id, { cab: false, alCambiar: cargarChats }).then(cargarChats); });

    // ---------------- Proveedores (fichas) ----------------
    async function proveedores() {
        if (!fichas.length) { try { fichas = (await EV.api('/Herramientas/ProveedorFichas')).items; } catch { $('#sgProvs').innerHTML = '<div class="sg-vacio">No se pudo cargar.</div>'; return; } }
        pintarProv();
    }
    function pintarProv() {
        const q = $('#sgPQ').value.trim().toLowerCase(), f = $('#sgPEstado').value;
        const l = fichas.filter(p => (!q || `${p.nombre} ${p.email || ''} ${p.telefono || ''} ${p.proveedor || ''}`.toLowerCase().includes(q)) && (!f || (f === 'p' ? p.pendiente > 0 : String(p.activo ? 1 : 0) === f)));
        $('#sgProvs').innerHTML = l.length ? l.map((p, i) => {
            const barra = ['borrador', 'pendiente', 'devuelta', 'rechazada', 'programada', 'activa'].map(k => `<span style="flex:${p[k]};background:${COL[k.toUpperCase()]}" title="${k}: ${p[k]}"></span>`).join('');
            const tel = (p.telefono || '').replace(/[^\d+]/g, '');
            return `<div class="sg-prov ${p.activo ? '' : 'off'}" style="animation-delay:${Math.min(i, 10) * 30}ms">
                <div class="sg-prov-cab">${av(p.nombre, 1)}<div><b>${esc(p.nombre)}</b><small>${esc(p.proveedor || p.id_Proveedor || '')}</small></div><span class="sg-chip ${p.activo ? 'verde' : 'rojo'}">${p.activo ? 'Activa' : 'Desactivada'}</span></div>
                <div class="sg-contacto">${p.email ? `<a href="mailto:${esc(p.email)}"><i class="bi bi-envelope"></i> ${esc(p.email)}</a>` : ''}${tel ? `<a href="https://wa.me/${tel.replace('+', '')}" target="_blank" rel="noopener"><i class="bi bi-whatsapp"></i> ${esc(p.telefono)}</a>` : ''}
                    <span><i class="bi bi-calendar3"></i> Cuenta desde ${fh(p.fecha_Alta).split(',')[0]}</span><span><i class="bi bi-clock-history"></i> Última actividad: ${p.ultima_Actividad ? 'hace ' + hace(p.ultima_Actividad) : '—'}</span></div>
                <div class="sg-prov-pie">${String(p.modulos || '').split(',').filter(Boolean).map(m => `<span class="sg-chip"><i class="bi ${esc((modulos[m] || {}).icono || 'bi-box')}"></i> ${esc((modulos[m] || {}).nombre || m)}</span>`).join('') || '<span class="sg-chip rojo">Sin módulos</span>'}</div>
                ${p.cargas ? `<div class="sg-estbar">${barra}</div>` : ''}
                <div class="sg-nums"><div><b>${p.cargas}</b><small>Cargas</small></div><div><b>${p.pendiente}</b><small>Por revisar</small></div><div><b>${p.activa}</b><small>En la web</small></div>
                    <div><b>${p.devuelta + p.rechazada}</b><small>Con el proveedor</small></div><div><b>${EV.fmt(p.productos)}</b><small>Productos</small></div><div><b>${p.mensajes}</b><small>Mensajes</small></div></div>
                <div class="sg-prov-pie"><button type="button" class="ev-btn sm" data-ver-cargas="${p.id}"><i class="bi bi-collection"></i> Ver sus cargas</button><a class="ev-btn ghost sm" href="/Herramientas/Index?tab=htCuentas"><i class="bi bi-pencil"></i> Editar cuenta</a></div></div>`;
        }).join('') : '<div class="sg-vacio">No hay proveedores con ese filtro.</div>';
    }
    $('#sgPQ').addEventListener('input', EV.debounce(pintarProv, 200)); $('#sgPEstado').addEventListener('change', pintarProv);
    $('#sgProvs').addEventListener('click', e => { const b = e.target.closest('[data-ver-cargas]'); if (!b) return; $('#hpCuenta').value = b.dataset.verCargas; filtro = ''; pintarConteo(conteo); pestana('lista'); listar(true); });

    // ---------------- responsable y prioridad dentro de la carga ----------------
    async function seguimientoCarga(c) {
        const caja = document.getElementById('sgSegCarga'); if (!caja) return;
        let g = {}, lista = equipo;
        try { const r = await EV.api('/Herramientas/ProveedorGestiones'); gest = Object.fromEntries((r.items || []).map(x => [x.id_Carga, x])); equipo = r.equipo || []; yo = r.yo || yo; segActivo = !!r.activo; g = gest[c.id] || {}; lista = equipo; } catch { }
        const nombres = [...new Set([...lista, g.asignado_A].filter(Boolean))];
        caja.innerHTML = `<h4><i class="bi bi-person-workspace"></i> Seguimiento interno</h4>
            ${segActivo ? '' : '<div class="hp-aviso ama" style="font-size:12.5px">Todavía no está activado en este servidor.</div>'}
            <div><label for="sgResp">Responsable</label><div style="display:flex;gap:6px"><select class="ui-input" id="sgResp"><option value="">Sin asignar</option>${nombres.map(n => `<option ${n === g.asignado_A ? 'selected' : ''}>${esc(n)}</option>`).join('')}</select>
                <button type="button" class="ev-btn ghost sm" id="sgMia">Asignármela</button></div></div>
            <div><label>Prioridad</label><div class="sg-prio">${[['0', 'Normal'], ['1', 'Alta'], ['2', 'Urgente']].map(([p, t]) => `<button type="button" data-p="${p}" class="${String(g.prioridad || 0) === p ? 'on' : ''}">${t}</button>`).join('')}</div></div>`;
        const guardar = async (asignado, prioridad) => { try { await EV.post('/Herramientas/ProveedorGestionGuardar', { id: c.id, asignado, prioridad }); g = { ...g, asignado_A: asignado || null, prioridad }; gest[c.id] = { id_Carga: c.id, ...g }; EV.toast('Guardado.'); if (kdatos) pintarTablero(); } catch { } };
        $('#sgResp').addEventListener('change', e => guardar(e.target.value, g.prioridad || 0));
        $('#sgMia').addEventListener('click', () => { if (!$('#sgResp').querySelector(`option[value="${CSS.escape(yo)}"]`) && ![...$('#sgResp').options].some(o => o.value === yo)) $('#sgResp').insertAdjacentHTML('beforeend', `<option>${esc(yo)}</option>`); $('#sgResp').value = yo; guardar(yo, g.prioridad || 0); });
        caja.querySelector('.sg-prio').addEventListener('click', e => { const b = e.target.closest('[data-p]'); if (!b) return; caja.querySelectorAll('.sg-prio button').forEach(x => x.classList.toggle('on', x === b)); guardar($('#sgResp').value, +b.dataset.p); });
    }

    // ---------------- arranque ----------------
    $('#hpRecargar').addEventListener('click', () => { kdatos = null; fichas = []; const t = document.querySelector('#sgTabs .on')?.dataset.tab || 'hoy'; pestana(t, false); cargarChats(); solicitudes(); listar(true); });
    setInterval(() => { if (!document.hidden) cargarChats(); }, 60000);
    cargarChats();
    resumen.then(() => pestana(params.get('tab') && document.getElementById('tab-' + params.get('tab')) ? params.get('tab') : 'hoy', false));

    // Abrir directo (campana: /Herramientas/CargasProveedores?carga=12)
    const carga = +params.get('carga');
    listar(true);
    if (carga) resumen.then(() => abrir(carga));
})();
</script>
}
