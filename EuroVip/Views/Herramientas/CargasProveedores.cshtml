                    texto: `Los ${c.productos} producto(s) de la carga <b>${esc(c.codigo)}</b> de <b>${esc(c.cuenta || '')}</b> se crean en la web en este momento.` + (calActual && calActual.puntos.length ? `<br><br><b>Ojo, el control de calidad encontró ${calActual.puntos.length} punto(s):</b><ul style="text-align:left;margin:6px 0 0 18px">${calActual.puntos.slice(0, 5).map(p => `<li>${esc(p.titulo)}</li>`).join('')}</ul>` : '') })) return;
                const r = await EV.post('/Herramientas/ProveedorCargaAprobar', { id: c.id });
                EV.toast(r.mensaje); EV.confeti();
            } else if (acc === 'aprobar-sug' || acc === 'programar') {
