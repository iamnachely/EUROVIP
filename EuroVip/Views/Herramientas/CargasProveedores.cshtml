    .sg-prov-cab b { font-size: 16px; } .sg-prov-cab small { color: var(--ev-muted); font-size: 12.5px; }
    .sg-contacto { display: grid; gap: 4px; font-size: 13px; } .sg-contacto a { color: #0E7C74; font-weight: 700; text-decoration: none; display: inline-flex; gap: 8px; align-items: center; } .sg-contacto span { display: inline-flex; gap: 8px; align-items: center; color: #3C5B57; }
    .sg-contacto i { width: 18px; color: var(--ev-muted); }
