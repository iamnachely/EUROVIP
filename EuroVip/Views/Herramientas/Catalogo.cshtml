@using EuroVip.Models
@model HrCatalogo
@{
    ViewData["Title"] = Model.Titulo + " · Herramientas";
    var opts = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
    var hab = HrCatalogos.Buscar("habitaciones")!;
    var fotos = HrCatalogos.Fotos(Model);   // catálogos con fotos en Eurovip.multimedia
    object Cliente(HrCatalogo c) => new { c.Clave, c.Titulo, c.Singular, c.El, c.Nuevo, c.Icono, c.Especial, c.Campos, c.Filtros, Extras = (c.Extras ?? Array.Empty<HrExtra>()).Select(x => new { x.Alias, x.Etiqueta }) };
}

@section Styles {
<link rel="stylesheet" href="~/css/eurovip-ui.css" asp-append-version="true" />
<style>
    .hc { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 20px; margin-top: 18px; align-items: start; }
    .hc-nav { position: sticky; top: 92px; background: var(--ev-surface); border: 1px solid var(--ev-line); border-radius: 22px; padding: 10px; }
    .hc-nav .g { font: 800 10.5px var(--ev-font); letter-spacing: .08em; text-transform: uppercase; color: var(--ev-muted); padding: 10px 10px 4px; }
    .hc-nav a { display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 12px; color: var(--ev-text); text-decoration: none; font-weight: 700; font-size: 13.5px; }
    .hc-nav a:hover { background: var(--ev-surface-2); }
    .hc-nav a.on { background: var(--ev-ink); color: #fff; }
    .hc-nav a.on i { color: var(--ev-aqua); }
    .hc-head { display: flex; align-items: center; gap: 16px; padding: 20px 24px; border-radius: 24px; background: var(--ev-grad); position: relative; overflow: hidden; }
    .hc-head .ico { width: 58px; height: 58px; border-radius: 18px; background: var(--ev-ink); color: var(--ev-aqua); display: grid; place-items: center; font-size: 26px; flex-shrink: 0; }
    .hc-head h1 { margin: 2px 0 0; font-size: 26px; font-weight: 800; letter-spacing: -.8px; }
    .hc-head .migas { font-size: 12.5px; font-weight: 700; opacity: .7; }
    .hc-head .migas a { color: inherit; }
    .hc-head p { margin: 2px 0 0; font-weight: 500; opacity: .75; font-size: 13.5px; }
    .hc-head .sp { flex: 1; }
    .hc-head .big { font-size: 30px; font-weight: 800; letter-spacing: -1px; text-align: right; line-height: 1; }
    .hc-head .big small { display: block; font-size: 11.5px; font-weight: 700; opacity: .7; letter-spacing: 0; }
    .hc-cell-img { width: 44px; height: 32px; border-radius: 8px; object-fit: cover; background: var(--ev-surface-2); display: block; }
    .ui-table tbody tr { cursor: pointer; }
    .ui-table td.k { font-family: ui-monospace, Consolas, monospace; font-weight: 700; font-size: 12.5px; }
    .hc-pager { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 14px; flex-wrap: wrap; }
    .hc-pager small { color: var(--ev-muted); font-weight: 600; }
    .hc-pages { display: flex; gap: 6px; }
    .hc-pages button { min-width: 38px; height: 38px; border-radius: 12px; border: 1px solid var(--ev-line); background: var(--ev-surface); font: 700 13px var(--ev-font); color: var(--ev-text); cursor: pointer; }
    .hc-pages button.on { background: var(--ev-ink); color: var(--ev-aqua); border-color: var(--ev-ink); }
    .hc-pages button:disabled { opacity: .4; cursor: default; }
    .hc-uso { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 12px 14px; border-radius: 14px; background: var(--ev-surface-2); border: 1px solid var(--ev-line); font-weight: 700; font-size: 13px; margin-bottom: 16px; }
    .hc-prev { margin-top: 8px; border-radius: 14px; overflow: hidden; max-height: 180px; background: var(--ev-surface-2); }
    /* Campo de imagen: subir a carpetas del proyecto en vez de escribir una URL */
    .hc-img { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 14px; align-items: center; padding: 12px; border-radius: 18px;
              border: 2px dashed var(--ev-line); background: var(--ev-surface-2); transition: border-color .2s, background .2s; }
    .hc-img.sobre { border-color: var(--ev-teal); background: var(--ev-mint); }
    .hc-img.subiendo { opacity: .6; pointer-events: none; }
    .hc-img-prev { aspect-ratio: 4 / 3; border-radius: 12px; overflow: hidden; background: var(--ev-grad); display: grid; place-items: center; }
    .hc-img-prev img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .hc-img-prev .sin { color: var(--ev-ink); font-weight: 700; font-size: 12.5px; opacity: .7; display: flex; gap: 6px; align-items: center; padding: 8px; text-align: center; }
    .hc-img-acc { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .hc-img-acc small { flex-basis: 100%; }
    @@media (max-width: 640px) { .hc-img { grid-template-columns: 1fr; } }
    .hc-prev img { width: 100%; max-height: 180px; object-fit: cover; display: block; }
    .ui-f input.may { text-transform: uppercase; }
    /* Datos a revisar (inconsistencias ya guardadas) */
    .hc-rev-btn { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 14px; border: 1px solid #FCD34D; background: #FEF3C7; color: #92400E;
                  font: 800 13px var(--ev-font); cursor: pointer; }
    .hc-rev-btn.ok { border-color: var(--ev-line); background: var(--ev-surface-2); color: var(--ev-muted); cursor: default; }
    .hc-rev-btn[aria-expanded="true"] { background: #92400E; color: #FEF3C7; border-color: #92400E; }
    .hc-rev { margin: 0 0 16px; border-radius: 20px; border: 1px solid #FCD34D; background: #FFFBEB; padding: 16px 18px; }
    .hc-rev h3 { margin: 0 0 4px; font-size: 16px; font-weight: 800; display: flex; align-items: center; gap: 8px; color: #92400E; }
    .hc-rev > p { margin: 0 0 12px; color: #92400E; font-weight: 600; font-size: 13px; }
    .hc-rev-g { background: var(--ev-surface); border: 1px solid var(--ev-line); border-radius: 16px; margin-top: 10px; overflow: hidden; }
    .hc-rev-g summary { list-style: none; cursor: pointer; padding: 12px 14px; display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 14px; }
    .hc-rev-g summary::-webkit-details-marker { display: none; }
    .hc-rev-g summary .n { min-width: 28px; height: 24px; padding: 0 8px; border-radius: 8px; background: #FEF3C7; color: #92400E; display: inline-grid; place-items: center; font-size: 12.5px; }
    .hc-rev-g summary small { color: var(--ev-muted); font-weight: 600; font-size: 12.5px; flex: 1; }
    .hc-rev-g[open] summary .bi-chevron-down { transform: rotate(180deg); }
    .hc-rev-g table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
    .hc-rev-g td { padding: 8px 14px; border-top: 1px solid var(--ev-line); }
    .hc-rev-g td.v { font-weight: 700; white-space: pre; }
    .hc-rev-g td.d { color: var(--ev-muted); font-weight: 600; }
    .hc-rev-g tr[data-r] { cursor: pointer; }
    .hc-rev-g tr[data-r]:hover { background: var(--ev-surface-2); }
    .hb-form { padding: 14px; border-radius: 16px; background: var(--ev-grad-soft); border: 1px solid var(--ev-line); margin-bottom: 12px; }
    @@media (max-width: 1100px) { .hc { grid-template-columns: 1fr; } .hc-nav { position: static; display: flex; flex-wrap: wrap; } .hc-nav .g { display: none; } }
    /* Categoría del hotel: estrellas de verdad (1 a 6) */
    .hc-est { display: inline-flex; gap: 4px; align-items: center; padding: 6px 10px; border: 1.5px solid var(--ev-line); border-radius: 14px; background: var(--ev-surface); }
    .hc-est button { border: 0; background: none; padding: 2px; font-size: 26px; line-height: 1; color: #D9DEE3; cursor: pointer; transition: transform .12s, color .12s; }
    .hc-est button.on { color: #F5A623; text-shadow: 0 1px 4px rgba(245,166,35,.45); }
    .hc-est button:hover { transform: scale(1.15); }
    .hc-est button:focus-visible { outline: 2px solid #F5A623; outline-offset: 2px; border-radius: 6px; }
    .hc-est .n { margin-left: 8px; font-weight: 800; font-size: 13px; color: var(--ev-muted); min-width: 74px; }
    .hc-est-celda { color: #F5A623; letter-spacing: 1px; white-space: nowrap; }
</style>
}

@Html.AntiForgeryToken()

<div class="hc">
    <nav class="hc-nav ev-rise" aria-label="Catálogos">
        <a asp-action="Index"><i class="bi bi-grid"></i> Todas las herramientas</a>
        @foreach (var g in HrCatalogos.Todos.GroupBy(c => c.Grupo))
        {
            <div class="g">@g.Key</div>
            @foreach (var c in g)
            {
                <a asp-action="Catalogo" asp-route-id="@c.Clave" class="@(c.Clave == Model.Clave ? "on" : "")"><i class="bi @c.Icono"></i> @c.Titulo</a>
            }
        }
    </nav>

    <div>
        <header class="hc-head ev-rise">
            <span class="ico"><i class="bi @Model.Icono"></i></span>
            <div>
                <div class="migas"><a asp-action="Index">Herramientas</a> › @Model.Grupo</div>
                <h1>@Model.Titulo</h1>
                <p>@Model.Descripcion</p>
            </div>
            <span class="sp"></span>
            <div class="big"><span id="hcTotal">—</span><small>registros</small></div>
            <button class="ev-btn" type="button" id="hcNuevo"><i class="bi bi-plus-lg"></i> @Model.Nuevo @Model.Singular</button>
        </header>

        <div class="ui-toolbar">
            <label class="ui-search"><i class="bi bi-search"></i><input id="hcQ" type="search" placeholder="Buscar en @Model.Titulo.ToLower()…" autocomplete="off"></label>
            <span id="hcFiltros" style="display:contents"></span>
            <select class="ui-select" id="hcTam" title="Filas por página"><option>25</option><option>50</option><option>100</option></select>
            <button type="button" class="hc-rev-btn ok" id="hcRevBtn" aria-expanded="false" aria-controls="hcRev" disabled><i class="bi bi-hourglass-split"></i> Revisando datos…</button>
        </div>

        <!-- Datos inconsistentes ya guardados: se pueden abrir y corregir desde aquí -->
        <section class="hc-rev" id="hcRev" hidden aria-live="polite"></section>

        <div id="hcLista"></div>
        <div class="hc-pager" id="hcPager" hidden><small id="hcRango"></small><div class="hc-pages" id="hcPages"></div></div>
    </div>
</div>

<!-- EDITOR -->
<aside class="ui-drawer" id="hcEditor" aria-hidden="true">
    <div class="ui-dh">
        <div class="ev-module-icon" style="width:46px;height:46px"><i class="bi @Model.Icono"></i></div>
        <div style="min-width:0"><h2 id="eTitulo">@Model.Singular</h2><small id="eSub"></small></div>
        <button class="ui-ibtn x" type="button" id="eCerrar" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
    </div>
    @if (Model.Especial == "alojamiento")
    {
        <div class="ui-tabs" id="eTabs" style="margin:0 24px">
            <button type="button" data-tab="ePaneDatos" class="on"><i class="bi bi-building"></i> Datos</button>
            <button type="button" data-tab="ePaneHabs"><i class="bi bi-door-open"></i> Habitaciones <span class="n" id="eNumHabs">0</span></button>
        </div>
    }
    <div class="ui-db">
        <div class="ui-pane on" id="ePaneDatos">
            <div id="eUso"></div>
            <div id="eForm"></div>
            @if (fotos is not null)
            {
                <div class="ui-f" style="margin-top:14px"><label>@(fotos.Value.Portada ? "Fotos" : "Galería") <em>se guardan al momento en multimedia</em></label><div id="eFotos"></div></div>
            }
        </div>
        @if (Model.Especial == "alojamiento")
        {
            <div class="ui-pane" id="ePaneHabs">
                <div style="display:flex;gap:8px;align-items:center;margin-bottom:12px;flex-wrap:wrap">
                    <label class="ui-search" style="flex:1;min-width:200px"><i class="bi bi-search"></i><input type="search" id="hbQ" placeholder="Filtrar habitaciones…"></label>
                    <button type="button" class="ev-btn sm" id="hbNueva"><i class="bi bi-plus-lg"></i> Nueva habitación</button>
                </div>
                <div id="hbForm"></div>
                <div id="hbLista"></div>
            </div>
        }
    </div>
    <div class="ui-df">
        <button class="ev-btn ghost" type="button" id="eEliminar"><i class="bi bi-trash3"></i> Eliminar</button>
        <span class="hint"><kbd>Ctrl</kbd> + <kbd>Enter</kbd> para guardar</span>
        <button class="ev-btn ghost" type="button" id="eCancelar">Cancelar</button>
        <button class="ev-btn" type="button" id="eGuardar"><i class="bi bi-check2-circle"></i> Guardar</button>
    </div>
</aside>

@section Scripts {
<script src="~/js/eurovip-ui.js" asp-append-version="true"></script>
<script src="~/js/eurovip-multimedia.js" asp-append-version="true"></script>
<script>
const HC = (() => {
    const $ = (s, el = document) => el.querySelector(s);
    const $$ = (s, el = document) => [...el.querySelectorAll(s)];
    const esc = EV.esc;
    const DEF = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Cliente(Model), opts));
    const HAB = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Cliente(hab), opts));
    const claves = DEF.campos.filter(c => c.clave).map(c => c.col);
    const url = new URLSearchParams(location.search);
    const st = { q: url.get('q') || '', pagina: 1, tam: 25, filtros: {} };
    const listas = {};
    let actual = null, nuevo = false;
    const drawer = EV.drawer($('#hcEditor'));
    const FOTOS = @Html.Raw(fotos is null ? "null" : System.Text.Json.JsonSerializer.Serialize(new { tipo = fotos.Value.Tipo, col = fotos.Value.Col, portada = fotos.Value.Portada }));
    let galeria = null;
    const tabs = $('#eTabs') ? EV.tabs($('#eTabs')) : null;

    const lista = async n => listas[n] ??= await EV.api('/Herramientas/Lista?nombre=' + n);
    const claveDe = f => Object.fromEntries(claves.map(c => [c, f[c]]));
    const fmtCelda = (c, v) => {
        if (v == null || v === '') return '<span style="color:var(--ev-muted)">—</span>';
        if (c.tipo === 'bool') return v ? '<span class="ui-chip" style="padding:2px 9px">Sí</span>' : '<span class="ui-chip ghost" style="padding:2px 9px">No</span>';
        if (c.tipo === 'url' || c.tipo === 'imagen') return esImg(v) ? `<img class="hc-cell-img" src="${esc(v)}" alt="" loading="lazy" onerror="this.replaceWith('—')">` : esc(v || '—');
        if (c.tipo === 'decimal') return EV.fmt(v, 2);
        if (c.tipo === 'estrellas' && /^[1-6]$/.test(String(v).trim())) return `<span class="hc-est-celda" title="${esc(v)} estrellas">${'★'.repeat(+v)}</span>`;
        return esc(String(v).length > 80 ? String(v).slice(0, 80) + '…' : v);
    };

    // ---------------- LISTA ----------------
    async function cargar() {
        $('#hcLista').innerHTML = '<div class="ui-skel" style="height:300px"></div>';
        const p = new URLSearchParams({ id: DEF.clave, q: st.q, pagina: st.pagina, tam: st.tam });
        Object.entries(st.filtros).forEach(([k, v]) => v !== '' && p.append('f_' + k, v));
        // Guardar búsqueda y filtros en la dirección: al recargar o volver atrás se ven igual (antes solo se leían)
        const enUrl = new URLSearchParams(location.search);
        [...enUrl.keys()].filter(k => k === 'q' || k.startsWith('f_')).forEach(k => enUrl.delete(k));
        if (st.q) enUrl.set('q', st.q);
        Object.entries(st.filtros).forEach(([k, v]) => v !== '' && v != null && enUrl.set('f_' + k, v));
        const qs = enUrl.toString();
        history.replaceState(null, '', location.pathname + (qs ? '?' + qs : '') + location.hash);
        try {
            const d = await EV.api('/Herramientas/Listar?' + p);
            $('#hcTotal').textContent = EV.fmt(d.total);
            pintar(d);
        } catch (e) { $('#hcLista').innerHTML = `<div class="ui-empty"><h3>No pudimos cargar</h3><p>${esc(e.message)}</p></div>`; }
    }

    function pintar(d) {
        const cols = DEF.campos.filter(c => c.enTabla && !(c.tipo === 'hotel' && st.filtros.id_alojamiento));
        const extras = DEF.extras || [];
        if (!d.filas.length) {
            $('#hcLista').innerHTML = `<div class="ui-empty"><i class="bi ${esc(DEF.icono)} big"></i><h3>${st.q || Object.values(st.filtros).some(v => v) ? 'Nada con esos filtros' : 'Todavía no hay registros'}</h3>
                <p>${st.q ? 'Prueba con otra palabra.' : ''}</p><button class="ev-btn" type="button" onclick="HC.nuevo()"><i class="bi bi-plus-lg"></i> ${esc(DEF.nuevo)} ${esc(DEF.singular)}</button></div>`;
            $('#hcPager').hidden = true; return;
        }
        $('#hcLista').innerHTML = `<div class="ui-table-wrap"><table class="ui-table"><thead><tr>
            ${cols.map(c => `<th>${esc(c.etiqueta)}</th>`).join('')}${extras.map(x => `<th>${esc(x.etiqueta)}</th>`).join('')}<th style="width:96px"></th></tr></thead><tbody>
            ${d.filas.map((f, i) => `<tr data-i="${i}">
                ${cols.map(c => `<td class="${c.clave && (c.tipo === 'number' || (c.max && c.max <= 10)) ? 'k' : ''}">${c.tipo === 'hotel' ? esc(f.hotel_nombre || f[c.col]) + ` <small style="color:var(--ev-muted)">#${f[c.col]}</small>` : fmtCelda(c, f[c.col])}</td>`).join('')}
                ${extras.map(x => `<td>${x.alias === 'habitaciones' ? `<span class="ui-chip ${f[x.alias] ? '' : 'ghost'}" style="padding:2px 9px">${EV.fmt(f[x.alias])}</span>` : esc(f[x.alias] ?? '—')}</td>`).join('')}
                <td style="white-space:nowrap;text-align:right"><button class="ui-ibtn" title="Editar" data-ed="${i}"><i class="bi bi-pencil"></i></button>
                    <button class="ui-ibtn danger" title="Eliminar" data-del="${i}"><i class="bi bi-trash3"></i></button></td></tr>`).join('')}
            </tbody></table></div>`;
        HC._filas = d.filas;
        const desde = (d.pagina - 1) * d.tam + 1, hasta = Math.min(d.pagina * d.tam, d.total), pags = Math.ceil(d.total / d.tam);
        $('#hcPager').hidden = false;
        $('#hcRango').textContent = `Mostrando ${EV.fmt(desde)}–${EV.fmt(hasta)} de ${EV.fmt(d.total)}`;
        $('#hcPages').innerHTML = pags <= 1 ? '' :
            `<button ${d.pagina === 1 ? 'disabled' : ''} data-p="${d.pagina - 1}"><i class="bi bi-chevron-left"></i></button>` +
            Array.from({ length: pags }, (_, i) => i + 1).filter(n => n === 1 || n === pags || Math.abs(n - d.pagina) <= 1)
                .map((n, i, a) => (i && n - a[i - 1] > 1 ? '<button disabled>…</button>' : '') + `<button class="${n === d.pagina ? 'on' : ''}" data-p="${n}">${n}</button>`).join('') +
            `<button ${d.pagina === pags ? 'disabled' : ''} data-p="${d.pagina + 1}"><i class="bi bi-chevron-right"></i></button>`;
    }

    async function pintarFiltros() {
        const html = [];
        for (const col of DEF.filtros || []) {
            const c = DEF.campos.find(x => x.col === col);
            if (c.tipo === 'bool') html.push(`<select class="ui-select" data-f="${col}"><option value="">${esc(c.etiqueta)}: todos</option><option value="1">${esc(c.etiqueta)}: sí</option><option value="0">${esc(c.etiqueta)}: no</option></select>`);
            else if (c.tipo === 'hotel') html.push(`<div class="ui-f" style="margin:0;min-width:260px"><input data-fhotel placeholder="Filtrar por hotel…" value=""></div>`);
            else if (c.lista) { const ops = await lista(c.lista); html.push(`<select class="ui-select" data-f="${col}"><option value="">Todos: ${esc(c.etiqueta.toLowerCase())}</option>${ops.map(o => `<option value="${esc(o.valor)}">${esc(o.texto)}</option>`).join('')}</select>`); }
        }
        $('#hcFiltros').innerHTML = html.join('');
        $$('#hcFiltros [data-f]').forEach(s => { if (url.get('f_' + s.dataset.f)) s.value = url.get('f_' + s.dataset.f); st.filtros[s.dataset.f] = s.value; s.onchange = () => { st.filtros[s.dataset.f] = s.value; st.pagina = 1; cargar(); }; });
        const fh = $('#hcFiltros [data-fhotel]');
        if (fh) {
            if (url.get('f_id_alojamiento')) { st.filtros.id_alojamiento = url.get('f_id_alojamiento'); fh.value = '#' + st.filtros.id_alojamiento; }
            EV.picker(fh, { url: q => `/Circuitos/Hoteles?q=${q}`, limpiar: false, map: x => ({ valor: x.id_Alojamiento, texto: x.nombre, sub: `${x.destino} · #${x.id_Alojamiento}`, icono: 'bi-building' }),
                onSelect: m => { st.filtros.id_alojamiento = m.valor; st.pagina = 1; cargar(); } });
            fh.addEventListener('input', () => { if (!fh.value.trim() && st.filtros.id_alojamiento) { st.filtros.id_alojamiento = ''; cargar(); } });
        }
    }

    // ---------------- FORMULARIO ----------------
    // Imágenes: rutas del sitio (/imagenes/…) o direcciones web
    const esImg = v => !!v && (EV.esUrl(v) || String(v).startsWith('/'));
    const previa = v => esImg(v) ? `<img src="${esc(v)}" alt="" onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'sin',textContent:'No se encontró la imagen'}))">`
                                 : '<span class="sin"><i class="bi bi-image"></i> Sin imagen</span>';

    async function campoHtml(c, v, esNuevo, pref = 'e') {
        const id = `${pref}_${c.col}`, bloqueado = (c.clave && !esNuevo) || (c.auto);
        const val = v ?? (esNuevo ? (c.defecto ?? '') : '');
        const lab = `<label for="${id}">${esc(c.etiqueta)}${c.req ? ' *' : ''}${c.ayuda ? ` <em>${esc(c.ayuda)}</em>` : ''}</label>`;
        const ro = bloqueado ? 'readonly tabindex="-1" style="opacity:.75"' : '';
        if (c.tipo === 'bool') return `<div class="ui-f"><label class="ui-switch" style="margin-top:26px"><input type="checkbox" id="${id}" data-c="${c.col}" ${val === true || val === 1 || val === '1' ? 'checked' : ''}><span class="tr"></span> ${esc(c.etiqueta)}</label></div>`;
        if (c.tipo === 'estrellas') {
            const n = /^[1-6]$/.test(String(val).trim()) ? +val : 0;
            return `<div class="ui-f"><label>${esc(c.etiqueta)}${c.req ? ' *' : ''}${c.ayuda ? ` <em>${esc(c.ayuda)}</em>` : ''}</label>
                <input type="hidden" id="${id}" data-c="${c.col}" value="${n || ''}">
                <div class="hc-est" role="radiogroup" aria-label="${esc(c.etiqueta)}" data-est="${c.col}">
                    ${[1, 2, 3, 4, 5, 6].map(i => `<button type="button" role="radio" aria-checked="${i === n}" aria-label="${i} estrella${i > 1 ? 's' : ''}" data-i="${i}" class="${i <= n ? 'on' : ''}">★</button>`).join('')}
                    <span class="n">${n ? n + ' estrella' + (n > 1 ? 's' : '') : 'Sin elegir'}</span></div><span class="msg"></span></div>`;
        }
        if (c.tipo === 'textarea') return `<div class="ui-f" style="grid-column:1/-1">${lab}<textarea id="${id}" data-c="${c.col}" rows="4">${esc(val)}</textarea></div>`;
        if (c.tipo === 'select') {
            const ops = await lista(c.lista);
            return `<div class="ui-f">${lab}<select id="${id}" data-c="${c.col}" ${bloqueado ? 'disabled' : ''}>${c.req ? '' : '<option value="">—</option>'}${ops.map(o => `<option value="${esc(o.valor)}" ${String(o.valor).toUpperCase() === String(val).toUpperCase() ? 'selected' : ''}>${esc(o.texto)}${o.valor !== o.texto && c.lista === 'paises' ? ' · ' + esc(o.valor) : ''}</option>`).join('')}</select><span class="msg"></span></div>`;
        }
        if (c.tipo === 'imagen') return `<div class="ui-f" style="grid-column:1/-1">${lab}
            <input type="hidden" id="${id}" data-c="${c.col}" value="${esc(val)}">
            <div class="hc-img" data-zona="${c.col}">
                <div class="hc-img-prev" data-prev="${c.col}">${previa(val)}</div>
                <div class="hc-img-acc">
                    <label class="ev-btn ghost sm" style="cursor:pointer"><input type="file" accept="image/jpeg,image/png,image/webp" data-subir="${c.col}" hidden><i class="bi bi-upload"></i> <span data-txt="${c.col}">${val ? 'Cambiar imagen' : 'Subir imagen'}</span></label>
                    <button type="button" class="ev-btn ghost sm" data-quitar="${c.col}" ${val ? '' : 'hidden'}><i class="bi bi-x-lg"></i> Quitar</button>
                    <small class="ui-help" style="margin:0">Arrastra una imagen aquí o pulsa Subir. JPG, PNG o WebP hasta 10 MB; se convierte a WebP.</small>
                    ${c.ayuda ? `<small class="ui-help" style="margin:0">${esc(c.ayuda)}</small>` : ''}
                </div>
            </div><span class="msg"></span></div>`;
        if (c.tipo === 'url') return `<div class="ui-f" style="grid-column:1/-1">${lab}<input id="${id}" data-c="${c.col}" maxlength="${c.max || ''}" value="${esc(val)}" placeholder="https://…"><span class="msg"></span><div class="hc-prev" data-prev="${c.col}">${EV.esUrl(val) ? `<img src="${esc(val)}" alt="" onerror="this.remove()">` : ''}</div></div>`;
        const tipo = c.tipo === 'number' || c.tipo === 'decimal' ? `type="number" step="${c.tipo === 'decimal' ? '0.01' : '1'}"` : '';
        const disp = c.tipo === 'hotel' && val ? (v && actual?.hotel_nombre ? `${actual.hotel_nombre}` : `#${val}`) : val;
        return `<div class="ui-f">${lab}<input id="${id}" data-c="${c.col}" ${tipo} maxlength="${c.max || ''}" value="${esc(disp)}" data-valor="${esc(val)}" class="${c.mayus ? 'may' : ''}" ${ro} autocomplete="off"><span class="msg"></span></div>`;
    }

    function activarCampos(cont, def, esNuevo) {
        def.campos.forEach(c => {
            const el = $(`[data-c="${c.col}"]`, cont); if (!el || el.readOnly) return;
            if (c.tipo === 'destino') {
                const pais = () => $('[data-c="id_pais"]', cont)?.value || '';
                EV.picker(el, { url: q => `/Circuitos/Destinos?pais=${encodeURIComponent(pais())}&q=${q}`, limpiar: false,
                    map: x => ({ valor: x.valor, texto: x.texto, sub: x.extra2 || x.extra, icono: 'bi-geo-alt' }), onSelect: m => { el.dataset.valor = m.valor; el.closest('.ui-f').classList.remove('err'); } });
                el.addEventListener('input', () => el.dataset.valor = '');
                $('[data-c="id_pais"]', cont)?.addEventListener('change', () => { el.value = ''; el.dataset.valor = ''; });
            }
            if (c.tipo === 'hotel') {
                EV.picker(el, { url: q => `/Circuitos/Hoteles?q=${q}`, limpiar: false, map: x => ({ valor: x.id_Alojamiento, texto: x.nombre, sub: `${x.destino} · #${x.id_Alojamiento}`, icono: 'bi-building' }),
                    onSelect: m => { el.dataset.valor = m.valor; } });
                el.addEventListener('input', () => el.dataset.valor = '');
            }
            if (c.tipo === 'tipohab') {
                EV.picker(el, { url: q => `/Herramientas/Lista?nombre=tiposHabitacion&q=${q}`, limpiar: false, map: x => ({ valor: x.valor, texto: x.texto, icono: 'bi-tag' }), onSelect: m => { el.dataset.valor = m.valor; } });
                el.addEventListener('input', () => el.dataset.valor = el.value);
            }
            if (c.tipo === 'imagen') {
                // Subir a wwwroot/imagenes/{carpeta}; el campo guarda la ruta y el registro se actualiza al pulsar Guardar
                const zona = $(`[data-zona="${c.col}"]`, cont), inp = $(`[data-subir="${c.col}"]`, cont);
                const pintar = (ruta, vista) => {
                    el.value = ruta || '';
                    $(`[data-prev="${c.col}"]`, cont).innerHTML = previa(vista || ruta);
                    $(`[data-txt="${c.col}"]`, cont).textContent = ruta ? 'Cambiar imagen' : 'Subir imagen';
                    $(`[data-quitar="${c.col}"]`, cont).hidden = !ruta;
                    el.dispatchEvent(new CustomEvent('ev-cambio', { bubbles: true }));   // el panel queda "con cambios sin guardar"
                };
                const subir = async archivo => {
                    if (!archivo) return;
                    if (!/^image\/(jpeg|png|webp)$/.test(archivo.type) || archivo.size > 10e6) { EV.toast('Elige una imagen JPG, PNG o WebP de hasta 10 MB.', 'err'); return; }
                    const n = $(`[data-c="${c.nombreDe}"]`, cont), nombre = (n?.dataset.valor || n?.value || '').trim();
                    if (!nombre) {
                        const et = def.campos.find(x => x.col === c.nombreDe);
                        EV.toast(et?.auto ? `Guarda primero ${DEF.el} ${DEF.singular} para poder subir la imagen (se nombra con su ${et.etiqueta.toLowerCase()}).`
                                          : `Primero completa «${et?.etiqueta || 'el nombre'}»: la imagen se guarda con ese nombre.`, 'err');
                        return;
                    }
                    const fd = new FormData(); fd.append('nombre', nombre); fd.append('archivo', archivo);
                    zona.classList.add('subiendo');
                    try {
                        // fetch directo (no EV.post): subir el archivo no es guardar el registro, el aviso de "sin guardar" debe seguir
                        const r = await fetch(`/Herramientas/SubirImagen?id=${encodeURIComponent(def.clave)}&campo=${encodeURIComponent(c.col)}`, { method: 'POST', body: fd, headers: { RequestVerificationToken: EV.token() } });
                        const d = await r.json().catch(() => ({}));
                        if (!r.ok) throw new Error(d.mensaje || 'No se pudo subir la imagen.');
                        pintar(d.ruta, d.url); EV.toast(d.mensaje);
                    } catch (e) { EV.toast(e.message, 'err'); }
                    finally { zona.classList.remove('subiendo'); inp.value = ''; }
                };
                inp.addEventListener('change', () => subir(inp.files[0]));
                $(`[data-quitar="${c.col}"]`, cont).addEventListener('click', () => pintar(''));
                ['dragenter', 'dragover'].forEach(t => zona.addEventListener(t, e => { e.preventDefault(); zona.classList.add('sobre'); }));
                ['dragleave', 'drop'].forEach(t => zona.addEventListener(t, e => { e.preventDefault(); zona.classList.remove('sobre'); }));
                zona.addEventListener('drop', e => subir(e.dataTransfer?.files?.[0]));
            }
            if (c.tipo === 'estrellas') {
                // Clic = elegir; pasar el ratón = vista previa; flechas izquierda/derecha también cambian
                const caja = $(`[data-est="${c.col}"]`, cont), bs = $$('button', caja), txt = $('.n', caja);
                const pintar = n => { bs.forEach(b => { b.classList.toggle('on', +b.dataset.i <= n); b.setAttribute('aria-checked', String(+b.dataset.i === n)); }); txt.textContent = n ? `${n} estrella${n > 1 ? 's' : ''}` : 'Sin elegir'; };
                const elegir = n => { el.value = n; pintar(n); el.closest('.ui-f').classList.remove('err'); el.dispatchEvent(new CustomEvent('ev-cambio', { bubbles: true })); };
                bs.forEach(b => {
                    b.addEventListener('click', () => elegir(+b.dataset.i));
                    b.addEventListener('mouseenter', () => pintar(+b.dataset.i));
                    b.addEventListener('keydown', e => { const n = +el.value || 0; if (e.key === 'ArrowRight' || e.key === 'ArrowUp') { e.preventDefault(); elegir(Math.min(6, n + 1)); bs[Math.min(5, n)].focus(); } if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') { e.preventDefault(); elegir(Math.max(1, n - 1)); bs[Math.max(0, n - 2)].focus(); } });
                });
                caja.addEventListener('mouseleave', () => pintar(+el.value || 0));
            }
            if (c.tipo === 'url') el.addEventListener('change', () => { const p = $(`[data-prev="${c.col}"]`, cont); p.innerHTML = EV.esUrl(el.value) ? `<img src="${esc(el.value)}" alt="" onerror="this.remove()">` : ''; });
        });
    }

    function leer(cont, def) {
        const datos = {}, err = [];
        $$('.ui-f.err', cont).forEach(f => f.classList.remove('err'));
        def.campos.forEach(c => {
            const el = $(`[data-c="${c.col}"]`, cont); if (!el) return;
            let v = c.tipo === 'bool' ? el.checked : (['destino', 'hotel', 'tipohab'].includes(c.tipo) ? el.dataset.valor : el.value);
            if (typeof v === 'string') v = v.trim();
            if (c.mayus && typeof v === 'string') v = v.toUpperCase();
            if (c.req && !c.auto && (v === '' || v == null) && !(c.defecto === '')) {
                const f = el.closest('.ui-f'); f.classList.add('err'); const m = $('.msg', f);
                const msg = ['destino', 'hotel'].includes(c.tipo) && el.value ? 'Elígelo de la lista' : 'Obligatorio';
                if (m) m.textContent = msg; err.push(`${c.etiqueta}: ${msg.toLowerCase()}`);
            }
            datos[c.col] = v;
        });
        return { datos, err };
    }

    async function abrir(fila) {
        nuevo = !fila;
        actual = null;
        $('#eUso').innerHTML = '';
        if (fila) {
            try { const r = await EV.post(`/Herramientas/Obtener?id=${DEF.clave}`, { Clave: claveDe(fila) }); actual = r.fila;
                  $('#eUso').innerHTML = r.usos.length
                    ? `<div class="hc-uso"><i class="bi bi-link-45deg"></i> Se usa en: ${r.usos.map(u => `<span class="ui-chip">${EV.fmt(u.n)} ${esc(u.etiqueta)}</span>`).join('')}<small style="color:var(--ev-muted);width:100%">Por eso no se puede eliminar${DEF.especial === 'alojamiento' ? ' (puedes desactivarlo)' : ''}.</small></div>`
                    : `<div class="hc-uso" style="color:var(--ev-muted)"><i class="bi bi-check2-circle"></i> No se usa en ninguna oferta ni circuito.</div>`;
                  $('#eEliminar').disabled = r.usos.length > 0; }
            catch (e) { EV.toast(e.message, 'err'); return; }
        } else $('#eEliminar').disabled = true;
        $('#eTitulo').textContent = nuevo ? `${DEF.nuevo} ${DEF.singular}` : (actual.nombre || actual.descripcion || actual[DEF.campos.find(c => !c.auto && c.tipo !== 'select' && c.tipo !== 'hotel').col] || DEF.singular);
        $('#eSub').textContent = nuevo ? DEF.titulo : claves.map(c => actual[c]).join(' · ');
        $('#eEliminar').hidden = nuevo;
        const htmls = await Promise.all(DEF.campos.filter(c => !(nuevo && c.auto)).map(c => campoHtml(c, actual?.[c.col], nuevo)));
        $('#eForm').innerHTML = `<div class="ui-row">${htmls.join('')}</div>${!nuevo && claves.length ? `<div class="ui-help">Los campos clave (${DEF.campos.filter(c => c.clave).map(c => c.etiqueta.toLowerCase()).join(', ')}) no se cambian: para eso crea uno nuevo.</div>` : ''}`;
        if (actual && DEF.campos.some(c => c.tipo === 'destino')) { const d = $('[data-c="id_destino"]', $('#eForm')); if (d) d.dataset.valor = actual.id_destino; }
        if (actual && DEF.campos.some(c => c.tipo === 'tipohab')) { const d = $('[data-c="id_tipo_habitacion"]', $('#eForm')); if (d) d.dataset.valor = actual.id_tipo_habitacion; }
        if (nuevo && st.filtros.id_alojamiento && DEF.campos.some(c => c.tipo === 'hotel')) { const h = $('[data-c="id_alojamiento"]', $('#eForm')); h.dataset.valor = st.filtros.id_alojamiento; h.value = $('#hcFiltros [data-fhotel]').value; }
        activarCampos($('#eForm'), DEF, nuevo);
        if (FOTOS) {
            galeria ??= EVMultimedia.montar($('#eFotos'), { tipo: FOTOS.tipo, portada: FOTOS.portada, nombre: `${DEF.el} ${DEF.singular}` });
            galeria.cambiar(nuevo ? null : actual?.[FOTOS.col]);
        }
        if (tabs) { tabs.ir('ePaneDatos'); $('#eTabs [data-tab="ePaneHabs"]').disabled = nuevo; $('#eNumHabs').textContent = actual?.habitaciones ?? 0; if (!nuevo) habs(); }
        drawer.abrir();
        setTimeout(() => $('#eForm input:not([readonly]), #eForm select:not([disabled])')?.focus(), 80);
    }

    async function guardar() {
        const { datos, err } = leer($('#eForm'), DEF);
        if (!nuevo) claves.forEach(c => datos[c] = actual[c]);
        if (err.length) { EV.toast(err[0], 'err'); return; }
        const b = $('#eGuardar'), html = b.innerHTML; b.disabled = true; b.innerHTML = '<span class="ui-spin"></span> Guardando…';
        try {
            const r = await EV.post(`/Herramientas/Guardar?id=${DEF.clave}`, { Datos: datos, Nuevo: nuevo });
            EV.toast(r.mensaje);
            cargar(); revisar();
            if (DEF.especial === 'alojamiento' && nuevo) { await abrir(r.clave); tabs.ir('ePaneHabs'); EV.toast('Ahora agrega sus habitaciones.', 'info'); }
            else drawer.cerrar();
        } catch (e) { EV.toast(e.message, 'err'); }
        finally { b.disabled = false; b.innerHTML = html; }
    }

    async function eliminar(fila) {
        const k = claveDe(fila);
        const nombre = fila.nombre || fila.descripcion || claves.map(c => fila[c]).join(' · ');
        if (!await EV.confirmar({ titulo: `¿Eliminar ${DEF.el} ${DEF.singular}?`, peligro: true, si: 'Sí, eliminar',
            texto: `Se eliminará <b>${esc(nombre)}</b>${DEF.especial === 'alojamiento' ? ' con todas sus habitaciones' : ''}. No se puede deshacer. Si se usa en ofertas o circuitos, no te dejará.` })) return;
        try { const r = await EV.post(`/Herramientas/Eliminar?id=${DEF.clave}`, { Clave: k }); EV.toast(r.mensaje); drawer.cerrar(); cargar(); revisar(); }
        catch (e) { EV.toast(e.message, 'err'); }
    }

    // ---------------- HABITACIONES (dentro de un alojamiento) ----------------
    let habFilas = [], habEdit = null;
    async function habs() {
        $('#hbLista').innerHTML = '<div class="ui-skel" style="height:160px"></div>';
        const d = await EV.api(`/Herramientas/Listar?id=habitaciones&tam=100&f_id_alojamiento=${actual.id_alojamiento}&q=${encodeURIComponent($('#hbQ').value.trim())}`);
        habFilas = d.filas;
        $('#eNumHabs').textContent = d.total;
        $('#hbLista').innerHTML = !d.filas.length ? '<div class="ui-empty" style="padding:22px"><p style="margin:0">Sin habitaciones. Agrega la primera.</p></div>'
            : `<div class="ui-table-wrap"><table class="ui-table"><thead><tr><th>#</th><th>Habitación</th><th>Tipo</th><th class="num">Supl.</th><th style="width:90px"></th></tr></thead><tbody>
              ${d.filas.map((h, i) => `<tr><td class="k">${h.id_habitacion}</td><td><b>${esc(h.nombre)}</b>${h.codigo ? ` <small style="color:var(--ev-muted)">${esc(h.codigo)}</small>` : ''}</td><td>${esc(h.id_tipo_habitacion)}</td><td class="num">${EV.fmt(h.precio, 2)}</td>
                <td style="text-align:right;white-space:nowrap"><button class="ui-ibtn" data-hed="${i}" title="Editar"><i class="bi bi-pencil"></i></button><button class="ui-ibtn danger" data-hdel="${i}" title="Eliminar"><i class="bi bi-trash3"></i></button></td></tr>`).join('')}
              </tbody></table></div>${d.total > 100 ? `<div class="ui-help">Mostrando 100 de ${EV.fmt(d.total)}. Usa el filtro para encontrar la que buscas.</div>` : ''}`;
    }
    async function habForm(h) {
        habEdit = h;
        const campos = HAB.campos.filter(c => c.tipo !== 'hotel' && !(c.auto && !h));
        const htmls = await Promise.all(campos.map(c => campoHtml(c, h?.[c.col], !h, 'h')));
        $('#hbForm').innerHTML = `<div class="hb-form"><b style="display:block;margin-bottom:10px">${h ? 'Editar habitación #' + h.id_habitacion : 'Nueva habitación'}</b><div class="ui-row r3">${htmls.join('')}</div>
            <div style="display:flex;gap:8px;justify-content:flex-end"><button type="button" class="ev-btn ghost sm" id="hbCancelar">Cancelar</button><button type="button" class="ev-btn sm" id="hbGuardar"><i class="bi bi-check2"></i> Guardar habitación</button></div></div>`;
        if (h) $('[data-c="id_tipo_habitacion"]', $('#hbForm')).dataset.valor = h.id_tipo_habitacion;
        activarCampos($('#hbForm'), { campos }, !h);
        $('#hbCancelar').onclick = () => $('#hbForm').innerHTML = '';
        $('#hbGuardar').onclick = async () => {
            const { datos, err } = leer($('#hbForm'), { campos });
            if (err.length) { EV.toast(err[0], 'err'); return; }
            datos.id_alojamiento = actual.id_alojamiento;
            if (h) datos.id_habitacion = h.id_habitacion;
            try { const r = await EV.post('/Herramientas/Guardar?id=habitaciones', { Datos: datos, Nuevo: !h }); EV.toast(r.mensaje); $('#hbForm').innerHTML = ''; habs(); cargar(); }
            catch (e) { EV.toast(e.message, 'err'); }
        };
        $('#hbForm input:not([readonly])')?.focus();
    }

    // ---------------- DATOS A REVISAR ----------------
    let revFilas = [];
    async function revisar() {
        const b = $('#hcRevBtn');
        let grupos = [];
        try { grupos = await EV.api('/Herramientas/Revisar?id=' + DEF.clave); } catch { b.hidden = true; return; }
        const total = grupos.reduce((s, g) => s + g.total, 0);
        if (!total) {
            b.className = 'hc-rev-btn ok'; b.disabled = true; b.setAttribute('aria-expanded', 'false');
            b.innerHTML = '<i class="bi bi-check2-circle"></i> Sin datos a revisar';
            $('#hcRev').hidden = true; return;
        }
        b.className = 'hc-rev-btn'; b.disabled = false;
        b.innerHTML = `<i class="bi bi-exclamation-triangle-fill"></i> ${EV.fmt(total)} dato${total === 1 ? '' : 's'} a revisar`;
        revFilas = [];
        $('#hcRev').innerHTML = `<h3><i class="bi bi-exclamation-triangle-fill"></i> Datos a revisar en ${esc(DEF.titulo.toLowerCase())}</h3>
            <p>Estos registros ya estaban guardados y no cumplen las reglas (ahora no se dejan cargar así). Pulsa uno para abrirlo y corregirlo.</p>
            ${grupos.map((g, gi) => `<details class="hc-rev-g" ${gi === 0 ? 'open' : ''}><summary><span class="n">${EV.fmt(g.total)}</span> ${esc(g.motivo)} <small>${esc(g.ayuda)}</small><i class="bi bi-chevron-down"></i></summary>
                <table><tbody>${g.filas.map(f => { revFilas.push(f); return `<tr data-r="${revFilas.length - 1}"><td class="v">${esc(f.valor ?? '—')}</td><td class="d">${esc(f.detalle ?? '')}</td>
                    <td style="text-align:right"><span class="ui-ibtn" title="Abrir"><i class="bi bi-pencil"></i></span></td></tr>`; }).join('')}</tbody></table>
                ${g.total > g.filas.length ? `<div class="ui-help" style="margin:8px 14px">Se muestran ${g.filas.length} de ${EV.fmt(g.total)}.</div>` : ''}</details>`).join('')}`;
    }

    // ---------------- INICIO ----------------
    async function iniciar() {
        $('#hcRevBtn').onclick = () => { const p = $('#hcRev'), abierto = p.hidden; p.hidden = !abierto; $('#hcRevBtn').setAttribute('aria-expanded', String(abierto)); };
        $('#hcRev').addEventListener('click', e => { const tr = e.target.closest('tr[data-r]'); if (tr) abrir(revFilas[+tr.dataset.r]); });
        revisar();
        $('#hcQ').value = st.q;
        await pintarFiltros();
        $('#hcQ').addEventListener('input', EV.debounce(e => { st.q = e.target.value.trim(); st.pagina = 1; cargar(); }, 300));
        $('#hcTam').onchange = e => { st.tam = +e.target.value; st.pagina = 1; cargar(); };
        $('#hcPages').addEventListener('click', e => { const b = e.target.closest('[data-p]'); if (b && !b.disabled) { st.pagina = +b.dataset.p; cargar(); window.scrollTo({ top: 0, behavior: 'smooth' }); } });
        $('#hcLista').addEventListener('click', e => {
            const del = e.target.closest('[data-del]'); if (del) { e.stopPropagation(); return eliminar(HC._filas[+del.dataset.del]); }
            const tr = e.target.closest('tr[data-i]'); if (tr) abrir(HC._filas[+tr.dataset.i]);
        });
        $('#hcNuevo').onclick = () => abrir(null);
        $('#eGuardar').onclick = guardar;
        $('#eEliminar').onclick = () => actual && eliminar(actual);
        $('#eCerrar').onclick = $('#eCancelar').onclick = () => drawer.cerrar();
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') drawer.cerrar();
            if (drawer.abierto() && e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); guardar(); }
        });
        if ($('#hbNueva')) {
            $('#hbNueva').onclick = () => habForm(null);
            $('#hbQ').addEventListener('input', EV.debounce(habs, 300));
            $('#hbLista').addEventListener('click', async e => {
                const ed = e.target.closest('[data-hed]'); if (ed) return habForm(habFilas[+ed.dataset.hed]);
                const de = e.target.closest('[data-hdel]');
                if (de) {
                    const h = habFilas[+de.dataset.hdel];
                    if (!await EV.confirmar({ titulo: '¿Eliminar habitación?', texto: `Se eliminará <b>${esc(h.nombre)}</b>. Si se usa en ofertas, no te dejará.`, peligro: true, si: 'Sí, eliminar' })) return;
                    try { const r = await EV.post('/Herramientas/Eliminar?id=habitaciones', { Clave: { id_alojamiento: h.id_alojamiento, id_habitacion: h.id_habitacion } }); EV.toast(r.mensaje); habs(); cargar(); }
                    catch (err) { EV.toast(err.message, 'err'); }
                }
            });
        }
        await cargar();
        if (url.get('abrir')) { try { abrir(JSON.parse(url.get('abrir'))); } catch { } }
        if (url.get('nuevo')) abrir(null);
    }
    document.addEventListener('DOMContentLoaded', iniciar);

    return { nuevo: () => abrir(null) };
})();
</script>
}
