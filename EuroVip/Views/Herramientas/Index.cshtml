@using EuroVip.Models
@{
    ViewData["Title"] = "Herramientas";
    var grupos = HrCatalogos.Todos.Select(c => c.Grupo).Distinct().ToList();
    var iconoGrupo = new Dictionary<string, string> { ["Geografía"] = "bi-globe2", ["Comercial"] = "bi-tags", ["Proveedores"] = "bi-briefcase", ["Hoteles"] = "bi-building" };
    // tamaño de cada tarjeta en el mosaico
    var tam = new Dictionary<string, string> { ["alojamientos"] = "xl", ["destinos"] = "wide", ["habitaciones"] = "wide", ["campanyas"] = "tall" };
    var i = 0;
}

@section Styles {
<link rel="stylesheet" href="~/css/eurovip-ui.css" asp-append-version="true" />
<style>
    /* ================= PORTADA ================= */
    .ht-hero { position: relative; z-index: 20; border-radius: 32px; padding: 34px 36px 30px; background: var(--ev-ink); color: #fff; isolation: isolate; }
    .ht-deco { position: absolute; inset: 0; border-radius: inherit; overflow: hidden; z-index: -1; pointer-events: none; }
    .ht-deco::before { content: ""; position: absolute; inset: 0;
        background-image: linear-gradient(rgba(116,242,230,.07) 1px, transparent 1px), linear-gradient(90deg, rgba(116,242,230,.07) 1px, transparent 1px);
        background-size: 34px 34px; mask-image: radial-gradient(ellipse at 70% 0%, #000 0%, transparent 70%); }
    .ht-blob { position: absolute; border-radius: 50%; filter: blur(60px); z-index: -1; opacity: .55; animation: htBlob 14s ease-in-out infinite alternate; }
    .ht-blob.a { width: 380px; height: 380px; background: #2BD4C4; right: -80px; top: -140px; }
    .ht-blob.b { width: 300px; height: 300px; background: #74F2E6; right: 280px; bottom: -200px; animation-delay: -5s; opacity: .35; }
    .ht-blob.c { width: 220px; height: 220px; background: #B3FFF3; left: -90px; top: -90px; animation-delay: -9s; opacity: .18; }
    @@keyframes htBlob { to { transform: translate(-40px, 30px) scale(1.15); } }
    .ht-orbita { position: absolute; right: 60px; top: 50%; width: 250px; height: 250px; margin-top: -125px; border-radius: 50%; border: 1px dashed rgba(116,242,230,.25); z-index: -1; animation: htGira 50s linear infinite; }
    .ht-orbita i { position: absolute; width: 42px; height: 42px; margin: -21px; border-radius: 14px; display: grid; place-items: center; font-size: 18px;
                   background: rgba(255,255,255,.08); border: 1px solid rgba(116,242,230,.3); color: #74F2E6; backdrop-filter: blur(6px); animation: htGira 50s linear infinite reverse; }
    .ht-orbita .nucleo { position: absolute; inset: 70px; border-radius: 50%; background: radial-gradient(circle, rgba(116,242,230,.35), transparent 70%); display: grid; place-items: center; font-size: 46px; color: #B3FFF3; animation: htGira 50s linear infinite reverse; }
    @@keyframes htGira { to { transform: rotate(360deg); } }
    .ht-hero .tag { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 99px; background: rgba(116,242,230,.14); color: #B3FFF3; font: 700 12px var(--ev-font); }
    .ht-hero .tag b { width: 7px; height: 7px; border-radius: 50%; background: #74F2E6; animation: htPulse 2s infinite; }
    @@keyframes htPulse { 0% { box-shadow: 0 0 0 0 rgba(116,242,230,.7); } 100% { box-shadow: 0 0 0 8px rgba(116,242,230,0); } }
    .ht-hero h1 { font-size: clamp(32px, 4vw, 48px); font-weight: 800; letter-spacing: -2px; margin: 14px 0 6px; line-height: 1; }
    .ht-hero h1 span { background: linear-gradient(90deg, #B3FFF3, #74F2E6, #2BD4C4); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .ht-hero p { margin: 0; max-width: 58ch; color: rgba(232,255,251,.72); font-weight: 500; font-size: 15px; }
    .ht-stats { display: flex; gap: 12px; margin: 22px 0 22px; flex-wrap: wrap; }
    .ht-stat { padding: 12px 18px; border-radius: 18px; background: rgba(255,255,255,.06); border: 1px solid rgba(116,242,230,.18); min-width: 130px; }
    .ht-stat b { display: block; font-size: 26px; font-weight: 800; letter-spacing: -1px; color: #fff; line-height: 1.1; }
    .ht-stat small { color: rgba(232,255,251,.6); font-weight: 600; font-size: 12px; }

    /* buscador tipo paleta de comandos */
    .ht-cmd { position: relative; max-width: 720px; z-index: 5; }
    .ht-cmd .caja { display: flex; align-items: center; gap: 12px; padding: 8px 10px 8px 20px; border-radius: 20px; background: rgba(255,255,255,.96); box-shadow: 0 20px 50px -20px rgba(0,0,0,.6); }
    .ht-cmd .caja i { color: var(--ev-deep); font-size: 18px; }
    .ht-cmd input { flex: 1; border: 0; outline: 0; background: transparent; font: 600 16px var(--ev-font); color: #0B1215; padding: 12px 0; min-width: 0; }
    .ht-cmd kbd { font: 700 11px var(--ev-font); padding: 5px 9px; border-radius: 9px; background: #F1FBF9; border: 1px solid #DCEBE8; color: #66807C; }
    .ht-pal { position: absolute; left: 0; right: 0; top: calc(100% + 10px); max-height: 440px; overflow: auto; border-radius: 22px; background: var(--ev-surface); color: var(--ev-text);
              border: 1px solid var(--ev-line); box-shadow: var(--ev-shadow-lg); padding: 8px; display: none; animation: uiFade .2s var(--ev-ease); }
    .ht-pal.on { display: block; }
    .ht-pal .g { font: 800 11px var(--ev-font); letter-spacing: .07em; text-transform: uppercase; color: var(--ev-muted); padding: 10px 12px 4px; display: flex; gap: 8px; align-items: center; }
    .ht-pal a { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 14px; color: var(--ev-text); text-decoration: none; font-weight: 700; font-size: 14px; }
    .ht-pal a .mi { width: 32px; height: 32px; border-radius: 10px; background: var(--ev-grad-soft); border: 1px solid var(--ev-line); display: grid; place-items: center; color: var(--ev-deep); flex-shrink: 0; }
    .ht-pal a small { color: var(--ev-muted); font-weight: 600; margin-left: auto; font-size: 12px; text-align: right; }
    .ht-pal a.sel, .ht-pal a:hover { background: var(--ev-grad-soft); }
    .ht-pal a.sel { box-shadow: inset 0 0 0 1.5px var(--ev-aqua); }
    .ht-pal .vacio { padding: 26px; text-align: center; color: var(--ev-muted); font-weight: 600; }

    /* ================= CUERPO ================= */
    .ht-body { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 22px; margin-top: 24px; align-items: start; }
    .ht-filtro { display: flex; gap: 6px; padding: 6px; border-radius: 18px; background: var(--ev-surface); border: 1px solid var(--ev-line); width: fit-content; max-width: 100%; overflow-x: auto; margin-bottom: 16px; }
    .ht-filtro button { display: flex; align-items: center; gap: 8px; border: 0; background: transparent; padding: 9px 14px; border-radius: 13px; font: 700 13.5px var(--ev-font); color: var(--ev-muted); cursor: pointer; white-space: nowrap; transition: all .25s var(--ev-ease); }
    .ht-filtro button span { font-size: 11px; padding: 2px 7px; border-radius: 99px; background: var(--ev-surface-2); }
    .ht-filtro button.on { background: var(--ev-ink); color: #fff; }
    .ht-filtro button.on span { background: rgba(116,242,230,.2); color: var(--ev-aqua); }

    /* mosaico */
    .ht-bento { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: 200px; grid-auto-flow: dense; gap: 14px; }
    .ht-card { --c1: #B3FFF3; --c2: #74F2E6; position: relative; overflow: hidden; border-radius: 26px; padding: 18px 20px; background: var(--ev-surface); border: 1px solid var(--ev-line);
               color: var(--ev-text); text-decoration: none; display: flex; flex-direction: column; transition: transform .35s var(--ev-ease), box-shadow .35s var(--ev-ease), border-color .35s, opacity .3s;
               animation: evRise .6s var(--ev-ease) both; animation-delay: calc(var(--n) * 45ms); }
    .ht-card.wide { grid-column: span 2; }
    .ht-card.tall { grid-row: span 2; }
    .ht-card.xl { grid-column: span 2; grid-row: span 2; }
    .ht-card[data-g="Geografía"] { --c1: #B3FFF3; --c2: #74F2E6; }
    .ht-card[data-g="Comercial"] { --c1: #74F2E6; --c2: #2BD4C4; }
    .ht-card[data-g="Proveedores"] { --c1: #CFFAF4; --c2: #8EEADF; }
    .ht-card[data-g="Hoteles"] { --c1: #2BD4C4; --c2: #0E8F86; }
    .ht-card .fondo { position: absolute; right: -24px; bottom: -34px; font-size: 150px; line-height: 1; color: var(--c2); opacity: .13; transform: rotate(-12deg); transition: transform .6s var(--ev-ease), opacity .4s; pointer-events: none; }
    .ht-card::before { content: ""; position: absolute; inset: 0; background: radial-gradient(500px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--c2) 22%, transparent), transparent 40%); opacity: 0; transition: opacity .3s; pointer-events: none; }
    .ht-card:hover { transform: translateY(-5px); box-shadow: 0 26px 50px -26px color-mix(in srgb, var(--c2) 70%, #000); border-color: var(--c2); }
    .ht-card:hover::before { opacity: 1; }
    .ht-card:hover .fondo { transform: rotate(0) scale(1.08); opacity: .2; }
    .ht-card .top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; position: relative; }
    .ht-card .ico { width: 50px; height: 50px; border-radius: 16px; background: linear-gradient(135deg, var(--c1), var(--c2)); display: grid; place-items: center; font-size: 22px; color: #0B1215; box-shadow: 0 10px 22px -10px var(--c2); }
    .ht-card[data-g="Hoteles"] .ico { color: #fff; }
    .ht-card .nuevo { opacity: 0; transform: translateY(-4px); transition: all .25s var(--ev-ease); border: 0; border-radius: 12px; padding: 7px 11px; background: var(--ev-ink); color: var(--ev-aqua); font: 800 12px var(--ev-font); cursor: pointer; display: flex; gap: 6px; align-items: center; }
    .ht-card:hover .nuevo, .ht-card:focus-within .nuevo { opacity: 1; transform: none; }
    .ht-card b.t { font-size: 17px; font-weight: 800; letter-spacing: -.3px; margin-top: 12px; position: relative; flex-shrink: 0; }
    .ht-card p { margin: 3px 0 0; color: var(--ev-muted); font-weight: 500; font-size: 13px; position: relative; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; flex-shrink: 0; }
    .ht-rev { display: inline-flex; align-items: center; gap: 5px; margin-top: 10px; padding: 4px 10px; border-radius: 10px; background: #FEF3C7; color: #92400E; font: 800 12px var(--ev-font); align-self: flex-start; position: relative; }
    .ht-card .pie { margin-top: auto; display: flex; align-items: flex-end; justify-content: space-between; position: relative; }
    .ht-card .num { font-size: 30px; font-weight: 800; letter-spacing: -1.4px; line-height: 1; }
    .ht-card .num small { display: block; font-size: 11.5px; letter-spacing: 0; color: var(--ev-muted); font-weight: 700; margin-top: 3px; }
    .ht-card .ir { width: 40px; height: 40px; border-radius: 13px; background: var(--ev-surface-2); border: 1px solid var(--ev-line); display: grid; place-items: center; transition: all .3s var(--ev-ease); }
    .ht-card:hover .ir { background: var(--ev-ink); color: var(--ev-aqua); border-color: var(--ev-ink); transform: translateX(3px); }
    .ht-card.xl { background: linear-gradient(150deg, var(--ev-surface) 40%, color-mix(in srgb, var(--c1) 30%, var(--ev-surface))); }
    .ht-card.xl .num { font-size: 52px; letter-spacing: -2.5px; }
    .ht-card.xl b.t { font-size: 24px; }
    .ht-card.xl p { font-size: 14.5px; -webkit-line-clamp: 3; }
    .ht-card .extra { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; position: relative; }
    .ht-card .extra span { padding: 6px 11px; border-radius: 11px; background: var(--ev-surface); border: 1px solid var(--ev-line); font-weight: 700; font-size: 12.5px; }
    .ht-card.oculta { display: none; }

    /* actividad */
    .ht-aside { position: sticky; top: 92px; display: grid; gap: 14px; }
    .ht-panel { border-radius: 24px; background: var(--ev-surface); border: 1px solid var(--ev-line); padding: 18px; }
    .ht-panel h3 { margin: 0 0 12px; font-size: 15px; font-weight: 800; display: flex; align-items: center; gap: 8px; }
    .ht-act { list-style: none; margin: 0; padding: 0; position: relative; }
    .ht-act::before { content: ""; position: absolute; left: 17px; top: 8px; bottom: 8px; width: 2px; background: var(--ev-line); }
    .ht-act li { display: flex; gap: 12px; padding: 8px 0; position: relative; }
    .ht-act .pt { width: 36px; height: 36px; border-radius: 12px; display: grid; place-items: center; flex-shrink: 0; background: var(--ev-surface-2); border: 1px solid var(--ev-line); z-index: 1; font-size: 15px; }
    .ht-act .pt.Crear { background: #DCFCE7; color: #166534; border-color: #BBF7D0; }
    .ht-act .pt.Editar { background: #E0F2FE; color: #075985; border-color: #BAE6FD; }
    .ht-act .pt.Eliminar { background: #FEE4E2; color: #B42318; border-color: #FECDCA; }
    .ht-act b { display: block; font-size: 13px; font-weight: 800; }
    .ht-act small { color: var(--ev-muted); font-weight: 600; font-size: 12px; }
    .ht-tips { display: grid; gap: 10px; font-size: 13px; font-weight: 600; color: var(--ev-muted); }
    .ht-tips div { display: flex; align-items: center; gap: 10px; }
    .ht-tips kbd { font: 800 11px var(--ev-font); padding: 4px 8px; border-radius: 8px; background: var(--ev-surface-2); border: 1px solid var(--ev-line); color: var(--ev-text); min-width: 26px; text-align: center; }
    .ht-db { background: var(--ev-ink); color: #fff; border-color: var(--ev-ink); }
    .ht-db p { margin: 0; color: rgba(232,255,251,.7); font-size: 13px; font-weight: 500; }
    .ht-db code { color: var(--ev-aqua); }

    @@media (max-width: 1350px) { .ht-body { grid-template-columns: 1fr; } .ht-aside { position: static; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); } }
    @@media (max-width: 1100px) { .ht-orbita { display: none; } .ht-bento { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: minmax(200px, auto); } .ht-card.tall, .ht-card.xl { grid-row: auto; } .ht-card.xl { min-height: 260px; } }
    @@media (max-width: 640px) { .ht-bento { grid-template-columns: 1fr; grid-auto-rows: auto; } .ht-card, .ht-card.wide, .ht-card.tall, .ht-card.xl { grid-column: auto; grid-row: auto; min-height: 170px; } .ht-hero { padding: 26px 20px; } }
    @@media (prefers-reduced-motion: reduce) { .ht-blob, .ht-orbita, .ht-orbita i, .ht-orbita .nucleo, .ht-card { animation: none !important; } }

    /* ================= CAMBIO 140: secciones con pestañas + cargas de proveedores ================= */
    .ht-secciones { position: sticky; top: 8px; z-index: 15; margin: 22px 0 0; display: flex; gap: 6px; padding: 6px; width: fit-content; max-width: 100%; overflow-x: auto;
                    border-radius: 20px; background: var(--ev-surface); border: 1px solid var(--ev-line); box-shadow: var(--ev-shadow); }
    .ht-secciones button { display: flex; align-items: center; gap: 9px; border: 0; background: transparent; padding: 11px 18px; border-radius: 15px; font: 800 14px var(--ev-font);
                           color: var(--ev-muted); cursor: pointer; white-space: nowrap; transition: all .25s var(--ev-ease); }
    .ht-secciones button:hover { color: var(--ev-text); background: var(--ev-surface-2); }
    .ht-secciones button.on { background: var(--ev-ink); color: #fff; }
    .ht-secciones button .n { min-width: 22px; height: 22px; padding: 0 7px; border-radius: 99px; display: inline-grid; place-items: center; font-size: 11.5px; background: #FDE68A; color: #713F12; }
    .ht-secciones button .n[hidden] { display: none; }
    .ht-tab { display: none; }
    .ht-tab.on { display: block; animation: uiFade .35s var(--ev-ease); }
    .hp-cab { display: flex; align-items: center; gap: 18px; margin: 22px 0 16px; flex-wrap: wrap; }
    .hp-cab img { width: 64px; height: 64px; border-radius: 20px; object-fit: cover; box-shadow: 0 0 0 5px var(--ev-mint); }
    .hp-cab h2 { margin: 0; font-size: 24px; font-weight: 800; letter-spacing: -.6px; }
    .hp-cab p { margin: 2px 0 0; color: var(--ev-muted); font-weight: 600; font-size: 13.5px; max-width: 720px; }
    .hp-cab .acc { margin-left: auto; display: flex; gap: 8px; flex-wrap: wrap; }
    .hp-kpis { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; margin-bottom: 14px; }
    .hp-kpi { border: 1px solid var(--ev-line); background: var(--ev-surface); border-radius: 18px; padding: 12px 14px; cursor: pointer; text-align: left; font: inherit; color: var(--ev-text);
              transition: transform .25s var(--ev-ease), border-color .25s, box-shadow .25s; }
    .hp-kpi:hover { transform: translateY(-2px); box-shadow: var(--ev-shadow); }
    .hp-kpi.on { border-color: var(--ev-teal); box-shadow: 0 0 0 3px rgba(116,242,230,.35); }
    .hp-kpi b { display: block; font-size: 24px; font-weight: 800; letter-spacing: -.5px; }
    .hp-kpi small { color: var(--ev-muted); font-weight: 700; font-size: 12px; display: flex; align-items: center; gap: 6px; }
    .hp-fil { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }
    .hp-fil .ui-input { width: auto; min-width: 180px; }
    .hp-fil .q { flex: 1; min-width: 220px; }
    .hp-lista { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 14px; }
    .hp-card { position: relative; display: grid; grid-template-columns: 86px minmax(0, 1fr); gap: 14px; padding: 14px; border-radius: 22px; background: var(--ev-surface);
               border: 1px solid var(--ev-line); cursor: pointer; text-align: left; font: inherit; color: var(--ev-text); transition: transform .3s var(--ev-ease), box-shadow .3s; animation: evRise .45s var(--ev-ease) both; }
    .hp-card:hover { transform: translateY(-3px); box-shadow: var(--ev-shadow); }
    .hp-card .fl { width: 86px; height: 108px; border-radius: 14px; background: var(--ev-grad-soft) center / cover no-repeat; display: grid; place-items: center; color: var(--ev-deep); font-size: 26px; }
    .hp-card h4 { margin: 0 0 2px; font-size: 15.5px; font-weight: 800; letter-spacing: -.3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .hp-card .sub { color: var(--ev-muted); font-size: 12.5px; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .hp-card .meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .hp-card .meta span { font-size: 11.5px; font-weight: 700; padding: 3px 8px; border-radius: 99px; background: var(--ev-surface-2); border: 1px solid var(--ev-line); }
    .hp-card .err { margin-top: 8px; font-size: 12px; font-weight: 700; color: #B42318; }
    .hp-est { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; padding: 4px 9px; border-radius: 99px; }
    .hp-est.PENDIENTE { background: #FEF3C7; color: #92400E; }
    .hp-est.PROGRAMADA { background: #E0E7FF; color: #3730A3; }
    .hp-est.RECHAZADA { background: #FEE4E2; color: #B42318; }
    .hp-est.ACTIVA { background: #DCFCE7; color: #166534; }
    .hp-est.BORRADOR { background: var(--ev-surface-2); color: var(--ev-muted); border: 1px solid var(--ev-line); }
    .hp-card .hp-est { position: absolute; top: 12px; right: 12px; }
    .hp-mas { display: flex; justify-content: center; margin-top: 14px; }
    /* detalle */
    .hp-det { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 20px; align-items: start; }
    .hp-aviso { display: flex; gap: 10px; padding: 12px 14px; border-radius: 16px; margin-bottom: 14px; font-weight: 600; font-size: 13.5px; }
    .hp-aviso.rojo { background: #FEF3F2; color: #B42318; }
    .hp-aviso.ama { background: #FFFBEB; color: #92400E; }
    .hp-aviso.azul { background: #EEF2FF; color: #3730A3; }
    .hp-aviso.verde { background: #ECFDF3; color: #067647; }
    .hp-aviso[hidden], #hpMas[hidden] { display: none !important; }
    .hp-linea { display: flex; gap: 0; margin: 0 0 16px; flex-wrap: wrap; }
    .hp-linea div { flex: 1; min-width: 120px; padding: 10px 12px; border-top: 3px solid var(--ev-line); font-size: 12px; font-weight: 700; color: var(--ev-muted); }
    .hp-linea div.ok { border-color: var(--ev-teal); color: var(--ev-text); }
    .hp-linea b { display: block; font-size: 12.5px; }
    .hp-flyer { border-radius: 20px; overflow: hidden; border: 1px solid var(--ev-line); background: var(--ev-surface-2); }
    .hp-flyer img { display: block; width: 100%; }
    .hp-flyer .acc { display: flex; gap: 6px; padding: 10px; flex-wrap: wrap; }
    .hp-rev { margin-top: 16px; padding: 16px; border-radius: 20px; border: 1.5px dashed var(--ev-line); background: var(--ev-surface-2); }
    .hp-rev h4 { margin: 0 0 10px; font-weight: 800; font-size: 14.5px; display: flex; align-items: center; gap: 8px; }
    .hp-mods { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .hp-mods label.ui-switch { padding: 10px 12px; border: 1px solid var(--ev-line); border-radius: 14px; background: var(--ev-surface); }
    @@media (max-width: 1100px) { .hp-kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); } .hp-det { grid-template-columns: 1fr; } }
    @@media (max-width: 640px) { .hp-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } .hp-mods { grid-template-columns: 1fr; } .hp-lista { grid-template-columns: 1fr; } }
</style>
}

<section class="ht-hero ev-rise">
    <div class="ht-deco" aria-hidden="true"><span class="ht-blob a"></span><span class="ht-blob b"></span><span class="ht-blob c"></span>
    <div class="ht-orbita" aria-hidden="true">
        <span class="nucleo"><i class="bi bi-tools" style="position:static;border:0;background:none;width:auto;height:auto;margin:0;font-size:46px;animation:none"></i></span>
        @{ var orb = HrCatalogos.Todos.Take(8).ToList(); }
        @for (var k = 0; k < orb.Count; k++)
        {
            var ang = k * 2 * Math.PI / orb.Count;
            <i class="bi @orb[k].Icono" style="left:@((50 + 50 * Math.Cos(ang)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;top:@((50 + 50 * Math.Sin(ang)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></i>
        }
    </div>
    </div>

    <span class="tag"><b></b> Esquema Eurovip · copia de ViajeVDT</span>
    <h1>Herra<span>mientas</span></h1>
    <p>Todos los catálogos de Eurovip en un solo lugar. Elige uno para buscar, crear, editar o eliminar. Nada se comparte con dbo.</p>

    <div class="ht-stats">
        <div class="ht-stat"><b id="sTotal">—</b><small>registros en total</small></div>
        <div class="ht-stat"><b>@HrCatalogos.Todos.Length</b><small>catálogos</small></div>
        <div class="ht-stat"><b>@grupos.Count</b><small>grupos</small></div>
        <div class="ht-stat"><b id="sHoy">—</b><small>cambios recientes</small></div>
        <div class="ht-stat" style="cursor:pointer" id="sProvIr" title="Ver las cargas de proveedores por revisar"><b id="sProv">—</b><small>cargas de proveedores por revisar</small></div>
    </div>

    <div class="ht-cmd">
        <label class="caja"><i class="bi bi-search"></i><input id="hrQ" type="search" placeholder="Busca en todo: Punta Cana, PUJ, Riu, DTGeneral…" autocomplete="off" aria-label="Buscar en todos los catálogos"><kbd>/</kbd></label>
        <div class="ht-pal" id="hrPal" role="listbox"></div>
    </div>
</section>

@* CAMBIO 140: la vista se ordena por secciones con pestañas (Catálogos · Cargas de proveedores · Proveedores) *@
<nav class="ht-secciones" id="htSecciones" role="tablist" aria-label="Secciones de Herramientas">
    <button type="button" class="on" data-tab="htCat" role="tab"><i class="bi bi-grid-1x2"></i> Catálogos</button>
    <button type="button" data-tab="htProv" role="tab"><i class="bi bi-inboxes"></i> Cargas de proveedores <span class="n" id="tabProvN" hidden>0</span></button>
    <button type="button" data-tab="htCuentas" role="tab"><i class="bi bi-briefcase"></i> Proveedores</button>
</nav>

<section class="ht-tab on" id="htCat" role="tabpanel">
<div class="ht-body">
    <div>
        <div class="ht-filtro" id="hrFiltro" role="tablist">
            <button type="button" class="on" data-g=""><i class="bi bi-grid"></i> Todos <span>@HrCatalogos.Todos.Length</span></button>
            @foreach (var g in grupos)
            {
                <button type="button" data-g="@g"><i class="bi @(iconoGrupo.GetValueOrDefault(g, "bi-folder"))"></i> @g <span>@HrCatalogos.Todos.Count(c => c.Grupo == g)</span></button>
            }
        </div>

        <div class="ht-bento">
            @foreach (var c in HrCatalogos.Todos.OrderBy(c => c.Clave == "alojamientos" ? 0 : c.Clave == "destinos" ? 1 : 2))
            {
                var t = tam.GetValueOrDefault(c.Clave, "");
                <a class="ht-card @t" style="--n:@(i++)" data-g="@c.Grupo" asp-action="Catalogo" asp-route-id="@c.Clave">
                    <i class="bi @c.Icono fondo" aria-hidden="true"></i>
                    <div class="top">
                        <span class="ico"><i class="bi @c.Icono"></i></span>
                        <button type="button" class="nuevo" data-nuevo="@c.Clave" title="@c.Nuevo @c.Singular"><i class="bi bi-plus-lg"></i> @c.Nuevo</button>
                    </div>
                    <b class="t">@c.Titulo</b>
                    <p>@c.Descripcion</p>
                    @if (c.Clave == "alojamientos")
                    {
                        <div class="extra"><span id="xHab">— habitaciones</span><span id="xDest">— destinos</span><span><i class="bi bi-shield-check"></i> con protección al borrar</span></div>
                    }
                    <span class="ht-rev" data-rev="@c.Clave" hidden></span>
                    <div class="pie"><span class="num"><span data-n="@c.Clave">—</span><small>registros</small></span><span class="ir"><i class="bi bi-arrow-right"></i></span></div>
                </a>
            }
        </div>
    </div>

    <aside class="ht-aside">
        <div class="ht-panel">
            <h3><i class="bi bi-activity"></i> Actividad reciente</h3>
            <ul class="ht-act" id="hrAct"><li><div class="ui-skel" style="height:120px;width:100%"></div></li></ul>
        </div>
        <div class="ht-panel">
            <h3><i class="bi bi-lightning-charge"></i> Atajos</h3>
            <div class="ht-tips">
                <div><kbd>/</kbd> buscar en todos los catálogos</div>
                <div><kbd>↑</kbd><kbd>↓</kbd> moverse entre resultados</div>
                <div><kbd>Enter</kbd> abrir el resultado</div>
                <div><kbd>Esc</kbd> cerrar la búsqueda</div>
            </div>
        </div>
        <div class="ht-panel">
            <h3><i class="bi bi-images"></i> Fotos (multimedia)</h3>
            <p style="margin:0 0 8px;color:var(--ev-muted);font-size:13px;font-weight:600">Todas las fotos van a la carpeta de fotos (<code>photosVacacionalparce\eurovip</code>, fotos.eurovip.com.do/eurovip): destinos, países, hoteles, alojamientos, circuitos (portada, intermedia, galería e itinerario), excursiones, traslados y slider.</p>
            <div id="mmCarpeta" style="font-size:12.5px;font-weight:600;margin-bottom:8px"></div>
            <div id="mmResumen" style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px"></div>
            @if ((Context.Items[EuroVip.Helpers.AccesoModuloFilter.ClavePermisos] as PermisosUsuario)?.EsSuper == true)
            {
                <button type="button" class="ev-btn ghost sm" id="mmMigrar"><i class="bi bi-arrow-left-right"></i> Pasar las fotos de antes</button>
                <button type="button" class="ev-btn ghost sm" id="mmDefecto"><i class="bi bi-image-alt"></i> Imagen por defecto a lo que no tiene foto</button>
                <button type="button" class="ev-btn ghost sm" id="mmRenombrar" hidden><i class="bi bi-input-cursor-text"></i> Poner nombres a las fotos</button>
                <div id="mmInforme" style="margin-top:8px;font-size:12.5px"></div>
            }
        </div>
        <div class="ht-panel ht-db">
            <h3><i class="bi bi-database-check" style="color:var(--ev-aqua)"></i> Dónde viven los datos</h3>
            <p>Servidor 93 · <code>TropitoursVDT.Eurovip</code>. Copiados de ViajeVDT (solo ES). Cada cambio queda en la auditoría.</p>
        </div>
    </aside>
</div>
</section>

@* ================= CAMBIO 140: bandeja de cargas de proveedores ================= *@
<section class="ht-tab" id="htProv" role="tabpanel">
    <div class="hp-cab">
        <img src="/img/ava/robot-escritorio.jpg" alt="">
        <div>
            <h2>Cargas de proveedores</h2>
            <p>Lo que cargan las empresas proveedoras NO sale en la web hasta que lo apruebas. Revisa los productos y el flyer, y luego
               <b>apruébala y publícala ahora</b>, <b>programa el alta</b> o <b>recházala</b> con el motivo y lo que tiene que corregir.</p>
        </div>
        <div class="acc"><button type="button" class="ev-btn ghost sm" id="hpRecargar"><i class="bi bi-arrow-clockwise"></i> Actualizar</button></div>
    </div>
    <div class="hp-kpis" id="hpKpis"></div>
    <div class="hp-fil">
        <input class="ui-input q" id="hpQ" type="search" placeholder="Buscar por código, título, proveedor o correo…" aria-label="Buscar cargas">
        <select class="ui-input" id="hpModulo" aria-label="Módulo"><option value="">Todos los módulos</option></select>
        <select class="ui-input" id="hpCuenta" aria-label="Proveedor"><option value="">Todos los proveedores</option></select>
    </div>
    <div id="hpProgramador" class="hp-aviso azul" hidden></div>
    <div class="hp-lista" id="hpLista"><div class="ui-skel" style="height:140px"></div><div class="ui-skel" style="height:140px"></div></div>
    <div class="hp-mas"><button type="button" class="ev-btn ghost sm" id="hpMas" hidden><i class="bi bi-chevron-down"></i> Ver más</button></div>
</section>

@* ================= CAMBIO 140: cuentas de proveedor (hasta la fase 3, que las dará de alta desde Gestión) ================= *@
<section class="ht-tab" id="htCuentas" role="tabpanel">
    <div class="hp-cab">
        <img src="/img/ava/robot-saludo.jpg" alt="">
        <div>
            <h2>Proveedores</h2>
            <p>Las empresas que pueden cargar productos. Cada cuenta pertenece a un proveedor del catálogo y solo carga en los módulos que le habilites.
               Lo que cargan llega a «Cargas de proveedores» para revisarlo.</p>
        </div>
        <div class="acc"><button type="button" class="ev-btn sm" id="hcNueva"><i class="bi bi-plus-lg"></i> Nueva cuenta</button></div>
    </div>
    <div class="ui-table-wrap">
        <table class="ui-table">
            <thead><tr><th>Empresa</th><th>Correo · teléfono</th><th>Proveedor del catálogo</th><th>Puede cargar</th><th>Cargas</th><th>Estado</th><th></th></tr></thead>
            <tbody id="hcLista"><tr><td colspan="7"><div class="ui-skel" style="height:60px"></div></td></tr></tbody>
        </table>
    </div>
</section>

<aside class="ui-drawer" id="hpVer" aria-hidden="true">
    <div class="ui-dh">
        <div class="ev-module-icon" style="width:46px;height:46px"><i class="bi bi-inboxes" id="hpVerIco"></i></div>
        <div style="min-width:0"><h2 id="hpVerTitulo">Carga</h2><small id="hpVerSub"></small></div>
        <button class="ui-ibtn x" type="button" id="hpVerCerrar" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="ui-db" id="hpVerCuerpo"></div>
</aside>

<aside class="ui-drawer" id="hcEditor" aria-hidden="true" style="width:min(640px, calc(100vw - 24px))">
    <div class="ui-dh">
        <div class="ev-module-icon" style="width:46px;height:46px"><i class="bi bi-briefcase"></i></div>
        <div style="min-width:0"><h2 id="hcTitulo">Nueva cuenta de proveedor</h2><small>Los campos con * son obligatorios.</small></div>
        <button class="ui-ibtn x" type="button" id="hcCerrar" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="ui-db">
        <input type="hidden" id="hcId">
        <div class="ui-f"><label for="hcNombre">Empresa *</label><input id="hcNombre" maxlength="150" placeholder="Nombre de la empresa proveedora"></div>
        <div class="ui-row">
            <div class="ui-f"><label for="hcEmail">Correo * <em>con él entra en Gestión</em></label><input id="hcEmail" type="email" maxlength="250" placeholder="correo de la empresa"></div>
            <div class="ui-f"><label for="hcTel">Teléfono</label><input id="hcTel" maxlength="30"></div>
        </div>
        <div class="ui-f"><label for="hcProv">Proveedor del catálogo * <em>lo que cargue irá a nombre de este proveedor</em></label><select id="hcProv"></select></div>
        <div class="ui-f"><label>Puede cargar en</label><div class="hp-mods" id="hcMods"></div></div>
        <label class="ui-switch"><input type="checkbox" id="hcActivo" checked><span class="tr"></span> Cuenta activa (si la desactivas no puede entrar ni cargar)</label>
    </div>
    <div class="ui-df">
        <span class="hint">El proveedor solo ve y edita sus propias cargas.</span>
        <button type="button" class="ev-btn ghost" id="hcCancelar">Cancelar</button>
        <button type="button" class="ev-btn" id="hcGuardar"><i class="bi bi-check2"></i> Guardar</button>
    </div>
</aside>

@section Scripts {
<script src="~/js/eurovip-ui.js" asp-append-version="true"></script>
<script>
(() => {
    const $ = s => document.querySelector(s), $$ = s => [...document.querySelectorAll(s)], esc = EV.esc;
    const defs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(HrCatalogos.Todos.ToDictionary(c => c.Clave, c => new { claves = c.Claves.Select(k => k.Col), titulo = (c.Campo("nombre") ?? c.Campo("descripcion") ?? c.Campos.First(f => !f.Auto && f.Tipo != "hotel" && f.Tipo != "select")).Col, nombre = c.Titulo })));
    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // contador animado
    const contar = (el, n) => {
        if (reducido) { el.textContent = EV.fmt(n); return; }
        const t0 = performance.now(), dur = 900;
        const paso = t => { const p = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - p, 3); el.textContent = EV.fmt(Math.round(n * e)); if (p < 1) requestAnimationFrame(paso); };
        requestAnimationFrame(paso);
    };

    EV.api('/Herramientas/Resumen').then(r => {
        const m = Object.fromEntries(r.map(x => [x.clave, x.total]));
        r.forEach(x => { const el = document.querySelector(`[data-n="${x.clave}"]`); if (el) contar(el, x.total); });
        contar($('#sTotal'), r.reduce((s, x) => s + x.total, 0));
        $('#xHab').textContent = `${EV.fmt(m.habitaciones || 0)} habitaciones`;
        $('#xDest').textContent = `${EV.fmt(m.destinos || 0)} destinos`;
    }).catch(() => {});

    // datos a revisar (inconsistencias guardadas) por mantenimiento
    EV.api('/Herramientas/RevisarResumen').then(r => Object.entries(r).forEach(([k, n]) => {
        const el = document.querySelector(`[data-rev="${k}"]`); if (!el) return;
        el.innerHTML = `<i class="bi bi-exclamation-triangle-fill"></i> ${EV.fmt(n)} a revisar`; el.hidden = false;
    })).catch(() => {});

    // fotos en multimedia
    const NOMBRE_TIPO = { ALOJAMIENTO: 'alojamientos', CIRCUITO: 'circuitos', EXCURSION: 'excursiones', TRASLADO: 'traslados', DESTINO: 'destinos', PAIS: 'países', HOTEL: 'hoteles', CRUCERO: 'cruceros', INICIO: 'tarjetas de la Home' };
    const resumenFotos = () => EV.api('/Herramientas/MultimediaResumen').then(res => {
        const r = res.fotos, c = res.carpeta;
        // Dónde guarda las fotos ESTE servidor y si puede escribir ahí
        $('#mmCarpeta').innerHTML = `<div style="padding:8px 10px;border-radius:10px;background:${c.sePuedeEscribir ? '#ECFDF3' : '#FEF3F2'};color:${c.sePuedeEscribir ? '#067647' : '#B42318'}">
            <i class="bi ${c.sePuedeEscribir ? 'bi-check-circle' : 'bi-exclamation-octagon'}"></i> Este servidor guarda en <code>${esc(c.carpeta)}</code>
            ${c.sePuedeEscribir ? `(${EV.fmt(c.archivos)} archivos)` : `<br><b>No puede escribir ahí:</b> ${esc(c.error || 'la carpeta no existe')}. Revisa Multimedia:CarpetaFisica en appsettings.json y los permisos del grupo de aplicaciones del IIS.`}
            <br>Se ven con <code>${esc(c.url)}</code></div>`;
        const rb = $('#mmRenombrar'); if (rb) { rb.hidden = !res.conCodigo; rb.innerHTML = `<i class="bi bi-input-cursor-text"></i> Poner nombres a ${res.conCodigo} foto(s) con código`; }
        const porTipo = {}; r.forEach(x => porTipo[x.tipo] = (porTipo[x.tipo] || 0) + x.n);
        $('#mmResumen').innerHTML = Object.keys(porTipo).length
            ? Object.entries(porTipo).map(([t, n]) => `<span class="ui-chip">${EV.fmt(n)} ${NOMBRE_TIPO[t] || t}</span>`).join('')
            : '<span style="color:var(--ev-muted);font-size:12.5px;font-weight:600">Todavía no hay fotos en multimedia.</span>';
    }).catch(() => {});
    resumenFotos();
    $('#mmRenombrar')?.addEventListener('click', async e => {
        if (!await EV.confirmar({ titulo: '¿Poner nombres a las fotos?', si: 'Sí, renombrar',
            texto: 'Las fotos que tienen un código por nombre pasan a llamarse como su producto (ej. <code>destinos/punta-cana/punta-cana.webp</code>). Se cambia el archivo y su dirección en la base. Hazlo en el servidor donde están los archivos.' })) return;
        const b = e.currentTarget, html = b.innerHTML; b.disabled = true; b.innerHTML = '<span class="ui-spin"></span> Renombrando…';
        try {
            const r = await EV.post('/Herramientas/RenombrarFotos');
            EV.toast(r.mensaje);
            $('#mmInforme').innerHTML = `<div><b>Renombradas:</b> ${EV.fmt(r.renombradas)} · <b>Ya estaban bien:</b> ${EV.fmt(r.yaBien)}</div>` +
                (r.sinArchivo.length ? `<details><summary>${r.sinArchivo.length} sin archivo en este servidor</summary><div style="max-height:160px;overflow:auto">${r.sinArchivo.map(esc).join('<br>')}</div></details>` : '') +
                (r.errores.length ? `<div style="color:#B42318"><b>Errores:</b><br>${r.errores.map(esc).join('<br>')}</div>` : '');
            resumenFotos();
        } catch (er) { EV.toast(er.message, 'err'); }
        finally { b.disabled = false; b.innerHTML = html; }
    });
    // Punto 2: a lo que no tiene ninguna foto se le pone la del destino o la general (no copia archivos; si después suben una foto, la reemplaza)
    $('#mmDefecto')?.addEventListener('click', async e => {
        if (!await EV.confirmar({ titulo: '¿Poner la imagen por defecto?', si: 'Sí, ponerla',
            texto: 'A los destinos de la web, hoteles, excursiones, traslados, circuitos, cruceros y días de itinerario que <b>no tienen ninguna foto</b> se les pone la foto de su destino (o la general: Punta Cana). No borra ni cambia ninguna foto que ya exista. <b>Hazlo en la app del servidor y después de «Pasar las fotos de antes»</b>, para que las fotos viejas cuenten como foto.' })) return;
        const b = e.currentTarget, html = b.innerHTML; b.disabled = true; b.innerHTML = '<span class="ui-spin"></span> Poniendo…';
        try {
            const r = await EV.post('/Multimedia/PorDefecto');
            EV.toast(r.mensaje);
            $('#mmInforme').innerHTML = '<b>Imagen por defecto:</b> ' + (Object.entries(r.resultado).map(([t, n]) => `${EV.fmt(n)} ${esc(t)}`).join(' · ') || 'nada');
            resumenFotos();
        } catch (er) { EV.toast(er.message, 'err'); }
        finally { b.disabled = false; b.innerHTML = html; }
    });
    $('#mmMigrar')?.addEventListener('click', async e => {
        if (!await EV.confirmar({ titulo: '¿Pasar las fotos de antes?', si: 'Sí, pasarlas',
            texto: 'Copia a la carpeta de fotos (fotos.eurovip.com.do/eurovip) las portadas de excursiones, traslados, circuitos, destinos, alojamientos y hoteles, las fotos del itinerario de circuito y los archivos del slider. No borra nada y lo que ya está se salta. Hazlo en la app del servidor (allí están las fotos).' })) return;
        const b = e.currentTarget, html = b.innerHTML; b.disabled = true; b.innerHTML = '<span class="ui-spin"></span> Pasando…';
        try {
            const r = await EV.post('/Herramientas/MigrarImagenes');
            EV.toast(r.mensaje);
            const lista = o => Object.entries(o).map(([t, n]) => `${EV.fmt(n)} ${NOMBRE_TIPO[t] || t}`).join(', ') || 'ninguna';
            $('#mmInforme').innerHTML = `<div><b>Pasadas:</b> ${lista(r.pasadas)}</div><div><b>Ya estaban:</b> ${lista(r.yaEstaban)}</div><div><b>Itinerario:</b> ${EV.fmt(r.itinerario)} · <b>Slider:</b> ${EV.fmt(r.slider)} archivos</div>` +
                (r.sinArchivo.length ? `<details><summary>${r.sinArchivo.length} sin archivo en este servidor</summary><div style="max-height:160px;overflow:auto">${r.sinArchivo.map(esc).join('<br>')}</div></details>` : '') +
                (r.errores.length ? `<div style="color:#B42318"><b>Errores:</b><br>${r.errores.map(esc).join('<br>')}</div>` : '');
            resumenFotos();
        } catch (er) { EV.toast(er.message, 'err'); }
        finally { b.disabled = false; b.innerHTML = html; }
    });

    // actividad reciente
    const verbo = { Crear: ['Creó', 'bi-plus-lg'], Editar: ['Editó', 'bi-pencil'], Eliminar: ['Eliminó', 'bi-trash3'] };
    const hace = f => { const s = (Date.now() - new Date(f)) / 1000; return s < 60 ? 'hace un momento' : s < 3600 ? `hace ${Math.round(s / 60)} min` : s < 86400 ? `hace ${Math.round(s / 3600)} h` : EV.fecha(f.slice(0, 10)); };
    EV.api('/Herramientas/Actividad').then(r => {
        $('#sHoy').textContent = r.length;
        $('#hrAct').innerHTML = r.length ? r.map(a => { const v = verbo[a.accion] || [a.accion, 'bi-dot'];
            return `<li><span class="pt ${esc(a.accion)}"><i class="bi ${v[1]}"></i></span><div><b>${v[0]} ${a.detalle ? '«' + esc(a.detalle) + '»' : ''}</b>
                <small><i class="bi ${esc(a.icono)}"></i> ${esc(a.catalogo)} · ${esc(a.usuario)} · ${hace(a.fecha)}</small></div></li>`; }).join('')
            : '<li style="color:var(--ev-muted);font-weight:600;font-size:13px">Todavía no hay cambios. Cuando alguien cree o edite algo, aparecerá aquí.</li>';
    }).catch(() => $('#hrAct').innerHTML = '');

    // filtro por grupo
    $('#hrFiltro').addEventListener('click', e => {
        const b = e.target.closest('[data-g]'); if (!b) return;
        $$('#hrFiltro button').forEach(x => x.classList.toggle('on', x === b));
        $$('.ht-card').forEach((c, k) => { const ver = !b.dataset.g || c.dataset.g === b.dataset.g; c.classList.toggle('oculta', !ver); if (ver) { c.style.animation = 'none'; c.offsetHeight; c.style.animation = ''; } });
    });

    // brillo que sigue al ratón + botón Nuevo
    $$('.ht-card').forEach(c => c.addEventListener('pointermove', e => { const r = c.getBoundingClientRect(); c.style.setProperty('--mx', `${e.clientX - r.left}px`); c.style.setProperty('--my', `${e.clientY - r.top}px`); }));
    document.addEventListener('click', e => { const n = e.target.closest('[data-nuevo]'); if (n) { e.preventDefault(); location.href = `/Herramientas/Catalogo/${n.dataset.nuevo}?nuevo=1`; } });

    // ---------- paleta de comandos ----------
    const pal = $('#hrPal'), inp = $('#hrQ');
    let enlaces = [], sel = -1;
    const marcar = i => { enlaces.forEach((a, k) => a.classList.toggle('sel', k === i)); sel = i; enlaces[i]?.scrollIntoView({ block: 'nearest' }); };
    const catalogosQueCoinciden = q => Object.entries(defs).filter(([, d]) => d.nombre.toLowerCase().includes(q.toLowerCase()));
    const buscar = EV.debounce(async () => {
        const q = inp.value.trim();
        if (q.length < 2) { pal.classList.remove('on'); return; }
        pal.classList.add('on');
        pal.innerHTML = '<div class="vacio"><span class="ui-spin"></span> Buscando en 11 catálogos…</div>';
        try {
            const r = await EV.api('/Herramientas/Buscar?q=' + encodeURIComponent(q));
            const cats = catalogosQueCoinciden(q);
            let html = cats.length ? `<div class="g"><i class="bi bi-grid"></i> Ir al catálogo</div>${cats.map(([k, d]) => `<a href="/Herramientas/Catalogo/${k}"><span class="mi"><i class="bi bi-arrow-right"></i></span>${esc(d.nombre)}</a>`).join('')}` : '';
            html += r.map(g => {
                const d = defs[g.clave];
                return `<div class="g"><i class="bi ${esc(g.icono)}"></i> ${esc(g.titulo)}</div>` + g.filas.map(f => {
                    const k = encodeURIComponent(JSON.stringify(Object.fromEntries(d.claves.map(c => [c, f[c]]))));
                    return `<a href="/Herramientas/Catalogo/${g.clave}?abrir=${k}"><span class="mi"><i class="bi ${esc(g.icono)}"></i></span>${esc(f[d.titulo] ?? '')}<small>${d.claves.map(c => esc(f[c])).join(' · ')}</small></a>`;
                }).join('') + `<a href="/Herramientas/Catalogo/${g.clave}?q=${encodeURIComponent(q)}" style="color:var(--ev-deep);font-size:13px"><span class="mi"><i class="bi bi-list-ul"></i></span>Ver todos en ${esc(d.nombre)}</a>`;
            }).join('');
            pal.innerHTML = html || `<div class="vacio"><i class="bi bi-search" style="font-size:26px;display:block;margin-bottom:6px"></i>Nada con «${esc(q)}»</div>`;
            enlaces = [...pal.querySelectorAll('a')];
            marcar(enlaces.length ? 0 : -1);
        } catch (e) { pal.innerHTML = `<div class="vacio" style="color:#B42318">${esc(e.message)}</div>`; }
    }, 300);
    inp.addEventListener('input', buscar);
    inp.addEventListener('focus', () => { if (inp.value.trim().length >= 2 && enlaces.length) pal.classList.add('on'); });
    inp.addEventListener('keydown', e => {
        if (e.key === 'ArrowDown' && enlaces.length) { e.preventDefault(); marcar((sel + 1) % enlaces.length); }
        else if (e.key === 'ArrowUp' && enlaces.length) { e.preventDefault(); marcar((sel - 1 + enlaces.length) % enlaces.length); }
        else if (e.key === 'Enter' && enlaces[sel]) { e.preventDefault(); location.href = enlaces[sel].href; }
        else if (e.key === 'Escape') { pal.classList.remove('on'); inp.blur(); }
    });
    document.addEventListener('click', e => { if (!e.target.closest('.ht-cmd')) pal.classList.remove('on'); });
    document.addEventListener('keydown', e => { if (e.key === '/' && !['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName)) { e.preventDefault(); inp.focus(); } });
})();
</script>
<script>
// =====================================================================================================================
// CAMBIO 140: secciones con pestañas, bandeja de «Cargas de proveedores» (revisar, aprobar y publicar, programar el alta,
// rechazar con motivo e instrucciones, flyer) y «Proveedores» (cuentas de las empresas proveedoras y sus módulos).
// =====================================================================================================================
(() => {
    const $ = s => document.querySelector(s), esc = EV.esc;
    const EST = {
        PENDIENTE: ['Por revisar', 'bi-hourglass-split'], PROGRAMADA: ['Programadas', 'bi-calendar-check'], RECHAZADA: ['Rechazadas', 'bi-x-octagon'],
        ACTIVA: ['En la web', 'bi-globe2'], BORRADOR: ['Borradores', 'bi-pencil'], '': ['Todas', 'bi-collection']
    };
    const UNO = { PENDIENTE: 'Por revisar', PROGRAMADA: 'Programada', RECHAZADA: 'Rechazada', ACTIVA: 'En la web', BORRADOR: 'Borrador' };
    const TABLAS = { SERVICIO: 'Oferta / salida', EXCURSION: 'Excursión', TRASLADO: 'Traslado', CRUCERO: 'Crucero' };
    const fh = d => d ? new Date(d).toLocaleString('es-ES', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—';
    const params = new URLSearchParams(location.search);
    let modulos = {}, conteo = {}, filtro = 'PENDIENTE', pagina = 1, total = 0, items = [], cuentas = [], catalogo = [];
    let listo = { prov: false, cuentas: false };

    // ---------------- pestañas (la elegida queda en la dirección: ?tab=htProv) ----------------
    const tabs = EV.tabs($('#htSecciones'), id => {
        const u = new URL(location.href);
        if (id === 'htCat') u.searchParams.delete('tab'); else u.searchParams.set('tab', id);
        u.searchParams.delete('carga');
        history.replaceState(null, '', u);
        if (id === 'htProv' && !listo.prov) { listo.prov = true; cargarCuentas().then(() => listar(true)); }
        if (id === 'htCuentas' && !listo.cuentas) { listo.cuentas = true; cargarCuentas(); }
    });
    $('#sProvIr').addEventListener('click', () => tabs.ir('htProv'));

    // ---------------- resumen: contador de pendientes (portada y pestaña) ----------------
    const resumen = EV.api('/Herramientas/ProveedoresResumen').then(r => {
        modulos = Object.fromEntries(r.modulos.map(m => [m.clave, m]));
        $('#hpModulo').insertAdjacentHTML('beforeend', r.modulos.map(m => `<option value="${esc(m.clave)}">${esc(m.nombre)}</option>`).join(''));
        pintarConteo(r.conteo);
        const pr = $('#hpProgramador');
        pr.hidden = r.publicaProgramadas;
        pr.innerHTML = '<i class="bi bi-info-circle"></i><span>En esta copia el <b>alta programada está apagada</b> (Eurovip:Proveedores:Publicar): las cargas programadas se publican solas solo en el servidor. Aquí puedes aprobarlas a mano.</span>';
        return r;
    }).catch(() => ({ modulos: [] }));

    function pintarConteo(c) {
        conteo = c || {};
        const n = conteo.PENDIENTE || 0;
        $('#sProv').textContent = EV.fmt(n);
        $('#tabProvN').textContent = n > 99 ? '99+' : n; $('#tabProvN').hidden = !n;
        const todas = Object.values(conteo).reduce((s, x) => s + x, 0);
        $('#hpKpis').innerHTML = ['PENDIENTE', 'PROGRAMADA', 'RECHAZADA', 'ACTIVA', 'BORRADOR', ''].map(e =>
            `<button type="button" class="hp-kpi ${filtro === e ? 'on' : ''}" data-est="${e}"><b>${EV.fmt(e ? conteo[e] || 0 : todas)}</b><small><i class="bi ${EST[e][1]}"></i> ${EST[e][0]}</small></button>`).join('');
    }
    $('#hpKpis').addEventListener('click', e => { const b = e.target.closest('[data-est]'); if (!b) return; filtro = b.dataset.est; pintarConteo(conteo); listar(true); });

    // ---------------- bandeja ----------------
    async function listar(reset) {
        if (reset) { pagina = 1; items = []; }
        const q = new URLSearchParams({ estado: filtro, modulo: $('#hpModulo').value, cuenta: $('#hpCuenta').value, q: $('#hpQ').value.trim(), pagina, tam: 24 });
        try {
            const r = await EV.api('/Herramientas/ProveedoresCargas?' + q);
            items = items.concat(r.items); total = r.total;
            pintarConteo(r.conteo);
            pintarLista();
        } catch (er) { $('#hpLista').innerHTML = `<div class="ui-empty" style="grid-column:1/-1"><h3>No se pudo cargar</h3><p>${esc(er.message)}</p></div>`; }
    }

    function fechaDe(c) {
        return c.estado === 'PENDIENTE' ? `Enviada ${fh(c.fecha_Solicitud)}` : c.estado === 'PROGRAMADA' ? `Alta ${fh(c.activar_En)}`
             : c.estado === 'ACTIVA' ? `Publicada ${fh(c.fecha_Activacion)}` : c.estado === 'RECHAZADA' ? `Rechazada ${fh(c.fecha_Revision)}` : `Creada ${fh(c.creado_En)}`;
    }

    function pintarLista() {
        if (!items.length) {
            $('#hpLista').innerHTML = `<div class="ui-empty" style="grid-column:1/-1"><i class="bi bi-inbox big"></i><h3>${filtro === 'PENDIENTE' ? '¡Nada por revisar!' : 'No hay cargas'}</h3>
                <p>${filtro === 'PENDIENTE' ? 'Cuando un proveedor envíe una carga a revisión aparecerá aquí y te avisará la campana.' : 'Prueba con otro filtro.'}</p></div>`;
        } else {
            $('#hpLista').innerHTML = items.map((c, k) => {
                const m = modulos[c.modulo] || { nombre: c.modulo, icono: 'bi-box' };
                return `<button type="button" class="hp-card" data-id="${c.id}" style="animation-delay:${Math.min(k, 12) * 35}ms">
                    <span class="fl" style="${c.flyer ? `background-image:url('${esc(c.flyer)}')` : ''}">${c.flyer ? '' : `<i class="bi ${esc(m.icono)}"></i>`}</span>
                    <div style="min-width:0;padding-right:74px">
                        <h4>${esc(c.codigo)}${c.titulo ? ' · ' + esc(c.titulo) : ''}</h4>
                        <div class="sub"><i class="bi ${esc(m.icono)}"></i> ${esc(m.nombre)} · ${esc(c.cuenta || '')}</div>
                        <div class="meta"><span>${EV.fmt(c.productos)} producto${c.productos === 1 ? '' : 's'}</span>${c.precio_Desde ? `<span>desde ${EV.dinero(c.precio_Desde, c.moneda)}</span>` : ''}<span>${fechaDe(c)}</span></div>
                        ${c.error ? `<div class="err"><i class="bi bi-exclamation-octagon"></i> ${esc(c.error.length > 120 ? c.error.slice(0, 120) + '…' : c.error)}</div>` : ''}
                    </div>
                    <span class="hp-est ${esc(c.estado)}">${UNO[c.estado] || esc(c.estado)}</span></button>`;
            }).join('');
        }
        $('#hpMas').hidden = items.length >= total;
    }
    $('#hpLista').addEventListener('click', e => { const b = e.target.closest('[data-id]'); if (b) abrir(+b.dataset.id); });
    $('#hpMas').addEventListener('click', () => { pagina++; listar(false); });
    $('#hpQ').addEventListener('input', EV.debounce(() => listar(true), 300));
    $('#hpModulo').addEventListener('change', () => listar(true));
    $('#hpCuenta').addEventListener('change', () => listar(true));
    $('#hpRecargar').addEventListener('click', () => { listar(true); refrescarResumen(); });
    const refrescarResumen = () => EV.api('/Herramientas/ProveedoresResumen').then(r => pintarConteo(r.conteo)).catch(() => {});

    // ---------------- detalle y revisión ----------------
    const visor = EV.drawer($('#hpVer'));
    $('#hpVerCerrar').addEventListener('click', () => visor.cerrar());
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && visor.abierto()) visor.cerrar(); });
    let actual = null;

    async function abrir(id) {
        try { actual = await EV.api('/Herramientas/ProveedorCarga?id=' + id); }
        catch (er) { EV.toast(er.message, 'err'); return; }
        pintarDetalle();
        visor.abrir();
        const u = new URL(location.href); u.searchParams.set('carga', id); history.replaceState(null, '', u);
    }

    function pintarDetalle() {
        const { carga: c, productos, items: pub, datos } = actual;
        const m = modulos[c.modulo] || { nombre: c.modulo, icono: 'bi-box' };
        $('#hpVerIco').className = 'bi ' + m.icono;
        $('#hpVerTitulo').innerHTML = `Carga ${esc(c.codigo)} <span class="hp-est ${esc(c.estado)}" style="vertical-align:middle">${UNO[c.estado] || esc(c.estado)}</span>`;
        $('#hpVerSub').textContent = `${m.nombre} · ${c.cuenta || ''} (${c.email || ''}) · proveedor ${c.proveedor || c.id_Proveedor || ''}${c.titulo ? ' · ' + c.titulo : ''}`;
        const avisos = [];
        if (c.error) avisos.push(`<div class="hp-aviso rojo"><i class="bi bi-exclamation-octagon"></i><span><b>No se pudo publicar:</b> ${esc(c.error)}</span></div>`);
        if (c.estado === 'RECHAZADA') avisos.push(`<div class="hp-aviso ama"><i class="bi bi-x-octagon"></i><span><b>Rechazada</b> por ${esc(c.revisado_Por || '')} el ${fh(c.fecha_Revision)}.<br><b>Motivo:</b> ${esc(c.motivo || '')}${c.instrucciones ? `<br><b>Instrucciones:</b> ${esc(c.instrucciones)}` : ''}<br><small>El proveedor puede corregirla y volver a enviarla.</small></span></div>`);
        else if (c.motivo && c.estado === 'PENDIENTE') avisos.push(`<div class="hp-aviso ama"><i class="bi bi-arrow-repeat"></i><span><b>Reenviada después de un rechazo.</b> Motivo anterior: ${esc(c.motivo)}</span></div>`);
        if (c.estado === 'PROGRAMADA') avisos.push(`<div class="hp-aviso azul"><i class="bi bi-calendar-check"></i><span>Se publicará en la web el <b>${fh(c.activar_En)}</b> (hora de República Dominicana). Programada por ${esc(c.revisado_Por || '')}.</span></div>`);
        if (c.estado === 'ACTIVA') avisos.push(`<div class="hp-aviso verde"><i class="bi bi-globe2"></i><span>En la web desde el <b>${fh(c.fecha_Activacion)}</b>. Revisó: ${esc(c.revisado_Por || '')}.</span></div>`);
        const paso = (ok, t, d) => `<div class="${ok ? 'ok' : ''}"><b>${t}</b>${d}</div>`;
        const linea = `<div class="hp-linea">${paso(true, 'Creada', fh(c.creado_En))}${paso(!!c.fecha_Solicitud, 'Enviada a revisión', fh(c.fecha_Solicitud))}${paso(!!c.fecha_Revision, 'Revisada', c.fecha_Revision ? `${fh(c.fecha_Revision)} · ${esc(c.revisado_Por || '')}` : '—')}${paso(!!c.fecha_Activacion, 'En la web', fh(c.fecha_Activacion))}</div>`;
        const tablaProd = productos.length ? `<div class="ui-table-wrap"><table class="ui-table"><thead><tr><th>#</th><th>Producto</th><th>Destino</th><th>Detalle</th><th class="num">Desde</th></tr></thead><tbody>${
            productos.map(p => `<tr><td>${p.indice}</td><td><b>${esc(p.nombre)}</b></td><td>${esc(p.destino || '—')}</td><td>${esc(p.detalle || '')}</td><td class="num">${p.precio != null ? EV.dinero(p.precio, p.moneda) : '—'}</td></tr>`).join('')
        }</tbody></table></div>` : '<div class="ui-empty"><p>La carga no tiene productos que se puedan leer.</p></div>';
        const tablaPub = pub.length ? `<h4 style="margin:18px 0 8px;font-weight:800">Publicado en la web (${pub.length})</h4><div class="ui-table-wrap"><table class="ui-table"><thead><tr><th>Tipo</th><th>N.º</th><th>Nombre</th><th class="num">Precio</th><th>A la venta</th></tr></thead><tbody>${
            pub.map(x => `<tr><td>${TABLAS[x.tabla] || esc(x.tabla)}</td><td>${x.id_Registro}</td><td>${esc(x.nombre || '')}</td><td class="num">${x.precio != null ? EV.dinero(x.precio, x.moneda) : '—'}</td><td>${x.activo === true ? '<i class="bi bi-check-circle-fill" style="color:#16A34A"></i> Sí' : x.activo === false ? 'Desactivado' : 'Ya no existe'}</td></tr>`).join('')
        }</tbody></table></div>` : '';
        const flyer = c.flyer ? `<div class="hp-flyer"><a href="${esc(c.flyer)}" target="_blank" rel="noopener"><img src="${esc(c.flyer)}?v=${Date.now()}" alt="Flyer de la carga ${esc(c.codigo)}"></a>
            <div class="acc"><a class="ev-btn ghost sm" href="${esc(c.flyer)}" target="_blank" rel="noopener"><i class="bi bi-eye"></i> Ver</a><a class="ev-btn ghost sm" href="${esc(c.flyer)}" download><i class="bi bi-download"></i> Descargar</a><button type="button" class="ev-btn ghost sm" data-acc="flyer"><i class="bi bi-arrow-repeat"></i> Regenerar</button></div></div>`
            : `<div class="ui-empty"><i class="bi bi-image big"></i><p>${c.estado === 'BORRADOR' ? 'El flyer se genera cuando el proveedor envía la carga a revisión.' : 'Sin flyer.'}</p>${c.estado !== 'BORRADOR' ? '<button type="button" class="ev-btn ghost sm" data-acc="flyer"><i class="bi bi-magic"></i> Generar flyer</button>' : ''}</div>`;
        const revisar = c.estado === 'PENDIENTE' || c.estado === 'PROGRAMADA';
        const manana = new Date(Date.now() + 86400000); manana.setHours(9, 0, 0, 0);
        const local = d => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}T${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
        const panel = revisar ? `<div class="hp-rev">
                <h4><i class="bi bi-rocket-takeoff"></i> Aprobar y publicar ahora</h4>
                <p style="margin:0 0 10px;color:var(--ev-muted);font-size:12.5px;font-weight:600">Se crean en la web con el mismo guardado de cada pantalla (y sus reglas: precio mínimo, código…).</p>
                <button type="button" class="ev-btn" data-acc="aprobar" style="width:100%;justify-content:center"><i class="bi bi-check2-circle"></i> Aprobar y publicar</button>
                <h4 style="margin-top:18px"><i class="bi bi-calendar-event"></i> Programar el alta</h4>
                <div class="ui-f"><label for="hpFecha">Fecha y hora <em>República Dominicana</em></label><input type="datetime-local" id="hpFecha" value="${c.activar_En ? String(c.activar_En).slice(0, 16) : local(manana)}"></div>
                <button type="button" class="ev-btn ghost" data-acc="programar" style="width:100%;justify-content:center"><i class="bi bi-calendar-check"></i> ${c.estado === 'PROGRAMADA' ? 'Cambiar la fecha' : 'Programar'}</button>
                <h4 style="margin-top:18px"><i class="bi bi-x-octagon"></i> Rechazar</h4>
                <div class="ui-f"><label for="hpMotivo">Motivo *</label><textarea id="hpMotivo" rows="3" maxlength="1000" placeholder="Qué está mal (lo verá el proveedor)"></textarea></div>
                <div class="ui-f"><label for="hpInstr">Instrucciones <em>qué tiene que corregir</em></label><textarea id="hpInstr" rows="3" maxlength="1000"></textarea></div>
                <button type="button" class="ev-btn red" data-acc="rechazar" style="width:100%;justify-content:center"><i class="bi bi-x-lg"></i> Rechazar</button>
            </div>` : '';
        $('#hpVerCuerpo').innerHTML = `${avisos.join('')}${linea}
            <div class="hp-det">
                <div style="min-width:0">
                    <h4 style="margin:0 0 8px;font-weight:800">Productos (${productos.length})</h4>${tablaProd}${tablaPub}
                    <details style="margin-top:16px"><summary style="cursor:pointer;font-weight:700;color:var(--ev-muted)">Ver los datos tal como los envió el proveedor (JSON)</summary>
                        <pre style="max-height:360px;overflow:auto;background:var(--ev-surface-2);border:1px solid var(--ev-line);border-radius:14px;padding:12px;font-size:12px">${esc(JSON.stringify(datos, null, 2))}</pre></details>
                </div>
                <div>${flyer}${panel}</div>
            </div>`;
    }

    $('#hpVerCuerpo').addEventListener('click', async e => {
        const b = e.target.closest('[data-acc]'); if (!b || !actual) return;
        const c = actual.carga, acc = b.dataset.acc;
        try {
            if (acc === 'aprobar') {
                if (!await EV.confirmar({ titulo: '¿Aprobar y publicar ahora?', si: 'Sí, publicar', icono: 'rocket-takeoff',
                    texto: `Los ${c.productos} producto(s) de la carga <b>${esc(c.codigo)}</b> de <b>${esc(c.cuenta || '')}</b> se crean en la web en este momento.` })) return;
                const r = await EV.post('/Herramientas/ProveedorCargaAprobar', { id: c.id });
                EV.toast(r.mensaje); EV.confeti();
            } else if (acc === 'programar') {
                const f = $('#hpFecha').value;
                if (!f) { EV.toast('Elige la fecha y la hora del alta.', 'err'); return; }
                const r = await EV.post('/Herramientas/ProveedorCargaProgramar', { id: c.id, fecha: f });
                EV.toast(r.mensaje);
            } else if (acc === 'rechazar') {
                const motivo = $('#hpMotivo').value.trim();
                if (!motivo) { EV.toast('Escribe el motivo del rechazo.', 'err'); $('#hpMotivo').focus(); return; }
                if (!await EV.confirmar({ titulo: '¿Rechazar la carga?', si: 'Sí, rechazar', peligro: true, icono: 'x-octagon',
                    texto: `El proveedor verá el motivo y las instrucciones y podrá corregirla y volver a enviarla.` })) return;
                const r = await EV.post('/Herramientas/ProveedorCargaRechazar', { id: c.id, motivo, instrucciones: $('#hpInstr').value.trim() });
                EV.toast(r.mensaje);
            } else if (acc === 'flyer') {
                const r = await EV.post('/Herramientas/ProveedorCargaFlyer', { id: c.id });
                EV.toast(r.mensaje);
            }
        } catch { /* EV.api ya mostró el aviso con la lista de problemas */ }
        try { actual = await EV.api('/Herramientas/ProveedorCarga?id=' + c.id); pintarDetalle(); } catch { }
        listar(true);
    });

    // ---------------- cuentas de proveedor ----------------
    async function cargarCuentas() {
        try {
            const r = await EV.api('/Herramientas/ProveedoresCuentas');
            cuentas = r.cuentas; catalogo = r.catalogo;
            const sel = $('#hpCuenta'), v = sel.value;
            sel.innerHTML = '<option value="">Todos los proveedores</option>' + cuentas.map(x => `<option value="${x.id}">${esc(x.nombre)}</option>`).join('');
            sel.value = v;
            pintarCuentas();
        } catch (er) { $('#hcLista').innerHTML = `<tr><td colspan="7">${esc(er.message)}</td></tr>`; }
    }

    function pintarCuentas() {
        $('#hcLista').innerHTML = cuentas.length ? cuentas.map(x => `<tr>
            <td><b>${esc(x.nombre)}</b></td>
            <td>${esc(x.email)}${x.telefono ? `<br><small style="color:var(--ev-muted)">${esc(x.telefono)}</small>` : ''}</td>
            <td>${esc(x.proveedor || '')} <small style="color:var(--ev-muted)">(${esc(x.id_Proveedor)})</small></td>
            <td><div class="ui-chips">${(x.listaModulos || []).map(mm => `<span class="ui-chip ghost"><i class="bi ${esc(modulos[mm]?.icono || 'bi-box')}"></i> ${esc(modulos[mm]?.nombre || mm)}</span>`).join('') || '<small style="color:var(--ev-muted)">Ninguno</small>'}</div></td>
            <td>${EV.fmt(x.cargas)}${x.pendientes ? ` · <b style="color:#92400E">${x.pendientes} por revisar</b>` : ''}</td>
            <td>${x.activo ? '<span class="hp-est ACTIVA">Activa</span>' : '<span class="hp-est BORRADOR">Desactivada</span>'}</td>
            <td style="white-space:nowrap"><button type="button" class="ui-ibtn" data-editar="${x.id}" title="Editar"><i class="bi bi-pencil"></i></button>
                <button type="button" class="ui-ibtn" data-cargas="${x.id}" title="Ver sus cargas"><i class="bi bi-inboxes"></i></button></td></tr>`).join('')
            : `<tr><td colspan="7"><div class="ui-empty"><i class="bi bi-briefcase big"></i><h3>Todavía no hay proveedores</h3><p>Crea la primera cuenta con «Nueva cuenta».</p></div></td></tr>`;
    }

    const editor = EV.drawer($('#hcEditor'));
    $('#hcCerrar').addEventListener('click', () => editor.cerrar());
    $('#hcCancelar').addEventListener('click', () => editor.cerrar());
    $('#hcNueva').addEventListener('click', () => editar(null));
    $('#hcLista').addEventListener('click', e => {
        const ed = e.target.closest('[data-editar]'); if (ed) return editar(cuentas.find(x => x.id === +ed.dataset.editar));
        const cg = e.target.closest('[data-cargas]');
        if (cg) { filtro = ''; tabs.ir('htProv'); $('#hpCuenta').value = cg.dataset.cargas; listar(true); }
    });

    async function editar(x) {
        await resumen;
        $('#hcTitulo').textContent = x ? `Editar «${x.nombre}»` : 'Nueva cuenta de proveedor';
        $('#hcId').value = x?.id || '';
        $('#hcNombre').value = x?.nombre || ''; $('#hcEmail').value = x?.email || ''; $('#hcTel').value = x?.telefono || '';
        const grupos = {};
        catalogo.forEach(p => (grupos[p.tipo || 'Otros'] ||= []).push(p));
        $('#hcProv').innerHTML = '<option value="">Elige el proveedor…</option>' + Object.entries(grupos).map(([g, l]) =>
            `<optgroup label="${esc(g)}">${l.map(p => `<option value="${esc(p.id)}">${esc(p.nombre)} (${esc(p.id)})</option>`).join('')}</optgroup>`).join('');
        $('#hcProv').value = x?.id_Proveedor || '';
        const tiene = new Set(x?.listaModulos || []);
        $('#hcMods').innerHTML = Object.values(modulos).map(m => `<label class="ui-switch"><input type="checkbox" value="${esc(m.clave)}" ${tiene.has(m.clave) ? 'checked' : ''}><span class="tr"></span><i class="bi ${esc(m.icono)}"></i> ${esc(m.nombre)}</label>`).join('');
        $('#hcActivo').checked = x ? x.activo : true;
        editor.abrir();
        setTimeout(() => $('#hcNombre').focus(), 200);
    }

    $('#hcGuardar').addEventListener('click', async () => {
        const dto = {
            id: +$('#hcId').value || null, nombre: $('#hcNombre').value.trim(), email: $('#hcEmail').value.trim(), telefono: $('#hcTel').value.trim() || null,
            id_Proveedor: $('#hcProv').value, modulos: [...$('#hcMods').querySelectorAll('input:checked')].map(i => i.value), activo: $('#hcActivo').checked
        };
        try {
            const r = await EV.post('/Herramientas/ProveedorCuentaGuardar', dto);
            EV.toast(r.mensaje); editor.cerrar(true); await cargarCuentas();
        } catch { }
    });

    // ---------------- abrir directo (campana: /Herramientas/Index?tab=htProv&carga=12) ----------------
    const tab = params.get('tab'), carga = +params.get('carga');
    if (tab && document.getElementById(tab)) {
        tabs.ir(tab);
        if (carga) resumen.then(() => abrir(carga));
    }
})();
</script>
}
