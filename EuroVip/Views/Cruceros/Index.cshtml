            ${C.secciones.length ? `<div class="cz-blq"><label class="cz-c"><span>Título de esta parte en la web ${opc}</span><input data-b="titulo_Seccion" maxlength="150" value="${esc(C.titulo_Seccion || '')}" placeholder="Si lo dejas vacío: «Tu barco - ${esc(C.barco_Nombre || '{barco}')}»"></label></div>` : ''}`;
    }

