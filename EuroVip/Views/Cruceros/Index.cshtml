            <div class="cz-barra">
                ${n ? `<button type="button" class="ev-btn" data-it="generar"><i class="bi bi-magic"></i> Crear los ${n + 1} días (${n} noches)</button>` : '<span class="ui-help" style="margin:0">Pon las <b>noches</b> en el paso 1 para crear todos los días de una vez.</span>'}
                <button type="button" class="ev-btn ghost" data-it="nuevo"><i class="bi bi-plus-lg"></i> Agregar un día</button>
                ${C.itinerario.length ? `<span class="cz-cuenta-chip">${C.itinerario.length} días · ${C.itinerario.filter(d => d.en_Navegacion).length} en el mar</span>` : ''}
            </div>
            <datalist id="dlPuertos">${sugeridos.map(p => `<option value="${esc(p)}">`).join('')}</datalist>
            ${C.itinerario.length ? `<div class="cz-ruta">${C.itinerario.map((d, i) => `<div class="cz-paso ${d.en_Navegacion ? 'mar' : ''}">
                <div class="cz-paso-n"><b>${i + 1}</b><small>DÍA</small>${sal ? `<em>${fechaCorta(masDias(sal.fecha, i))}</em>` : ''}</div>
