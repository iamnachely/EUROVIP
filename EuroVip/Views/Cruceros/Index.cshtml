@{
    ViewData["Title"] = "Cruceros";
}

@section Styles {
<link rel="stylesheet" href="~/css/eurovip-ui.css" asp-append-version="true" />
<style>
    .cz-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 18px 0 4px; }
    .cz-kpi { text-align: left; border: 1px solid var(--ev-line); background: var(--ev-surface); border-radius: 18px; padding: 14px 16px; cursor: pointer; font: inherit; color: inherit; transition: border-color .2s, transform .2s, box-shadow .2s; }
    .cz-kpi:hover { transform: translateY(-2px); box-shadow: var(--ev-shadow); }
    .cz-kpi.on { border-color: var(--ev-teal); box-shadow: 0 0 0 4px rgba(116,242,230,.3); }
    .cz-kpi b { display: block; font-size: 26px; font-weight: 800; letter-spacing: -.6px; }
    .cz-kpi small { color: var(--ev-muted); font-weight: 700; font-size: 12.5px; display: flex; align-items: center; gap: 6px; }
    .cz-kpi.mal b { color: #B54708; }
    .cz-cuenta { color: var(--ev-muted); font-weight: 700; font-size: 13px; margin: 6px 0 12px; }
    .cz-ayuda { border-radius: 20px; border: 1px solid #B3FFF3; background: #ECFEFB; color: #0E6F68; margin: 14px 0 4px; }
    .cz-ayuda summary { list-style: none; cursor: pointer; display: flex; gap: 10px; align-items: center; padding: 13px 18px; font-weight: 800; font-size: 14px; }
    .cz-ayuda summary::-webkit-details-marker { display: none; }
    .cz-ayuda summary .fl { margin-left: auto; transition: transform .2s; }
    .cz-ayuda[open] summary .fl { transform: rotate(180deg); }
    .cz-ayuda ol { margin: 0; padding: 0 22px 16px 40px; display: grid; gap: 6px; font-size: 13.5px; font-weight: 600; color: var(--ev-text); }

    /* Tarjeta de crucero (como la lista de la web) */
    .cz-lista { display: grid; gap: 16px; }
    .cz-card { display: grid; grid-template-columns: 260px minmax(0, 1fr) 190px; gap: 20px; padding: 18px; border-radius: 20px; border: 1px solid var(--ev-line); background: var(--ev-surface); transition: transform .25s var(--ev-ease), box-shadow .25s, border-color .25s; }
    .cz-card:hover { transform: translateY(-3px); box-shadow: var(--ev-shadow); border-color: var(--ev-aqua); }
    .cz-card.off { opacity: .62; }
    .cz-card .foto { border-radius: 14px; overflow: hidden; background: var(--ev-grad); aspect-ratio: 4/3.4; display: grid; place-items: center; cursor: pointer; }
    .cz-card .foto img { width: 100%; height: 100%; object-fit: cover; }
    .cz-card .foto .sin { color: var(--ev-ink); font-weight: 800; font-size: 13px; text-align: center; opacity: .8; }
    .cz-card .foto .sin i { font-size: 38px; display: block; }
    .cz-card h3 { margin: 0 0 10px; font-size: 21px; font-weight: 800; letter-spacing: -.4px; line-height: 1.2; }
    .cz-dl { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 4px 12px; font-size: 13.5px; margin: 0; }
    .cz-dl dt { font-weight: 800; }
    .cz-dl dd { margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cz-precios { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; border-top: 1px solid var(--ev-line); margin-top: 12px; padding-top: 10px; }
    .cz-precios div small { display: block; font-weight: 800; font-size: 12.5px; }
    .cz-precios div b { color: #00337F; font-size: 14.5px; }
    .cz-precios div.sin b { color: var(--ev-muted); font-weight: 600; font-size: 12.5px; }
    .cz-der { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; text-align: right; }
    .cz-der .logo { max-width: 160px; max-height: 56px; object-fit: contain; }
    .cz-der .nav { font-weight: 800; color: #00337F; }
    .cz-der .chips { display: flex; gap: 5px; flex-wrap: wrap; justify-content: flex-end; }
    .cz-der .acc { margin-top: auto; display: flex; gap: 4px; flex-wrap: wrap; justify-content: flex-end; }
    .cz-chip { font: 700 11.5px var(--ev-font); padding: 4px 9px; border-radius: 9px; background: var(--ev-surface-2); border: 1px solid var(--ev-line); display: inline-flex; gap: 5px; align-items: center; }
    .cz-chip.ok { background: #ECFDF3; color: #067647; border-color: #ABEFC6; }
    .cz-chip.av { background: #FFFAEB; color: #93370D; border-color: #FEDF89; }
    @@media (max-width: 1000px) { .cz-card { grid-template-columns: 200px minmax(0, 1fr); } .cz-der { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; text-align: left; } .cz-der .acc { margin: 0; } }
    @@media (max-width: 640px) { .cz-card { grid-template-columns: 1fr; } .cz-precios { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

    /* Catálogos */
    .cz-cats { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
    .cz-cat { border: 1px solid var(--ev-line); border-radius: 20px; background: var(--ev-surface); padding: 16px; }
    .cz-cat h3 { margin: 0 0 12px; font-size: 16px; display: flex; gap: 8px; align-items: center; }
    .cz-cat h3 .sp { flex: 1; }
    .cz-it { display: flex; gap: 10px; align-items: center; padding: 8px; border-radius: 12px; }
    .cz-it:hover { background: var(--ev-surface-2); }
    .cz-it .im { width: 46px; height: 46px; border-radius: 10px; background: var(--ev-surface-2); display: grid; place-items: center; overflow: hidden; flex-shrink: 0; border: 1px solid var(--ev-line); }
    .cz-it .im img { width: 100%; height: 100%; object-fit: contain; }
    .cz-it .tx { flex: 1; min-width: 0; }
    .cz-it .tx b { display: block; font-size: 14px; }
    .cz-it .tx small { color: var(--ev-muted); font-weight: 600; }

    /* Editor */
    .cz-pasos { margin: 0 24px; overflow-x: auto; }
    .cz-blq { border: 1px solid var(--ev-line); border-radius: 18px; padding: 14px 16px; margin-bottom: 14px; background: var(--ev-surface); }
    .cz-blq > h3 { margin: 0 0 12px; font-size: 14.5px; font-weight: 800; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .cz-blq > h3 .sp { flex: 1; }
    .cz-blq > h3 small { color: var(--ev-muted); font-weight: 600; font-size: 12px; }
    .cz-cats-sel { display: flex; gap: 8px; flex-wrap: wrap; }
    .cz-cats-sel label { display: inline-flex; gap: 6px; align-items: center; padding: 7px 12px; border-radius: 12px; border: 1px solid var(--ev-line); cursor: pointer; font-weight: 700; font-size: 13px; }
    .cz-cats-sel label:has(input:checked) { background: var(--ev-ink); color: var(--ev-aqua); border-color: var(--ev-ink); }
    .cz-cats-sel input { accent-color: var(--ev-teal); }
    .cz-tab { width: 100%; border-collapse: separate; border-spacing: 0 6px; }
    .cz-tab th { text-align: left; font: 800 11.5px var(--ev-font); color: var(--ev-muted); text-transform: uppercase; letter-spacing: .05em; padding: 0 6px; }
    .cz-tab td { padding: 0 6px; vertical-align: top; }
    .cz-tab input, .cz-tab select, .cz-tab textarea { width: 100%; }
    .cz-tab .num { width: 70px; }
    .cz-tab .hora { width: 104px; }
    .cz-foto { position: relative; width: 74px; height: 54px; border-radius: 10px; overflow: hidden; background: var(--ev-surface-2); border: 1px dashed var(--ev-line); display: grid; place-items: center; cursor: pointer; flex-shrink: 0; }
    .cz-foto img { width: 100%; height: 100%; object-fit: cover; }
    .cz-foto i { color: var(--ev-muted); font-size: 18px; }
    .cz-foto.grande { width: 100%; height: 130px; }
    .cz-foto .x { position: absolute; right: 3px; top: 3px; width: 20px; height: 20px; border-radius: 50%; border: 0; background: rgba(11,18,21,.75); color: #fff; font-size: 11px; cursor: pointer; display: grid; place-items: center; }
    .cz-foto.subiendo::after { content: "…"; position: absolute; inset: 0; background: rgba(255,255,255,.7); display: grid; place-items: center; font-weight: 800; }
    .cz-sec { border: 1px solid var(--ev-line); border-radius: 16px; padding: 12px; margin-bottom: 12px; background: var(--ev-surface-2); }
    .cz-sec-h { display: flex; gap: 8px; align-items: center; margin-bottom: 10px; }
    .cz-sec-h input { flex: 1; font-weight: 800; }
    .cz-acts { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 10px; }
    .cz-act { border: 1px solid var(--ev-line); border-radius: 14px; padding: 10px; background: var(--ev-surface); display: grid; gap: 6px; }
    .cz-act .fila { display: flex; gap: 6px; }
    .cz-add { border: 2px dashed var(--ev-line); border-radius: 14px; background: transparent; cursor: pointer; color: var(--ev-muted); font: 700 13px var(--ev-font); min-height: 90px; }
    .cz-add:hover { border-color: var(--ev-teal); color: var(--ev-deep); background: var(--ev-mint); }
    .cz-tipo { border: 1px solid var(--ev-line); border-radius: 16px; padding: 12px; margin-bottom: 10px; display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 12px; background: var(--ev-surface); }
    .cz-tipo .campos { display: grid; gap: 8px; }
    .cz-tipo .g { display: grid; grid-template-columns: 90px minmax(0, 1fr) 80px 80px 80px; gap: 8px; }
    .cz-cabs { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
    .cz-cab { display: inline-flex; gap: 4px; align-items: center; border: 1px solid var(--ev-line); border-radius: 10px; padding: 3px 4px 3px 8px; background: var(--ev-surface-2); font-size: 12.5px; font-weight: 700; }
    .cz-cab input { width: 64px; padding: 4px 6px; }
    .cz-cab select { padding: 4px; }
    .cz-cab button { border: 0; background: none; cursor: pointer; color: var(--ev-muted); }
    .cz-salidas { display: flex; gap: 8px; flex-wrap: wrap; }
    .cz-sal { display: inline-flex; gap: 8px; align-items: center; padding: 7px 8px 7px 12px; border-radius: 12px; border: 1px solid var(--ev-line); background: var(--ev-surface); font-weight: 700; font-size: 13px; cursor: pointer; }
    .cz-sal.on { border-color: var(--ev-ink); background: var(--ev-ink); color: var(--ev-aqua); }
    .cz-sal.off { opacity: .55; text-decoration: line-through; }
    .cz-sal button { border: 0; background: rgba(0,0,0,.08); color: inherit; border-radius: 7px; width: 22px; height: 22px; cursor: pointer; }
    .cz-mat { width: 100%; border-collapse: collapse; }
    .cz-mat th, .cz-mat td { border-bottom: 1px solid var(--ev-line); padding: 7px 6px; text-align: left; font-size: 13px; }
    .cz-mat th { font: 800 12px var(--ev-font); background: var(--ev-surface-2); }
    .cz-mat td input { width: 120px; text-align: right; }
    .cz-mat tr.grp td { background: var(--ev-surface-2); font-weight: 800; font-size: 12px; text-transform: uppercase; letter-spacing: .05em; color: var(--ev-muted); }
    @@media (max-width: 760px) { .cz-tipo { grid-template-columns: 1fr; } .cz-tipo .g { grid-template-columns: 1fr 1fr; } }

    /* Vista previa (como la ficha de la web) */
    .vz-banner { position: relative; min-height: 150px; border-radius: 18px; overflow: hidden; display: flex; align-items: center; padding: 24px; color: #fff; background: linear-gradient(135deg, #0E8F86, #74F2E6); margin-bottom: 16px; }
    .vz-banner img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .vz-banner h2 { position: relative; margin: 0; font-size: clamp(24px, 3vw, 34px); font-weight: 800; text-shadow: 0 2px 14px rgba(0,0,0,.35); max-width: 640px; line-height: 1.1; }
    .vz-sub { font-size: 19px; font-weight: 800; margin: 0 0 12px; }
    .vz-top { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 16px; margin-bottom: 18px; }
    .vz-gal { position: relative; border-radius: 16px; overflow: hidden; background: var(--ev-surface-2); aspect-ratio: 16/10; }
    .vz-gal img { width: 100%; height: 100%; object-fit: cover; }
    .vz-gal button { position: absolute; top: 50%; transform: translateY(-50%); width: 38px; height: 38px; border-radius: 50%; border: 2px solid #00337F; background: #fff; color: #00337F; cursor: pointer; }
    .vz-gal .a { left: 10px; } .vz-gal .s { right: 10px; }
    .vz-info { border: 1px solid var(--ev-line); border-radius: 14px; padding: 12px 14px; display: grid; gap: 8px; font-size: 13.5px; }
    .vz-info span { display: flex; gap: 8px; align-items: center; } .vz-info i { color: #00337F; }
    .vz-desde { margin-top: 10px; } .vz-desde small { color: var(--ev-muted); } .vz-desde b { display: block; font-size: 28px; color: #00337F; }
    .vz-h { font-size: 18px; font-weight: 800; margin: 18px 0 10px; }
    .vz-tabs { display: flex; gap: 18px; border-bottom: 1px solid var(--ev-line); margin-bottom: 12px; flex-wrap: wrap; }
    .vz-tabs button { border: 0; background: none; padding: 8px 2px; font: 800 13.5px var(--ev-font); color: var(--ev-text); cursor: pointer; border-bottom: 3px solid transparent; }
    .vz-tabs button.on { border-color: #00337F; }
    .vz-acts { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; }
    .vz-act img, .vz-act .sin { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 8px; background: var(--ev-surface-2); display: block; }
    .vz-act b { display: block; margin-top: 6px; font-size: 14px; }
    .vz-act small { color: #00337F; font-weight: 800; }
    .vz-fechas { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 10px; }
    .vz-fecha { border: 1px solid var(--ev-line); border-radius: 12px; padding: 12px; text-align: center; font-size: 13px; cursor: pointer; }
    .vz-fecha.on { border-color: #00337F; background: #E0F4FE; }
    .vz-fecha b { display: block; font-size: 15px; }
    .vz-fecha table { width: 100%; margin-top: 8px; font-size: 12.5px; }
    .vz-fecha td:last-child { text-align: right; font-weight: 800; }
    .vz-cab { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 12px; border: 1px solid var(--ev-line); border-radius: 14px; overflow: hidden; margin-bottom: 10px; }
    .vz-cab img, .vz-cab .sin { width: 100%; height: 100%; min-height: 120px; object-fit: cover; background: var(--ev-surface-2); }
    .vz-cab > div:last-child { padding: 12px 12px 12px 0; }
    .vz-cab b { font-size: 16px; } .vz-cab .pr { font-size: 22px; font-weight: 800; color: #00337F; }
    @@media (max-width: 760px) { .vz-top { grid-template-columns: 1fr; } .vz-cab { grid-template-columns: 1fr; } }
</style>
}

@Html.AntiForgeryToken()

<section class="ui-hero ev-rise">
    <i class="bi bi-water ui-hero-ico" aria-hidden="true"></i>
    <div>
        <span class="ev-chip dark"><i class="bi bi-water"></i> Catálogo · Cruceros</span>
        <h1>Cruceros</h1>
        <p>Carga cruceros como en la web: fotos, itinerario por día con horas, «a bordo» (comida, entretenimiento…), cabinas y cubiertas, fechas de salida, tarifas y precios por persona.</p>
    </div>
    <div class="ui-hero-acts">
        <button class="ev-btn" type="button" id="czNuevo"><i class="bi bi-plus-lg"></i> Nuevo crucero</button>
    </div>
    <svg class="ui-hero-waves" viewBox="0 0 600 40" preserveAspectRatio="none" aria-hidden="true">
        <g><path d="M-240 18 q30 -8 60 0 t60 0 q30 -8 60 0 t60 0 q30 -8 60 0 t60 0 q30 -8 60 0 t60 0 q30 -8 60 0 t60 0 q30 -8 60 0 t60 0 q30 -8 60 0 t60 0 L840 40 L-240 40 Z" fill="#fff" /></g>
        <g><path d="M-240 26 q30 -6 60 0 t60 0 q30 -6 60 0 t60 0 q30 -6 60 0 t60 0 q30 -6 60 0 t60 0 q30 -6 60 0 t60 0 q30 -6 60 0 t60 0 q30 -6 60 0 t60 0 L840 40 L-240 40 Z" fill="#fff" /></g>
    </svg>
</section>

<details class="cz-ayuda" id="czAyuda">
    <summary><i class="bi bi-lightbulb"></i> ¿Cómo se carga un crucero? <i class="bi bi-chevron-down fl"></i></summary>
    <ol>
        <li>En <b>Catálogos</b> crea la <b>naviera</b> (Disney Cruise Line, MSC…) con su logo, sus <b>barcos</b> (Disney Treasure…) y las <b>categorías</b> de la web (Desde Rep. Dom., Cruceros Disney…).</li>
        <li>Con <b>Nuevo crucero</b>: título, barco, puertos, noches y en qué categorías sale. Guarda y ya puedes subir sus <b>fotos</b> (portada, banner y galería).</li>
        <li><b>Itinerario</b>: un día por fila con el puerto y las horas de llegada y salida (o «En navegación»). La fecha de cada día sale de la fecha de salida.</li>
        <li><b>A bordo</b>: las pestañas de «Tu barco» (Comida y bebida, Entretenimiento…) con sus actividades: foto, título y descripción.</li>
        <li><b>Cabinas</b>: los tipos de camarote por categoría (Interior, Exterior, Balcón, Suite) con foto, capacidad y m²; las <b>cubiertas</b> y, si quieres, las cabinas concretas (si no, se vende «Garantizada»).</li>
        <li><b>Fechas y precios</b>: las fechas de salida, los <b>códigos de tarifa</b> (BEST_PRICE, Florida Resident…) y el precio <b>por persona</b> de cada tipo de cabina en cada fecha y tarifa.</li>
        <li>Cada categoría con cruceros activos y precio sale sola en la <b>Home</b> (sección CRUCEROS), con el precio «desde».</li>
    </ol>
</details>

<div class="ui-tabs" id="czVistas" style="margin-top:16px;max-width:420px">
    <button type="button" data-tab="pCruceros" class="on"><i class="bi bi-water"></i> Cruceros <span class="n" id="nCruceros">0</span></button>
    <button type="button" data-tab="pCatalogos"><i class="bi bi-collection"></i> Catálogos</button>
</div>

<section class="ui-pane on" id="pCruceros">
    <div class="cz-kpis" id="czKpis"></div>
    <div class="ui-toolbar">
        <label class="ui-search"><i class="bi bi-search"></i><input id="czQ" type="search" placeholder="Buscar por título, barco, puerto, código…" autocomplete="off" /></label>
        <select class="ui-select" id="czNaviera" title="Naviera"><option value="">Todas las navieras</option></select>
        <select class="ui-select" id="czCategoria" title="Categoría"><option value="">Todas las categorías</option></select>
        <select class="ui-select" id="czOrden" title="Ordenar">
            <option value="fecha">Próxima salida</option>
            <option value="precio">Precio: menor a mayor</option>
            <option value="titulo">Título (A-Z)</option>
            <option value="recientes">Más recientes</option>
        </select>
    </div>
    <div class="cz-cuenta" id="czCuenta"></div>
    <div id="czLista"><div class="ui-skel" style="height:300px"></div></div>
</section>

<section class="ui-pane" id="pCatalogos">
    <div class="cz-cats" id="czCats" style="margin-top:16px"></div>
</section>

<!-- ===================== EDITOR ===================== -->
<aside class="ui-drawer" id="czEditor" aria-hidden="true">
    <div class="ui-dh">
        <div class="ev-module-icon" style="width:46px;height:46px"><i class="bi bi-water"></i></div>
        <div style="min-width:0"><h2 id="edTitulo">Nuevo crucero</h2><small id="edSub">Los campos con * son obligatorios.</small></div>
        <button class="ui-ibtn x" type="button" id="edCerrar" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="cz-pasos">
        <div class="ui-tabs" id="edTabs">
            <button type="button" data-tab="eDatos" class="on"><i class="bi bi-info-circle"></i> Datos</button>
            <button type="button" data-tab="eFotos"><i class="bi bi-images"></i> Fotos</button>
            <button type="button" data-tab="eItin"><i class="bi bi-signpost-2"></i> Itinerario <span class="n" id="nItin">0</span></button>
            <button type="button" data-tab="eBordo"><i class="bi bi-stars"></i> A bordo <span class="n" id="nBordo">0</span></button>
            <button type="button" data-tab="eCabinas"><i class="bi bi-door-closed"></i> Cabinas <span class="n" id="nCabinas">0</span></button>
            <button type="button" data-tab="ePrecios"><i class="bi bi-calendar3"></i> Fechas y precios <span class="n" id="nSalidas">0</span></button>
        </div>
    </div>
    <div class="ui-db" id="edCuerpo">
        <section class="ui-pane on" id="eDatos"></section>
        <section class="ui-pane" id="eFotos"></section>
        <section class="ui-pane" id="eItin"></section>
        <section class="ui-pane" id="eBordo"></section>
        <section class="ui-pane" id="eCabinas"></section>
        <section class="ui-pane" id="ePrecios"></section>
    </div>
    <div class="ui-df">
        <button class="ev-btn ghost" type="button" id="edEliminar"><i class="bi bi-trash3"></i> Eliminar</button>
        <span class="hint">Ctrl + Enter guarda</span>
        <button class="ev-btn ghost" type="button" id="edCancelar">Cancelar</button>
        <button class="ev-btn" type="button" id="edGuardar"><i class="bi bi-check2-circle"></i> Guardar</button>
    </div>
</aside>

<!-- ===================== VER (como la web) ===================== -->
<aside class="ui-drawer" id="czVer" aria-hidden="true">
    <div class="ui-dh">
        <div class="ev-module-icon" style="width:46px;height:46px"><i class="bi bi-eye"></i></div>
        <div style="min-width:0"><h2 id="verTitulo">Crucero</h2><small id="verSub"></small></div>
        <button class="ui-ibtn x" type="button" id="verCerrar" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="ui-db" id="verCuerpo"></div>
    <div class="ui-df">
        <span class="hint">Así lo verá el cliente</span>
        <button class="ev-btn ghost" type="button" id="verDuplicar"><i class="bi bi-copy"></i> Duplicar</button>
        <button class="ev-btn" type="button" id="verEditar"><i class="bi bi-pencil"></i> Editar</button>
    </div>
</aside>

<!-- ===================== CATÁLOGO (naviera / barco / categoría) ===================== -->
<aside class="ui-drawer" id="czCat" aria-hidden="true">
    <div class="ui-dh">
        <div class="ev-module-icon" style="width:46px;height:46px"><i class="bi bi-collection"></i></div>
        <div style="min-width:0"><h2 id="catTitulo">Catálogo</h2><small>Se guarda al pulsar Guardar.</small></div>
        <button class="ui-ibtn x" type="button" id="catCerrar" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="ui-db" id="catCuerpo"></div>
    <div class="ui-df">
        <button class="ev-btn ghost" type="button" id="catEliminar"><i class="bi bi-trash3"></i> Eliminar</button>
        <span class="hint"></span>
        <button class="ev-btn ghost" type="button" id="catCancelar">Cancelar</button>
        <button class="ev-btn" type="button" id="catGuardar"><i class="bi bi-check2-circle"></i> Guardar</button>
    </div>
</aside>

@section Scripts {
<script src="~/js/eurovip-ui.js" asp-append-version="true"></script>
<script src="~/js/eurovip-multimedia.js" asp-append-version="true"></script>
<script>
(() => {
    const $ = (s, el = document) => el.querySelector(s);
    const $$ = (s, el = document) => [...el.querySelectorAll(s)];
    const esc = EV.esc;
    const editor = EV.drawer($('#czEditor')), visor = EV.drawer($('#czVer')), dCat = EV.drawer($('#czCat'));
    const vistas = EV.tabs($('#czVistas'));
    const edTabs = EV.tabs($('#edTabs'), id => { if (id === 'eFotos') pintarFotos(); });
    let D = { cruceros: [], navieras: [], barcos: [], categorias: [], categoriasCabina: {} };
    let C = null, verId = null, galeria = null, salidaSel = null, catTipoSel = 'INTERIOR', sec = 0;
    const st = { q: '', naviera: '', categoria: '', filtro: '', orden: 'fecha' };
    const CATS = ['INTERIOR', 'EXTERIOR', 'BALCON', 'SUITE'];
    const CAT_CORTO = { INTERIOR: 'Interior', EXTERIOR: 'Exterior', BALCON: 'Balcón', SUITE: 'Suite' };

    const dinero = v => v == null ? '—' : `${EV.simbolo()} ${EV.fmt(v, Number(v) % 1 ? 2 : 0)}`;
    const nuevaClave = p => p + 'n' + (++sec);
    const fechaTxt = f => f ? new Date(f.slice(0, 10) + 'T00:00:00').toLocaleDateString('es', { day: '2-digit', month: 'long', year: 'numeric' }) : '—';
    const fechaCorta = f => new Date(f.slice(0, 10) + 'T00:00:00').toLocaleDateString('es', { day: '2-digit', month: 'short', year: 'numeric' });
    const masDias = (f, n) => { const d = new Date(f.slice(0, 10) + 'T00:00:00Z'); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); };
    const hoy = new Date(Date.now() - new Date().getTimezoneOffset() * 6e4).toISOString().slice(0, 10);

    // ===================== DATOS =====================
    async function cargar() {
        try { D = await EV.api('/Cruceros/Listar'); }
        catch (e) { $('#czLista').innerHTML = `<div class="ui-empty"><h3>No pudimos cargar los cruceros</h3><p>${esc(e.message)}</p></div>`; return; }
        $('#nCruceros').textContent = D.cruceros.length;
        const sel = (id, todos, pares) => { const s = $(id), v = s.value; s.innerHTML = `<option value="">${todos}</option>` + pares.map(([k, t]) => `<option value="${k}" ${String(k) === v ? 'selected' : ''}>${esc(t)}</option>`).join(''); };
        sel('#czNaviera', 'Todas las navieras', D.navieras.map(n => [n.id_Naviera, n.nombre]));
        sel('#czCategoria', 'Todas las categorías', D.categorias.map(c => [c.id_Categoria, c.nombre]));
        if (!D.cruceros.length) $('#czAyuda').open = true;
        pintar(); pintarCatalogos();
    }

    function filtrados() {
        const q = st.q.toLowerCase();
        return D.cruceros.filter(c =>
            (!st.naviera || String(c.id_Naviera) === st.naviera) &&
            (!st.categoria || (c.ids_Categoria || '').split(',').includes(st.categoria)) &&
            (!q || [c.titulo, c.barco, c.naviera, c.puerto_Salida, c.puerto_Llegada, c.codigo, c.itinerario, c.categorias].some(x => (x || '').toLowerCase().includes(q)) || String(c.id_Crucero) === q) &&
            (st.filtro === '' || (st.filtro === 'activos' && c.activo) || (st.filtro === 'inactivos' && !c.activo) ||
             (st.filtro === 'sinfoto' && !c.imagen) || (st.filtro === 'sinprecio' && c.desde_Pp == null) || (st.filtro === 'venta' && c.activo && c.desde_Pp != null)))
            .sort({
                fecha: (a, b) => (a.proxima_Salida || '9999').localeCompare(b.proxima_Salida || '9999'),
                precio: (a, b) => (a.desde_Pp ?? 1e12) - (b.desde_Pp ?? 1e12),
                titulo: (a, b) => a.titulo.localeCompare(b.titulo, 'es'),
                recientes: (a, b) => b.id_Crucero - a.id_Crucero
            }[st.orden]);
    }

    function pintar() {
        const t = D.cruceros;
        const k = [['', t.length, 'Cruceros', 'bi-water'], ['venta', t.filter(c => c.activo && c.desde_Pp != null).length, 'A la venta', 'bi-broadcast'],
                   ['inactivos', t.filter(c => !c.activo).length, 'Desactivados', 'bi-pause-circle'],
                   ['sinprecio', t.filter(c => c.desde_Pp == null).length, 'Sin fechas o precios', 'bi-currency-dollar', true],
                   ['sinfoto', t.filter(c => !c.imagen).length, 'Sin foto', 'bi-image', true]];
        $('#czKpis').innerHTML = k.map(([f, n, tx, i, al]) => `<button type="button" class="cz-kpi ${st.filtro === f ? 'on' : ''} ${al && n ? 'mal' : ''}" data-filtro="${f}"><b>${EV.fmt(n)}</b><small><i class="bi ${i}"></i> ${tx}</small></button>`).join('');
        const l = filtrados();
        $('#czCuenta').textContent = l.length === t.length ? `${EV.fmt(l.length)} cruceros` : `Mostrando ${EV.fmt(l.length)} de ${EV.fmt(t.length)}`;
        if (!t.length) { $('#czLista').innerHTML = `<div class="ui-empty"><i class="bi bi-water" style="font-size:40px"></i><h3>Todavía no hay cruceros</h3><p>Primero crea en <b>Catálogos</b> la naviera y el barco; luego pulsa «Nuevo crucero».</p></div>`; return; }
        if (!l.length) { $('#czLista').innerHTML = `<div class="ui-empty"><i class="bi bi-search" style="font-size:36px"></i><h3>No hay cruceros con ese filtro</h3></div>`; return; }
        $('#czLista').innerHTML = `<div class="cz-lista">${l.map(tarjeta).join('')}</div>`;
    }

    function tarjeta(c) {
        const p = (cat, v) => `<div class="${v == null ? 'sin' : ''}"><small>${cat}</small><b>${v == null ? '—' : dinero(v)}</b></div>`;
        return `<article class="cz-card ${c.activo ? '' : 'off'}" data-id="${c.id_Crucero}">
            <div class="foto" data-accion="ver">${c.imagen ? `<img src="${esc(c.imagen)}" alt="" loading="lazy">` : '<span class="sin"><i class="bi bi-water"></i>Sin foto</span>'}</div>
            <div style="min-width:0">
                <h3>${esc(c.titulo)}</h3>
                <dl class="cz-dl">
                    <dt>Fecha</dt><dd>${c.proxima_Salida ? fechaTxt(c.proxima_Salida) + (c.salidas_Futuras > 1 ? ` <small style="color:var(--ev-muted)">(+${c.salidas_Futuras - 1} fechas)</small>` : '') : '<span style="color:#B54708">Sin fechas a la venta</span>'}</dd>
                    <dt>Duración</dt><dd>${c.noches + 1} días · ${c.noches} noches</dd>
                    <dt>Barco</dt><dd>${esc(c.barco)}</dd>
                    <dt>Desde / Hasta</dt><dd>${esc(c.puerto_Salida)}${c.puerto_Llegada !== c.puerto_Salida ? ' / ' + esc(c.puerto_Llegada) : ''}</dd>
                    <dt>Itinerario</dt><dd>${esc(c.itinerario || '—')}</dd>
                </dl>
                <div class="cz-precios">${p('Interior', c.interior_Pp)}${p('Exterior', c.exterior_Pp)}${p('Balcón', c.balcon_Pp)}${p('Suite', c.suite_Pp)}</div>
            </div>
            <div class="cz-der">
                ${c.naviera_Logo ? `<img class="logo" src="${esc(c.naviera_Logo)}" alt="${esc(c.naviera)}">` : `<span class="nav">${esc(c.naviera)}</span>`}
                <div class="chips">${c.activo ? '<span class="cz-chip ok"><i class="bi bi-broadcast"></i> En la web</span>' : '<span class="cz-chip av">Desactivado</span>'}
                    ${c.categorias ? `<span class="cz-chip"><i class="bi bi-tags"></i> ${esc(c.categorias)}</span>` : '<span class="cz-chip av">Sin categoría</span>'}
                    <span class="cz-chip">n.º ${c.id_Crucero}${c.codigo ? ' · ' + esc(c.codigo) : ''}</span></div>
                <div class="acc">
                    <button type="button" class="ui-ibtn" data-accion="ver" title="Ver como la web"><i class="bi bi-eye"></i></button>
                    <button type="button" class="ui-ibtn" data-accion="editar" title="Editar"><i class="bi bi-pencil"></i></button>
                    <button type="button" class="ui-ibtn" data-accion="duplicar" title="Duplicar"><i class="bi bi-copy"></i></button>
                    <button type="button" class="ui-ibtn" data-accion="activar" title="${c.activo ? 'Desactivar' : 'Activar'}"><i class="bi ${c.activo ? 'bi-pause-circle' : 'bi-play-circle'}"></i></button>
                    <button type="button" class="ui-ibtn danger" data-accion="eliminar" title="Eliminar"><i class="bi bi-trash3"></i></button>
                </div>
            </div>
        </article>`;
    }

    // ===================== CATÁLOGOS =====================
    function pintarCatalogos() {
        const it = (im, b, s, attrs) => `<div class="cz-it"><span class="im">${im ? `<img src="${esc(im)}" alt="">` : '<i class="bi bi-image" style="color:var(--ev-muted)"></i>'}</span>
            <span class="tx"><b>${b}</b><small>${s}</small></span><button type="button" class="ui-ibtn" ${attrs} title="Editar"><i class="bi bi-pencil"></i></button></div>`;
        $('#czCats').innerHTML = `
            <div class="cz-cat"><h3><i class="bi bi-flag"></i> Navieras <span class="sp"></span><button type="button" class="ev-btn sm" data-cat-nuevo="naviera"><i class="bi bi-plus-lg"></i> Nueva</button></h3>
                ${D.navieras.map(n => it(n.logo, esc(n.nombre), `${n.barcos} barco(s)${n.activo ? '' : ' · inactiva'}`, `data-cat-ed="naviera" data-id="${n.id_Naviera}"`)).join('') || '<p class="ui-help">Ninguna todavía. Ej.: Disney Cruise Line.</p>'}</div>
            <div class="cz-cat"><h3><i class="bi bi-water"></i> Barcos <span class="sp"></span><button type="button" class="ev-btn sm" data-cat-nuevo="barco" ${D.navieras.length ? '' : 'disabled title="Primero crea una naviera"'}><i class="bi bi-plus-lg"></i> Nuevo</button></h3>
                ${D.barcos.map(b => it(b.imagen, esc(b.nombre), `${esc(b.naviera)} · ${b.cruceros} crucero(s)${b.activo ? '' : ' · inactivo'}`, `data-cat-ed="barco" data-id="${b.id_Barco}"`)).join('') || '<p class="ui-help">Ninguno todavía. Ej.: Disney Treasure.</p>'}</div>
            <div class="cz-cat"><h3><i class="bi bi-tags"></i> Categorías de la web <span class="sp"></span><button type="button" class="ev-btn sm" data-cat-nuevo="categoria"><i class="bi bi-plus-lg"></i> Nueva</button></h3>
                ${D.categorias.map(g => it(g.imagen, esc(g.nombre), `${g.cruceros} crucero(s) · orden ${g.orden}${g.activo ? '' : ' · oculta'}`, `data-cat-ed="categoria" data-id="${g.id_Categoria}"`)).join('') || '<p class="ui-help">Ninguna todavía. Ej.: Desde Rep. Dom., Cruceros Disney.</p>'}</div>`;
    }

    let catActual = null;
    function abrirCat(que, id) {
        const x = que === 'naviera' ? D.navieras.find(n => n.id_Naviera === id) : que === 'barco' ? D.barcos.find(b => b.id_Barco === id) : D.categorias.find(g => g.id_Categoria === id);
        catActual = { que, id: id || 0, img: x ? (que === 'naviera' ? x.logo : x.imagen) : null };
        $('#catTitulo').textContent = (x ? 'Editar ' : 'Nueva ') + { naviera: 'naviera', barco: 'barco', categoria: 'categoría' }[que];
        $('#catEliminar').hidden = !x;
        $('#catCuerpo').innerHTML = `
            <div class="ui-f"><label>${que === 'naviera' ? 'Logo' : 'Foto'} <em>se ve en la web</em></label>${fotoHtml('cat', catActual.img, true)}</div>
            ${que === 'barco' ? `<div class="ui-f"><label for="catNav">Naviera *</label><select id="catNav">${D.navieras.map(n => `<option value="${n.id_Naviera}" ${x?.id_Naviera === n.id_Naviera ? 'selected' : ''}>${esc(n.nombre)}</option>`).join('')}</select></div>` : ''}
            <div class="ui-f"><label for="catNombre">Nombre *</label><input id="catNombre" maxlength="100" value="${esc(x?.nombre || '')}" placeholder="${{ naviera: 'Ej. Disney Cruise Line', barco: 'Ej. Disney Treasure', categoria: 'Ej. Cruceros Disney' }[que]}"></div>
            ${que !== 'naviera' ? `<div class="ui-f"><label for="catDesc">Descripción</label><textarea id="catDesc" rows="${que === 'barco' ? 5 : 2}" maxlength="${que === 'barco' ? 4000 : 300}" placeholder="${que === 'barco' ? 'Lo que se muestra en «Tu barco»' : 'Ej. Ofrecer experiencias familiares únicas en cruceros Disney.'}">${esc(x?.descripcion || '')}</textarea></div>` : ''}
            ${que === 'categoria' ? `<div class="ui-f"><label for="catOrden">Orden en la web</label><input id="catOrden" type="number" min="1" max="999" value="${x?.orden ?? 1}"></div>` : ''}
            <div class="ui-f"><label class="ui-switch"><input type="checkbox" id="catActivo" ${x?.activo === false ? '' : 'checked'}><span class="tr"></span> ${que === 'categoria' ? 'Visible en la web' : 'Activo'}</label></div>`;
        dCat.abrir();
        setTimeout(() => $('#catNombre').focus(), 80);
    }

    async function guardarCat() {
        const { que, id } = catActual;
        const b = { nombre: $('#catNombre').value.trim(), activo: $('#catActivo').checked };
        if (!b.nombre) { EV.toast('Escribe el nombre.', 'err'); return; }
        let url;
        if (que === 'naviera') { url = '/Cruceros/GuardarNaviera'; Object.assign(b, { id_Naviera: id, logo: catActual.img }); }
        else if (que === 'barco') { url = '/Cruceros/GuardarBarco'; Object.assign(b, { id_Barco: id, id_Naviera: +$('#catNav').value, descripcion: $('#catDesc').value.trim() || null, imagen: catActual.img }); }
        else { url = '/Cruceros/GuardarCategoria'; Object.assign(b, { id_Categoria: id, descripcion: $('#catDesc').value.trim() || null, imagen: catActual.img, orden: +$('#catOrden').value || 1 }); }
        try { const r = await EV.post(url, b); EV.toast(r.mensaje); dCat.cerrar(true); await cargar(); }
        catch (e) { EV.toast(e.message, 'err'); }
    }

    async function eliminarCat() {
        if (!await EV.confirmar({ titulo: '¿Eliminar?', peligro: true, si: 'Sí, eliminar', texto: catActual.que === 'categoria' ? 'Los cruceros NO se borran: solo dejan de estar en esta categoría (y su tarjeta sale de la Home).' : 'No se puede deshacer.' })) return;
        try { const r = await EV.post(`/Cruceros/EliminarCatalogo?que=${catActual.que}&id=${catActual.id}`); EV.toast(r.mensaje); dCat.cerrar(true); await cargar(); }
        catch (e) { EV.toast(e.message, 'err'); }
    }

    // ===================== FOTOS SUELTAS (actividad, cabina, cubierta, día, catálogo) =====================
    // ruta: 'cat' | 'dia:i' | 'act:s:a' | 'tipo:clave' | 'cub:i'
    function fotoHtml(ruta, url, grande) {
        return `<label class="cz-foto ${grande ? 'grande' : ''}" title="Subir foto" data-foto="${ruta}">
            ${url ? `<img src="${esc(url)}" alt=""><button type="button" class="x" data-quitar-foto="${ruta}" title="Quitar foto">×</button>` : '<i class="bi bi-camera"></i>'}
            <input type="file" accept="image/jpeg,image/png,image/webp" hidden data-subir-foto="${ruta}"></label>`;
    }
    const tipoFoto = r => r === 'cat' ? catActual.que : { dia: 'itinerario', act: 'actividad', tipo: 'cabina', cub: 'cubierta' }[r.split(':')[0]];
    function ponerFoto(ruta, url) {
        const p = ruta.split(':');
        if (p[0] === 'cat') catActual.img = url;
        else if (p[0] === 'dia') C.itinerario[+p[1]].imagen = url;
        else if (p[0] === 'act') C.secciones[+p[1]].actividades[+p[2]].imagen = url;
        else if (p[0] === 'tipo') C.cabinas.find(t => t.clave === p[1]).imagen = url;
        else if (p[0] === 'cub') C.cubiertas[+p[1]].plano = url;
    }
    async function subirFoto(ruta, archivo, el) {
        if (!/^image\/(jpeg|png|webp)$/.test(archivo.type) || archivo.size > 10e6) { EV.toast('Usa una imagen JPG, PNG o WebP de hasta 10 MB.', 'err'); return; }
        const fd = new FormData(); fd.append('tipo', tipoFoto(ruta)); if (C?.id_Crucero) fd.append('id', C.id_Crucero); fd.append('archivo', archivo);
        el.classList.add('subiendo');
        try {
            const r = await EVProgreso.subir('/Cruceros/SubirImagen', fd);
            ponerFoto(ruta, r.url);
            el.outerHTML = fotoHtml(ruta, r.url, el.classList.contains('grande'));
            (ruta === 'cat' ? $('#czCat') : $('#czEditor')).dispatchEvent(new Event('ev-cambio'));
        } catch (e) { EV.toast(e.message, 'err'); el.classList.remove('subiendo'); }
    }

    // ===================== EDITOR =====================
    const vacio = () => ({ id_Crucero: null, titulo: '', subtitulo: '', id_Barco: D.barcos.find(b => b.activo)?.id_Barco || 0, puerto_Salida: '', puerto_Llegada: '', noches: 7, codigo: '',
        descripcion: '', incluye: '', no_Incluye: '', titulo_Seccion: '', activo: true, categorias: [], itinerario: [], secciones: [], cubiertas: [], cabinas: [], salidas: [], tarifas: [], precios: [] });

    async function abrir(id) {
        if (!D.barcos.length) { EV.toast('Primero crea en Catálogos la naviera y el barco.', 'err'); vistas.ir('pCatalogos'); return; }
        if (id) { try { C = await EV.api('/Cruceros/Obtener?id=' + id); } catch (e) { EV.toast(e.message, 'err'); return; } }
        else C = vacio();
        C.salidas.forEach(s => s.fecha = s.fecha.slice(0, 10));
        salidaSel = C.salidas[0]?.clave || null;
        galeria = null; $('#eFotos').innerHTML = '';
        $('#edTitulo').textContent = id ? C.titulo : 'Nuevo crucero';
        $('#edSub').textContent = id ? `n.º ${C.id_Crucero} · ${C.usuario ? 'cargado por ' + C.usuario : ''}` : 'Completa las pestañas; las fotos se suben después de guardar la primera vez.';
        $('#edEliminar').hidden = !id;
        pintarEditor(); edTabs.ir('eDatos'); editor.abrir();
        setTimeout(() => $('[data-b="titulo"]')?.focus(), 80);
    }

    function pintarEditor() { pintarDatos(); pintarItin(); pintarBordo(); pintarCabinas(); pintarPrecios(); contadores(); }
    function contadores() {
        $('#nItin').textContent = C.itinerario.length; $('#nBordo').textContent = C.secciones.reduce((n, s) => n + s.actividades.length, 0);
        $('#nCabinas').textContent = C.cabinas.length; $('#nSalidas').textContent = C.salidas.length;
    }

    // data-b="ruta.del.dato" + data-t="num|bool|hora" → se guarda en C al escribir
    function asignar(ruta, valor) {
        const p = ruta.split('.'); let o = C;
        for (let i = 0; i < p.length - 1; i++) o = o[isNaN(p[i]) ? p[i] : +p[i]];
        o[isNaN(p.at(-1)) ? p.at(-1) : +p.at(-1)] = valor;
    }
    const val = (r) => r.split('.').reduce((o, k) => o?.[isNaN(k) ? k : +k], C);
    const inp = (ruta, extra = '', tipo = 'text') => `<input data-b="${ruta}" ${tipo === 'num' ? 'type="number" data-t="num"' : ''} value="${esc(val(ruta) ?? '')}" ${extra}>`;
    const txt = (ruta, extra = '') => `<textarea data-b="${ruta}" ${extra}>${esc(val(ruta) ?? '')}</textarea>`;

    function pintarDatos() {
        const barcoSel = D.barcos.find(b => b.id_Barco === C.id_Barco);
        $('#eDatos').innerHTML = `
            <div class="cz-blq"><h3><i class="bi bi-info-circle"></i> El crucero</h3>
                <div class="ui-f"><label>Título * <em>el que sale en la tarjeta y la cabecera</em></label>${inp('titulo', 'maxlength="200" placeholder="Ej. Halloween en Alta Mar del Caribe Oriental"')}</div>
                <div class="ui-f"><label>Subtítulo <em>si lo dejas vacío: «Saliendo el {fecha} para {noches} noches a bordo del {barco}»</em></label>${inp('subtitulo', 'maxlength="300"')}</div>
                <div class="ui-row">
                    <div class="ui-f"><label>Barco *</label><select data-b="id_Barco" data-t="num">${D.navieras.map(n => `<optgroup label="${esc(n.nombre)}">${D.barcos.filter(b => b.id_Naviera === n.id_Naviera).map(b => `<option value="${b.id_Barco}" ${b.id_Barco === C.id_Barco ? 'selected' : ''}>${esc(b.nombre)}</option>`).join('')}</optgroup>`).join('')}</select>
                        <small class="ui-help" style="margin:4px 0 0">Naviera: <b>${esc(barcoSel?.naviera || '—')}</b>. ¿No está? Créalo en Catálogos.</small></div>
                    <div class="ui-f"><label>Código / ID del proveedor</label>${inp('codigo', 'maxlength="50" placeholder="Ej. 2256635"')}</div>
                </div>
                <div class="ui-row r3">
                    <div class="ui-f"><label>Puerto de salida *</label>${inp('puerto_Salida', 'maxlength="100" placeholder="Ej. Port Canaveral"')}</div>
                    <div class="ui-f"><label>Puerto de llegada *</label>${inp('puerto_Llegada', 'maxlength="100" placeholder="Ej. Port Canaveral"')}</div>
                    <div class="ui-f"><label>Noches *</label>${inp('noches', 'min="1" max="180"', 'num')}</div>
                </div>
                <div class="ui-f"><label class="ui-switch"><input type="checkbox" data-b="activo" data-t="bool" ${C.activo ? 'checked' : ''}><span class="tr"></span> Activo (sale en la web si tiene fechas y precios)</label></div>
            </div>
