@{
    ViewData["Title"] = "Cruceros";
}

@section Styles {
<link rel="stylesheet" href="~/css/eurovip-ui.css" asp-append-version="true" />
<style>
    .cz-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 18px 0 4px; }
    .cz-kpi { text-align: left; border: 1px solid var(--ev-line); background: var(--ev-surface); border-radius: 18px; padding: 14px 16px; cursor: pointer; font: inherit; color: inherit; transition: border-color .2s, transform .2s, box-shadow .2s; }
    .cz-kpi:hover { transform: translateY(-2px); box-shadow: var(--ev-shadow); }
    .cz-kpi.on { border-color: var(--ev-teal); box-shadow: 0 0 0 4px rgba(116,242,230,.3); }
    .cz-kpi b { display: block; font-size: 26px; font-weight: 800; letter-spacing: -.6px; }
    .cz-kpi small { color: var(--ev-muted); font-weight: 700; font-size: 12.5px; display: flex; align-items: center; gap: 6px; }
    .cz-kpi.mal b { color: #B54708; }
    .cz-cuenta { color: var(--ev-muted); font-weight: 700; font-size: 13px; margin: 6px 0 12px; }
    .cz-ayuda { border-radius: 20px; border: 1px solid #B3FFF3; background: #ECFEFB; color: #0E6F68; margin: 14px 0 4px; }
    .cz-ayuda summary { list-style: none; cursor: pointer; display: flex; gap: 10px; align-items: center; padding: 13px 18px; font-weight: 800; font-size: 14px; }
    .cz-ayuda summary::-webkit-details-marker { display: none; }
    .cz-ayuda summary .fl { margin-left: auto; transition: transform .2s; }
    .cz-ayuda[open] summary .fl { transform: rotate(180deg); }
    .cz-ayuda ol { margin: 0; padding: 0 22px 16px 40px; display: grid; gap: 6px; font-size: 13.5px; font-weight: 600; color: var(--ev-text); }

    /* Tarjeta de crucero (como la lista de la web) */
    .cz-lista { display: grid; gap: 16px; }
    .cz-card { display: grid; grid-template-columns: 260px minmax(0, 1fr) 190px; gap: 20px; padding: 18px; border-radius: 20px; border: 1px solid var(--ev-line); background: var(--ev-surface); transition: transform .25s var(--ev-ease), box-shadow .25s, border-color .25s; }
    .cz-card:hover { transform: translateY(-3px); box-shadow: var(--ev-shadow); border-color: var(--ev-aqua); }
    .cz-card.off { opacity: .62; }
    .cz-card .foto { border-radius: 14px; overflow: hidden; background: var(--ev-grad); aspect-ratio: 4/3.4; display: grid; place-items: center; cursor: pointer; }
    .cz-card .foto img { width: 100%; height: 100%; object-fit: cover; }
    .cz-card .foto .sin { color: var(--ev-ink); font-weight: 800; font-size: 13px; text-align: center; opacity: .8; }
    .cz-card .foto .sin i { font-size: 38px; display: block; }
    .cz-card h3 { margin: 0 0 10px; font-size: 21px; font-weight: 800; letter-spacing: -.4px; line-height: 1.2; }
    .cz-dl { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 4px 12px; font-size: 13.5px; margin: 0; }
    .cz-dl dt { font-weight: 800; }
    .cz-dl dd { margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cz-precios { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; border-top: 1px solid var(--ev-line); margin-top: 12px; padding-top: 10px; }
    .cz-precios div small { display: block; font-weight: 800; font-size: 12.5px; }
    .cz-precios div b { color: #00337F; font-size: 14.5px; }
    .cz-precios div.sin b { color: var(--ev-muted); font-weight: 600; font-size: 12.5px; }
    .cz-der { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; text-align: right; }
    .cz-der .logo { max-width: 160px; max-height: 56px; object-fit: contain; }
    .cz-der .nav { font-weight: 800; color: #00337F; }
    .cz-der .chips { display: flex; gap: 5px; flex-wrap: wrap; justify-content: flex-end; }
    .cz-der .acc { margin-top: auto; display: flex; gap: 4px; flex-wrap: wrap; justify-content: flex-end; }
    .cz-chip { font: 700 11.5px var(--ev-font); padding: 4px 9px; border-radius: 9px; background: var(--ev-surface-2); border: 1px solid var(--ev-line); display: inline-flex; gap: 5px; align-items: center; }
    .cz-chip.ok { background: #ECFDF3; color: #067647; border-color: #ABEFC6; }
    .cz-chip.av { background: #FFFAEB; color: #93370D; border-color: #FEDF89; }
    @@media (max-width: 1000px) { .cz-card { grid-template-columns: 200px minmax(0, 1fr); } .cz-der { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; text-align: left; } .cz-der .acc { margin: 0; } }
    @@media (max-width: 640px) { .cz-card { grid-template-columns: 1fr; } .cz-precios { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

    /* Catálogos */
    .cz-cats { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
    .cz-cat { border: 1px solid var(--ev-line); border-radius: 20px; background: var(--ev-surface); padding: 16px; }
    .cz-cat h3 { margin: 0 0 12px; font-size: 16px; display: flex; gap: 8px; align-items: center; }
    .cz-cat h3 .sp { flex: 1; }
    .cz-it { display: flex; gap: 10px; align-items: center; padding: 8px; border-radius: 12px; }
    .cz-it:hover { background: var(--ev-surface-2); }
    .cz-it .im { width: 46px; height: 46px; border-radius: 10px; background: var(--ev-surface-2); display: grid; place-items: center; overflow: hidden; flex-shrink: 0; border: 1px solid var(--ev-line); }
    .cz-it .im img { width: 100%; height: 100%; object-fit: contain; }
    .cz-it .tx { flex: 1; min-width: 0; }
    .cz-it .tx b { display: block; font-size: 14px; }
    .cz-it .tx small { color: var(--ev-muted); font-weight: 600; }

    /* Editor */
    .cz-pasos { margin: 0 24px; overflow-x: auto; }
    .cz-blq { border: 1px solid var(--ev-line); border-radius: 18px; padding: 14px 16px; margin-bottom: 14px; background: var(--ev-surface); }
    .cz-blq > h3 { margin: 0 0 12px; font-size: 14.5px; font-weight: 800; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .cz-blq > h3 .sp { flex: 1; }
    .cz-blq > h3 small { color: var(--ev-muted); font-weight: 600; font-size: 12px; }
    .cz-cats-sel { display: flex; gap: 8px; flex-wrap: wrap; }
    .cz-cats-sel label { display: inline-flex; gap: 6px; align-items: center; padding: 7px 12px; border-radius: 12px; border: 1px solid var(--ev-line); cursor: pointer; font-weight: 700; font-size: 13px; }
    .cz-cats-sel label:has(input:checked) { background: var(--ev-ink); color: var(--ev-aqua); border-color: var(--ev-ink); }
    .cz-cats-sel input { accent-color: var(--ev-teal); }
    .cz-tab { width: 100%; border-collapse: separate; border-spacing: 0 6px; }
    .cz-tab th { text-align: left; font: 800 11.5px var(--ev-font); color: var(--ev-muted); text-transform: uppercase; letter-spacing: .05em; padding: 0 6px; }
    .cz-tab td { padding: 0 6px; vertical-align: top; }
    .cz-tab input, .cz-tab select, .cz-tab textarea { width: 100%; }
    .cz-tab .num { width: 70px; }
    .cz-tab .hora { width: 104px; }
    .cz-foto { position: relative; width: 74px; height: 54px; border-radius: 10px; overflow: hidden; background: var(--ev-surface-2); border: 1px dashed var(--ev-line); display: grid; place-items: center; cursor: pointer; flex-shrink: 0; }
    .cz-foto img { width: 100%; height: 100%; object-fit: cover; }
    .cz-foto i { color: var(--ev-muted); font-size: 18px; }
    .cz-foto.grande { width: 100%; height: 130px; }
    .cz-foto .x { position: absolute; right: 3px; top: 3px; width: 20px; height: 20px; border-radius: 50%; border: 0; background: rgba(11,18,21,.75); color: #fff; font-size: 11px; cursor: pointer; display: grid; place-items: center; }
    .cz-foto.subiendo::after { content: "…"; position: absolute; inset: 0; background: rgba(255,255,255,.7); display: grid; place-items: center; font-weight: 800; }
    .cz-sec { border: 1px solid var(--ev-line); border-radius: 16px; padding: 12px; margin-bottom: 12px; background: var(--ev-surface-2); }
    .cz-sec-h { display: flex; gap: 8px; align-items: center; margin-bottom: 10px; }
    .cz-sec-h input { flex: 1; font-weight: 800; }
    .cz-acts { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 10px; }
    .cz-act { border: 1px solid var(--ev-line); border-radius: 14px; padding: 10px; background: var(--ev-surface); display: grid; gap: 6px; }
    .cz-act .fila { display: flex; gap: 6px; }
    .cz-add { border: 2px dashed var(--ev-line); border-radius: 14px; background: transparent; cursor: pointer; color: var(--ev-muted); font: 700 13px var(--ev-font); min-height: 90px; }
    .cz-add:hover { border-color: var(--ev-teal); color: var(--ev-deep); background: var(--ev-mint); }
    .cz-tipo { border: 1px solid var(--ev-line); border-radius: 16px; padding: 12px; margin-bottom: 10px; display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 12px; background: var(--ev-surface); }
    .cz-tipo .campos { display: grid; gap: 8px; }
    .cz-tipo .g { display: grid; grid-template-columns: 90px minmax(0, 1fr) 80px 80px 80px; gap: 8px; }
    .cz-cabs { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
    .cz-cab { display: inline-flex; gap: 4px; align-items: center; border: 1px solid var(--ev-line); border-radius: 10px; padding: 3px 4px 3px 8px; background: var(--ev-surface-2); font-size: 12.5px; font-weight: 700; }
    .cz-cab input { width: 64px; padding: 4px 6px; }
    .cz-cab select { padding: 4px; }
    .cz-cab button { border: 0; background: none; cursor: pointer; color: var(--ev-muted); }
    .cz-salidas { display: flex; gap: 8px; flex-wrap: wrap; }
    .cz-sal { display: inline-flex; gap: 8px; align-items: center; padding: 7px 8px 7px 12px; border-radius: 12px; border: 1px solid var(--ev-line); background: var(--ev-surface); font-weight: 700; font-size: 13px; cursor: pointer; }
    .cz-sal.on { border-color: var(--ev-ink); background: var(--ev-ink); color: var(--ev-aqua); }
    .cz-sal.off { opacity: .55; text-decoration: line-through; }
    .cz-sal button { border: 0; background: rgba(0,0,0,.08); color: inherit; border-radius: 7px; width: 22px; height: 22px; cursor: pointer; }
    .cz-mat { width: 100%; border-collapse: collapse; }
    .cz-mat th, .cz-mat td { border-bottom: 1px solid var(--ev-line); padding: 7px 6px; text-align: left; font-size: 13px; }
    .cz-mat th { font: 800 12px var(--ev-font); background: var(--ev-surface-2); }
    .cz-mat td input { width: 120px; text-align: right; }
    .cz-mat tr.grp td { background: var(--ev-surface-2); font-weight: 800; font-size: 12px; text-transform: uppercase; letter-spacing: .05em; color: var(--ev-muted); }
    @@media (max-width: 760px) { .cz-tipo { grid-template-columns: 1fr; } .cz-tipo .g { grid-template-columns: 1fr 1fr; } }

    /* Vista previa (como la ficha de la web) */
    .vz-banner { position: relative; min-height: 150px; border-radius: 18px; overflow: hidden; display: flex; align-items: center; padding: 24px; color: #fff; background: linear-gradient(135deg, #0E8F86, #74F2E6); margin-bottom: 16px; }
    .vz-banner img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .vz-banner h2 { position: relative; margin: 0; font-size: clamp(24px, 3vw, 34px); font-weight: 800; text-shadow: 0 2px 14px rgba(0,0,0,.35); max-width: 640px; line-height: 1.1; }
    .vz-sub { font-size: 19px; font-weight: 800; margin: 0 0 12px; }
    .vz-top { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 16px; margin-bottom: 18px; }
    .vz-gal { position: relative; border-radius: 16px; overflow: hidden; background: var(--ev-surface-2); aspect-ratio: 16/10; }
    .vz-gal img { width: 100%; height: 100%; object-fit: cover; }
    .vz-gal button { position: absolute; top: 50%; transform: translateY(-50%); width: 38px; height: 38px; border-radius: 50%; border: 2px solid #00337F; background: #fff; color: #00337F; cursor: pointer; }
    .vz-gal .a { left: 10px; } .vz-gal .s { right: 10px; }
    .vz-info { border: 1px solid var(--ev-line); border-radius: 14px; padding: 12px 14px; display: grid; gap: 8px; font-size: 13.5px; }
    .vz-info span { display: flex; gap: 8px; align-items: center; } .vz-info i { color: #00337F; }
    .vz-desde { margin-top: 10px; } .vz-desde small { color: var(--ev-muted); } .vz-desde b { display: block; font-size: 28px; color: #00337F; }
    .vz-h { font-size: 18px; font-weight: 800; margin: 18px 0 10px; }
    .vz-tabs { display: flex; gap: 18px; border-bottom: 1px solid var(--ev-line); margin-bottom: 12px; flex-wrap: wrap; }
    .vz-tabs button { border: 0; background: none; padding: 8px 2px; font: 800 13.5px var(--ev-font); color: var(--ev-text); cursor: pointer; border-bottom: 3px solid transparent; }
    .vz-tabs button.on { border-color: #00337F; }
    .vz-acts { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; }
    .vz-act img, .vz-act .sin { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 8px; background: var(--ev-surface-2); display: block; }
    .vz-act b { display: block; margin-top: 6px; font-size: 14px; }
    .vz-act { cursor: pointer; border-radius: 10px; padding: 4px; transition: background .2s; }
    .vz-act:hover { background: var(--ev-surface-2); }
    .vz-act small { color: #00337F; font-weight: 800; }
    .vz-act:hover small { text-decoration: underline; }
    /* Ventana de una actividad (como el «Leer más..» de la web) */
    .vz-modal { position: fixed; inset: 0; z-index: 300; background: rgba(11,18,21,.55); display: grid; place-items: center; padding: 20px; animation: vzIn .2s ease; }
    .vz-modal > div { position: relative; background: var(--ev-surface); border-radius: 18px; overflow: hidden; width: min(760px, 100%); max-height: 90vh; overflow-y: auto; box-shadow: var(--ev-shadow-lg); }
    .vz-modal img { width: 100%; max-height: 420px; object-fit: cover; display: block; }
    .vz-modal .tx { padding: 18px 24px 24px; }
    .vz-modal h3 { margin: 0 0 10px; font-size: 24px; font-weight: 800; }
    .vz-modal p { margin: 0; white-space: pre-line; line-height: 1.6; color: var(--ev-text); }
    .vz-modal .x { position: absolute; right: 12px; top: 12px; width: 38px; height: 38px; border-radius: 50%; border: 0; background: #fff; box-shadow: var(--ev-shadow); cursor: pointer; font-size: 16px; }
    .vz-modal .nav { display: flex; justify-content: space-between; gap: 8px; padding: 0 24px 18px; }
    @@keyframes vzIn { from { opacity: 0; } }
    .vz-fechas { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 10px; }
    .vz-fecha { border: 1px solid var(--ev-line); border-radius: 12px; padding: 12px; text-align: center; font-size: 13px; cursor: pointer; }
    .vz-fecha.on { border-color: #00337F; background: #E0F4FE; }
    .vz-fecha b { display: block; font-size: 15px; }
    .vz-fecha table { width: 100%; margin-top: 8px; font-size: 12.5px; }
    .vz-fecha td:last-child { text-align: right; font-weight: 800; }
    .vz-cab { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 12px; border: 1px solid var(--ev-line); border-radius: 14px; overflow: hidden; margin-bottom: 10px; }
    .vz-cab img, .vz-cab .sin { width: 100%; height: 100%; min-height: 120px; object-fit: cover; background: var(--ev-surface-2); }
    .vz-cab > div:last-child { padding: 12px 12px 12px 0; }
    .vz-cab b { font-size: 16px; } .vz-cab .pr { font-size: 22px; font-weight: 800; color: #00337F; }
    @@media (max-width: 760px) { .vz-top { grid-template-columns: 1fr; } .vz-cab { grid-template-columns: 1fr; } }

    /* ===== Editor paso a paso (v2) ===== */
    .cz-pasos .ui-tabs button .num { display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: var(--ev-surface-2); font-size: 11px; font-weight: 800; margin-right: 2px; }
    .cz-pasos .ui-tabs button.on .num { background: var(--ev-aqua); color: var(--ev-ink); }
    .cz-pasos .ui-tabs button.lleno .num { background: #ABEFC6; color: #067647; }
    .cz-opc { color: var(--ev-muted); font-weight: 600; font-size: 12px; font-style: normal; }
    .cz-intro { display: flex; gap: 10px; align-items: flex-start; font-size: 13px; font-weight: 600; color: #0E6F68; background: #ECFEFB; border: 1px solid #B3FFF3; border-radius: 14px; padding: 10px 14px; margin-bottom: 14px; }
    .cz-chips { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .cz-chips label { display: inline-flex; gap: 6px; align-items: center; padding: 7px 12px; border-radius: 12px; border: 1px solid var(--ev-line); cursor: pointer; font-weight: 700; font-size: 13px; }
    .cz-chips label:has(input:checked) { background: var(--ev-ink); color: var(--ev-aqua); border-color: var(--ev-ink); }
    .cz-chips .nueva { background: #ECFDF3; border-color: #ABEFC6; color: #067647; cursor: default; }
    .cz-chips .nueva button { border: 0; background: none; cursor: pointer; color: inherit; }
    .cz-mas > summary { cursor: pointer; font-weight: 800; font-size: 13.5px; list-style: none; display: flex; gap: 8px; align-items: center; color: var(--ev-deep); padding: 4px 0; }
    .cz-mas > summary::-webkit-details-marker { display: none; }
    .cz-mas[open] > summary .bi-chevron-down { transform: rotate(180deg); }
    .cz-mas > div { margin-top: 12px; }
    /* Itinerario en tarjetas */
    .cz-dias { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 12px; }
    .cz-dia { border: 1px solid var(--ev-line); border-radius: 16px; padding: 12px; background: var(--ev-surface); display: grid; gap: 10px; }
    .cz-dia.nav { background: linear-gradient(135deg, #F0F9FF, #fff); }
    .cz-dia-h { display: flex; gap: 8px; align-items: center; }
    .cz-dia-h { flex-wrap: wrap; } .cz-dia-h b { font-size: 15px; white-space: nowrap; } .cz-dia-h small { color: var(--ev-muted); font-weight: 700; white-space: nowrap; }
    .cz-dia-h .sp { flex: 1; }
    .cz-horas { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .cz-horas label { font: 800 11.5px var(--ev-font); color: var(--ev-muted); text-transform: uppercase; letter-spacing: .04em; display: grid; gap: 4px; }
    .cz-horas input { font-size: 16px; font-weight: 700; padding: 9px 10px; }
    .cz-dia .fila { display: flex; gap: 10px; align-items: flex-start; }
    .cz-dia .fila textarea { flex: 1; min-height: 54px; }
    /* Fotos pendientes (crucero nuevo) */
    .cz-pend { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
    .cz-pend-slot { border: 2px dashed var(--ev-line); border-radius: 16px; min-height: 150px; position: relative; overflow: hidden; display: grid; place-items: center; text-align: center; cursor: pointer; background: var(--ev-surface-2); color: var(--ev-muted); font-weight: 700; font-size: 13px; }
    .cz-pend-slot:hover, .cz-pend-slot.sobre { border-color: var(--ev-teal); background: var(--ev-mint); color: var(--ev-deep); }
    .cz-pend-slot img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .cz-pend-slot .et { position: absolute; left: 8px; top: 8px; z-index: 2; font: 800 11px var(--ev-font); padding: 4px 8px; border-radius: 8px; background: var(--ev-ink); color: var(--ev-aqua); }
    .cz-pend-slot .x { position: absolute; right: 8px; top: 8px; z-index: 2; width: 28px; height: 28px; border-radius: 50%; border: 0; background: rgba(11,18,21,.75); color: #fff; cursor: pointer; }
    .cz-pend-gal { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 8px; margin-top: 12px; }
    .cz-pend-gal .cz-pend-slot { min-height: 90px; }
    /* Precios: fechas × tipos de cabina */
    .cz-grid { width: 100%; border-collapse: collapse; }
    .cz-grid th, .cz-grid td { border-bottom: 1px solid var(--ev-line); padding: 6px; font-size: 13px; text-align: left; white-space: nowrap; }
    .cz-grid th { font: 800 12px var(--ev-font); background: var(--ev-surface-2); position: sticky; top: 0; }
    .cz-grid th small { display: block; color: var(--ev-muted); font-weight: 700; text-transform: uppercase; font-size: 10.5px; }
    .cz-grid td input { width: 110px; text-align: right; }
    .cz-grid td.f { font-weight: 800; }
    .cz-grid tr.off td.f { text-decoration: line-through; opacity: .6; }
    /* Resumen antes de guardar */
    .cz-res { display: grid; gap: 10px; }
    .cz-res-it { display: grid; grid-template-columns: 34px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 12px 14px; border-radius: 14px; border: 1px solid var(--ev-line); background: var(--ev-surface); }
    .cz-res-it .ic { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; font-size: 16px; background: #ECFDF3; color: #067647; }
    .cz-res-it.vacio .ic { background: var(--ev-surface-2); color: var(--ev-muted); }
    .cz-res-it.aviso .ic { background: #FFFAEB; color: #B54708; }
    .cz-res-it b { display: block; font-size: 14px; } .cz-res-it span { color: var(--ev-muted); font-size: 12.5px; font-weight: 600; }
    .cz-res-it button { white-space: nowrap; }
    .cz-home { border-radius: 16px; padding: 14px 16px; display: flex; gap: 12px; align-items: center; font-weight: 700; margin-bottom: 12px; }
    .cz-home.ok { background: #ECFDF3; border: 1px solid #ABEFC6; color: #067647; }
    .cz-home.no { background: #FFFAEB; border: 1px solid #FEDF89; color: #93370D; }
    .cz-home i { font-size: 22px; }
    /* ===== v3: editor grande, etiquetas visibles, colores y sugerencias ===== */
    #czEditor.ui-drawer { width: calc(100vw - 24px); max-width: 1480px; }
    #czEditor .ui-db { padding-left: 32px; padding-right: 32px; }
    #czEditor input:not([type=checkbox]):not([type=file]), #czEditor select, #czEditor textarea { font-size: 15px; padding: 10px 12px; border-radius: 12px; }
    #czEditor .cz-pasos .ui-tabs button { padding: 10px 16px; font-size: 14px; }
    .cz-c { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
    .cz-c > span { font: 800 12px var(--ev-font); color: var(--ev-text); text-transform: uppercase; letter-spacing: .04em; }
    .cz-c > span .cz-opc { text-transform: none; letter-spacing: 0; }
    .cz-c > small { color: var(--ev-muted); font-weight: 600; font-size: 11.5px; min-height: 14px; }
    .cz-c.ancho { flex: 1; }
    .cz-barra { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-bottom: 14px; }
    .cz-cuenta-chip { font: 800 12px var(--ev-font); padding: 6px 10px; border-radius: 999px; background: var(--ev-surface-2); color: var(--ev-muted); white-space: nowrap; }
    .cz-g3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .cz-g4 { display: grid; grid-template-columns: 180px minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr); gap: 12px; }
    /* itinerario: una fila por día, como una ruta */
    .cz-ruta { display: grid; gap: 12px; }
    .cz-paso { display: grid; grid-template-columns: 86px minmax(0, 1fr) 200px 44px; gap: 16px; align-items: start; padding: 16px; border-radius: 18px; border: 1px solid var(--ev-line); background: var(--ev-surface); border-left: 6px solid #0E8F86; }
    .cz-paso.mar { border-left-color: #0284C7; background: linear-gradient(90deg, #F0F9FF, var(--ev-surface) 40%); }
    .cz-paso-n { display: grid; justify-items: center; text-align: center; gap: 2px; }
    .cz-paso-n b { width: 54px; height: 54px; border-radius: 16px; display: grid; place-items: center; font-size: 22px; background: #0E8F86; color: #fff; }
    .cz-paso.mar .cz-paso-n b { background: #0284C7; }
    .cz-paso-n small { font: 800 10.5px var(--ev-font); letter-spacing: .1em; color: var(--ev-muted); }
    .cz-paso-n em { font-style: normal; font-weight: 700; font-size: 12px; color: var(--ev-text); }
    .cz-paso-c { display: grid; gap: 12px; }
    .cz-paso-g { display: grid; grid-template-columns: minmax(0, 2fr) 150px 150px; gap: 12px; }
    .cz-paso-f { display: grid; gap: 5px; } .cz-paso-f .cz-foto.grande { height: 120px; }
    .cz-paso-a { display: grid; gap: 6px; }
    .cz-seg { display: inline-flex; border: 1px solid var(--ev-line); border-radius: 12px; overflow: hidden; width: max-content; }
    .cz-seg button { border: 0; background: var(--ev-surface); padding: 8px 14px; font: 700 13px var(--ev-font); cursor: pointer; color: var(--ev-muted); }
    .cz-seg button.on { background: #0E8F86; color: #fff; }
    .cz-paso.mar .cz-seg button.on { background: #0284C7; }
    .cz-mar { padding: 14px; border-radius: 12px; background: #E0F2FE; color: #075985; font-weight: 700; font-size: 13.5px; }
    /* sugerencias (pestañas, actividades, cabinas) */
    .cz-sugs { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .cz-sugs.chica { margin: 0 0 12px; } .cz-sugs.chica small { color: var(--ev-muted); font-weight: 800; font-size: 12px; }
    .cz-sug { --c: #0E8F86; display: inline-flex; gap: 6px; align-items: center; border: 1.5px solid color-mix(in srgb, var(--c) 45%, transparent); background: color-mix(in srgb, var(--c) 9%, var(--ev-surface)); color: var(--c); padding: 8px 14px; border-radius: 999px; font: 800 13px var(--ev-font); cursor: pointer; transition: transform .15s, background .15s; }
    .cz-sug:hover:not(:disabled) { transform: translateY(-1px); background: color-mix(in srgb, var(--c) 18%, var(--ev-surface)); }
    .cz-sug.ya, .cz-sug:disabled { opacity: .55; cursor: default; }
    .cz-cat-et { --c: #0E8F86; display: inline-flex; gap: 5px; align-items: center; font: 800 12px var(--ev-font); color: #fff; background: var(--c); padding: 5px 10px; border-radius: 8px; min-width: 96px; }
    /* a bordo: pestañas con color y actividades grandes */
    .cz-secc { --c: #0E8F86; border-radius: 20px; border: 1px solid color-mix(in srgb, var(--c) 30%, var(--ev-line)); background: linear-gradient(180deg, color-mix(in srgb, var(--c) 7%, var(--ev-surface)), var(--ev-surface) 120px); padding: 16px; margin-bottom: 16px; }
    .cz-secc-h { display: flex; gap: 12px; align-items: end; margin-bottom: 12px; }
    .cz-secc-h .ic { width: 46px; height: 46px; border-radius: 14px; background: var(--c); color: #fff; display: grid; place-items: center; font-size: 22px; flex-shrink: 0; }
    .cz-acts2 { display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 14px; }
    .cz-act2 { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 14px; padding: 14px; border-radius: 16px; background: var(--ev-surface); border: 1px solid var(--ev-line); box-shadow: 0 2px 10px rgba(11,18,21,.04); }
    .cz-act2 .cz-foto.grande { height: 100%; min-height: 150px; }
    .cz-act2-c { display: grid; gap: 10px; }
    .cz-act2-a { display: flex; justify-content: space-between; gap: 8px; align-items: center; flex-wrap: wrap; }
    .cz-add2 { border: 2px dashed color-mix(in srgb, var(--c, #0E8F86) 45%, var(--ev-line)); border-radius: 16px; background: transparent; cursor: pointer; min-height: 180px; display: grid; place-content: center; justify-items: center; gap: 4px; color: var(--c, #0E8F86); font-family: var(--ev-font); }
    .cz-add2 i { font-size: 30px; } .cz-add2 small { color: var(--ev-muted); font-weight: 600; }
