    /* cabinas */
    .cz-tipo2 { --c: #0E8F86; display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 18px; padding: 16px; border-radius: 18px; border: 1px solid var(--ev-line); border-top: 5px solid var(--c); background: var(--ev-surface); margin-bottom: 14px; }
    .cz-tipo2-f { display: grid; gap: 6px; text-align: center; align-content: start; } .cz-tipo2-f small { color: var(--ev-muted); font-weight: 700; font-size: 12px; }
    .cz-tipo2-f .cz-foto.grande { height: 160px; }
    .cz-tipo2-c { display: grid; gap: 12px; }
    .cz-chk .ui-switch { margin-top: 6px; }
    /* fechas y precios */
    .cz-fechas2 { display: grid; grid-template-columns: minmax(260px, 1fr) minmax(0, 2fr); gap: 16px; }
    .cz-fcaja { display: grid; gap: 12px; align-content: start; padding: 16px; border-radius: 16px; background: var(--ev-surface-2); }
    .cz-fcaja > b { font-size: 14px; display: flex; gap: 8px; align-items: center; }
    .cz-grid th { --c: #0E8F86; border-top: 3px solid var(--c); min-width: 150px; }
    .cz-grid th small { color: var(--c); }
    .cz-dinero { display: flex; align-items: center; gap: 6px; border: 1px solid var(--ev-line); border-radius: 12px; padding: 0 8px; background: var(--ev-surface); }
    .cz-dinero b { color: var(--ev-muted); font-size: 12px; }
    .cz-dinero input { border: 0 !important; width: 110px; text-align: right; padding: 9px 4px !important; background: transparent; }
    .cz-home .ev-btn { flex-shrink: 0; }
    @@media (max-width: 1000px) { .cz-paso { grid-template-columns: 70px minmax(0, 1fr); } .cz-paso-f, .cz-paso-a { grid-column: 2; } .cz-paso-a { display: flex; }
        .cz-paso-g, .cz-g4, .cz-g3, .cz-fechas2 { grid-template-columns: 1fr; } .cz-tipo2, .cz-act2 { grid-template-columns: 1fr; } .cz-acts2 { grid-template-columns: 1fr; } }
</style>
}

