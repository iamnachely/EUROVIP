                        <button type="button" data-it="mar" data-i="${i}" class="${d.en_Navegacion ? 'on' : ''}"><i class="bi bi-water"></i> En el mar</button>
                    </div>
                    ${d.en_Navegacion ? `<div class="cz-mar"><i class="bi bi-water"></i> Día de navegación: el barco no para en ningún puerto (en la web sale «En navegación»).</div>` : `
                    <div class="cz-paso-g">
                        <label class="cz-c ancho"><span>Puerto</span><input data-b="itinerario.${i}.puerto" list="dlPuertos" maxlength="150" value="${esc(d.puerto || '')}" placeholder="Escribe o elige, ej. Tortola, BVI"></label>
                        <label class="cz-c"><span>Llega a las</span><input type="time" step="60" data-b="itinerario.${i}.hora_Llegada" value="${esc(d.hora_Llegada || '')}"><small>${i === 0 ? 'vacío en el día de embarque' : ''}</small></label>
