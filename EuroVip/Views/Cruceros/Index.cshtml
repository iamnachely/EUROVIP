                <div class="cz-sugs">${SECCIONES.map(s => `<button type="button" class="cz-sug ${usadas.has(s.t.toLowerCase()) ? 'ya' : ''}" style="--c:${s.c}" data-bo="sug" data-t="${esc(s.t)}" ${usadas.has(s.t.toLowerCase()) ? 'disabled' : ''}><i class="bi ${s.i}"></i> ${esc(s.t)}${usadas.has(s.t.toLowerCase()) ? ' <i class="bi bi-check2"></i>' : ''}</button>`).join('')}
