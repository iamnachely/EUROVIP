@section Scripts {
<script src="~/js/eurovip-ui.js" asp-append-version="true"></script>
<script src="~/js/eurovip-multimedia.js" asp-append-version="true"></script>
<script src="~/js/eurovip-fotos.js" asp-append-version="true"></script>
<script>
(() => {
    const $ = (s, el = document) => el.querySelector(s);
    const $$ = (s, el = document) => [...el.querySelectorAll(s)];
    const esc = EV.esc;
    const editor = EV.drawer($('#czEditor')), visor = EV.drawer($('#czVer')), dCat = EV.drawer($('#czCat'));
    const vistas = EV.tabs($('#czVistas'));
    const PASOS = ['eDatos', 'eFotos', 'eItin', 'eBordo', 'eCabinas', 'ePrecios', 'eResumen'];
    let paso = 'eDatos';
    const edTabs = EV.tabs($('#edTabs'), id => { paso = id; alCambiarPaso(); });
    let D = { cruceros: [], navieras: [], barcos: [], categorias: [], categoriasCabina: {} };
    let C = null, verId = null, sec = 0, tarSel = null;
    let fotosMontadas = false;          // componente de fotos (crucero ya guardado)
    let P = { PORTADA: null, INTERMEDIA: null, GALERIA: [] };   // fotos elegidas en un crucero nuevo: se suben al guardar
    const st = { q: '', naviera: '', categoria: '', filtro: '', orden: 'fecha' };
    const CATS = ['INTERIOR', 'EXTERIOR', 'BALCON', 'SUITE'];
    const CAT_CORTO = { INTERIOR: 'Interior', EXTERIOR: 'Exterior', BALCON: 'Balcón', SUITE: 'Suite' };
    const IMG_OK = /^image\/(jpeg|png|webp)$/;

    const dinero = v => v == null ? '—' : `${EV.simbolo()} ${EV.fmt(v, Number(v) % 1 ? 2 : 0)}`;
    const nuevaClave = p => p + 'n' + (++sec);
    const fechaTxt = f => f ? new Date(f.slice(0, 10) + 'T00:00:00').toLocaleDateString('es', { day: '2-digit', month: 'long', year: 'numeric' }) : '—';
    const fechaCorta = f => new Date(f.slice(0, 10) + 'T00:00:00').toLocaleDateString('es', { day: '2-digit', month: 'short', year: 'numeric' });
    const masDias = (f, n) => { const d = new Date(f.slice(0, 10) + 'T00:00:00Z'); d.setUTCDate(d.getUTCDate() + (n || 0)); return d.toISOString().slice(0, 10); };
    const hoy = new Date(Date.now() - new Date().getTimezoneOffset() * 6e4).toISOString().slice(0, 10);
    const noches = () => C.noches || (C.itinerario.length > 1 ? C.itinerario.length - 1 : null);

    // ===================== LISTA =====================
    async function cargar() {
        try { D = await EV.api('/Cruceros/Listar'); }
        catch (e) { $('#czLista').innerHTML = `<div class="ui-empty"><h3>No pudimos cargar los cruceros</h3><p>${esc(e.message)}</p></div>`; return; }
        $('#nCruceros').textContent = D.cruceros.length;
        const sel = (id, todos, pares) => { const s = $(id), v = s.value; s.innerHTML = `<option value="">${todos}</option>` + pares.map(([k, t]) => `<option value="${k}" ${String(k) === v ? 'selected' : ''}>${esc(t)}</option>`).join(''); };
        sel('#czNaviera', 'Todas las navieras', D.navieras.map(n => [n.id_Naviera, n.nombre]));
        sel('#czCategoria', 'Todas las categorías', D.categorias.map(c => [c.id_Categoria, c.nombre]));
        if (!D.cruceros.length) $('#czAyuda').open = true;
        pintar(); pintarCatalogos();
    }

    function filtrados() {
        const q = st.q.toLowerCase();
        return D.cruceros.filter(c =>
            (!st.naviera || String(c.id_Naviera) === st.naviera) &&
            (!st.categoria || (c.ids_Categoria || '').split(',').includes(st.categoria)) &&
            (!q || [c.titulo, c.barco, c.naviera, c.puerto_Salida, c.puerto_Llegada, c.codigo, c.itinerario, c.categorias].some(x => (x || '').toLowerCase().includes(q)) || String(c.id_Crucero) === q) &&
            (st.filtro === '' || (st.filtro === 'activos' && c.activo) || (st.filtro === 'inactivos' && !c.activo) ||
             (st.filtro === 'sinfoto' && !c.imagen) || (st.filtro === 'sinprecio' && c.desde_Pp == null) || (st.filtro === 'venta' && c.activo && c.desde_Pp != null)))
            .sort({
                fecha: (a, b) => (a.proxima_Salida || '9999').localeCompare(b.proxima_Salida || '9999'),
                precio: (a, b) => (a.desde_Pp ?? 1e12) - (b.desde_Pp ?? 1e12),
                titulo: (a, b) => a.titulo.localeCompare(b.titulo, 'es'),
                recientes: (a, b) => b.id_Crucero - a.id_Crucero
            }[st.orden]);
    }

    function pintar() {
        const t = D.cruceros;
        const k = [['', t.length, 'Cruceros', 'bi-water'], ['venta', t.filter(c => c.activo && c.desde_Pp != null).length, 'A la venta', 'bi-broadcast'],
                   ['inactivos', t.filter(c => !c.activo).length, 'Desactivados', 'bi-pause-circle'],
                   ['sinprecio', t.filter(c => c.desde_Pp == null).length, 'Sin fechas o precios', 'bi-currency-dollar', true],
                   ['sinfoto', t.filter(c => !c.imagen).length, 'Sin foto', 'bi-image', true]];
        $('#czKpis').innerHTML = k.map(([f, n, tx, i, al]) => `<button type="button" class="cz-kpi ${st.filtro === f ? 'on' : ''} ${al && n ? 'mal' : ''}" data-filtro="${f}"><b>${EV.fmt(n)}</b><small><i class="bi ${i}"></i> ${tx}</small></button>`).join('');
        const l = filtrados();
        $('#czCuenta').textContent = l.length === t.length ? `${EV.fmt(l.length)} cruceros` : `Mostrando ${EV.fmt(l.length)} de ${EV.fmt(t.length)}`;
        if (!t.length) { $('#czLista').innerHTML = `<div class="ui-empty"><i class="bi bi-water" style="font-size:40px"></i><h3>Todavía no hay cruceros</h3><p>Pulsa «Nuevo crucero»: solo hace falta el título.</p></div>`; return; }
        if (!l.length) { $('#czLista').innerHTML = `<div class="ui-empty"><i class="bi bi-search" style="font-size:36px"></i><h3>No hay cruceros con ese filtro</h3></div>`; return; }
        $('#czLista').innerHTML = `<div class="cz-lista">${l.map(tarjeta).join('')}</div>`;
    }

    function tarjeta(c) {
        const p = (cat, v) => `<div class="${v == null ? 'sin' : ''}"><small>${cat}</small><b>${v == null ? '—' : dinero(v)}</b></div>`;
        const puertos = [c.puerto_Salida, c.puerto_Llegada !== c.puerto_Salida ? c.puerto_Llegada : null].filter(Boolean).map(esc).join(' / ');
        return `<article class="cz-card ${c.activo ? '' : 'off'}" data-id="${c.id_Crucero}">
            <div class="foto" data-accion="ver">${c.imagen ? `<img src="${esc(c.imagen)}" alt="" loading="lazy">` : '<span class="sin"><i class="bi bi-water"></i>Sin foto</span>'}</div>
            <div style="min-width:0">
                <h3>${esc(c.titulo)}</h3>
                <dl class="cz-dl">
                    <dt>Fecha</dt><dd>${c.proxima_Salida ? fechaTxt(c.proxima_Salida) + (c.salidas_Futuras > 1 ? ` <small style="color:var(--ev-muted)">(+${c.salidas_Futuras - 1} fechas)</small>` : '') : '<span style="color:#B54708">Sin fechas a la venta</span>'}</dd>
                    <dt>Duración</dt><dd>${c.noches ? `${c.noches + 1} días · ${c.noches} noches` : '—'}</dd>
                    <dt>Barco</dt><dd>${esc(c.barco || '—')}</dd>
                    <dt>Desde / Hasta</dt><dd>${puertos || '—'}</dd>
                    <dt>Itinerario</dt><dd>${esc(c.itinerario || '—')}</dd>
                </dl>
                <div class="cz-precios">${p('Interior', c.interior_Pp)}${p('Exterior', c.exterior_Pp)}${p('Balcón', c.balcon_Pp)}${p('Suite', c.suite_Pp)}</div>
            </div>
            <div class="cz-der">
                ${c.naviera_Logo ? `<img class="logo" src="${esc(c.naviera_Logo)}" alt="${esc(c.naviera || '')}">` : `<span class="nav">${esc(c.naviera || '')}</span>`}
                <div class="chips">${c.activo ? '<span class="cz-chip ok"><i class="bi bi-broadcast"></i> En la web</span>' : '<span class="cz-chip av">Desactivado</span>'}
                    ${c.categorias ? `<span class="cz-chip"><i class="bi bi-tags"></i> ${esc(c.categorias)}</span>` : '<span class="cz-chip av">Sin categoría</span>'}
                    <span class="cz-chip">n.º ${c.id_Crucero}${c.codigo ? ' · ' + esc(c.codigo) : ''}</span></div>
                <div class="acc">
                    <button type="button" class="ui-ibtn" data-accion="ver" title="Ver como la web"><i class="bi bi-eye"></i></button>
                    <button type="button" class="ui-ibtn" data-accion="fotos" title="Fotos: portada, banner y galería"><i class="bi bi-images"></i></button>
                    <button type="button" class="ui-ibtn" data-accion="editar" title="Editar"><i class="bi bi-pencil"></i></button>
                    <button type="button" class="ui-ibtn" data-accion="duplicar" title="Duplicar"><i class="bi bi-copy"></i></button>
                    <button type="button" class="ui-ibtn" data-accion="activar" title="${c.activo ? 'Desactivar' : 'Activar'}"><i class="bi ${c.activo ? 'bi-pause-circle' : 'bi-play-circle'}"></i></button>
                    <button type="button" class="ui-ibtn danger" data-accion="eliminar" title="Eliminar"><i class="bi bi-trash3"></i></button>
                </div>
            </div>
        </article>`;
    }

    // ===================== CATÁLOGOS =====================
    function pintarCatalogos() {
        const it = (im, b, s, attrs) => `<div class="cz-it"><span class="im">${im ? `<img src="${esc(im)}" alt="">` : '<i class="bi bi-image" style="color:var(--ev-muted)"></i>'}</span>
            <span class="tx"><b>${b}</b><small>${s}</small></span><button type="button" class="ui-ibtn" ${attrs} title="Editar"><i class="bi bi-pencil"></i></button></div>`;
        $('#czCats').innerHTML = `
            <div class="cz-cat"><h3><i class="bi bi-flag"></i> Navieras <span class="sp"></span><button type="button" class="ev-btn sm" data-cat-nuevo="naviera"><i class="bi bi-plus-lg"></i> Nueva</button></h3>
                ${D.navieras.map(n => it(n.logo, esc(n.nombre), `${n.barcos} barco(s)${n.activo ? '' : ' · inactiva'}`, `data-cat-ed="naviera" data-id="${n.id_Naviera}"`)).join('') || '<p class="ui-help">Ninguna todavía. También se crean solas al escribirlas en un crucero.</p>'}</div>
            <div class="cz-cat"><h3><i class="bi bi-water"></i> Barcos <span class="sp"></span><button type="button" class="ev-btn sm" data-cat-nuevo="barco" ${D.navieras.length ? '' : 'disabled title="Primero crea una naviera"'}><i class="bi bi-plus-lg"></i> Nuevo</button></h3>
                ${D.barcos.map(b => it(b.imagen, esc(b.nombre), `${esc(b.naviera)} · ${b.cruceros} crucero(s)${b.activo ? '' : ' · inactivo'}`, `data-cat-ed="barco" data-id="${b.id_Barco}"`)).join('') || '<p class="ui-help">Ninguno todavía. Ej.: Disney Treasure.</p>'}</div>
            <div class="cz-cat"><h3><i class="bi bi-tags"></i> Categorías de la web <span class="sp"></span><button type="button" class="ev-btn sm" data-cat-nuevo="categoria"><i class="bi bi-plus-lg"></i> Nueva</button></h3>
                ${D.categorias.map(g => it(g.imagen, esc(g.nombre), `${g.cruceros} crucero(s) · orden ${g.orden}${g.activo ? '' : ' · oculta'}`, `data-cat-ed="categoria" data-id="${g.id_Categoria}"`)).join('') || '<p class="ui-help">Ninguna todavía. Ej.: Desde Rep. Dom., Cruceros Disney.</p>'}</div>`;
    }

    let catActual = null;
    function abrirCat(que, id) {
        const x = que === 'naviera' ? D.navieras.find(n => n.id_Naviera === id) : que === 'barco' ? D.barcos.find(b => b.id_Barco === id) : D.categorias.find(g => g.id_Categoria === id);
        catActual = { que, id: id || 0, img: x ? (que === 'naviera' ? x.logo : x.imagen) : null };
        $('#catTitulo').textContent = (x ? 'Editar ' : 'Nueva ') + { naviera: 'naviera', barco: 'barco', categoria: 'categoría' }[que];
        $('#catEliminar').hidden = !x;
        $('#catCuerpo').innerHTML = `
            <div class="ui-f"><label>${que === 'naviera' ? 'Logo' : 'Foto'} <em>se ve en la web</em></label>${fotoHtml('cat', catActual.img, true)}</div>
            ${que === 'barco' ? `<div class="ui-f"><label for="catNav">Naviera *</label><select id="catNav">${D.navieras.map(n => `<option value="${n.id_Naviera}" ${x?.id_Naviera === n.id_Naviera ? 'selected' : ''}>${esc(n.nombre)}</option>`).join('')}</select></div>` : ''}
            <div class="ui-f"><label for="catNombre">Nombre *</label><input id="catNombre" maxlength="100" value="${esc(x?.nombre || '')}" placeholder="${{ naviera: 'Ej. Disney Cruise Line', barco: 'Ej. Disney Treasure', categoria: 'Ej. Cruceros Disney' }[que]}"></div>
            ${que !== 'naviera' ? `<div class="ui-f"><label for="catDesc">Descripción</label><textarea id="catDesc" rows="${que === 'barco' ? 5 : 2}" maxlength="${que === 'barco' ? 4000 : 300}" placeholder="${que === 'barco' ? 'Lo que se muestra en «Tu barco»' : 'Ej. Ofrecer experiencias familiares únicas en cruceros Disney.'}">${esc(x?.descripcion || '')}</textarea></div>` : ''}
            ${que === 'categoria' ? `<div class="ui-f"><label for="catOrden">Orden en la web</label><input id="catOrden" type="number" min="1" max="999" value="${x?.orden ?? 1}"></div>` : ''}
            <div class="ui-f"><label class="ui-switch"><input type="checkbox" id="catActivo" ${x?.activo === false ? '' : 'checked'}><span class="tr"></span> ${que === 'categoria' ? 'Visible en la web' : 'Activo'}</label></div>`;
        dCat.abrir();
        setTimeout(() => $('#catNombre').focus(), 80);
    }

    async function guardarCat() {
        const { que, id } = catActual;
        const b = { nombre: $('#catNombre').value.trim(), activo: $('#catActivo').checked };
        if (!b.nombre) { EV.toast('Escribe el nombre.', 'err'); return; }
        let url;
        if (que === 'naviera') { url = '/Cruceros/GuardarNaviera'; Object.assign(b, { id_Naviera: id, logo: catActual.img }); }
        else if (que === 'barco') { url = '/Cruceros/GuardarBarco'; Object.assign(b, { id_Barco: id, id_Naviera: +$('#catNav').value, descripcion: $('#catDesc').value.trim() || null, imagen: catActual.img }); }
        else { url = '/Cruceros/GuardarCategoria'; Object.assign(b, { id_Categoria: id, descripcion: $('#catDesc').value.trim() || null, imagen: catActual.img, orden: +$('#catOrden').value || 1 }); }
        try { const r = await EV.post(url, b); EV.toast(r.mensaje); dCat.cerrar(true); await cargar(); }
        catch (e) { EV.toast(e.message, 'err'); }
    }

    async function eliminarCat() {
        if (!await EV.confirmar({ titulo: '¿Eliminar?', peligro: true, si: 'Sí, eliminar', texto: catActual.que === 'categoria' ? 'Los cruceros NO se borran: solo dejan de estar en esta categoría (y su tarjeta sale de la Home).' : 'No se puede deshacer.' })) return;
        try { const r = await EV.post(`/Cruceros/EliminarCatalogo?que=${catActual.que}&id=${catActual.id}`); EV.toast(r.mensaje); dCat.cerrar(true); await cargar(); }
        catch (e) { EV.toast(e.message, 'err'); }
    }

    // ===================== FOTOS SUELTAS (actividad, cabina, cubierta, día, catálogo): se suben al momento y se guardan con el crucero =====================
    // ruta: 'cat' | 'dia:i' | 'act:s:a' | 'tipo:clave' | 'cub:i'
    function fotoHtml(ruta, url, grande) {
        return `<label class="cz-foto ${grande ? 'grande' : ''}" title="${url ? 'Cambiar foto' : 'Subir foto'}" data-foto="${ruta}">
            ${url ? `<img src="${esc(url)}" alt=""><button type="button" class="x" data-quitar-foto="${ruta}" title="Quitar foto">×</button>` : '<i class="bi bi-camera"></i>'}
            <input type="file" accept="image/jpeg,image/png,image/webp" hidden data-subir-foto="${ruta}"></label>`;
    }
    const tipoFoto = r => r === 'cat' ? catActual.que : { dia: 'itinerario', act: 'actividad', tipo: 'cabina', cub: 'cubierta' }[r.split(':')[0]];
    function ponerFoto(ruta, url) {
        const p = ruta.split(':');
        if (p[0] === 'cat') catActual.img = url;
        else if (p[0] === 'dia') C.itinerario[+p[1]].imagen = url;
        else if (p[0] === 'act') C.secciones[+p[1]].actividades[+p[2]].imagen = url;
        else if (p[0] === 'tipo') C.cabinas.find(t => t.clave === p[1]).imagen = url;
        else if (p[0] === 'cub') C.cubiertas[+p[1]].plano = url;
    }
    async function subirFoto(ruta, archivo, el) {
        if (!IMG_OK.test(archivo.type) || archivo.size > 10e6) { EV.toast('Usa una imagen JPG, PNG o WebP de hasta 10 MB.', 'err'); return; }
        const fd = new FormData(); fd.append('tipo', tipoFoto(ruta)); if (C?.id_Crucero) fd.append('id', C.id_Crucero); fd.append('archivo', archivo);
        el.classList.add('subiendo');
        try {
            const r = await EVProgreso.subir('/Cruceros/SubirImagen', fd);
            ponerFoto(ruta, r.url);
            el.outerHTML = fotoHtml(ruta, r.url, el.classList.contains('grande'));
            (ruta === 'cat' ? $('#czCat') : $('#czEditor')).dispatchEvent(new Event('ev-cambio'));
            EV.toast('Foto subida.');
        } catch (e) { EV.toast(e.message, 'err'); el.classList.remove('subiendo'); }
    }

    // ===================== EDITOR =====================
    const vacio = () => ({ id_Crucero: null, titulo: '', subtitulo: '', id_Barco: null, naviera_Nombre: '', barco_Nombre: '', puerto_Salida: '', puerto_Llegada: '', noches: null, codigo: '',
        descripcion: '', incluye: '', no_Incluye: '', titulo_Seccion: '', activo: true, categorias: D.categorias.length === 1 ? [D.categorias[0].id_Categoria] : [], categorias_Nuevas: [],
        itinerario: [], secciones: [], cubiertas: [], cabinas: [], salidas: [], tarifas: [], precios: [] });

    async function abrir(id) {
        if (id) { try { C = await EV.api('/Cruceros/Obtener?id=' + id); } catch (e) { EV.toast(e.message, 'err'); return; } }
        else C = vacio();
        C.categorias_Nuevas = [];
        C.salidas.forEach(s => s.fecha = s.fecha.slice(0, 10));
        C.itinerario.sort((a, b) => a.dia - b.dia);
        tarSel = C.tarifas[0]?.clave || null;
        fotosMontadas = false; P = { PORTADA: null, INTERMEDIA: null, GALERIA: [] }; $('#eFotos').innerHTML = '';
        $('#edTitulo').textContent = id ? C.titulo : 'Nuevo crucero';
        $('#edSub').textContent = id ? `n.º ${C.id_Crucero}${C.usuario ? ' · cargado por ' + C.usuario : ''}` : 'Solo el título es obligatorio. Lo demás, cuando lo tengas.';
        $('#edEliminar').hidden = !id;
        pintarDatos(); pintarItin(); pintarBordo(); pintarCabinas(); pintarPrecios();
        edTabs.ir('eDatos'); editor.abrir();
        setTimeout(() => $('[data-b="titulo"]')?.focus(), 80);
    }

    function alCambiarPaso() {
        const i = PASOS.indexOf(paso);
        $('#edAnterior').disabled = i === 0;
        $('#edSiguiente').hidden = paso === 'eResumen';
        $('#edGuardar').innerHTML = paso === 'eResumen' ? '<i class="bi bi-check2-circle"></i> Guardar' : '<i class="bi bi-clipboard-check"></i> Revisar y guardar';
        if (paso === 'eFotos') pintarFotos();
        if (paso === 'ePrecios') pintarPrecios();
        if (paso === 'eResumen') pintarResumen();
        marcarPasos();
        $('#edCuerpo').scrollTop = 0;
    }
    function marcarPasos() {
        if (!C) return;
        const lleno = { eDatos: !!C.titulo?.trim(), eFotos: fotosMontadas || P.PORTADA || P.INTERMEDIA || P.GALERIA.length, eItin: C.itinerario.length, eBordo: C.secciones.length,
                        eCabinas: C.cabinas.length, ePrecios: C.salidas.length };
        $$('#edTabs [data-tab]').forEach(b => b.classList.toggle('lleno', !!lleno[b.dataset.tab] && b.dataset.tab !== paso));
    }

    // data-b="ruta.del.dato" + data-t="num|bool" → se guarda en C al escribir
    function asignar(ruta, valor) {
        const p = ruta.split('.'); let o = C;
        for (let i = 0; i < p.length - 1; i++) o = o[isNaN(p[i]) ? p[i] : +p[i]];
        o[isNaN(p.at(-1)) ? p.at(-1) : +p.at(-1)] = valor;
    }
    const val = r => r.split('.').reduce((o, k) => o?.[isNaN(k) ? k : +k], C);
    const inp = (ruta, extra = '', tipo = 'text') => `<input data-b="${ruta}" ${tipo === 'num' ? 'type="number" data-t="num"' : ''} value="${esc(val(ruta) ?? '')}" ${extra}>`;
    const txt = (ruta, extra = '') => `<textarea data-b="${ruta}" ${extra}>${esc(val(ruta) ?? '')}</textarea>`;
    const opc = '<em class="cz-opc">opcional</em>';

    // ---------- 1. Datos ----------
    function pintarDatos() {
        if (C.id_Barco && !C.barco_Nombre) { const b = D.barcos.find(x => x.id_Barco === C.id_Barco); if (b) { C.barco_Nombre = b.nombre; C.naviera_Nombre = b.naviera; } }
        $('#eDatos').innerHTML = `
            <div class="cz-blq"><h3><i class="bi bi-info-circle"></i> El crucero</h3>
                <div class="ui-f"><label>Título * <em>el que sale en la tarjeta y la cabecera</em></label>${inp('titulo', 'maxlength="200" placeholder="Ej. Halloween en Alta Mar del Caribe Oriental"')}</div>
                <div class="ui-row">
                    <div class="ui-f"><label>Naviera ${opc}</label><input data-b="naviera_Nombre" list="dlNavieras" maxlength="100" value="${esc(C.naviera_Nombre || '')}" placeholder="Ej. Disney Cruise Line">
                        <datalist id="dlNavieras">${D.navieras.map(n => `<option value="${esc(n.nombre)}">`).join('')}</datalist></div>
                    <div class="ui-f"><label>Barco ${opc}</label><input data-b="barco_Nombre" list="dlBarcos" maxlength="100" value="${esc(C.barco_Nombre || '')}" placeholder="Ej. Disney Treasure">
                        <datalist id="dlBarcos">${D.barcos.map(b => `<option value="${esc(b.nombre)}">${esc(b.naviera)}</option>`).join('')}</datalist></div>
                </div>
                <p class="ui-help" style="margin:-4px 0 12px"><i class="bi bi-magic"></i> Elige de la lista o escribe uno nuevo: si no existe, se crea al guardar.</p>
                <div class="ui-row r3">
                    <div class="ui-f"><label>Noches ${opc}</label>${inp('noches', 'min="1" max="180" placeholder="Ej. 7"', 'num')}</div>
                    <div class="ui-f"><label>Puerto de salida ${opc}</label>${inp('puerto_Salida', 'maxlength="100" placeholder="Ej. Port Canaveral"')}</div>
                    <div class="ui-f"><label>Puerto de llegada ${opc}</label>${inp('puerto_Llegada', 'maxlength="100" placeholder="Si lo dejas vacío, el mismo de salida"')}</div>
                </div>
                <div class="ui-f"><label class="ui-switch"><input type="checkbox" data-b="activo" data-t="bool" ${C.activo ? 'checked' : ''}><span class="tr"></span> Activo: sale en la web y en la Home</label></div>
            </div>
            <div class="cz-blq"><h3><i class="bi bi-tags"></i> Categoría de la web <small>es la tarjeta de la Home donde sale · si no eliges, va a «Cruceros»</small></h3>
                <div class="cz-chips">${D.categorias.map(g => `<label><input type="checkbox" data-categoria="${g.id_Categoria}" ${C.categorias.includes(g.id_Categoria) ? 'checked' : ''}> ${esc(g.nombre)}</label>`).join('')}
                    ${C.categorias_Nuevas.map((n, i) => `<span class="cz-chips nueva" style="display:inline-flex"><label class="nueva"><i class="bi bi-plus-circle"></i> ${esc(n)} <button type="button" data-cat-quitar="${i}" title="Quitar">×</button></label></span>`).join('')}
                    <span style="display:inline-flex;gap:6px"><input id="edCatNueva" maxlength="100" placeholder="Nueva categoría…" style="width:190px"><button type="button" class="ev-btn ghost sm" data-cat-agregar><i class="bi bi-plus-lg"></i> Agregar</button></span>
                </div>
            </div>
            <details class="cz-blq cz-mas" ${C.descripcion || C.subtitulo || C.codigo || C.incluye || C.no_Incluye ? 'open' : ''}><summary><i class="bi bi-text-paragraph"></i> Más textos ${opc} <i class="bi bi-chevron-down"></i></summary><div>
                <div class="ui-row"><div class="ui-f"><label>Subtítulo <em>si lo dejas vacío: «Saliendo el {fecha} para {noches} noches a bordo del {barco}»</em></label>${inp('subtitulo', 'maxlength="300"')}</div>
                    <div class="ui-f"><label>Código / ID del proveedor</label>${inp('codigo', 'maxlength="50" placeholder="Ej. 2256635"')}</div></div>
                <div class="ui-f"><label>Descripción</label>${txt('descripcion', 'rows="4"')}</div>
                <div class="ui-row"><div class="ui-f"><label>Incluye</label>${txt('incluye', 'rows="3"')}</div><div class="ui-f"><label>No incluye</label>${txt('no_Incluye', 'rows="3"')}</div></div>
            </div></details>`;
    }

    // ---------- 2. Fotos ----------
    function pintarFotos() {
        if (C.id_Crucero) {
            if (fotosMontadas) return;
            $('#eFotos').innerHTML = `<div class="cz-intro"><i class="bi bi-info-circle"></i><span>Portada = la tarjeta de la lista · Intermedia = el banner de la cabecera · Galería = el slider de la ficha. Se guardan al momento.</span></div><div id="eFotosMm"></div>`;
            EVFotos.montar($('#eFotosMm'), { tipo: 'CRUCERO', clave: C.id_Crucero, alCambiar: () => { fotosMontadas = true; marcarPasos(); } });
            fotosMontadas = true;
            return;
        }
        const slot = (uso, titulo, f) => `<label class="cz-pend-slot" data-pend="${uso}">
            <span class="et">${titulo}</span>${f ? `<img src="${URL.createObjectURL(f)}" alt=""><button type="button" class="x" data-pend-quitar="${uso}" title="Quitar">×</button>` : `<span><i class="bi bi-cloud-arrow-up" style="font-size:28px;display:block"></i>Pulsa o arrastra una foto</span>`}
            <input type="file" accept="image/jpeg,image/png,image/webp" hidden data-pend-subir="${uso}" ${uso === 'GALERIA' ? 'multiple' : ''}></label>`;
        $('#eFotos').innerHTML = `<div class="cz-intro"><i class="bi bi-info-circle"></i><span>Elige las fotos ahora: se suben solas al guardar el crucero. ${opc}</span></div>
            <div class="cz-pend">${slot('PORTADA', 'Portada · tarjeta de la lista', P.PORTADA)}${slot('INTERMEDIA', 'Banner · cabecera de la ficha', P.INTERMEDIA)}</div>
            <div class="cz-blq" style="margin-top:12px"><h3><i class="bi bi-images"></i> Galería <small>${P.GALERIA.length} foto(s)</small></h3>
                <div class="cz-pend-gal">${P.GALERIA.map((f, i) => `<div class="cz-pend-slot"><img src="${URL.createObjectURL(f)}" alt=""><button type="button" class="x" data-pend-quitar="GALERIA:${i}" title="Quitar">×</button></div>`).join('')}
                    ${slot('GALERIA', 'Añadir', null)}</div></div>`;
    }
    function ponerPendientes(uso, archivos) {
        const ok = [...archivos].filter(f => IMG_OK.test(f.type) && f.size <= 10e6);
        if (ok.length < archivos.length) EV.toast('Algunas no son JPG, PNG o WebP de hasta 10 MB.', 'err');
        if (!ok.length) return;
        if (uso === 'GALERIA') P.GALERIA.push(...ok); else P[uso] = ok[0];
        pintarFotos(); marcarPasos(); $('#czEditor').dispatchEvent(new Event('ev-cambio'));
    }
    async function subirPendientes(id) {
        const tandas = [['PORTADA', P.PORTADA ? [P.PORTADA] : []], ['INTERMEDIA', P.INTERMEDIA ? [P.INTERMEDIA] : []], ['GALERIA', P.GALERIA]].filter(([, l]) => l.length);
        let mal = 0;
        for (const [uso, lista] of tandas) {
            const fd = new FormData(); fd.append('tipo', 'CRUCERO'); fd.append('clave', id); fd.append('uso', uso); lista.forEach(f => fd.append('archivos', f));
            try { await EVProgreso.subir('/Multimedia/Subir', fd); } catch (e) { mal++; EV.toast('Fotos (' + uso.toLowerCase() + '): ' + e.message, 'err'); }
        }
        P = { PORTADA: null, INTERMEDIA: null, GALERIA: [] };
        return tandas.length - mal;
    }

    // ---------- 3. Itinerario ----------
    function pintarItin() {
        const sal = C.salidas.filter(s => s.activo).sort((a, b) => a.fecha.localeCompare(b.fecha))[0];
        const n = noches();
        $('#eItin').innerHTML = `<div class="cz-intro"><i class="bi bi-info-circle"></i><span>Un día por tarjeta: el puerto y a qué hora llega y sale el barco (o márcalo «En navegación»). Todo ${opc}.${sal ? ` Las fechas salen de la primera salida (${fechaCorta(sal.fecha)}).` : ''}</span></div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px">
                <button type="button" class="ev-btn sm" data-it="nuevo"><i class="bi bi-plus-lg"></i> Agregar día</button>
                ${n ? `<button type="button" class="ev-btn ghost sm" data-it="generar"><i class="bi bi-magic"></i> Crear los ${n + 1} días (${n} noches)</button>` : '<span class="ui-help" style="margin:0;align-self:center">Pon las noches en «Datos» para crear todos los días de una vez.</span>'}
            </div>
            ${C.itinerario.length ? `<div class="cz-dias">${C.itinerario.map((d, i) => `<div class="cz-dia ${d.en_Navegacion ? 'nav' : ''}">
                <div class="cz-dia-h"><b>Día ${i + 1}</b>${sal ? `<small>${fechaCorta(masDias(sal.fecha, i))}</small>` : ''}<span class="sp"></span>
                    <label class="ui-switch" title="En navegación (At Sea)"><input type="checkbox" data-b="itinerario.${i}.en_Navegacion" data-t="bool" ${d.en_Navegacion ? 'checked' : ''}><span class="tr"></span> En navegación</label>
                    <button type="button" class="ui-ibtn danger" data-it="quitar" data-i="${i}" title="Quitar este día"><i class="bi bi-trash3"></i></button></div>
                ${d.en_Navegacion ? '<div class="ui-help" style="margin:0"><i class="bi bi-water"></i> Día en el mar: sin puerto ni horas.</div>' : `
                ${inp(`itinerario.${i}.puerto`, 'maxlength="150" placeholder="Puerto, ej. Tortola"')}
                <div class="cz-horas"><label>Llega<input type="time" step="60" data-b="itinerario.${i}.hora_Llegada" value="${esc(d.hora_Llegada || '')}"></label>
                    <label>Sale<input type="time" step="60" data-b="itinerario.${i}.hora_Salida" value="${esc(d.hora_Salida || '')}"></label></div>`}
                <div class="fila">${txt(`itinerario.${i}.descripcion`, 'rows="2" placeholder="Qué hay en este día (opcional)"')}${fotoHtml('dia:' + i, d.imagen)}</div>
            </div>`).join('')}</div>` : '<div class="ui-empty" style="padding:24px"><p style="margin:0">Sin días todavía.</p></div>'}`;
    }

    // ---------- 4. A bordo ----------
    function pintarBordo() {
        $('#eBordo').innerHTML = `<div class="cz-intro"><i class="bi bi-info-circle"></i><span>Las pestañas de «Tu barco» en la web (Comida y bebida, Entretenimiento…) con sus actividades: foto, título y descripción. ${opc}</span></div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px">
                <button type="button" class="ev-btn ghost sm" data-bo="base"><i class="bi bi-magic"></i> Crear las 4 básicas</button>
                <button type="button" class="ev-btn sm" data-bo="seccion"><i class="bi bi-plus-lg"></i> Sección</button></div>
            ${C.secciones.map((s, i) => `<div class="cz-sec">
                <div class="cz-sec-h">${inp(`secciones.${i}.titulo`, 'maxlength="100" placeholder="Nombre de la pestaña, ej. Entretenimiento"')}
                    <button type="button" class="ui-ibtn" data-bo="subir" data-i="${i}" ${i === 0 ? 'disabled' : ''} title="Mover antes"><i class="bi bi-arrow-up"></i></button>
                    <button type="button" class="ui-ibtn danger" data-bo="qsec" data-i="${i}" title="Quitar sección"><i class="bi bi-trash3"></i></button></div>
                <div class="cz-acts">${s.actividades.map((a, j) => `<div class="cz-act">
                    <div class="fila">${fotoHtml(`act:${i}:${j}`, a.imagen)}<div style="flex:1;display:grid;gap:4px">${inp(`secciones.${i}.actividades.${j}.titulo`, 'maxlength="150" placeholder="Título"')}
                        <button type="button" class="ev-btn ghost sm" data-bo="qact" data-i="${i}" data-j="${j}"><i class="bi bi-x-lg"></i> Quitar</button></div></div>
                    ${txt(`secciones.${i}.actividades.${j}.descripcion`, 'rows="3" placeholder="Descripción («Leer más»)"')}</div>`).join('')}
                    <button type="button" class="cz-add" data-bo="act" data-i="${i}"><i class="bi bi-plus-circle"></i><br>Actividad</button></div>
            </div>`).join('') || '<div class="ui-empty" style="padding:24px"><p style="margin:0">Sin secciones todavía.</p></div>'}
            ${C.secciones.length ? `<div class="ui-f" style="margin-top:8px"><label>Título de esta parte en la web ${opc} <em>si lo dejas vacío: «Tu barco - {barco}»</em></label>${inp('titulo_Seccion', 'maxlength="150"')}</div>` : ''}`;
    }

    // ---------- 5. Cabinas ----------
    function pintarCabinas() {
        const tipoInp = (t, campo, ph, extra = '') => `<input data-tipo="${t.clave}" data-campo="${campo}" value="${esc(t[campo] ?? '')}" placeholder="${ph}" ${extra}>`;
        $('#eCabinas').innerHTML = `<div class="cz-intro"><i class="bi bi-info-circle"></i><span>Los tipos de camarote que se venden (Interior, Exterior, Balcón, Suite). Son los que tendrán precio en el paso 6. ${opc}</span></div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px">
                <button type="button" class="ev-btn ghost sm" data-ca="basicos"><i class="bi bi-magic"></i> Crear los 4 tipos básicos</button>
                <button type="button" class="ev-btn sm" data-ca="tipo"><i class="bi bi-plus-lg"></i> Tipo de cabina</button></div>
            ${C.cabinas.map(t => `<div class="cz-tipo">
                ${fotoHtml('tipo:' + t.clave, t.imagen, true)}
                <div class="campos">
                    <div class="g"><select data-tipo="${t.clave}" data-campo="categoria" title="Categoría">${CATS.map(k => `<option value="${k}" ${k === t.categoria ? 'selected' : ''}>${CAT_CORTO[k]}</option>`).join('')}</select>
                        ${tipoInp(t, 'nombre', 'Nombre, ej. Camarote Interior Estándar', 'maxlength="150"')}
                        ${tipoInp(t, 'capacidad_Min', 'Pers. mín', 'type="number" min="1" max="20" data-t="num"')}${tipoInp(t, 'capacidad_Max', 'Pers. máx', 'type="number" min="1" max="20" data-t="num"')}${tipoInp(t, 'metros', 'm²', 'type="number" min="1" step="0.1" data-t="num"')}</div>
                    <textarea data-tipo="${t.clave}" data-campo="descripcion" rows="2" placeholder="Descripción (opcional)">${esc(t.descripcion || '')}</textarea>
                    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">${tipoInp(t, 'codigo', 'Código, ej. 11C (opcional)', 'maxlength="20" style="width:190px"')}
                        <span style="flex:1"></span><button type="button" class="ev-btn ghost sm" data-ca="qtipo" data-k="${t.clave}"><i class="bi bi-trash3"></i> Quitar</button></div>
                </div></div>`).join('') || '<div class="ui-empty" style="padding:24px"><p style="margin:0">Sin tipos de cabina. Pulsa «Crear los 4 tipos básicos».</p></div>'}
            <details class="cz-blq cz-mas" style="margin-top:12px" ${C.cubiertas.length || C.cabinas.some(t => t.cabinas.length) ? 'open' : ''}><summary><i class="bi bi-layers"></i> Avanzado: cubiertas y cabinas concretas ${opc} <i class="bi bi-chevron-down"></i></summary><div>
                <p class="ui-help" style="margin:0 0 10px">Si no pones cabinas concretas, se vende «Garantizada» (la naviera asigna el número).</p>
                <button type="button" class="ev-btn ghost sm" data-ca="cubierta"><i class="bi bi-plus-lg"></i> Cubierta</button>
                ${C.cubiertas.length ? `<table class="cz-tab" style="margin-top:8px"><thead><tr><th>N.º</th><th>Nombre</th><th>Plano</th><th></th></tr></thead><tbody>${C.cubiertas.map((u, i) => `<tr>
                    <td class="num">${inp(`cubiertas.${i}.numero`, 'min="1" max="99" class="num"', 'num')}</td><td>${inp(`cubiertas.${i}.nombre`, 'maxlength="100" placeholder="Ej. Cubierta 7"')}</td>
                    <td>${fotoHtml('cub:' + i, u.plano)}</td><td><button type="button" class="ui-ibtn danger" data-ca="qcub" data-i="${i}"><i class="bi bi-x-lg"></i></button></td></tr>`).join('')}</tbody></table>` : ''}
                ${C.cabinas.map(t => `<div class="cz-cabs" style="margin-top:10px"><b style="font-size:12.5px">${esc(t.nombre || CAT_CORTO[t.categoria])}:</b>${t.cabinas.map((k, i) => `<span class="cz-cab">
                    <input value="${esc(k.numero || '')}" data-cab="${t.clave}" data-i="${i}" data-campo="numero" placeholder="N.º" maxlength="10">
                    <select data-cab="${t.clave}" data-i="${i}" data-campo="cubierta"><option value="">Cubierta ?</option>${C.cubiertas.map(u => `<option value="${u.numero}" ${k.cubierta === u.numero ? 'selected' : ''}>Cub. ${u.numero}</option>`).join('')}</select>
                    <button type="button" data-ca="qcab" data-k="${t.clave}" data-i="${i}" title="Quitar">×</button></span>`).join('')}
                    <button type="button" class="ev-btn ghost sm" data-ca="cab" data-k="${t.clave}"><i class="bi bi-plus-lg"></i> Cabina</button>
                    <label class="ui-switch" style="margin-left:6px"><input type="checkbox" data-tipo="${t.clave}" data-campo="permite_Garantizada" data-t="bool" ${t.permite_Garantizada ? 'checked' : ''}><span class="tr"></span> «Garantizada»</label></div>`).join('')}
            </div></details>`;
    }

    // ---------- 6. Fechas y precios ----------
    function pintarPrecios() {
        C.salidas.sort((a, b) => a.fecha.localeCompare(b.fecha));
        if (tarSel && !C.tarifas.some(f => f.clave === tarSel)) tarSel = C.tarifas[0]?.clave || null;
        const pr = new Map(C.precios.map(p => [`${p.salida}|${p.tarifa}|${p.cabina}`, p.precio_Pp]));
        const tipos = CATS.flatMap(k => C.cabinas.filter(t => t.categoria === k));
        const n = noches();
        const tar = tarSel || 'auto';
        $('#ePrecios').innerHTML = `<div class="cz-intro"><i class="bi bi-info-circle"></i><span>Agrega las fechas de salida y escribe el precio <b>por persona</b> de cada tipo de cabina (base 2 personas compartiendo). ${opc}</span></div>
            <div class="cz-blq"><h3><i class="bi bi-calendar3"></i> Fechas de salida ${n ? `<small>la llegada = salida + ${n} noches</small>` : ''}</h3>
                <div class="ui-row r4" style="align-items:end">
                    <div class="ui-f"><label>Una fecha</label><input type="date" id="prFecha" min="${hoy}"></div>
                    <div class="ui-f"><button type="button" class="ev-btn ghost" data-pr="fecha"><i class="bi bi-plus-lg"></i> Agregar fecha</button></div>
                    <div class="ui-f"><label>O varias: desde / hasta / cada (días)</label><div style="display:flex;gap:6px"><input type="date" id="prDesde"><input type="date" id="prHasta"><input type="number" id="prCada" value="7" min="1" style="width:70px"></div></div>
                    <div class="ui-f"><button type="button" class="ev-btn ghost" data-pr="serie"><i class="bi bi-calendar-plus"></i> Agregar serie</button></div>
                </div>
            </div>
            <div class="cz-blq"><h3><i class="bi bi-currency-dollar"></i> Precios por persona en ${EV.simbolo()} <span class="sp"></span>
                ${C.tarifas.length > 1 ? `<select id="prTarifa" title="Tarifa">${C.tarifas.map(f => `<option value="${f.clave}" ${f.clave === tarSel ? 'selected' : ''}>${esc(f.codigo || f.nombre || '¿?')}</option>`).join('')}</select>` : ''}
                ${C.salidas.length > 1 && tipos.length ? '<button type="button" class="ev-btn ghost sm" data-pr="copiar"><i class="bi bi-files"></i> Copiar la 1.ª fecha a todas</button>' : ''}</h3>
                ${!C.salidas.length ? '<p class="ui-help" style="margin:0">Agrega una fecha arriba para poner precios.</p>'
                  : !tipos.length ? '<p class="ui-help" style="margin:0">Primero crea los tipos de cabina (paso 5 · botón «Crear los 4 tipos básicos»).</p>'
                  : `<div style="overflow-x:auto"><table class="cz-grid"><thead><tr><th>Salida</th>${tipos.map(t => `<th><small>${CAT_CORTO[t.categoria]}</small>${esc(t.nombre || '')}</th>`).join('')}<th></th></tr></thead><tbody>
                     ${C.salidas.map(s => `<tr class="${s.activo ? '' : 'off'}"><td class="f">${fechaCorta(s.fecha)}${n ? ` <small style="color:var(--ev-muted);font-weight:600">→ ${fechaCorta(masDias(s.fecha, n))}</small>` : ''}${s.fecha <= hoy ? ' <small style="color:#B54708">(pasada)</small>' : ''}</td>
                        ${tipos.map(t => `<td><input type="number" min="0" step="0.01" data-precio="${s.clave}|${tar}|${t.clave}" value="${pr.get(`${s.clave}|${tarSel}|${t.clave}`) ?? ''}" placeholder="—"></td>`).join('')}
                        <td><button type="button" class="ui-ibtn" data-pr="act" data-k="${s.clave}" title="${s.activo ? 'Desactivar esta fecha' : 'Activar esta fecha'}"><i class="bi ${s.activo ? 'bi-pause' : 'bi-play'}"></i></button>
                            <button type="button" class="ui-ibtn danger" data-pr="qsal" data-k="${s.clave}" title="Quitar fecha"><i class="bi bi-x-lg"></i></button></td></tr>`).join('')}
                     </tbody></table></div>`}
                ${!C.salidas.length ? '' : `<p style="margin:10px 0 0"><button type="button" class="ev-btn ghost sm" data-pr="limpiar-fechas"><i class="bi bi-trash3"></i> Quitar todas las fechas</button></p>`}
            </div>
            <details class="cz-blq cz-mas" ${C.tarifas.length > 1 ? 'open' : ''}><summary><i class="bi bi-tag"></i> Avanzado: varios códigos de tarifa ${opc} <i class="bi bi-chevron-down"></i></summary><div>
                <p class="ui-help" style="margin:0 0 10px">Si el crucero tiene un solo precio, no hace falta: se usa «BEST_PRICE». Agrega otros (ej. «Florida Resident») si la naviera da precios distintos.</p>
                ${C.tarifas.map((f, i) => `<div style="display:flex;gap:8px;margin-bottom:6px">${inp(`tarifas.${i}.codigo`, 'maxlength="50" placeholder="Código, ej. FLRES" style="width:180px"')}${inp(`tarifas.${i}.nombre`, 'maxlength="100" placeholder="Nombre, ej. Florida Resident"')}
                    <button type="button" class="ui-ibtn danger" data-pr="qtar" data-i="${i}" title="Quitar tarifa y sus precios"><i class="bi bi-x-lg"></i></button></div>`).join('')}
                <button type="button" class="ev-btn ghost sm" data-pr="tarifa"><i class="bi bi-plus-lg"></i> Tarifa</button>
            </div></details>`;
    }

    function ponerPrecio(k, v) {
        let [s, f, t] = k.split('|');
        if (f === 'auto') {   // primer precio sin tarifas: se crea BEST_PRICE
            if (!C.tarifas.length) C.tarifas.push({ clave: nuevaClave('f'), codigo: 'BEST_PRICE', nombre: 'BEST_PRICE', descripcion: '' });
            tarSel = C.tarifas[0].clave; f = tarSel;
            $$('[data-precio]').forEach(i => i.dataset.precio = i.dataset.precio.replace('|auto|', `|${f}|`));
        }
        C.precios = C.precios.filter(p => !(p.salida === s && p.tarifa === f && p.cabina === t));
        if (v > 0) C.precios.push({ salida: s, tarifa: f, cabina: t, precio_Pp: v });
    }

    // ---------- 7. Revisar y guardar ----------
    async function pintarResumen() {
        const it = (ok, icono, titulo, detalle, pasoIr, aviso) => `<div class="cz-res-it ${ok ? (aviso ? 'aviso' : '') : 'vacio'}"><span class="ic"><i class="bi ${ok ? (aviso ? 'bi-exclamation-triangle' : icono) : 'bi-dash-circle'}"></i></span>
            <div><b>${titulo}</b><span>${detalle}</span></div>${pasoIr ? `<button type="button" class="ev-btn ghost sm" data-ir="${pasoIr}">${ok ? 'Cambiar' : 'Agregar'}</button>` : ''}</div>`;
        const cats = [...D.categorias.filter(g => $$('[data-categoria]').some(c => c.checked && +c.dataset.categoria === g.id_Categoria)).map(g => g.nombre), ...C.categorias_Nuevas];
        const futuras = C.salidas.filter(s => s.activo && s.fecha > hoy);
        const precios = C.precios.filter(p => p.precio_Pp > 0);
        const desde = precios.filter(p => futuras.some(s => s.clave === p.salida)).map(p => p.precio_Pp);
        let fotos = P.PORTADA ? 1 : 0; fotos += P.INTERMEDIA ? 1 : 0; fotos += P.GALERIA.length;
        let fotosTxt = fotos ? `${fotos} foto(s) se subirán al guardar` : 'Sin fotos';
        if (C.id_Crucero) { try { const l = (await EV.api(`/Multimedia/Listar?tipo=CRUCERO&clave=${C.id_Crucero}`)).items; fotos = l.length; fotosTxt = l.length ? `${l.length} foto(s)${l.some(x => x.uso === 'PORTADA') ? ' · con portada' : ' · sin portada'}` : 'Sin fotos'; } catch { } }
        const nav = C.itinerario.filter(d => d.en_Navegacion).length;
        const acts = C.secciones.reduce((s, x) => s + x.actividades.length, 0);
        const n = noches();
        const home = C.activo
            ? `<div class="cz-home ok"><i class="bi bi-house-check"></i><div>Al guardar sale en la <b>Home</b> (sección CRUCEROS) en la tarjeta <b>${esc((cats.length ? cats : ['Cruceros']).join('», «'))}</b>${desde.length ? `, con precio desde <b>${dinero(Math.min(...desde))}</b>` : ' (sin precio «desde» hasta que tenga una fecha futura con precio)'}.</div></div>`
            : `<div class="cz-home no"><i class="bi bi-eye-slash"></i><div>Está <b>desactivado</b>: se guarda pero <b>no sale</b> en la web ni en la Home. Actívalo en «Datos» si quieres que salga.</div></div>`;
        $('#eResumen').innerHTML = `${home}<div class="cz-res">
            ${it(!!C.titulo?.trim(), 'bi-type', C.titulo?.trim() ? esc(C.titulo) : 'Falta el título (obligatorio)', [C.naviera_Nombre, C.barco_Nombre].filter(Boolean).map(esc).join(' · ') || 'Sin naviera ni barco', 'eDatos', !C.titulo?.trim())}
            ${it(n || C.puerto_Salida, 'bi-signpost', n ? `${n} noches · ${n + 1} días` : 'Sin noches', [C.puerto_Salida, C.puerto_Llegada].filter(Boolean).map(esc).join(' → ') || 'Sin puertos', 'eDatos')}
            ${it(true, 'bi-tags', 'Categoría: ' + esc((cats.length ? cats : ['Cruceros (por defecto)']).join(', ')), C.categorias_Nuevas.length ? 'Las nuevas se crean al guardar' : 'Es la tarjeta de la Home donde sale', 'eDatos')}
            ${it(fotos, 'bi-images', 'Fotos', fotosTxt, 'eFotos')}
            ${it(C.itinerario.length, 'bi-signpost-2', `Itinerario: ${C.itinerario.length} día(s)`, C.itinerario.length ? `${C.itinerario.filter(d => !d.en_Navegacion).map(d => esc(d.puerto || '¿?')).join(' · ')}${nav ? ` · ${nav} en navegación` : ''}` : 'Sin itinerario', 'eItin')}
            ${it(C.secciones.length, 'bi-stars', `A bordo: ${C.secciones.length} sección(es), ${acts} actividad(es)`, C.secciones.map(s => esc(s.titulo || '¿?')).join(' · ') || 'Sin «Tu barco»', 'eBordo')}
            ${it(C.cabinas.length, 'bi-door-closed', `Cabinas: ${C.cabinas.length} tipo(s)`, C.cabinas.map(t => esc(t.nombre || CAT_CORTO[t.categoria])).join(' · ') || 'Sin tipos de cabina', 'eCabinas')}
            ${it(C.salidas.length, 'bi-calendar3', `Fechas: ${C.salidas.length} (${futuras.length} a la venta)`, C.salidas.length ? C.salidas.slice(0, 6).map(s => fechaCorta(s.fecha)).join(' · ') + (C.salidas.length > 6 ? ' …' : '') : 'Sin fechas', 'ePrecios', C.salidas.length && !futuras.length)}
            ${it(precios.length, 'bi-currency-dollar', `Precios: ${precios.length}`, precios.length ? `desde ${dinero(Math.min(...precios.map(p => p.precio_Pp)))} por persona${C.tarifas.length > 1 ? ` · ${C.tarifas.length} tarifas` : ''}` : 'Sin precios', 'ePrecios')}
        </div><p class="ui-help" style="margin:14px 0 0">Revisa y pulsa <b>Guardar</b>. Lo que está en gris es opcional: lo puedes completar después.</p>`;
    }

    async function guardar() {
        C.categorias = $$('[data-categoria]').filter(c => c.checked).map(c => +c.dataset.categoria);
        if (!C.titulo?.trim()) { EV.toast('Escribe el título del crucero (es lo único obligatorio).', 'err'); edTabs.ir('eDatos'); setTimeout(() => $('[data-b="titulo"]')?.focus(), 50); return; }
        if (paso !== 'eResumen') { edTabs.ir('eResumen'); return; }   // antes de guardar, siempre el resumen
        const usadas = new Set(C.precios.map(p => p.tarifa));
        const dto = { ...C, id_Barco: null, itinerario: C.itinerario.map((d, i) => ({ ...d, dia: i + 1 })), tarifas: C.tarifas.filter(f => usadas.has(f.clave) || f.codigo?.trim()) };
        const b = $('#edGuardar'), html = b.innerHTML; b.disabled = true; b.innerHTML = '<span class="ui-spin"></span> Guardando…';
        try {
            const r = await EV.post('/Cruceros/Guardar', dto);
            const subidas = await subirPendientes(r.id);
            editor.cerrar(true);
            await cargar();
            EV.toast(r.mensaje + (subidas ? ' Fotos subidas.' : '') + (C.activo ? ' Ya está en la Home.' : ''));
            EV.resaltar(document.querySelector(`.cz-card[data-id="${r.id}"]`));
        } catch (e) { EV.toast(e.message, 'err'); }
        finally { b.disabled = false; b.innerHTML = html; }
    }

    async function eliminar(id) {
        const c = D.cruceros.find(x => x.id_Crucero === id); if (!c) return;
        if (!await EV.confirmar({ titulo: '¿Eliminar el crucero?', peligro: true, si: 'Sí, eliminar', texto: `Se eliminará <b>${esc(c.titulo)}</b> con su itinerario, a bordo, cabinas, fechas, precios y fotos. No se puede deshacer.<br>Si solo quieres que no salga en la web, <b>desactívalo</b>.` })) return;
        try { const r = await EV.post('/Cruceros/Eliminar?id=' + id); EV.toast(r.mensaje); editor.cerrar(true); visor.cerrar(true); await cargar(); }
        catch (e) { EV.toast(e.message, 'err'); }
    }
    async function activar(id) {
        const c = D.cruceros.find(x => x.id_Crucero === id); if (!c) return;
        try { const r = await EV.post(`/Cruceros/Activar?id=${id}&activo=${!c.activo}`); EV.toast(r.mensaje); await cargar(); } catch (e) { EV.toast(e.message, 'err'); }
    }
    async function duplicar(id) {
        try { const r = await EV.post('/Cruceros/Duplicar?id=' + id); EV.toast(r.mensaje); visor.cerrar(true); await cargar(); abrir(r.id); } catch (e) { EV.toast(e.message, 'err'); }
    }

    // ===================== VER (como la web) =====================
    async function ver(id) {
        let c, fotos = [];
        try { c = await EV.api('/Cruceros/Obtener?id=' + id); fotos = (await EV.api(`/Multimedia/Listar?tipo=CRUCERO&clave=${id}`)).items; } catch (e) { EV.toast(e.message, 'err'); return; }
        verId = id;
        const barco = D.barcos.find(b => b.id_Barco === c.id_Barco) || { nombre: c.barco_Nombre }, nav = D.navieras.find(n => n.id_Naviera === barco.id_Naviera) || { nombre: c.naviera_Nombre };
        const nch = c.noches || 0;
        const salidas = c.salidas.map(s => ({ ...s, fecha: s.fecha.slice(0, 10) })).filter(s => s.activo && s.fecha > hoy).sort((a, b) => a.fecha.localeCompare(b.fecha));
        let sel = salidas[0]?.clave, tarSelV = c.tarifas[0]?.clave, catSel = CATS.find(k => c.cabinas.some(t => t.categoria === k));
        const banner = fotos.find(f => f.uso === 'INTERMEDIA'), gal = fotos.filter(f => f.uso !== 'INTERMEDIA').sort((a, b) => (a.uso === 'PORTADA' ? -1 : 1) - (b.uso === 'PORTADA' ? -1 : 1) || a.orden - b.orden);
        let gi = 0;
        const minPor = (s, k) => { const v = c.precios.filter(p => p.salida === s && c.cabinas.find(t => t.clave === p.cabina)?.categoria === k).map(p => p.precio_Pp); return v.length ? Math.min(...v) : null; };
        const desde = s => { const v = c.precios.filter(p => p.salida === s).map(p => p.precio_Pp); return v.length ? Math.min(...v) : null; };
        $('#verTitulo').textContent = c.titulo;
        $('#verSub').textContent = `n.º ${c.id_Crucero}${c.activo ? '' : ' · desactivado'}`;
        const pintarV = () => {
            const s = salidas.find(x => x.clave === sel);
            $('#verCuerpo').innerHTML = `
                <div class="vz-banner">${banner ? `<img src="${esc(banner.url)}" alt="">` : ''}<h2>${esc(c.titulo)}</h2></div>
                <p class="vz-sub">${esc(c.subtitulo || [s ? `Saliendo el ${fechaTxt(s.fecha)}` : '', nch ? `para ${nch} noches` : '', barco.nombre ? `a bordo del ${barco.nombre}` : ''].filter(Boolean).join(' '))}</p>
                <div class="vz-top">
                    <div class="vz-gal">${gal.length ? `<img src="${esc(gal[gi % gal.length].url)}" alt="">${gal.length > 1 ? '<button type="button" class="a" data-v="ant"><i class="bi bi-chevron-left"></i></button><button type="button" class="s" data-v="sig"><i class="bi bi-chevron-right"></i></button>' : ''}` : '<div class="ui-empty" style="margin:0;height:100%;display:grid;place-items:center">Sin fotos</div>'}</div>
                    <div><div class="vz-info">
                        <span><i class="bi bi-life-preserver"></i> ${s ? `${fechaCorta(s.fecha)}${nch ? ` al ${fechaCorta(masDias(s.fecha, nch))}` : ''}` : 'Sin fechas'}${nch ? ` (${nch} noches)` : ''}</span>
                        ${nav.nombre ? `<span><i class="bi bi-life-preserver"></i> ${esc(nav.nombre)}</span>` : ''}<span><i class="bi bi-life-preserver"></i> 2 Adultos</span>
                        ${barco.nombre ? `<span><i class="bi bi-life-preserver"></i> ${esc(barco.nombre)}</span>` : ''}
                        ${c.puerto_Salida ? `<span><i class="bi bi-life-preserver"></i> ${esc(c.puerto_Salida)} / ${esc(c.puerto_Llegada || c.puerto_Salida)}</span>` : ''}
                        ${c.codigo ? `<span><i class="bi bi-life-preserver"></i> ID de crucero: ${esc(c.codigo)}</span>` : ''}</div>
                        ${s && desde(s.clave) != null ? `<div class="vz-desde"><small>Desde</small><b>${dinero(desde(s.clave) * 2)}</b><small>${dinero(desde(s.clave))} por persona · basado en 2 personas compartiendo</small></div>` : ''}
                        ${nav.logo ? `<img src="${esc(nav.logo)}" alt="" style="max-width:180px;margin-top:10px">` : ''}</div>
                </div>
                ${c.descripcion ? `<p style="white-space:pre-line">${esc(c.descripcion)}</p>` : ''}
                <div class="vz-h">Itinerario</div>
                ${c.itinerario.length ? `<div class="ui-table-wrap"><table class="ui-table"><thead><tr><th>#</th><th>Fecha</th><th>Puerto</th><th>Llega</th><th>Sale</th></tr></thead><tbody>${c.itinerario.map(d => `<tr>
                    <td>${d.dia}</td><td>${s ? fechaCorta(masDias(s.fecha, d.dia - 1)) : '—'}</td><td><b>${esc(d.en_Navegacion ? 'En navegación' : d.puerto)}</b>${d.descripcion ? `<br><small style="color:var(--ev-muted)">${esc(d.descripcion)}</small>` : ''}</td>
                    <td>${d.hora_Llegada || '–'}</td><td>${d.hora_Salida || '–'}</td></tr>`).join('')}</tbody></table></div>` : '<p class="ui-help">Sin itinerario.</p>'}
                ${c.secciones.length ? `<div class="vz-h">${esc(c.titulo_Seccion || 'Tu barco' + (barco.nombre ? ' - ' + barco.nombre : ''))}</div>
                    ${barco.descripcion ? `<p style="white-space:pre-line;color:var(--ev-muted)">${esc(barco.descripcion)}</p>` : ''}
                    <div class="vz-tabs">${c.secciones.map((x, i) => `<button type="button" data-vsec="${i}" class="${i === 0 ? 'on' : ''}">${esc(x.titulo)}</button>`).join('')}</div>
                    <div id="vzActs"></div>` : ''}
                <div class="vz-h">Elige tus fechas de viaje</div>
                ${salidas.length ? `<div class="vz-fechas">${salidas.map(x => `<div class="vz-fecha ${x.clave === sel ? 'on' : ''}" data-vsal="${x.clave}"><b>${fechaCorta(x.fecha)}</b>${nch ? `a<b>${fechaCorta(masDias(x.fecha, nch))}</b>` : ''}
                    <table>${CATS.map(k => minPor(x.clave, k) != null ? `<tr><td>${CAT_CORTO[k]}</td><td>${dinero(minPor(x.clave, k))}</td></tr>` : '').join('')}</table></div>`).join('')}</div>` : '<p class="ui-help">Sin fechas futuras activas.</p>'}
                ${s && c.tarifas.length ? `<div class="vz-h">Elige el código de tarifa</div>
                    <div class="vz-tabs">${c.tarifas.map(f => `<button type="button" data-vtar="${f.clave}" class="${f.clave === tarSelV ? 'on' : ''}">${esc(f.nombre)}</button>`).join('')}</div>
                    <div class="vz-tabs">${CATS.filter(k => c.cabinas.some(t => t.categoria === k)).map(k => `<button type="button" data-vcat="${k}" class="${k === catSel ? 'on' : ''}">${CAT_CORTO[k]}</button>`).join('')}</div>
                    ${c.cabinas.filter(t => t.categoria === catSel).map(t => { const p = c.precios.find(x => x.salida === sel && x.tarifa === tarSelV && x.cabina === t.clave);
                        return `<div class="vz-cab">${t.imagen ? `<img src="${esc(t.imagen)}" alt="">` : '<div class="sin"></div>'}<div><b>${esc(t.nombre)}${t.codigo ? ' - ' + esc(t.codigo) : ''}</b>
                        <div style="color:var(--ev-muted);font-size:13px">${t.capacidad_Min || t.capacidad_Max ? `Capacidad: ${[t.capacidad_Min, t.capacidad_Max].filter(Boolean).join(' o ')}` : ''}${t.metros ? ` · Tamaño: ${t.metros} m²` : ''}</div>
                        ${t.descripcion ? `<div style="font-size:13px;margin-top:4px">${esc(t.descripcion)}</div>` : ''}
                        <div style="margin-top:6px"><small>Desde</small> <span class="pr">${p ? dinero(p.precio_Pp) + ' pp' : '—'}</span></div>
                        <small style="color:var(--ev-muted)">${t.cabinas.length ? 'Cabinas: ' + t.cabinas.map(k => `${esc(k.numero)}${k.cubierta ? ' (cub. ' + k.cubierta + ')' : ''}`).join(', ') : ''}${t.permite_Garantizada ? (t.cabinas.length ? ' · ' : '') + 'Garantizada' : ''}</small></div></div>`; }).join('')}` : ''}`;
            const pintarActs = i => { const x = c.secciones[i]; if (!x || !$('#vzActs')) return; $('#vzActs').innerHTML = `<div class="vz-acts">${x.actividades.map((a, j) => `<div class="vz-act" data-vact="${i}:${j}" title="Ver la descripción">${a.imagen ? `<img src="${esc(a.imagen)}" alt="">` : '<div class="sin"></div>'}<b>${esc(a.titulo)}</b><small>Leer más..</small></div>`).join('') || '<p class="ui-help">Sin actividades.</p>'}</div>`; };
            pintarActs(0);
            $('#verCuerpo').onclick = e => {
                const va = e.target.closest('[data-vact]'); if (va) { const [si, ai] = va.dataset.vact.split(':').map(Number); verActividad(c.secciones[si], ai); return; }
                const v = e.target.closest('[data-v]'), vs = e.target.closest('[data-vsec]'), vsal = e.target.closest('[data-vsal]'), vt = e.target.closest('[data-vtar]'), vc = e.target.closest('[data-vcat]');
                if (v) { gi = (gi + (v.dataset.v === 'sig' ? 1 : gal.length - 1)) % gal.length; pintarV(); }
                else if (vs) { $$('[data-vsec]').forEach(b => b.classList.toggle('on', b === vs)); pintarActs(+vs.dataset.vsec); }
                else if (vsal) { sel = vsal.dataset.vsal; pintarV(); }
                else if (vt) { tarSelV = vt.dataset.vtar; pintarV(); }
                else if (vc) { catSel = vc.dataset.vcat; pintarV(); }
            };
        };
        pintarV();
        visor.abrir();
    }

    /** Ventana con la foto grande, el título y la descripción de una actividad (con flechas para ver las demás de la sección). */
    function verActividad(sec, j) {
        document.querySelector('.vz-modal')?.remove();
        const a = sec.actividades[j], n = sec.actividades.length;
        const m = document.createElement('div'); m.className = 'vz-modal';
        m.innerHTML = `<div role="dialog" aria-modal="true" aria-label="${esc(a.titulo)}">${a.imagen ? `<img src="${esc(a.imagen)}" alt="">` : ''}
            <button type="button" class="x" data-cerrar aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            <div class="tx"><small style="color:var(--ev-muted);font-weight:700">${esc(sec.titulo)} · ${j + 1} de ${n}</small><h3>${esc(a.titulo)}</h3>
                <p>${a.descripcion ? esc(a.descripcion) : '<span style="color:var(--ev-muted)">Esta actividad todavía no tiene descripción. Ponla en Editar → A bordo.</span>'}</p></div>
            ${n > 1 ? `<div class="nav"><button type="button" class="ev-btn ghost sm" data-paso="-1"><i class="bi bi-arrow-left"></i> Anterior</button><button type="button" class="ev-btn ghost sm" data-paso="1">Siguiente <i class="bi bi-arrow-right"></i></button></div>` : ''}</div>`;
        const cerrar = () => { m.remove(); document.removeEventListener('keydown', tecla, true); };
        const tecla = e => { if (e.key === 'Escape') { e.stopImmediatePropagation(); cerrar(); } else if (e.key === 'ArrowRight' && n > 1) { cerrar(); verActividad(sec, (j + 1) % n); } else if (e.key === 'ArrowLeft' && n > 1) { cerrar(); verActividad(sec, (j + n - 1) % n); } };
        m.addEventListener('click', e => { const p = e.target.closest('[data-paso]'); if (p) { cerrar(); verActividad(sec, (j + n + +p.dataset.paso) % n); } else if (e.target === m || e.target.closest('[data-cerrar]')) cerrar(); });
        document.addEventListener('keydown', tecla, true);
        document.body.appendChild(m);
    }

    // ===================== EVENTOS =====================
    function iniciar() {
        $('#czNuevo').onclick = () => abrir(null);
        $('#czQ').addEventListener('input', EV.debounce(e => { st.q = e.target.value.trim(); pintar(); }, 200));
        $('#czNaviera').onchange = e => { st.naviera = e.target.value; pintar(); };
        $('#czCategoria').onchange = e => { st.categoria = e.target.value; pintar(); };
        $('#czOrden').onchange = e => { st.orden = e.target.value; pintar(); };
        $('#czKpis').addEventListener('click', e => { const k = e.target.closest('[data-filtro]'); if (!k) return; st.filtro = st.filtro === k.dataset.filtro ? '' : k.dataset.filtro; pintar(); });
        $('#czLista').addEventListener('click', e => {
            const card = e.target.closest('.cz-card'); if (!card) return;
            const id = +card.dataset.id, acc = e.target.closest('[data-accion]')?.dataset.accion;
            ({ ver, editar: abrir, duplicar, activar, eliminar, fotos: x => EVFotos.abrir({ tipo: 'CRUCERO', clave: x, titulo: D.cruceros.find(c => c.id_Crucero === x)?.titulo, alCambiar: EV.debounce(cargar, 400) }) })[acc]?.(id);
        });
        $('#czCats').addEventListener('click', e => {
            const n = e.target.closest('[data-cat-nuevo]'), ed = e.target.closest('[data-cat-ed]');
            if (n) abrirCat(n.dataset.catNuevo, 0); else if (ed) abrirCat(ed.dataset.catEd, +ed.dataset.id);
        });

        // ---- editor: escribir en los campos ----
        const ed = $('#edCuerpo');
        const leer = t => {
            if (t.dataset.b) {
                let v = t.type === 'checkbox' ? t.checked : t.value;
                if (t.dataset.t === 'num') v = t.value === '' ? null : Number(t.value);
                asignar(t.dataset.b, v);
                if (t.dataset.b === 'titulo') $('#edTitulo').textContent = v || 'Nuevo crucero';
                if (t.dataset.b === 'barco_Nombre') { const b = D.barcos.find(x => x.nombre.toLowerCase() === String(v).trim().toLowerCase()); if (b && !C.naviera_Nombre?.trim()) { C.naviera_Nombre = b.naviera; const n = $('[data-b="naviera_Nombre"]'); if (n) n.value = b.naviera; } }
            } else if (t.dataset.tipo) {
                const x = C.cabinas.find(k => k.clave === t.dataset.tipo);
                x[t.dataset.campo] = t.type === 'checkbox' ? t.checked : t.dataset.t === 'num' ? (t.value === '' ? null : Number(t.value)) : t.value;
            } else if (t.dataset.cab) {
                const k = C.cabinas.find(x => x.clave === t.dataset.cab).cabinas[+t.dataset.i];
                k[t.dataset.campo] = t.dataset.campo === 'cubierta' ? (t.value === '' ? null : Number(t.value)) : t.value;
            } else if (t.dataset.precio) ponerPrecio(t.dataset.precio, t.value === '' ? 0 : Number(t.value));
        };
        // input + change: las horas (type=time) avisan con uno u otro según el navegador
        ed.addEventListener('input', e => leer(e.target));
        ed.addEventListener('change', e => {
            const t = e.target;
            if (t.dataset.subirFoto && t.files[0]) { subirFoto(t.dataset.subirFoto, t.files[0], t.closest('.cz-foto')); t.value = ''; return; }
            if (t.dataset.pendSubir && t.files.length) { ponerPendientes(t.dataset.pendSubir, t.files); return; }
            if (t.id === 'prTarifa') { tarSel = t.value; pintarPrecios(); return; }
            leer(t);
            if (t.dataset.b?.endsWith('en_Navegacion')) pintarItin();
            if (t.dataset.b === 'noches') { pintarItin(); }
            if (t.dataset.tipo && t.dataset.campo === 'categoria') pintarCabinas();
            if (t.dataset.b?.startsWith('cubiertas.')) pintarCabinas();
            marcarPasos();
        });
        ed.addEventListener('keydown', e => { if (e.target.id === 'edCatNueva' && e.key === 'Enter') { e.preventDefault(); ed.querySelector('[data-cat-agregar]').click(); } });
        // arrastrar fotos a los recuadros de un crucero nuevo
        ed.addEventListener('dragover', e => { const z = e.target.closest('[data-pend]'); if (z) { e.preventDefault(); z.classList.add('sobre'); } });
        ed.addEventListener('dragleave', e => e.target.closest('[data-pend]')?.classList.remove('sobre'));
        ed.addEventListener('drop', e => { const z = e.target.closest('[data-pend]'); if (!z) return; e.preventDefault(); z.classList.remove('sobre'); ponerPendientes(z.dataset.pend, e.dataTransfer.files); });
        ed.addEventListener('click', e => {
            const cambio = () => $('#czEditor').dispatchEvent(new Event('ev-cambio'));
            const q = e.target.closest('[data-quitar-foto]');
            if (q) { e.preventDefault(); ponerFoto(q.dataset.quitarFoto, null); q.closest('.cz-foto').outerHTML = fotoHtml(q.dataset.quitarFoto, null, q.closest('.cz-foto').classList.contains('grande')); cambio(); return; }
            const pq = e.target.closest('[data-pend-quitar]');
            if (pq) { e.preventDefault(); const [u, i] = pq.dataset.pendQuitar.split(':'); if (u === 'GALERIA') P.GALERIA.splice(+i, 1); else P[u] = null; pintarFotos(); marcarPasos(); return; }
            const ir = e.target.closest('[data-ir]'); if (ir) { edTabs.ir(ir.dataset.ir); return; }
            if (e.target.closest('[data-cat-agregar]')) {
                const v = $('#edCatNueva').value.trim(); if (!v) { $('#edCatNueva').focus(); return; }
                const ya = D.categorias.find(g => g.nombre.toLowerCase() === v.toLowerCase());
                if (ya) { C.categorias = [...new Set([...$$('[data-categoria]').filter(c => c.checked).map(c => +c.dataset.categoria), ya.id_Categoria])]; }
                else if (!C.categorias_Nuevas.some(n => n.toLowerCase() === v.toLowerCase())) C.categorias_Nuevas.push(v);
                C.categorias = [...new Set([...C.categorias, ...$$('[data-categoria]').filter(c => c.checked).map(c => +c.dataset.categoria)])];
                pintarDatos(); cambio(); return;
            }
            const cq = e.target.closest('[data-cat-quitar]'); if (cq) { C.categorias = $$('[data-categoria]').filter(c => c.checked).map(c => +c.dataset.categoria); C.categorias_Nuevas.splice(+cq.dataset.catQuitar, 1); pintarDatos(); cambio(); return; }
            const b = e.target.closest('[data-it],[data-bo],[data-ca],[data-pr]'); if (!b) return;
            const i = +b.dataset.i, j = +b.dataset.j, k = b.dataset.k;
            const dia = d => ({ dia: d, puerto: '', en_Navegacion: false, hora_Llegada: '', hora_Salida: '', descripcion: '', imagen: null });
            // itinerario
            if (b.dataset.it === 'nuevo') { C.itinerario.push(dia(C.itinerario.length + 1)); pintarItin(); setTimeout(() => $$('#eItin .cz-dia').at(-1)?.querySelector('input:not([type=checkbox])')?.focus(), 50); }
            else if (b.dataset.it === 'generar') { const n = noches(); while (C.itinerario.length < n + 1) C.itinerario.push(dia(C.itinerario.length + 1)); if (C.puerto_Salida && !C.itinerario[0].puerto) C.itinerario[0].puerto = C.puerto_Salida; const u = C.itinerario[n]; if (u && !u.puerto) u.puerto = C.puerto_Llegada || C.puerto_Salida || ''; pintarItin(); }
            else if (b.dataset.it === 'quitar') { C.itinerario.splice(i, 1); pintarItin(); }
            // a bordo
            else if (b.dataset.bo === 'seccion') { C.secciones.push({ titulo: '', actividades: [] }); pintarBordo(); }
            else if (b.dataset.bo === 'base') { ['Comida y bebida', 'Entretenimiento', 'Relajación', 'Otro'].forEach(t => { if (!C.secciones.some(s => (s.titulo || '').toLowerCase() === t.toLowerCase())) C.secciones.push({ titulo: t, actividades: [] }); }); pintarBordo(); }
            else if (b.dataset.bo === 'qsec') { C.secciones.splice(i, 1); pintarBordo(); }
            else if (b.dataset.bo === 'subir') { [C.secciones[i - 1], C.secciones[i]] = [C.secciones[i], C.secciones[i - 1]]; pintarBordo(); }
            else if (b.dataset.bo === 'act') { C.secciones[i].actividades.push({ titulo: '', descripcion: '', imagen: null }); pintarBordo(); }
            else if (b.dataset.bo === 'qact') { C.secciones[i].actividades.splice(j, 1); pintarBordo(); }
            // cabinas
            else if (b.dataset.ca === 'basicos') { CATS.forEach(c => { if (!C.cabinas.some(t => t.categoria === c)) C.cabinas.push(tipoNuevo(c, CAT_CORTO[c])); }); pintarCabinas(); }
            else if (b.dataset.ca === 'tipo') { C.cabinas.push(tipoNuevo('INTERIOR', '')); pintarCabinas(); }
            else if (b.dataset.ca === 'qtipo') { C.cabinas = C.cabinas.filter(t => t.clave !== k); C.precios = C.precios.filter(p => p.cabina !== k); pintarCabinas(); }
            else if (b.dataset.ca === 'cubierta') { C.cubiertas.push({ numero: Math.max(0, ...C.cubiertas.map(u => u.numero || 0)) + 1, nombre: '', plano: null }); pintarCabinas(); }
            else if (b.dataset.ca === 'qcub') { const n = C.cubiertas[i].numero; C.cubiertas.splice(i, 1); C.cabinas.forEach(t => t.cabinas.forEach(x => { if (x.cubierta === n) x.cubierta = null; })); pintarCabinas(); }
            else if (b.dataset.ca === 'cab') { C.cabinas.find(t => t.clave === k).cabinas.push({ numero: '', cubierta: null, disponible: true }); pintarCabinas(); }
            else if (b.dataset.ca === 'qcab') { C.cabinas.find(t => t.clave === k).cabinas.splice(i, 1); pintarCabinas(); }
            // fechas, tarifas y precios
            else if (b.dataset.pr === 'fecha') {
                const f = $('#prFecha').value; if (!f) { EV.toast('Elige la fecha.', 'err'); $('#prFecha').focus(); return; }
                if (C.salidas.some(s => s.fecha === f)) { EV.toast('Esa fecha ya está.', 'err'); return; }
                C.salidas.push({ clave: nuevaClave('s'), fecha: f, activo: true }); pintarPrecios(); pintarItin();
            }
            else if (b.dataset.pr === 'serie') {
                const d = $('#prDesde').value, h = $('#prHasta').value, cada = +$('#prCada').value || 7;
                if (!d || !h || h < d) { EV.toast('Elige desde y hasta (hasta ≥ desde).', 'err'); return; }
                let n = 0; for (let f = d; f <= h && n < 200; f = masDias(f, cada)) if (!C.salidas.some(s => s.fecha === f)) { C.salidas.push({ clave: nuevaClave('s'), fecha: f, activo: true }); n++; }
                EV.toast(`${n} fecha(s) agregadas.`); pintarPrecios(); pintarItin();
            }
            else if (b.dataset.pr === 'qsal') { C.salidas = C.salidas.filter(s => s.clave !== k); C.precios = C.precios.filter(p => p.salida !== k); pintarPrecios(); }
            else if (b.dataset.pr === 'act') { const s = C.salidas.find(x => x.clave === k); s.activo = !s.activo; pintarPrecios(); }
            else if (b.dataset.pr === 'limpiar-fechas') {
                EV.confirmar({ titulo: '¿Quitar todas las fechas?', peligro: true, si: 'Sí, quitar', texto: 'Se quitan las fechas y sus precios (no se guarda hasta pulsar Guardar).' })
                    .then(ok => { if (ok) { C.salidas = []; C.precios = []; pintarPrecios(); cambio(); } });
                return;
            }
            else if (b.dataset.pr === 'tarifa') { C.tarifas.push({ clave: nuevaClave('f'), codigo: C.tarifas.length ? '' : 'BEST_PRICE', nombre: C.tarifas.length ? '' : 'BEST_PRICE', descripcion: '' }); tarSel ??= C.tarifas[0].clave; pintarPrecios(); }
            else if (b.dataset.pr === 'qtar') { const kk = C.tarifas[i].clave; C.tarifas.splice(i, 1); C.precios = C.precios.filter(p => p.tarifa !== kk); pintarPrecios(); }
            else if (b.dataset.pr === 'copiar') {
                const s0 = C.salidas[0].clave, f = tarSel;
                const base = C.precios.filter(p => p.salida === s0 && p.tarifa === f);
                if (!base.length) { EV.toast('La primera fecha no tiene precios: escríbelos primero.', 'err'); return; }
                EV.confirmar({ titulo: '¿Copiar precios?', si: 'Sí, copiar', texto: `Los precios de las otras ${C.salidas.length - 1} fecha(s) se reemplazan por los de la primera.` }).then(ok => {
                    if (!ok) return;
                    C.salidas.slice(1).forEach(s => { C.precios = C.precios.filter(p => !(p.salida === s.clave && p.tarifa === f)).concat(base.map(p => ({ ...p, salida: s.clave }))); });
                    pintarPrecios(); cambio(); EV.toast('Precios copiados a todas las fechas.');
                });
                return;
            }
            cambio(); marcarPasos();
        });
        const tipoNuevo = (categoria, nombre) => ({ clave: nuevaClave('t'), categoria, codigo: '', nombre, descripcion: '', capacidad_Min: null, capacidad_Max: null, metros: null, imagen: null, permite_Garantizada: true, cabinas: [] });

        $('#edGuardar').onclick = guardar;
        $('#edSiguiente').onclick = () => edTabs.ir(PASOS[Math.min(PASOS.length - 1, PASOS.indexOf(paso) + 1)]);
        $('#edAnterior').onclick = () => edTabs.ir(PASOS[Math.max(0, PASOS.indexOf(paso) - 1)]);
        $('#edCerrar').onclick = () => editor.cerrar();
        $('#edEliminar').onclick = () => C?.id_Crucero && eliminar(C.id_Crucero);
        $('#verCerrar').onclick = () => visor.cerrar();
        $('#verEditar').onclick = () => { visor.cerrar(true); abrir(verId); };
        $('#verDuplicar').onclick = () => verId && duplicar(verId);
        // catálogos
        $('#catCuerpo').addEventListener('change', e => { const t = e.target; if (t.dataset.subirFoto && t.files[0]) subirFoto('cat', t.files[0], t.closest('.cz-foto')); });
        $('#catCuerpo').addEventListener('click', e => { const q = e.target.closest('[data-quitar-foto]'); if (q) { e.preventDefault(); catActual.img = null; q.closest('.cz-foto').outerHTML = fotoHtml('cat', null, true); } });
        $('#catGuardar').onclick = guardarCat;
        $('#catCancelar').onclick = $('#catCerrar').onclick = () => dCat.cerrar();
        $('#catEliminar').onclick = eliminarCat;
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') { editor.cerrar(); visor.cerrar(); dCat.cerrar(); }
            if (editor.abierto() && e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); guardar(); }
        });
        cargar();
    }
    document.addEventListener('DOMContentLoaded', iniciar);
})();
</script>
}
