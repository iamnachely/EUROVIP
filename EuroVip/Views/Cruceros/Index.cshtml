                        <button type="button" class="ev-btn" data-pr="fecha"><i class="bi bi-plus-lg"></i> Agregar fecha</button></div>
                    <div class="cz-fcaja"><b><i class="bi bi-calendar-range"></i> Varias fechas de una vez</b>
                        <div class="cz-g3">
                            <label class="cz-c"><span>Desde</span><input type="date" id="prDesde" min="${hoy}"></label>
                            <label class="cz-c"><span>Hasta</span><input type="date" id="prHasta" min="${hoy}"></label>
                            <label class="cz-c"><span>Cada cuántos días</span><input type="number" id="prCada" value="7" min="1"></label>
                        </div>
                        <small class="ui-help" style="margin:0">Ej. desde 01/11 hasta 31/12 cada 7 días = una salida por semana.</small>
                        <button type="button" class="ev-btn ghost" data-pr="serie"><i class="bi bi-calendar-plus"></i> Agregar todas</button></div>
                </div>
            </div>
            <div class="cz-blq"><h3><i class="bi bi-currency-dollar"></i> Precios por persona en ${EV.simbolo()} <span class="sp"></span>
                ${C.tarifas.length > 1 ? `<label class="cz-c" style="flex-direction:row;align-items:center;gap:6px"><span>Tarifa</span><select id="prTarifa">${C.tarifas.map(f => `<option value="${f.clave}" ${f.clave === tarSel ? 'selected' : ''}>${esc(f.codigo || f.nombre || '¿?')}</option>`).join('')}</select></label>` : ''}
                ${C.salidas.length > 1 && tipos.length ? '<button type="button" class="ev-btn ghost sm" data-pr="copiar"><i class="bi bi-files"></i> Copiar la 1.ª fecha a todas</button>' : ''}</h3>
                <div class="cz-barra" style="margin-bottom:10px"><span class="cz-c" style="flex-direction:row;align-items:center;gap:8px"><span>Agregar otra columna (tipo de cabina)</span>
                    <select id="prNuevaCol"><option value="">Elige…</option>${libres.map(s => `<option value="${esc(s.n)}">${CAT_CORTO[s.k]} · ${esc(s.n)}</option>`).join('')}<option value="__otro">Otro (escribir nombre)…</option></select></span>
                    <button type="button" class="ev-btn ghost sm" data-pr="col"><i class="bi bi-plus-lg"></i> Agregar columna</button></div>
                ${!C.salidas.length ? '<p class="ui-help" style="margin:0">Agrega una fecha arriba para poner precios.</p>'
                  : !tipos.length ? '<p class="ui-help" style="margin:0">Agrega tipos de cabina: aquí arriba («Agregar otra columna») o en el paso 5.</p>'
                  : `<div style="overflow-x:auto"><table class="cz-grid"><thead><tr><th>Salida</th>${tipos.map(t => `<th style="--c:${COLOR_CAT[t.categoria]}"><small><i class="bi ${ICONO_CAT[t.categoria]}"></i> ${CAT_CORTO[t.categoria]}</small>${(t.nombre || '').trim().toLowerCase() === CAT_CORTO[t.categoria].toLowerCase() ? '' : esc(t.nombre || '')}</th>`).join('')}<th></th></tr></thead><tbody>
                     ${C.salidas.map(s => `<tr class="${s.activo ? '' : 'off'}"><td class="f">${fechaCorta(s.fecha)}${n ? ` <small style="color:var(--ev-muted);font-weight:600">→ ${fechaCorta(masDias(s.fecha, n))}</small>` : ''}${s.fecha <= hoy ? ' <small style="color:#B54708">(pasada)</small>' : ''}</td>
                        ${tipos.map(t => `<td><div class="cz-dinero"><b>${EV.simbolo()}</b><input type="number" min="0" step="0.01" data-precio="${s.clave}|${tar}|${t.clave}" value="${pr.get(`${s.clave}|${tarSel}|${t.clave}`) ?? ''}" placeholder="0"></div></td>`).join('')}
                        <td style="white-space:nowrap"><button type="button" class="ui-ibtn" data-pr="act" data-k="${s.clave}" title="${s.activo ? 'Desactivar esta fecha' : 'Activar esta fecha'}"><i class="bi ${s.activo ? 'bi-pause' : 'bi-play'}"></i></button>
                            <button type="button" class="ui-ibtn danger" data-pr="qsal" data-k="${s.clave}" title="Quitar fecha"><i class="bi bi-x-lg"></i></button></td></tr>`).join('')}
                     </tbody></table></div>`}
                ${!C.salidas.length ? '' : `<p style="margin:10px 0 0"><button type="button" class="ev-btn ghost sm" data-pr="limpiar-fechas"><i class="bi bi-trash3"></i> Quitar todas las fechas</button></p>`}
            </div>
            <details class="cz-blq cz-mas" ${C.tarifas.length > 1 ? 'open' : ''}><summary><i class="bi bi-tag"></i> Avanzado: varios códigos de tarifa ${opc} <i class="bi bi-chevron-down"></i></summary><div>
                <p class="ui-help" style="margin:0 0 10px">Si el crucero tiene un solo precio, no hace falta: se usa «BEST_PRICE». Agrega otros (ej. «Florida Resident») si la naviera da precios distintos.</p>
                ${C.tarifas.map((f, i) => `<div class="cz-g3" style="margin-bottom:6px;grid-template-columns:200px 1fr auto"><label class="cz-c"><span>Código</span>${inp(`tarifas.${i}.codigo`, 'maxlength="50" placeholder="Ej. FLRES"')}</label><label class="cz-c"><span>Nombre que se ve</span>${inp(`tarifas.${i}.nombre`, 'maxlength="100" placeholder="Ej. Florida Resident"')}</label>
                    <button type="button" class="ui-ibtn danger" data-pr="qtar" data-i="${i}" title="Quitar tarifa y sus precios" style="align-self:end"><i class="bi bi-x-lg"></i></button></div>`).join('')}
                <button type="button" class="ev-btn ghost sm" data-pr="tarifa"><i class="bi bi-plus-lg"></i> Tarifa</button>
            </div></details>`;
    }

    function ponerPrecio(k, v) {
        let [s, f, t] = k.split('|');
        if (f === 'auto') {   // primer precio sin tarifas: se crea BEST_PRICE
            if (!C.tarifas.length) C.tarifas.push({ clave: nuevaClave('f'), codigo: 'BEST_PRICE', nombre: 'BEST_PRICE', descripcion: '' });
            tarSel = C.tarifas[0].clave; f = tarSel;
            $$('[data-precio]').forEach(i => i.dataset.precio = i.dataset.precio.replace('|auto|', `|${f}|`));
        }
        C.precios = C.precios.filter(p => !(p.salida === s && p.tarifa === f && p.cabina === t));
        if (v > 0) C.precios.push({ salida: s, tarifa: f, cabina: t, precio_Pp: v });
    }

    // ---------- 7. Revisar y guardar ----------
    async function pintarResumen() {
        const it = (ok, icono, titulo, detalle, pasoIr, aviso) => `<div class="cz-res-it ${ok ? (aviso ? 'aviso' : '') : 'vacio'}"><span class="ic"><i class="bi ${ok ? (aviso ? 'bi-exclamation-triangle' : icono) : 'bi-dash-circle'}"></i></span>
            <div><b>${titulo}</b><span>${detalle}</span></div>${pasoIr ? `<button type="button" class="ev-btn ghost sm" data-ir="${pasoIr}">${ok ? 'Cambiar' : 'Agregar'}</button>` : ''}</div>`;
        const cats = [...D.categorias.filter(g => $$('[data-categoria]').some(c => c.checked && +c.dataset.categoria === g.id_Categoria)).map(g => g.nombre), ...C.categorias_Nuevas];
        const futuras = C.salidas.filter(s => s.activo && s.fecha > hoy);
        const precios = C.precios.filter(p => p.precio_Pp > 0);
        const desde = precios.filter(p => futuras.some(s => s.clave === p.salida)).map(p => p.precio_Pp);
        let fotos = P.PORTADA ? 1 : 0; fotos += P.INTERMEDIA ? 1 : 0; fotos += P.GALERIA.length;
        let fotosTxt = fotos ? `${fotos} foto(s) se subirán al guardar` : 'Sin fotos';
        if (C.id_Crucero) { try { const l = (await EV.api(`/Multimedia/Listar?tipo=CRUCERO&clave=${C.id_Crucero}`)).items; fotos = l.length; fotosTxt = l.length ? `${l.length} foto(s)${l.some(x => x.uso === 'PORTADA') ? ' · con portada' : ' · sin portada'}` : 'Sin fotos'; } catch { } }
        const nav = C.itinerario.filter(d => d.en_Navegacion).length;
        const acts = C.secciones.reduce((s, x) => s + x.actividades.length, 0);
        const n = noches();
        // Crucero NUEVO muy incompleto → se guarda Desactivado (pedido de la usuaria); con el botón se puede activar igual
        const faltan = [!desde.length && 'fechas futuras con precio', !fotos && 'fotos', !C.itinerario.length && 'itinerario', !(C.barco_Nombre || '').trim() && 'barco', !C.cabinas.length && 'cabinas'].filter(Boolean);
        const incompleto = !desde.length || faltan.length >= 3;
        if (!C.id_Crucero && incompleto && C.activo && !C._activoElegido) { C.activo = false; C._autoDesactivado = true; }
        if (!incompleto && C._autoDesactivado && !C._activoElegido) { C.activo = true; C._autoDesactivado = false; }
        const aviso = C._autoDesactivado && !C.activo
            ? `<div class="cz-home no"><i class="bi bi-pause-circle"></i><div style="flex:1">Se guardará <b>Desactivado</b> porque todavía falta: <b>${faltan.join(', ')}</b>. Así no sale a medias en la web; cuando lo completes, actívalo (paso 1 o el botón ▶ de la lista).</div>
                <button type="button" class="ev-btn sm" data-res="activar"><i class="bi bi-broadcast"></i> Activarlo igualmente</button></div>` : '';
        const home = aviso ? aviso : C.activo
            ? `<div class="cz-home ok"><i class="bi bi-house-check"></i><div>Al guardar sale en la <b>Home</b> (sección CRUCEROS) en la tarjeta <b>${esc((cats.length ? cats : ['Cruceros']).join('», «'))}</b>${desde.length ? `, con precio desde <b>${dinero(Math.min(...desde))}</b>` : ' (sin precio «desde» hasta que tenga una fecha futura con precio)'}.</div></div>`
            : `<div class="cz-home no"><i class="bi bi-eye-slash"></i><div>Está <b>desactivado</b>: se guarda pero <b>no sale</b> en la web ni en la Home. Actívalo en «Datos» si quieres que salga.</div></div>`;
        $('#eResumen').innerHTML = `${home}<div class="cz-res">
            ${it(!!C.titulo?.trim(), 'bi-type', C.titulo?.trim() ? esc(C.titulo) : 'Falta el título (obligatorio)', [C.naviera_Nombre, C.barco_Nombre].filter(Boolean).map(esc).join(' · ') || 'Sin naviera ni barco', 'eDatos', !C.titulo?.trim())}
            ${it(n || C.puerto_Salida, 'bi-signpost', n ? `${n} noches · ${n + 1} días` : 'Sin noches', [C.puerto_Salida, C.puerto_Llegada].filter(Boolean).map(esc).join(' → ') || 'Sin puertos', 'eDatos')}
            ${it(true, 'bi-tags', 'Categoría: ' + esc((cats.length ? cats : ['Cruceros (por defecto)']).join(', ')), C.categorias_Nuevas.length ? 'Las nuevas se crean al guardar' : 'Es la tarjeta de la Home donde sale', 'eDatos')}
            ${it(fotos, 'bi-images', 'Fotos', fotosTxt, 'eFotos')}
            ${it(C.itinerario.length, 'bi-signpost-2', `Itinerario: ${C.itinerario.length} día(s)`, C.itinerario.length ? `${C.itinerario.filter(d => !d.en_Navegacion).map(d => esc(d.puerto || '¿?')).join(' · ')}${nav ? ` · ${nav} en navegación` : ''}` : 'Sin itinerario', 'eItin')}
            ${it(C.secciones.length, 'bi-stars', `A bordo: ${C.secciones.length} sección(es), ${acts} actividad(es)`, C.secciones.map(s => esc(s.titulo || '¿?')).join(' · ') || 'Sin «Tu barco»', 'eBordo')}
            ${it(C.cabinas.length, 'bi-door-closed', `Cabinas: ${C.cabinas.length} tipo(s)`, C.cabinas.map(t => esc(t.nombre || CAT_CORTO[t.categoria])).join(' · ') || 'Sin tipos de cabina', 'eCabinas')}
            ${it(C.salidas.length, 'bi-calendar3', `Fechas: ${C.salidas.length} (${futuras.length} a la venta)`, C.salidas.length ? C.salidas.slice(0, 6).map(s => fechaCorta(s.fecha)).join(' · ') + (C.salidas.length > 6 ? ' …' : '') : 'Sin fechas', 'ePrecios', C.salidas.length && !futuras.length)}
            ${it(precios.length, 'bi-currency-dollar', `Precios: ${precios.length}`, precios.length ? `desde ${dinero(Math.min(...precios.map(p => p.precio_Pp)))} por persona${C.tarifas.length > 1 ? ` · ${C.tarifas.length} tarifas` : ''}` : 'Sin precios', 'ePrecios')}
        </div><p class="ui-help" style="margin:14px 0 0">Revisa y pulsa <b>Guardar</b>. Lo que está en gris es opcional: lo puedes completar después.</p>`;
    }

    async function guardar() {
        C.categorias = $$('[data-categoria]').filter(c => c.checked).map(c => +c.dataset.categoria);
        if (!C.titulo?.trim()) { EV.toast('Escribe el título del crucero (es lo único obligatorio).', 'err'); edTabs.ir('eDatos'); setTimeout(() => $('[data-b="titulo"]')?.focus(), 50); return; }
        if (paso !== 'eResumen') { edTabs.ir('eResumen'); return; }   // antes de guardar, siempre el resumen
        const usadas = new Set(C.precios.map(p => p.tarifa));
        const dto = { ...C, id_Barco: null, itinerario: C.itinerario.map((d, i) => ({ ...d, dia: i + 1 })), tarifas: C.tarifas.filter(f => usadas.has(f.clave) || f.codigo?.trim()) };
        const b = $('#edGuardar'), html = b.innerHTML; b.disabled = true; b.innerHTML = '<span class="ui-spin"></span> Guardando…';
        try {
            const r = await EV.post('/Cruceros/Guardar', dto);
            const subidas = await subirPendientes(r.id);
            editor.cerrar(true);
            await cargar();
            EV.toast(r.mensaje + (subidas ? ' Fotos subidas.' : '') + (C.activo ? ' Ya está en la Home.' : ''));
            EV.resaltar(document.querySelector(`.cz-card[data-id="${r.id}"]`));
        } catch (e) { EV.toast(e.message, 'err'); }
        finally { b.disabled = false; b.innerHTML = html; }
    }

    async function eliminar(id) {
        const c = D.cruceros.find(x => x.id_Crucero === id); if (!c) return;
        if (!await EV.confirmar({ titulo: '¿Eliminar el crucero?', peligro: true, si: 'Sí, eliminar', texto: `Se eliminará <b>${esc(c.titulo)}</b> con su itinerario, a bordo, cabinas, fechas, precios y fotos. No se puede deshacer.<br>Si solo quieres que no salga en la web, <b>desactívalo</b>.` })) return;
        try { const r = await EV.post('/Cruceros/Eliminar?id=' + id); EV.toast(r.mensaje); editor.cerrar(true); visor.cerrar(true); await cargar(); }
        catch (e) { EV.toast(e.message, 'err'); }
    }
    async function activar(id) {
        const c = D.cruceros.find(x => x.id_Crucero === id); if (!c) return;
        try { const r = await EV.post(`/Cruceros/Activar?id=${id}&activo=${!c.activo}`); EV.toast(r.mensaje); await cargar(); } catch (e) { EV.toast(e.message, 'err'); }
    }
    async function duplicar(id) {
        try { const r = await EV.post('/Cruceros/Duplicar?id=' + id); EV.toast(r.mensaje); visor.cerrar(true); await cargar(); abrir(r.id); } catch (e) { EV.toast(e.message, 'err'); }
    }

    // ===================== VER (como la web) =====================
    async function ver(id) {
        let c, fotos = [];
        try { c = await EV.api('/Cruceros/Obtener?id=' + id); fotos = (await EV.api(`/Multimedia/Listar?tipo=CRUCERO&clave=${id}`)).items; } catch (e) { EV.toast(e.message, 'err'); return; }
        verId = id;
        const barco = D.barcos.find(b => b.id_Barco === c.id_Barco) || { nombre: c.barco_Nombre }, nav = D.navieras.find(n => n.id_Naviera === barco.id_Naviera) || { nombre: c.naviera_Nombre };
        const nch = c.noches || 0;
        const salidas = c.salidas.map(s => ({ ...s, fecha: s.fecha.slice(0, 10) })).filter(s => s.activo && s.fecha > hoy).sort((a, b) => a.fecha.localeCompare(b.fecha));
        let sel = salidas[0]?.clave, tarSelV = c.tarifas[0]?.clave, catSel = CATS.find(k => c.cabinas.some(t => t.categoria === k));
        const banner = fotos.find(f => f.uso === 'INTERMEDIA'), gal = fotos.filter(f => f.uso !== 'INTERMEDIA').sort((a, b) => (a.uso === 'PORTADA' ? -1 : 1) - (b.uso === 'PORTADA' ? -1 : 1) || a.orden - b.orden);
        let gi = 0;
        const minPor = (s, k) => { const v = c.precios.filter(p => p.salida === s && c.cabinas.find(t => t.clave === p.cabina)?.categoria === k).map(p => p.precio_Pp); return v.length ? Math.min(...v) : null; };
        const desde = s => { const v = c.precios.filter(p => p.salida === s).map(p => p.precio_Pp); return v.length ? Math.min(...v) : null; };
        $('#verTitulo').textContent = c.titulo;
        $('#verSub').textContent = `n.º ${c.id_Crucero}${c.activo ? '' : ' · desactivado'}`;
        const pintarV = () => {
            const s = salidas.find(x => x.clave === sel);
            $('#verCuerpo').innerHTML = `
                <div class="vz-banner">${banner ? `<img src="${esc(banner.url)}" alt="">` : ''}<h2>${esc(c.titulo)}</h2></div>
                <p class="vz-sub">${esc(c.subtitulo || [s ? `Saliendo el ${fechaTxt(s.fecha)}` : '', nch ? `para ${nch} noches` : '', barco.nombre ? `a bordo del ${barco.nombre}` : ''].filter(Boolean).join(' '))}</p>
                <div class="vz-top">
                    <div class="vz-gal">${gal.length ? `<img src="${esc(gal[gi % gal.length].url)}" alt="">${gal.length > 1 ? '<button type="button" class="a" data-v="ant"><i class="bi bi-chevron-left"></i></button><button type="button" class="s" data-v="sig"><i class="bi bi-chevron-right"></i></button>' : ''}` : '<div class="ui-empty" style="margin:0;height:100%;display:grid;place-items:center">Sin fotos</div>'}</div>
                    <div><div class="vz-info">
                        <span><i class="bi bi-life-preserver"></i> ${s ? `${fechaCorta(s.fecha)}${nch ? ` al ${fechaCorta(masDias(s.fecha, nch))}` : ''}` : 'Sin fechas'}${nch ? ` (${nch} noches)` : ''}</span>
                        ${nav.nombre ? `<span><i class="bi bi-life-preserver"></i> ${esc(nav.nombre)}</span>` : ''}<span><i class="bi bi-life-preserver"></i> 2 Adultos</span>
                        ${barco.nombre ? `<span><i class="bi bi-life-preserver"></i> ${esc(barco.nombre)}</span>` : ''}
                        ${c.puerto_Salida ? `<span><i class="bi bi-life-preserver"></i> ${esc(c.puerto_Salida)} / ${esc(c.puerto_Llegada || c.puerto_Salida)}</span>` : ''}
                        ${c.codigo ? `<span><i class="bi bi-life-preserver"></i> ID de crucero: ${esc(c.codigo)}</span>` : ''}</div>
                        ${s && desde(s.clave) != null ? `<div class="vz-desde"><small>Desde</small><b>${dinero(desde(s.clave) * 2)}</b><small>${dinero(desde(s.clave))} por persona · basado en 2 personas compartiendo</small></div>` : ''}
                        ${nav.logo ? `<img src="${esc(nav.logo)}" alt="" style="max-width:180px;margin-top:10px">` : ''}</div>
                </div>
                ${c.descripcion ? `<p style="white-space:pre-line">${esc(c.descripcion)}</p>` : ''}
                <div class="vz-h">Itinerario</div>
                ${c.itinerario.length ? `<div class="ui-table-wrap"><table class="ui-table"><thead><tr><th>#</th><th>Fecha</th><th>Puerto</th><th>Llega</th><th>Sale</th></tr></thead><tbody>${c.itinerario.map(d => `<tr>
                    <td>${d.dia}</td><td>${s ? fechaCorta(masDias(s.fecha, d.dia - 1)) : '—'}</td><td><b>${esc(d.en_Navegacion ? 'En navegación' : d.puerto)}</b>${d.descripcion ? `<br><small style="color:var(--ev-muted)">${esc(d.descripcion)}</small>` : ''}</td>
                    <td>${d.hora_Llegada || '–'}</td><td>${d.hora_Salida || '–'}</td></tr>`).join('')}</tbody></table></div>` : '<p class="ui-help">Sin itinerario.</p>'}
                ${c.secciones.length ? `<div class="vz-h">${esc(c.titulo_Seccion || 'Tu barco' + (barco.nombre ? ' - ' + barco.nombre : ''))}</div>
                    ${barco.descripcion ? `<p style="white-space:pre-line;color:var(--ev-muted)">${esc(barco.descripcion)}</p>` : ''}
                    <div class="vz-tabs">${c.secciones.map((x, i) => `<button type="button" data-vsec="${i}" class="${i === 0 ? 'on' : ''}">${esc(x.titulo)}</button>`).join('')}</div>
                    <div id="vzActs"></div>` : ''}
                <div class="vz-h">Elige tus fechas de viaje</div>
                ${salidas.length ? `<div class="vz-fechas">${salidas.map(x => `<div class="vz-fecha ${x.clave === sel ? 'on' : ''}" data-vsal="${x.clave}"><b>${fechaCorta(x.fecha)}</b>${nch ? `a<b>${fechaCorta(masDias(x.fecha, nch))}</b>` : ''}
                    <table>${CATS.map(k => minPor(x.clave, k) != null ? `<tr><td>${CAT_CORTO[k]}</td><td>${dinero(minPor(x.clave, k))}</td></tr>` : '').join('')}</table></div>`).join('')}</div>` : '<p class="ui-help">Sin fechas futuras activas.</p>'}
                ${s && c.tarifas.length ? `<div class="vz-h">Elige el código de tarifa</div>
                    <div class="vz-tabs">${c.tarifas.map(f => `<button type="button" data-vtar="${f.clave}" class="${f.clave === tarSelV ? 'on' : ''}">${esc(f.nombre)}</button>`).join('')}</div>
                    <div class="vz-tabs">${CATS.filter(k => c.cabinas.some(t => t.categoria === k)).map(k => `<button type="button" data-vcat="${k}" class="${k === catSel ? 'on' : ''}">${CAT_CORTO[k]}</button>`).join('')}</div>
                    ${c.cabinas.filter(t => t.categoria === catSel).map(t => { const p = c.precios.find(x => x.salida === sel && x.tarifa === tarSelV && x.cabina === t.clave);
                        return `<div class="vz-cab">${t.imagen ? `<img src="${esc(t.imagen)}" alt="">` : '<div class="sin"></div>'}<div><b>${esc(t.nombre)}${t.codigo ? ' - ' + esc(t.codigo) : ''}</b>
                        <div style="color:var(--ev-muted);font-size:13px">${t.capacidad_Min || t.capacidad_Max ? `Capacidad: ${[t.capacidad_Min, t.capacidad_Max].filter(Boolean).join(' o ')}` : ''}${t.metros ? ` · Tamaño: ${t.metros} m²` : ''}</div>
                        ${t.descripcion ? `<div style="font-size:13px;margin-top:4px">${esc(t.descripcion)}</div>` : ''}
                        <div style="margin-top:6px"><small>Desde</small> <span class="pr">${p ? dinero(p.precio_Pp) + ' pp' : '—'}</span></div>
                        <small style="color:var(--ev-muted)">${t.cabinas.length ? 'Cabinas: ' + t.cabinas.map(k => `${esc(k.numero)}${k.cubierta ? ' (cub. ' + k.cubierta + ')' : ''}`).join(', ') : ''}${t.permite_Garantizada ? (t.cabinas.length ? ' · ' : '') + 'Garantizada' : ''}</small></div></div>`; }).join('')}` : ''}`;
            const pintarActs = i => { const x = c.secciones[i]; if (!x || !$('#vzActs')) return; $('#vzActs').innerHTML = `<div class="vz-acts">${x.actividades.map((a, j) => `<div class="vz-act" data-vact="${i}:${j}" title="Ver la descripción">${a.imagen ? `<img src="${esc(a.imagen)}" alt="">` : '<div class="sin"></div>'}<b>${esc(a.titulo)}</b><small>Leer más..</small></div>`).join('') || '<p class="ui-help">Sin actividades.</p>'}</div>`; };
            pintarActs(0);
            $('#verCuerpo').onclick = e => {
                const va = e.target.closest('[data-vact]'); if (va) { const [si, ai] = va.dataset.vact.split(':').map(Number); verActividad(c.secciones[si], ai); return; }
                const v = e.target.closest('[data-v]'), vs = e.target.closest('[data-vsec]'), vsal = e.target.closest('[data-vsal]'), vt = e.target.closest('[data-vtar]'), vc = e.target.closest('[data-vcat]');
                if (v) { gi = (gi + (v.dataset.v === 'sig' ? 1 : gal.length - 1)) % gal.length; pintarV(); }
                else if (vs) { $$('[data-vsec]').forEach(b => b.classList.toggle('on', b === vs)); pintarActs(+vs.dataset.vsec); }
                else if (vsal) { sel = vsal.dataset.vsal; pintarV(); }
                else if (vt) { tarSelV = vt.dataset.vtar; pintarV(); }
                else if (vc) { catSel = vc.dataset.vcat; pintarV(); }
            };
        };
        pintarV();
        visor.abrir();
    }

    /** Ventana con la foto grande, el título y la descripción de una actividad (con flechas para ver las demás de la sección). */
    function verActividad(sec, j) {
        document.querySelector('.vz-modal')?.remove();
        const a = sec.actividades[j], n = sec.actividades.length;
        const m = document.createElement('div'); m.className = 'vz-modal';
        m.innerHTML = `<div role="dialog" aria-modal="true" aria-label="${esc(a.titulo)}">${a.imagen ? `<img src="${esc(a.imagen)}" alt="">` : ''}
            <button type="button" class="x" data-cerrar aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            <div class="tx"><small style="color:var(--ev-muted);font-weight:700">${esc(sec.titulo)} · ${j + 1} de ${n}</small><h3>${esc(a.titulo)}</h3>
                <p>${a.descripcion ? esc(a.descripcion) : '<span style="color:var(--ev-muted)">Esta actividad todavía no tiene descripción. Ponla en Editar → A bordo.</span>'}</p></div>
            ${n > 1 ? `<div class="nav"><button type="button" class="ev-btn ghost sm" data-paso="-1"><i class="bi bi-arrow-left"></i> Anterior</button><button type="button" class="ev-btn ghost sm" data-paso="1">Siguiente <i class="bi bi-arrow-right"></i></button></div>` : ''}</div>`;
        const cerrar = () => { m.remove(); document.removeEventListener('keydown', tecla, true); };
        const tecla = e => { if (e.key === 'Escape') { e.stopImmediatePropagation(); cerrar(); } else if (e.key === 'ArrowRight' && n > 1) { cerrar(); verActividad(sec, (j + 1) % n); } else if (e.key === 'ArrowLeft' && n > 1) { cerrar(); verActividad(sec, (j + n - 1) % n); } };
        m.addEventListener('click', e => { const p = e.target.closest('[data-paso]'); if (p) { cerrar(); verActividad(sec, (j + n + +p.dataset.paso) % n); } else if (e.target === m || e.target.closest('[data-cerrar]')) cerrar(); });
        document.addEventListener('keydown', tecla, true);
        document.body.appendChild(m);
    }

    // ===================== EVENTOS =====================
    function iniciar() {
        $('#czNuevo').onclick = () => abrir(null);
        $('#czQ').addEventListener('input', EV.debounce(e => { st.q = e.target.value.trim(); pintar(); }, 200));
        $('#czNaviera').onchange = e => { st.naviera = e.target.value; pintar(); };
        $('#czCategoria').onchange = e => { st.categoria = e.target.value; pintar(); };
        $('#czOrden').onchange = e => { st.orden = e.target.value; pintar(); };
        $('#czKpis').addEventListener('click', e => { const k = e.target.closest('[data-filtro]'); if (!k) return; st.filtro = st.filtro === k.dataset.filtro ? '' : k.dataset.filtro; pintar(); });
        $('#czLista').addEventListener('click', e => {
            const card = e.target.closest('.cz-card'); if (!card) return;
            const id = +card.dataset.id, acc = e.target.closest('[data-accion]')?.dataset.accion;
            ({ ver, editar: abrir, duplicar, activar, eliminar, fotos: x => EVFotos.abrir({ tipo: 'CRUCERO', clave: x, titulo: D.cruceros.find(c => c.id_Crucero === x)?.titulo, alCambiar: EV.debounce(cargar, 400) }) })[acc]?.(id);
        });
        $('#czCats').addEventListener('click', e => {
            const n = e.target.closest('[data-cat-nuevo]'), ed = e.target.closest('[data-cat-ed]');
            if (n) abrirCat(n.dataset.catNuevo, 0); else if (ed) abrirCat(ed.dataset.catEd, +ed.dataset.id);
        });

        // ---- editor: escribir en los campos ----
        const ed = $('#edCuerpo');
        const leer = t => {
            if (t.dataset.b) {
                let v = t.type === 'checkbox' ? t.checked : t.value;
                if (t.dataset.t === 'num') v = t.value === '' ? null : Number(t.value);
                asignar(t.dataset.b, v);
                if (t.dataset.b === 'titulo') $('#edTitulo').textContent = v || 'Nuevo crucero';
                if (t.dataset.b === 'activo') C._activoElegido = true;   // la usuaria eligió: ya no se cambia solo
                if (t.dataset.b === 'barco_Nombre') { const b = D.barcos.find(x => x.nombre.toLowerCase() === String(v).trim().toLowerCase()); if (b && !C.naviera_Nombre?.trim()) { C.naviera_Nombre = b.naviera; const n = $('[data-b="naviera_Nombre"]'); if (n) n.value = b.naviera; } }
            } else if (t.dataset.tipo) {
                const x = C.cabinas.find(k => k.clave === t.dataset.tipo);
                x[t.dataset.campo] = t.type === 'checkbox' ? t.checked : t.dataset.t === 'num' ? (t.value === '' ? null : Number(t.value)) : t.value;
            } else if (t.dataset.cab) {
                const k = C.cabinas.find(x => x.clave === t.dataset.cab).cabinas[+t.dataset.i];
                k[t.dataset.campo] = t.dataset.campo === 'cubierta' ? (t.value === '' ? null : Number(t.value)) : t.value;
            } else if (t.dataset.precio) ponerPrecio(t.dataset.precio, t.value === '' ? 0 : Number(t.value));
        };
        // input + change: las horas (type=time) avisan con uno u otro según el navegador
        ed.addEventListener('input', e => leer(e.target));
        ed.addEventListener('change', e => {
            const t = e.target;
            if (t.dataset.subirFoto && t.files[0]) { subirFoto(t.dataset.subirFoto, t.files[0], t.closest('.cz-foto')); t.value = ''; return; }
            if (t.dataset.pendSubir && t.files.length) { ponerPendientes(t.dataset.pendSubir, t.files); return; }
            if (t.id === 'prTarifa') { tarSel = t.value; pintarPrecios(); return; }
            leer(t);
            if (t.dataset.b?.endsWith('en_Navegacion')) pintarItin();
            if (t.dataset.b === 'noches') { pintarItin(); }
            if (t.dataset.tipo && (t.dataset.campo === 'categoria' || t.dataset.campo === 'permite_Garantizada')) { pintarCabinas(); pintarPrecios(); }
            if (t.dataset.b?.startsWith('cubiertas.')) pintarCabinas();
            marcarPasos();
        });
        ed.addEventListener('keydown', e => { if (e.target.id === 'edCatNueva' && e.key === 'Enter') { e.preventDefault(); ed.querySelector('[data-cat-agregar]').click(); } });
        // arrastrar fotos a los recuadros de un crucero nuevo
        ed.addEventListener('dragover', e => { const z = e.target.closest('[data-pend]'); if (z) { e.preventDefault(); z.classList.add('sobre'); } });
        ed.addEventListener('dragleave', e => e.target.closest('[data-pend]')?.classList.remove('sobre'));
        ed.addEventListener('drop', e => { const z = e.target.closest('[data-pend]'); if (!z) return; e.preventDefault(); z.classList.remove('sobre'); ponerPendientes(z.dataset.pend, e.dataTransfer.files); });
        ed.addEventListener('click', e => {
            const cambio = () => $('#czEditor').dispatchEvent(new Event('ev-cambio'));
            const q = e.target.closest('[data-quitar-foto]');
            if (q) { e.preventDefault(); ponerFoto(q.dataset.quitarFoto, null); q.closest('.cz-foto').outerHTML = fotoHtml(q.dataset.quitarFoto, null, q.closest('.cz-foto').classList.contains('grande')); cambio(); return; }
            const pq = e.target.closest('[data-pend-quitar]');
            if (pq) { e.preventDefault(); const [u, i] = pq.dataset.pendQuitar.split(':'); if (u === 'GALERIA') P.GALERIA.splice(+i, 1); else P[u] = null; pintarFotos(); marcarPasos(); return; }
            const ir = e.target.closest('[data-ir]'); if (ir) { edTabs.ir(ir.dataset.ir); return; }
            if (e.target.closest('[data-res="activar"]')) { C.activo = true; C._activoElegido = true; C._autoDesactivado = false; pintarResumen(); pintarDatos(); return; }
            if (e.target.closest('[data-cat-agregar]')) {
                const v = $('#edCatNueva').value.trim(); if (!v) { $('#edCatNueva').focus(); return; }
                const ya = D.categorias.find(g => g.nombre.toLowerCase() === v.toLowerCase());
                if (ya) { C.categorias = [...new Set([...$$('[data-categoria]').filter(c => c.checked).map(c => +c.dataset.categoria), ya.id_Categoria])]; }
                else if (!C.categorias_Nuevas.some(n => n.toLowerCase() === v.toLowerCase())) C.categorias_Nuevas.push(v);
                C.categorias = [...new Set([...C.categorias, ...$$('[data-categoria]').filter(c => c.checked).map(c => +c.dataset.categoria)])];
                pintarDatos(); cambio(); return;
            }
            const cq = e.target.closest('[data-cat-quitar]'); if (cq) { C.categorias = $$('[data-categoria]').filter(c => c.checked).map(c => +c.dataset.categoria); C.categorias_Nuevas.splice(+cq.dataset.catQuitar, 1); pintarDatos(); cambio(); return; }
            const b = e.target.closest('[data-it],[data-bo],[data-ca],[data-pr]'); if (!b) return;
            const i = +b.dataset.i, j = +b.dataset.j, k = b.dataset.k;
            const dia = d => ({ dia: d, puerto: '', en_Navegacion: false, hora_Llegada: '', hora_Salida: '', descripcion: '', imagen: null });
            // itinerario
            if (b.dataset.it === 'nuevo') { C.itinerario.push(dia(C.itinerario.length + 1)); pintarItin(); setTimeout(() => $$('#eItin .cz-dia').at(-1)?.querySelector('input:not([type=checkbox])')?.focus(), 50); }
            else if (b.dataset.it === 'generar') { const n = noches(); while (C.itinerario.length < n + 1) C.itinerario.push(dia(C.itinerario.length + 1)); if (C.puerto_Salida && !C.itinerario[0].puerto) C.itinerario[0].puerto = C.puerto_Salida; const u = C.itinerario[n]; if (u && !u.puerto) u.puerto = C.puerto_Llegada || C.puerto_Salida || ''; pintarItin(); }
            else if (b.dataset.it === 'quitar') { C.itinerario.splice(i, 1); pintarItin(); }
            else if (b.dataset.it === 'mar' || b.dataset.it === 'puerto') { C.itinerario[i].en_Navegacion = b.dataset.it === 'mar'; pintarItin(); }
            else if (b.dataset.it === 'arriba' || b.dataset.it === 'abajo') { const j2 = b.dataset.it === 'arriba' ? i - 1 : i + 1; [C.itinerario[i], C.itinerario[j2]] = [C.itinerario[j2], C.itinerario[i]]; pintarItin(); }
            else if (b.dataset.it === 'insertar') { C.itinerario.splice(i + 1, 0, dia(i + 2)); pintarItin(); }
            // a bordo
            else if (b.dataset.bo === 'seccion') { C.secciones.push({ titulo: '', actividades: [] }); pintarBordo(); }
            else if (b.dataset.bo === 'base') { ['Comida y bebida', 'Entretenimiento', 'Relajación', 'Otro'].forEach(t => { if (!C.secciones.some(s => (s.titulo || '').toLowerCase() === t.toLowerCase())) C.secciones.push({ titulo: t, actividades: [] }); }); pintarBordo(); }
            else if (b.dataset.bo === 'qsec') { C.secciones.splice(i, 1); pintarBordo(); }
            else if (b.dataset.bo === 'subir') { [C.secciones[i - 1], C.secciones[i]] = [C.secciones[i], C.secciones[i - 1]]; pintarBordo(); }
            else if (b.dataset.bo === 'act') { C.secciones[i].actividades.push({ titulo: '', descripcion: '', imagen: null }); pintarBordo(); }
            else if (b.dataset.bo === 'qact') { C.secciones[i].actividades.splice(j, 1); pintarBordo(); }
            else if (b.dataset.bo === 'sug') { C.secciones.push({ titulo: b.dataset.t, actividades: [] }); pintarBordo(); }
            else if (b.dataset.bo === 'sugact') { C.secciones[i].actividades.push({ titulo: b.dataset.t, descripcion: '', imagen: null }); pintarBordo(); }
            // cabinas
            else if (b.dataset.ca === 'sug') { const s = CABINAS_SUG.find(x => x.n === b.dataset.n); if (s) C.cabinas.push({ ...tipoNuevo(s.k, s.n), capacidad_Min: s.min, capacidad_Max: s.max, metros: s.m }); pintarCabinas(); pintarPrecios(); }
            else if (b.dataset.ca === 'basicos') { CATS.forEach(c => { if (!C.cabinas.some(t => t.categoria === c)) C.cabinas.push(tipoNuevo(c, CAT_CORTO[c])); }); pintarCabinas(); }
            else if (b.dataset.ca === 'tipo') { C.cabinas.push(tipoNuevo('INTERIOR', '')); pintarCabinas(); }
            else if (b.dataset.ca === 'qtipo') { C.cabinas = C.cabinas.filter(t => t.clave !== k); C.precios = C.precios.filter(p => p.cabina !== k); pintarCabinas(); }
            else if (b.dataset.ca === 'cubierta') { C.cubiertas.push({ numero: Math.max(0, ...C.cubiertas.map(u => u.numero || 0)) + 1, nombre: '', plano: null }); pintarCabinas(); }
            else if (b.dataset.ca === 'qcub') { const n = C.cubiertas[i].numero; C.cubiertas.splice(i, 1); C.cabinas.forEach(t => t.cabinas.forEach(x => { if (x.cubierta === n) x.cubierta = null; })); pintarCabinas(); }
            else if (b.dataset.ca === 'cab') { C.cabinas.find(t => t.clave === k).cabinas.push({ numero: '', cubierta: null, disponible: true }); pintarCabinas(); }
            else if (b.dataset.ca === 'qcab') { C.cabinas.find(t => t.clave === k).cabinas.splice(i, 1); pintarCabinas(); }
            // fechas, tarifas y precios
            else if (b.dataset.pr === 'col') {
                const v = $('#prNuevaCol').value;
                if (!v) { EV.toast('Elige qué tipo de cabina agregar.', 'err'); return; }
                if (v === '__otro') {
                    EV.pedir({ titulo: 'Otro tipo de cabina', etiqueta: 'Nombre (ej. Yacht Club, Haven, Spa Suite…)', maxlength: 150, si: 'Agregar' }).then(nom => {
                        if (!nom?.trim()) return;
                        C.cabinas.push(tipoNuevo('SUITE', nom.trim())); pintarCabinas(); pintarPrecios(); cambio();
                        EV.toast('Columna agregada. En el paso 5 puedes cambiar su grupo (Interior, Exterior, Balcón o Suite) y sus datos.');
                    });
                    return;
                }
                const s = CABINAS_SUG.find(x => x.n === v);
                C.cabinas.push({ ...tipoNuevo(s.k, s.n), capacidad_Min: s.min, capacidad_Max: s.max, metros: s.m }); pintarCabinas(); pintarPrecios();
            }
            else if (b.dataset.pr === 'fecha') {
                const f = $('#prFecha').value; if (!f) { EV.toast('Elige la fecha.', 'err'); $('#prFecha').focus(); return; }
                if (C.salidas.some(s => s.fecha === f)) { EV.toast('Esa fecha ya está.', 'err'); return; }
                C.salidas.push({ clave: nuevaClave('s'), fecha: f, activo: true }); pintarPrecios(); pintarItin();
            }
            else if (b.dataset.pr === 'serie') {
                const d = $('#prDesde').value, h = $('#prHasta').value, cada = +$('#prCada').value || 7;
                if (!d || !h || h < d) { EV.toast('Elige desde y hasta (hasta ≥ desde).', 'err'); return; }
                let n = 0; for (let f = d; f <= h && n < 200; f = masDias(f, cada)) if (!C.salidas.some(s => s.fecha === f)) { C.salidas.push({ clave: nuevaClave('s'), fecha: f, activo: true }); n++; }
                EV.toast(`${n} fecha(s) agregadas.`); pintarPrecios(); pintarItin();
            }
            else if (b.dataset.pr === 'qsal') { C.salidas = C.salidas.filter(s => s.clave !== k); C.precios = C.precios.filter(p => p.salida !== k); pintarPrecios(); }
            else if (b.dataset.pr === 'act') { const s = C.salidas.find(x => x.clave === k); s.activo = !s.activo; pintarPrecios(); }
            else if (b.dataset.pr === 'limpiar-fechas') {
                EV.confirmar({ titulo: '¿Quitar todas las fechas?', peligro: true, si: 'Sí, quitar', texto: 'Se quitan las fechas y sus precios (no se guarda hasta pulsar Guardar).' })
                    .then(ok => { if (ok) { C.salidas = []; C.precios = []; pintarPrecios(); cambio(); } });
                return;
            }
            else if (b.dataset.pr === 'tarifa') { C.tarifas.push({ clave: nuevaClave('f'), codigo: C.tarifas.length ? '' : 'BEST_PRICE', nombre: C.tarifas.length ? '' : 'BEST_PRICE', descripcion: '' }); tarSel ??= C.tarifas[0].clave; pintarPrecios(); }
            else if (b.dataset.pr === 'qtar') { const kk = C.tarifas[i].clave; C.tarifas.splice(i, 1); C.precios = C.precios.filter(p => p.tarifa !== kk); pintarPrecios(); }
            else if (b.dataset.pr === 'copiar') {
                const s0 = C.salidas[0].clave, f = tarSel;
                const base = C.precios.filter(p => p.salida === s0 && p.tarifa === f);
                if (!base.length) { EV.toast('La primera fecha no tiene precios: escríbelos primero.', 'err'); return; }
                EV.confirmar({ titulo: '¿Copiar precios?', si: 'Sí, copiar', texto: `Los precios de las otras ${C.salidas.length - 1} fecha(s) se reemplazan por los de la primera.` }).then(ok => {
                    if (!ok) return;
                    C.salidas.slice(1).forEach(s => { C.precios = C.precios.filter(p => !(p.salida === s.clave && p.tarifa === f)).concat(base.map(p => ({ ...p, salida: s.clave }))); });
                    pintarPrecios(); cambio(); EV.toast('Precios copiados a todas las fechas.');
                });
                return;
            }
            cambio(); marcarPasos();
        });
        const tipoNuevo = (categoria, nombre) => ({ clave: nuevaClave('t'), categoria, codigo: '', nombre, descripcion: '', capacidad_Min: null, capacidad_Max: null, metros: null, imagen: null, permite_Garantizada: true, cabinas: [] });

        $('#edGuardar').onclick = guardar;
        $('#edSiguiente').onclick = () => edTabs.ir(PASOS[Math.min(PASOS.length - 1, PASOS.indexOf(paso) + 1)]);
        $('#edAnterior').onclick = () => edTabs.ir(PASOS[Math.max(0, PASOS.indexOf(paso) - 1)]);
        $('#edCerrar').onclick = () => editor.cerrar();
        $('#edEliminar').onclick = () => C?.id_Crucero && eliminar(C.id_Crucero);
        $('#verCerrar').onclick = () => visor.cerrar();
        $('#verEditar').onclick = () => { visor.cerrar(true); abrir(verId); };
        $('#verDuplicar').onclick = () => verId && duplicar(verId);
        // catálogos
        $('#catCuerpo').addEventListener('change', e => { const t = e.target; if (t.dataset.subirFoto && t.files[0]) subirFoto('cat', t.files[0], t.closest('.cz-foto')); });
        $('#catCuerpo').addEventListener('click', e => { const q = e.target.closest('[data-quitar-foto]'); if (q) { e.preventDefault(); catActual.img = null; q.closest('.cz-foto').outerHTML = fotoHtml('cat', null, true); } });
        $('#catGuardar').onclick = guardarCat;
        $('#catCancelar').onclick = $('#catCerrar').onclick = () => dCat.cerrar();
        $('#catEliminar').onclick = eliminarCat;
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') { editor.cerrar(); visor.cerrar(); dCat.cerrar(); }
            if (editor.abierto() && e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); guardar(); }
        });
        cargar();
    }
    document.addEventListener('DOMContentLoaded', iniciar);
})();
</script>
}
