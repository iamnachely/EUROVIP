            <label><input type="file" accept="image/jpeg,image/png,image/webp" data-rep="${d}" hidden><i class="bi bi-arrow-repeat"></i> Reemplazar</label></div>`;
        $('#sdForm').innerHTML = `
            <div class="ui-sec"><div class="ui-sec-t"><span><i class="bi bi-display"></i></span> Imágenes <small>mismo nombre de archivo en las 3 carpetas</small></div>
                <div class="cr-vistas">${vista('web', 'Web')}${vista('tablet', 'Tablet')}${vista('movil', 'Móvil')}</div></div>
            <div class="ui-sec"><div class="ui-sec-t"><span>1</span> Datos del slide</div>
                <div class="ui-row r3">
                    <div class="ui-f"><label>Orientación</label><select id="sOri"><option value="H">Horizontal</option><option value="V">Vertical</option></select></div>
                    <div class="ui-f" style="grid-column:span 2"><label>Enlace al pulsar <em>opcional</em></label><input id="sUrl" maxlength="500" placeholder="https://… o /ruta-de-la-web" value="${esc(s.url || '')}"></div>
                </div>
                <label class="ui-switch"><input type="checkbox" id="sAct" ${s.activo ? 'checked' : ''}><span class="tr"></span> Activo (sale en la web)</label></div>
            <div class="ui-sec"><div class="ui-sec-t"><span>2</span> Precio "desde" que muestra el slide <small>se puede recalcular con lo que hay a la venta</small></div>
                <div id="sPrecios"></div>
                <div class="hb-form" style="padding:14px;border-radius:16px;background:var(--ev-grad-soft);border:1px solid var(--ev-line);margin-top:10px">
                    <b style="display:block;margin-bottom:8px"><i class="bi bi-plus-circle"></i> Agregar precio</b>
                    <div class="ui-f" style="margin-bottom:8px"><label>Tomarlo de una tarjeta de la Home <em>opcional, llena todo solo</em></label><select id="sDesdeHome"><option value="">— Elige una tarjeta —</option>${todas().filter(t => t.tipo_Servicio !== 'HOTEL').map(t => `<option value="${t.id}">${esc(t.id_Destino)} desde ${esc(t.origen)} · ${esc(t.campanya || t.id_Campanya)}${t.precioWeb ? ' · ' + EV.dinero(t.precioWeb) : ''}</option>`).join('')}</select></div>
                    <div class="cr-dest">
                        <div class="ui-f"><label>Origen</label><input id="pOri" placeholder="Madrid"></div>
                        <div class="ui-f"><label>Destino</label><input id="pDes" placeholder="Punta Cana"></div>
                        <div class="ui-f"><label>Campaña</label><select id="pCam">${cat.campanyas.map(c => `<option value="${esc(c.valor)}">${esc(c.texto)}</option>`).join('')}</select></div>
                        <div class="ui-f"><label>Régimen</label><select id="pReg"><option value="">Cualquiera</option>${cat.regimenes.map(r => `<option value="${esc(r.texto)}">${esc(r.texto)}</option>`).join('')}</select></div>
                        <div class="ui-f"><label>Precio</label><div class="ui-money"><b>RD$</b><input id="pPre" type="number" min="0" step="1"></div></div>
                        <div style="display:flex;gap:6px"><button type="button" class="ev-btn ghost sm" id="pCalc" title="Calcular con las ofertas a la venta"><i class="bi bi-calculator"></i></button><button type="button" class="ev-btn sm" id="pAdd"><i class="bi bi-plus-lg"></i></button></div>
                    </div></div></div>`;
        $('#sOri').value = s.orientacion === 'V' ? 'V' : 'H';
        const gen = cat.campanyas.find(c => c.texto === 'DTGeneral'); if (gen) $('#pCam').value = gen.valor;
        pintarPrecios();
        EV.picker($('#pOri'), { url: q => `/Circuitos/Destinos?pais=ES&q=${q}`, limpiar: false, map: x => ({ valor: x.valor, texto: x.texto, icono: 'bi-geo' }), onSelect: m => $('#pOri').value = m.valor });
        EV.picker($('#pDes'), { url: q => `/Circuitos/Destinos?q=${q}`, limpiar: false, map: x => ({ valor: x.valor, texto: x.texto, sub: x.extra, icono: 'bi-geo-alt' }), onSelect: m => $('#pDes').value = m.valor });
        $('#sDesdeHome').onchange = e => { const t = todas().find(x => x.id === +e.target.value); if (!t) return; $('#pOri').value = t.origen; $('#pDes').value = t.id_Destino; $('#pCam').value = String(t.id_Campanya); if (t.precioWeb) $('#pPre').value = Math.round(t.precioWeb); };
        $('#pCalc').onclick = async () => {
            if (!$('#pOri').value || !$('#pDes').value) { EV.toast('Elige origen y destino.', 'err'); return; }
            const r = await EV.api(`/HomeWeb/PrecioMinimo?origen=${encodeURIComponent($('#pOri').value)}&destino=${encodeURIComponent($('#pDes').value)}&campanya=${$('#pCam').value}&regimen=${encodeURIComponent($('#pReg').value)}`);
            if (r.precio) { $('#pPre').value = Math.round(r.precio); EV.toast(`Precio más bajo a la venta: ${EV.dinero(r.precio)}`); } else EV.toast('No hay ofertas a la venta con esos datos.', 'info');
        };
        $('#pAdd').onclick = async () => {
            const dto = { Id_Carrusel: s.id_Carrusel, Origen: $('#pOri').value.trim(), Destino: $('#pDes').value.trim(), Id_Campanya: +$('#pCam').value, Regimen: $('#pReg').value || null, Precio: +$('#pPre').value || 0 };
            if (!dto.Origen || !dto.Destino) { EV.toast('Elige origen y destino.', 'err'); return; }
            try { const r = await EV.post('/HomeWeb/SlideDestino', dto); s.destinos.push({ ...dto, id: r.id, origen: dto.Origen, destino: dto.Destino, precio: dto.Precio, id_Campanya: dto.Id_Campanya, regimen: dto.Regimen }); pintarPrecios(); pintarCarrusel(); EV.toast(r.mensaje); $('#pPre').value = ''; }
            catch (e) { EV.toast(e.message, 'err'); }
        };
        $$('[data-rep]', $('#sdForm')).forEach(inp => inp.onchange = async () => {
            const f = inp.files[0]; if (!f) return;
            const fd = new FormData(); fd.append('id', s.id_Carrusel); fd.append(inp.dataset.rep, f);
            try { const r = await EV.post('/HomeWeb/ImagenesSlide', fd); EV.toast(r.mensaje); const im = inp.closest('.cr-vista').querySelector('.im'); im.innerHTML = `<img src="${URL.createObjectURL(f)}" alt="">`; await cargar(); }
            catch (e) { EV.toast(e.message, 'err'); }
        });
        dS.abrir();
    }

    function pintarPrecios() {
        const s = slideActual;
        $('#sPrecios').innerHTML = !s.destinos.length ? '<div class="ui-help">Este slide no muestra precio. Agrega uno abajo si quieres que diga "desde …".</div>'
            : `<div class="ui-table-wrap"><table class="ui-table"><thead><tr><th>Origen → destino</th><th>Campaña</th><th>Régimen</th><th style="width:130px">Precio</th><th style="width:96px"></th></tr></thead><tbody>
              ${s.destinos.map((d, i) => `<tr class="${d.precio > 0 && d.precio < PRECIO_ALERTA ? 'bad' : ''}"><td><b>${esc(d.origen)}</b> → ${esc(d.destino)}</td><td>${esc(cat.campanyas.find(c => +c.valor === d.id_Campanya)?.texto || d.id_Campanya)}</td><td>${esc(d.regimen || '—')}</td>
                <td><div class="ui-money"><b>RD$</b><input type="number" min="0" step="1" value="${Math.round(d.precio)}" data-dp="${i}"></div></td>
                <td style="text-align:right;white-space:nowrap"><button type="button" class="ui-ibtn" data-dcalc="${i}" title="Recalcular con lo que está a la venta"><i class="bi bi-calculator"></i></button><button type="button" class="ui-ibtn danger" data-ddel="${i}" title="Quitar"><i class="bi bi-trash3"></i></button></td></tr>`).join('')}
              </tbody></table></div>`;
        $$('[data-dp]', $('#sPrecios')).forEach(inp => inp.onchange = async () => { const d = s.destinos[+inp.dataset.dp]; d.precio = +inp.value || 0; await guardarPrecio(d); });
        $$('[data-dcalc]', $('#sPrecios')).forEach(b => b.onclick = async () => {
            const d = s.destinos[+b.dataset.dcalc];
            const r = await EV.api(`/HomeWeb/PrecioMinimo?origen=${encodeURIComponent(d.origen)}&destino=${encodeURIComponent(d.destino)}&campanya=${d.id_Campanya}&regimen=${encodeURIComponent(d.regimen || '')}`);
            if (!r.precio) { EV.toast('No hay ofertas a la venta para ese destino y campaña.', 'info'); return; }
            d.precio = Math.round(r.precio); await guardarPrecio(d); pintarPrecios();
        });
        $$('[data-ddel]', $('#sPrecios')).forEach(b => b.onclick = async () => {
            const d = s.destinos[+b.dataset.ddel];
            try { const r = await EV.post(`/HomeWeb/EliminarSlideDestino?id=${d.id}`, {}); s.destinos.splice(+b.dataset.ddel, 1); pintarPrecios(); pintarCarrusel(); pintarSlider(); EV.toast(r.mensaje); }
            catch (e) { EV.toast(e.message, 'err'); }
        });
    }
    async function guardarPrecio(d) {
        try { await EV.post('/HomeWeb/SlideDestino', { Id: d.id, Id_Carrusel: slideActual.id_Carrusel, Origen: d.origen, Destino: d.destino, Precio: d.precio, Id_Campanya: d.id_Campanya, Regimen: d.regimen }); EV.toast('Precio guardado.'); pintarCarrusel(); pintarSlider(); }
        catch (e) { EV.toast(e.message, 'err'); }
    }

    async function guardarSlide() {
        if (!slideActual) return guardarNuevoSlide();
        try {
            const r = await EV.post('/HomeWeb/Slide', { Id_Carrusel: slideActual.id_Carrusel, Orientacion: $('#sOri').value, Url: $('#sUrl').value.trim() || null, Activo: $('#sAct').checked });
            EV.toast(r.mensaje); dS.cerrar(); cargar();
        } catch (e) { EV.toast(e.message, 'err'); }
    }

    function nuevoSlide() {
        slideActual = null;
        $('#sdTitulo').textContent = 'Nuevo slide'; $('#sdSub').textContent = 'Sube la imagen web; tablet y móvil son opcionales (si faltan se usa la web)';
        $('#sdEliminar').hidden = true;
        const caja = (d, et, req) => `<div class="cr-vista"><label class="im cr-drop" data-drop="${d}"><input type="file" accept="image/jpeg,image/png,image/webp" data-nf="${d}" hidden><span><i class="bi bi-cloud-arrow-up" style="font-size:22px;display:block"></i>${req ? 'Obligatoria' : 'Opcional'}</span></label><small>${et}</small></div>`;
        $('#sdForm').innerHTML = `
            <div class="ui-sec"><div class="ui-sec-t"><span><i class="bi bi-images"></i></span> Imágenes <small>arrastra o haz clic · JPG, PNG o WebP</small></div>
                <div class="cr-vistas">${caja('web', 'Web', true)}${caja('tablet', 'Tablet')}${caja('movil', 'Móvil')}</div></div>
            <div class="ui-sec"><div class="ui-sec-t"><span>1</span> Datos</div>
                <div class="ui-row r3">
                    <div class="ui-f"><label>Nombre del archivo * <em>sin espacios</em></label><input id="nNom" maxlength="90" placeholder="VeranoPuntaCana"><span class="msg"></span></div>
                    <div class="ui-f"><label>Orientación</label><select id="sOri"><option value="H">Horizontal</option><option value="V">Vertical</option></select></div>
                    <div class="ui-f"><label>Enlace al pulsar <em>opcional</em></label><input id="sUrl" maxlength="500" placeholder="https://…"></div>
                </div>
                <label class="ui-switch"><input type="checkbox" id="sAct" checked><span class="tr"></span> Activo (sale en la web al final del carrusel)</label>
                <div class="ui-help" style="margin-top:8px">Después de crearlo podrás agregarle el precio "desde".</div></div>`;
        const files = {};
        $$('[data-nf]').forEach(inp => {
            const lab = inp.closest('label'), poner = f => { if (!f) return; files[inp.dataset.nf] = f; lab.querySelector('span').innerHTML = `<img src="${URL.createObjectURL(f)}" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">`;
                if (inp.dataset.nf === 'web' && !$('#nNom').value) $('#nNom').value = f.name.replace(/\.[^.]+$/, '').replace(/[^A-Za-z0-9_\-]/g, ''); };
            inp.onchange = () => poner(inp.files[0]);
            ['dragenter', 'dragover'].forEach(t => lab.addEventListener(t, e => { e.preventDefault(); lab.classList.add('over'); }));
            ['dragleave', 'drop'].forEach(t => lab.addEventListener(t, e => { e.preventDefault(); lab.classList.remove('over'); }));
            lab.addEventListener('drop', e => poner(e.dataTransfer.files[0]));
        });
        HW._nuevos = files;
        dS.abrir();
    }

    async function guardarNuevoSlide() {
        const f = HW._nuevos || {};
        if (!f.web) { EV.toast('Sube la imagen para web.', 'err'); return; }
        const nom = $('#nNom').value.trim();
        if (!/^[A-Za-z0-9_\-]{3,}$/.test(nom)) { const fl = $('#nNom').closest('.ui-f'); fl.classList.add('err'); fl.querySelector('.msg').textContent = 'Mínimo 3 letras, sin espacios ni símbolos'; return; }
        const fd = new FormData();
        fd.append('nombre', nom); fd.append('orientacion', $('#sOri').value); fd.append('url', $('#sUrl').value.trim()); fd.append('activo', $('#sAct').checked);
        ['web', 'tablet', 'movil'].forEach(k => f[k] && fd.append(k, f[k]));
        const b = $('#sdGuardar'), html = b.innerHTML; b.disabled = true; b.innerHTML = '<span class="ui-spin"></span> Subiendo…';
        try { const r = await EV.post('/HomeWeb/NuevoSlide', fd); EV.toast(r.mensaje); await cargar(); abrirSlide(r.id); }
        catch (e) { EV.toast(e.message, 'err'); }
        finally { b.disabled = false; b.innerHTML = html; }
    }

    // ===================== TARJETAS =====================
    async function abrirTarjeta(t, idSeccion) {
        cat ??= await EVC.catalogos();
        tarjetaActual = t;
        const v = t || { tipo_Servicio: 'OFERTA', id_Pais_Origen: 'ES', origen: '', id_PaisDestino: 'DO', id_Destino: '', estado: true, id_Contenedor: idSeccion ?? null };
        $('#tdTitulo').textContent = t ? (t.tipo_Servicio === 'CIRCUITO' ? t.descripcion : t.id_Destino) : 'Nueva tarjeta';
        $('#tdSub').textContent = t ? `${tipoChip[t.tipo_Servicio] || t.tipo_Servicio}${t.id_Servicio > 0 ? ' · servicio #' + t.id_Servicio : ' · tarjeta manual'}` : 'Se agrega a la Home';
        $('#tdEliminar').hidden = !t;
        const paises = cat.paises.map(p => `<option value="${esc(p.valor)}">${esc(p.texto)}</option>`).join('');
        $('#tdForm').innerHTML = `
            ${t && t.vigente === false ? '<div class="ui-note warn"><i class="bi bi-exclamation-triangle"></i><div>La oferta de esta tarjeta <b>ya no está a la venta</b>. Ocúltala, quítala o pulsa "Traer ofertas a la Home" para poner la más barata vigente.</div></div>' : ''}
            ${t && t.id_Servicio > 0 ? '<div class="ui-note info"><i class="bi bi-magic"></i><div>Esta tarjeta viene de las ofertas: al pulsar "Traer ofertas a la Home" se actualizan su precio e imagen, pero se respetan la sección, el orden y si está oculta.</div></div>' : ''}
            <div class="ui-sec"><div class="ui-sec-t"><span>1</span> Qué se muestra</div>
                <div class="hc-prev" id="tdPrev" style="border-radius:16px;overflow:hidden;margin-bottom:12px;max-height:200px;background:var(--ev-grad-soft)"></div>
                <div class="ui-row r3">
                    <div class="ui-f"><label>Tipo</label><select id="tTipoF">${['OFERTA', 'CIRCUITO', 'HOTEL', 'EXCURSION', 'TRASLADO', 'COMBINADO'].map(x => `<option>${x}</option>`).join('')}</select></div>
                    <div class="ui-f"><label>Campaña *</label><select id="tCam">${cat.campanyas.map(c => `<option value="${esc(c.valor)}">${esc(c.texto)}</option>`).join('')}</select></div>
                    <div class="ui-f"><label>Sección</label><select id="tSecF"><option value="">— Sin sección —</option>${D.contenedores.map(c => `<option value="${c.id_Contenedor}">${esc(c.nombre)}</option>`).join('')}</select></div>
                </div>
                <div class="ui-row r4">
                    <div class="ui-f"><label>País origen</label><select id="tPO">${paises}</select></div>
                    <div class="ui-f"><label>Origen *</label><input id="tOri" maxlength="30"><span class="msg"></span></div>
                    <div class="ui-f"><label>País destino</label><select id="tPD">${paises}</select></div>
                    <div class="ui-f"><label>Destino *</label><input id="tDes" maxlength="1500"><span class="msg"></span></div>
                </div>
                <input type="hidden" id="tImg">
                <div class="ui-help" style="margin:-4px 0 10px"><i class="bi bi-image"></i> La imagen sale de las carpetas del proyecto: en hoteles, la foto cargada en <a href="/Hoteles/Index">Hoteles</a>; en circuitos, la portada cargada en <a href="/Circuitos/Index">Circuitos</a>.</div>
                <div class="ui-f"><label>Descripción <em>en circuitos es el nombre que se ve</em></label><textarea id="tDesc" rows="2"></textarea></div>
            </div>
            <div class="ui-sec"><div class="ui-sec-t"><span>2</span> Precio y notas</div>
                <div class="ui-row r3">
                    <div class="ui-f"><label>Precio "desde"</label><div class="ui-money"><b>RD$</b><input id="tPre" type="number" min="0" step="1"></div></div>
                    <div class="ui-f"><label>Noches</label><input id="tNoc" type="number" min="0" max="60"></div>
                    <div class="ui-f"><label class="ui-switch" style="margin-top:28px"><input type="checkbox" id="tEstF"><span class="tr"></span> Visible en la web</label></div>
                </div>
                <div class="ui-f"><label>Notas</label><textarea id="tNot" rows="2" maxlength="1000"></textarea></div>
            </div>`;
        $('#tTipoF').value = v.tipo_Servicio; $('#tCam').value = String(v.id_Campanya || cat.campanyas.find(c => c.texto === 'DTGeneral')?.valor || cat.campanyas[0].valor);
        $('#tSecF').value = v.id_Contenedor ?? ''; $('#tPO').value = (v.id_Pais_Origen || 'ES').toUpperCase(); $('#tPD').value = (v.id_PaisDestino || 'DO').toUpperCase();
        $('#tOri').value = v.origen || ''; $('#tDes').value = v.id_Destino || ''; $('#tImg').value = v.caratulaDestino || ''; $('#tDesc').value = v.descripcion || '';
        $('#tPre').value = v.precioWeb != null ? Math.round(v.precioWeb) : ''; $('#tNoc').value = v.noches ?? ''; $('#tNot').value = v.notas || ''; $('#tEstF').checked = v.estado !== false;
        // caratulaDestino se conserva tal cual (en hoteles es el destino, no una imagen); la vista previa usa la imagen de las carpetas
        const u = carat(v);
        $('#tdPrev').innerHTML = u ? `<img src="${esc(u)}" alt="" style="width:100%;max-height:200px;object-fit:cover;display:block" onerror="this.remove()">` : '';
        EV.picker($('#tOri'), { url: q => `/Circuitos/Destinos?pais=${encodeURIComponent($('#tPO').value)}&q=${q}`, limpiar: false, map: x => ({ valor: x.valor, texto: x.texto, icono: 'bi-geo' }), onSelect: m => $('#tOri').value = m.valor });
        EV.picker($('#tDes'), { url: q => `/Circuitos/Destinos?pais=${encodeURIComponent($('#tPD').value)}&q=${q}`, limpiar: false, map: x => ({ valor: x.valor, texto: x.texto, icono: 'bi-geo-alt' }), onSelect: m => $('#tDes').value = m.valor });
        dT.abrir();
    }

    async function guardarTarjeta() {
        const dto = {
            Id: tarjetaActual?.id ?? null, Tipo_Servicio: $('#tTipoF').value, Id_Campanya: +$('#tCam').value, Id_Pais_Origen: $('#tPO').value, Origen: $('#tOri').value.trim(),
            Id_PaisDestino: $('#tPD').value, Id_Destino: $('#tDes').value.trim(), CaratulaDestino: $('#tImg').value.trim() || null, Descripcion: $('#tDesc').value.trim(),
            PrecioWeb: $('#tPre').value === '' ? null : +$('#tPre').value, Id_Contenedor: $('#tSecF').value ? +$('#tSecF').value : null,
            Noches: $('#tNoc').value === '' ? null : +$('#tNoc').value, Notas: $('#tNot').value.trim() || null, Estado: $('#tEstF').checked
        };
        $$('#tdForm .ui-f.err').forEach(f => f.classList.remove('err'));
        const falta = (id, m) => { const f = $(id).closest('.ui-f'); f.classList.add('err'); f.querySelector('.msg').textContent = m; EV.toast(m, 'err'); };
        if (!dto.Origen) return falta('#tOri', 'Escribe el origen');
        if (!dto.Id_Destino) return falta('#tDes', 'Escribe el destino');
        const b = $('#tdGuardar'), html = b.innerHTML; b.disabled = true; b.innerHTML = '<span class="ui-spin"></span> Guardando…';
        try {
            const r = await EV.post('/HomeWeb/GuardarTarjeta', dto); EV.toast(r.mensaje); dT.cerrar(true);
            await cargar();
            EV.resaltar(document.querySelector(`.hw-card[data-t="${r.id}"]`));   // se ve dónde quedó la tarjeta
        }
        catch (e) { EV.toast(e.message, 'err'); }
        finally { b.disabled = false; b.innerHTML = html; }
    }

    async function estadoTarjeta(id) {
        const t = todas().find(x => x.id === id); if (!t) return;
        if (!t.estado && sinSeccion(t)) { EV.toast('Esta tarjeta no tiene sección: arrástrala a una sección y saldrá en la web sola.', 'err'); return; }
        try { const r = await EV.post('/HomeWeb/EstadoTarjeta', { Id: id, Estado: !t.estado }); EV.toast(r.mensaje, 'ok', { texto: 'Deshacer', accion: async () => { await EV.post('/HomeWeb/EstadoTarjeta', { Id: id, Estado: t.estado }); cargar(); } }); cargar(); }
        catch (e) { EV.toast(e.message, 'err'); }
    }

    // ===================== TABLA =====================
    function pintarTabla() {
        const q = $('#tQ').value.trim().toLowerCase(), tipo = $('#tTipo').value, sec = $('#tSec').value, est = $('#tEst').value;
        const filas = todas().filter(t => (!q || [t.id_Destino, t.origen, t.descripcion, t.campanya, String(t.id_Servicio)].some(x => (x || '').toLowerCase().includes(q)))
            && (!tipo || t.tipo_Servicio === tipo) && (!sec || (sec === '-1' ? !t.id_Contenedor || !D.contenedores.some(c => c.id_Contenedor === t.id_Contenedor) : t.id_Contenedor === +sec))
            && (!est || (est === 'v' ? t.vigente === false : String(+t.estado) === est)));
        $('#tLista').innerHTML = !filas.length ? '<div class="ui-empty"><i class="bi bi-postcard big"></i><h3>No hay tarjetas con esos filtros</h3><p>Pulsa "Traer ofertas a la Home" para llenarla con lo que está a la venta.</p></div>'
            : `<div class="ui-table-wrap"><table class="ui-table"><thead><tr><th></th><th>Destino</th><th>Tipo</th><th>Origen</th><th>Campaña</th><th class="num">Precio</th><th>Sección</th><th>Pos.</th><th>Visible</th><th></th></tr></thead><tbody>
              ${filas.map(t => `<tr data-tt="${t.id}" style="cursor:pointer"><td>${carat(t) ? `<img class="hw-mini" src="${esc(carat(t))}" alt="" loading="lazy" onerror="this.style.visibility='hidden'">` : '<span class="hw-mini"></span>'}</td>
                <td><b>${esc(t.tipo_Servicio === 'CIRCUITO' ? t.descripcion : t.id_Destino)}</b>${t.vigente === false ? ' <span class="ui-chip" style="background:#FEE4E2;color:#B42318;padding:2px 8px;font-size:11px">ya no se vende</span>' : ''}<br><small style="color:var(--ev-muted)">${t.id_Servicio > 0 ? '#' + t.id_Servicio : 'manual'}</small></td>
                <td>${tipoChip[t.tipo_Servicio] || esc(t.tipo_Servicio)}</td><td>${esc(t.origen)}</td><td>${esc(t.campanya || t.id_Campanya)}</td>
                <td class="num">${t.precioWeb ? EV.dinero(t.precioWeb) : '—'}</td><td>${esc(t.contenedor || '—')}</td><td>${t.posicion_Destino ?? '—'}</td>
                <td><label class="ui-switch" onclick="event.stopPropagation()"><input type="checkbox" data-tvis="${t.id}" ${t.estado ? 'checked' : ''}><span class="tr"></span></label></td>
                <td><button type="button" class="ui-ibtn" title="Editar"><i class="bi bi-pencil"></i></button></td></tr>`).join('')}
              </tbody></table></div>`;
    }

    // ===================== INICIO =====================
    async function iniciar() {
        if (location.hash === '#carrusel') tabs.ir('pCarrusel');
        window.addEventListener('hashchange', () => location.hash === '#carrusel' && tabs.ir('pCarrusel'));
        try { await cargar(); } catch (e) { $('#hwSecciones').innerHTML = `<div class="ui-empty"><h3>No se pudo cargar la Home</h3><p>${esc(e.message)}</p></div>`; return; }

        $('#hwDev').addEventListener('click', e => { const b = e.target.closest('[data-dev]'); if (!b) return; dev = b.dataset.dev; $$('#hwDev button').forEach(x => x.classList.toggle('on', x === b)); $('#hwMarco').dataset.dev = dev; pintarSlider(); });
        $('#hwSlider').tabIndex = 0;   // el clic (flechas, puntos o ir al carrusel) lo maneja pintarSlider
        $('#hwNuevaSec').onclick = async () => {
            const nombre = await EV.pedir({ titulo: 'Nueva sección de la Home', etiqueta: 'Nombre de la sección', si: 'Crear sección', icono: 'plus-lg', maxlength: 60,
                ayuda: 'Ej. 🌴 CARIBE, ☀️ OFERTAS DE VERANO. Puedes poner emojis (en Windows: tecla Windows + punto). Luego arrastra tarjetas a la sección.' });
            if (!nombre?.trim()) return;
            try { const r = await EV.post('/HomeWeb/Seccion', { Nombre: nombre.trim(), Estado: true }); EV.toast(r.mensaje); cargar(); } catch (e) { EV.toast(e.message, 'err'); }
        };
        document.addEventListener('click', async e => {
            const ojo = e.target.closest('[data-ojo]'); if (ojo) { e.stopPropagation(); return estadoTarjeta(+ojo.dataset.ojo); }
            const add = e.target.closest('[data-addsec]'); if (add) return abrirTarjeta(null, +add.dataset.addsec);
            const card = e.target.closest('.hw-card'); if (card) return abrirTarjeta(todas().find(t => t.id === +card.dataset.t));
            const tr = e.target.closest('[data-tt]'); if (tr) return abrirTarjeta(todas().find(t => t.id === +tr.dataset.tt));
            const sed = e.target.closest('[data-sed]'); if (sed) return abrirSlide(+sed.dataset.sed);
            const mov = e.target.closest('[data-smover]'); if (mov) return moverSlide(+mov.dataset.smover, +mov.dataset.paso);
            const so = e.target.closest('[data-secojo]');
            if (so) { const c = D.contenedores.find(x => x.id_Contenedor === +so.dataset.secojo); try { const r = await EV.post('/HomeWeb/Seccion', { Id_Contenedor: c.id_Contenedor, Nombre: c.nombre, Estado: !c.estado }); EV.toast(c.estado ? 'Sección oculta en la web.' : 'Sección visible en la web.'); cargar(); } catch (er) { EV.toast(er.message, 'err'); } return; }
            const sr = e.target.closest('[data-secren]');
            if (sr) { const c = D.contenedores.find(x => x.id_Contenedor === +sr.dataset.secren); const n = await EV.pedir({ titulo: 'Cambiar nombre de la sección', etiqueta: 'Nombre', valor: c.nombre, maxlength: 60, ayuda: 'Puedes poner emojis (en Windows: tecla Windows + punto). Ej. 🚐 TRASLADOS' }); if (!n?.trim() || n.trim() === c.nombre) return;
                try { const r = await EV.post('/HomeWeb/Seccion', { Id_Contenedor: c.id_Contenedor, Nombre: n.trim(), Estado: c.estado }); EV.toast(r.mensaje); cargar(); } catch (er) { EV.toast(er.message, 'err'); } return; }
            const sd = e.target.closest('[data-secdel]');
            if (sd) { const c = D.contenedores.find(x => x.id_Contenedor === +sd.dataset.secdel);
                if (!await EV.confirmar({ titulo: `¿Eliminar la sección ${c.nombre}?`, peligro: true, si: 'Sí, eliminar', texto: c.tarjetas.length ? `Sus <b>${c.tarjetas.length}</b> tarjetas NO se borran: pasan a «Sin sección».` : 'La sección está vacía.' })) return;
                try { const r = await EV.post(`/HomeWeb/EliminarSeccion?id=${c.id_Contenedor}`, {}); EV.toast(r.mensaje); cargar(); } catch (er) { EV.toast(er.message, 'err'); } }
        });
        document.addEventListener('change', async e => {
            const sa = e.target.closest('[data-sact]');
            if (sa) { const s = D.slides.find(x => x.id_Carrusel === +sa.dataset.sact);
                try { await EV.post('/HomeWeb/Slide', { Id_Carrusel: s.id_Carrusel, Orientacion: s.orientacion, Url: s.url, Activo: sa.checked }); EV.toast(sa.checked ? 'Slide activo en la web.' : 'Slide desactivado.'); cargar(); } catch (er) { EV.toast(er.message, 'err'); sa.checked = !sa.checked; } }
            const tv = e.target.closest('[data-tvis]'); if (tv) estadoTarjeta(+tv.dataset.tvis);
        });
        $('#crFiltro').addEventListener('click', e => { const b = e.target.closest('[data-v]'); if (!b) return; crFiltro = b.dataset.v; $$('#crFiltro .ui-pick').forEach(x => x.classList.toggle('on', x === b)); pintarCarrusel(); });
        ['#tQ', '#tTipo', '#tSec', '#tEst'].forEach(id => $(id).addEventListener('input', EV.debounce(pintarTabla, 150)));

        $('#tdGuardar').onclick = guardarTarjeta;
        $('#tdEliminar').onclick = async () => {
            const t = tarjetaActual; if (!t) return;
            if (!await EV.confirmar({ titulo: '¿Quitar esta tarjeta de la Home?', peligro: true, si: 'Sí, quitar', texto: `Se quita <b>${esc(t.id_Destino)}</b> de la Home. La oferta NO se borra.${t.id_Servicio > 0 ? ' Si la quieres de vuelta, usa "Traer ofertas a la Home".' : ''} Si solo quieres que no se vea, usa el ojo para ocultarla.` })) return;
            try { const r = await EV.post(`/HomeWeb/EliminarTarjeta?id=${t.id}`, {}); EV.toast(r.mensaje); dT.cerrar(); cargar(); } catch (e) { EV.toast(e.message, 'err'); }
        };
        $('#sdGuardar').onclick = guardarSlide;
        $('#sdEliminar').onclick = async () => {
            const s = slideActual; if (!s) return;
            if (!await EV.confirmar({ titulo: '¿Eliminar este slide?', peligro: true, si: 'Sí, eliminar', texto: `Se quita <b>${esc(s.ruta)}</b> del carrusel (web, tablet y móvil) con sus precios. Si solo quieres que no salga, desactívalo.` })) return;
            try { const r = await EV.post(`/HomeWeb/EliminarSlide?id=${s.id_Carrusel}`, {}); EV.toast(r.mensaje); dS.cerrar(); cargar(); } catch (e) { EV.toast(e.message, 'err'); }
        };
        $$('[data-cerrar]').forEach(b => b.onclick = () => { dT.cerrar(); dS.cerrar(); });
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') { dT.cerrar(); dS.cerrar(); }
            if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { if (dT.abierto()) { e.preventDefault(); guardarTarjeta(); } else if (dS.abierto()) { e.preventDefault(); guardarSlide(); } }
        });

        $('#hwTraer').onclick = async () => {
            if (!await EV.confirmar({ titulo: '¿Traer ofertas a la Home?', si: 'Sí, traer', icono: 'magic',
                texto: 'Para cada destino a la venta se pone la oferta (o circuito) más barata. Se respetan las secciones, el orden y lo que ocultaste.' })) return;
            const b = $('#hwTraer'), html = b.innerHTML; b.disabled = true; b.innerHTML = '<span class="ui-spin"></span> Trayendo…';
            try { const r = await EV.post('/HomeWeb/TraerOfertas', {}); EV.toast(r.mensaje); cargar(); } catch (e) { EV.toast(e.message, 'err'); }
            finally { b.disabled = false; b.innerHTML = html; }
        };
        $('#hwRecalc').onclick = async () => {
            if (!await EV.confirmar({ titulo: '¿Recalcular los precios del carrusel?', icono: 'arrow-repeat', si: 'Sí, recalcular',
                texto: 'Cada destino de los slides toma el precio <b>"desde"</b> de la oferta más barata que está a la venta hoy. Los precios que se escribieron a mano en los slides se reemplazan.' })) return;
            const b = $('#hwRecalc'), html = b.innerHTML; b.disabled = true; b.innerHTML = '<span class="ui-spin"></span> Calculando…';
            try { const r = await EV.post('/HomeWeb/RecalcularPrecios', {}); EV.toast(r.mensaje, 'info'); cargar(); } catch (e) { EV.toast(e.message, 'err'); }
            finally { b.disabled = false; b.innerHTML = html; }
        };
        $('#hwAjustes').onclick = async () => {
            const a = await EV.api('/HomeWeb/Ajustes');
            const v = await EV.pedir({ titulo: 'Precio base mínimo', etiqueta: `Precio base mínimo (${EV.simbolo()})`, valor: a.precioBaseMinimo, tipo: 'number', min: 0, icono: 'sliders',
                ayuda: 'Ninguna oferta ni circuito se puede cargar con un precio base menor a este valor.' });
            if (v == null) return;
            const n = parseFloat(String(v).replace(',', '.'));
            if (isNaN(n) || n < 0) { EV.toast('Escribe un número válido.', 'err'); return; }
            try { const r = await EV.post('/HomeWeb/GuardarAjustes', { PrecioBaseMinimo: n }); EV.toast(r.mensaje); } catch (e) { EV.toast(e.message, 'err'); }
        };
    }
    document.addEventListener('DOMContentLoaded', iniciar);

    return { nuevaTarjeta: () => abrirTarjeta(null), nuevoSlide };
})();
</script>
}
