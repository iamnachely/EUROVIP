@{
    ViewData["Title"] = "Home de la web";
}

@section Styles {
<link rel="stylesheet" href="~/css/eurovip-ui.css" asp-append-version="true" />
<style>
    /* ---------- portada ---------- */
    .hw-hero { position: relative; overflow: hidden; border-radius: 30px; padding: 26px 30px; background: var(--ev-ink); color: #fff; display: flex; gap: 20px; align-items: center; flex-wrap: wrap; isolation: isolate; }
    .hw-hero::before { content: ""; position: absolute; inset: 0; z-index: -1; background: radial-gradient(600px 300px at 90% -20%, rgba(43,212,196,.55), transparent 60%), radial-gradient(400px 200px at 10% 120%, rgba(179,255,243,.25), transparent 60%); }
    .hw-hero h1 { margin: 0; font-size: clamp(26px, 3vw, 34px); font-weight: 800; letter-spacing: -1.2px; }
    .hw-hero p { margin: 4px 0 0; color: rgba(232,255,251,.72); font-weight: 500; max-width: 60ch; }
    .hw-hero .sp { flex: 1; }
    .hw-hero .acts { display: flex; gap: 8px; flex-wrap: wrap; }
    .hw-hero .ev-btn.light { background: rgba(255,255,255,.1); color: #fff; border: 1px solid rgba(116,242,230,.3); }
    .hw-kpis { display: flex; gap: 10px; flex-wrap: wrap; width: 100%; }
    .hw-kpi { padding: 10px 16px; border-radius: 16px; background: rgba(255,255,255,.06); border: 1px solid rgba(116,242,230,.18); }
    /* Aviso "no sale en la Home" */
    .hw-fuera { margin-top: 14px; border-radius: 20px; border: 1px solid #B3FFF3; background: #ECFEFB; color: #0E6F68; overflow: hidden; }
    .hw-fuera.mal { border-color: #FEDF89; background: #FFFAEB; color: #93370D; }
    .hw-fuera summary { list-style: none; cursor: pointer; display: flex; gap: 10px; align-items: center; padding: 14px 18px; font-size: 14px; flex-wrap: wrap; }
    .hw-fuera summary::-webkit-details-marker { display: none; }
    .hw-fuera summary span { font-weight: 600; opacity: .85; font-size: 13px; }
    .hw-fuera summary .fl { margin-left: auto; transition: transform .2s; }
    .hw-fuera[open] > summary .fl { transform: rotate(180deg); }
    .hw-fuera-l { display: grid; gap: 8px; padding: 0 14px 14px; }
    .hw-fuera summary .chips { display: flex; gap: 6px; flex-wrap: wrap; }
    .hw-fuera summary .chips em { font-style: normal; font-size: 12px; font-weight: 800; padding: 3px 9px; border-radius: 99px; background: rgba(255,255,255,.75); }
    .hw-fuera-g { border-radius: 14px; border: 1px solid var(--ev-line); background: var(--ev-surface); color: var(--ev-text); }
    .hw-fuera .hw-fuera-g > summary { padding: 10px 12px; font-weight: 800; }
    .hw-fuera-g > summary .n { font-size: 12px; padding: 2px 8px; border-radius: 99px; background: var(--ev-surface-2); color: var(--ev-muted); opacity: 1; }
    .hw-fuera-g[open] > summary .fl { transform: rotate(180deg); }
    .hw-fuera-g > .hw-fuera-l { padding: 0 10px 10px; }
    .hw-fuera-l .it { display: flex; gap: 12px; align-items: center; padding: 10px 12px; border-radius: 14px; background: var(--ev-surface); color: var(--ev-text); border: 1px solid var(--ev-line); }
    .hw-fuera-l .ic { width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; background: var(--ev-mint); color: var(--ev-deep); flex-shrink: 0; font-size: 17px; }
    .hw-fuera-l .ic.mal { background: #FEF3C7; color: #B54708; }
    .hw-fuera-l .tx { flex: 1; min-width: 0; display: grid; gap: 2px; }
    .hw-fuera-l .tx b { font-size: 14px; }
    .hw-fuera-l .tx small { font-weight: 700; color: var(--ev-muted); font-size: 11.5px; margin-left: 4px; }
    .hw-fuera-l .tx span { font-size: 13px; color: var(--ev-muted); font-weight: 600; }
    .hw-kpi b { font-size: 20px; font-weight: 800; display: block; line-height: 1.1; }
    .hw-kpi small { color: rgba(232,255,251,.6); font-weight: 600; font-size: 12px; }
    .hw-kpi.alerta { border-color: #F79009; background: rgba(247,144,9,.12); }

    .hw-barra { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin: 18px 0 14px; }
    .hw-barra .sp { flex: 1; }
    .hw-dev { display: flex; gap: 4px; padding: 4px; border-radius: 14px; background: var(--ev-surface); border: 1px solid var(--ev-line); }
    .hw-dev button { border: 0; background: transparent; border-radius: 10px; padding: 8px 12px; font: 700 13px var(--ev-font); color: var(--ev-muted); cursor: pointer; display: flex; gap: 6px; align-items: center; }
    .hw-dev button.on { background: var(--ev-ink); color: var(--ev-aqua); }

    /* ---------- vista de la home (marco del dispositivo) ---------- */
    .hw-marco { margin: 0 auto; transition: max-width .45s var(--ev-ease); border-radius: 28px; background: var(--ev-surface); border: 1px solid var(--ev-line); box-shadow: var(--ev-shadow); padding: 18px; }
    .hw-marco[data-dev="tablet"] { max-width: 820px; border-width: 10px; border-color: var(--ev-ink); border-radius: 36px; }
    .hw-marco[data-dev="movil"] { max-width: 400px; border-width: 10px; border-color: var(--ev-ink); border-radius: 40px; }
    .hw-slider { position: relative; border-radius: 22px; overflow: hidden; background: var(--ev-grad-soft); aspect-ratio: 16 / 5; cursor: pointer; }
    .hw-marco[data-dev="tablet"] .hw-slider { aspect-ratio: 16 / 7; }
    .hw-marco[data-dev="movil"] .hw-slider { aspect-ratio: 4 / 5; }
    .hw-slider img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .8s ease; }
    .hw-slider img.on { opacity: 1; }
    .hw-slider .vacio { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; color: var(--ev-muted); font-weight: 700; }
    .hw-slider .puntos { position: absolute; left: 50%; bottom: 12px; transform: translateX(-50%); display: flex; gap: 6px; z-index: 2; }
    .hw-slider .puntos i { width: 8px; height: 8px; border-radius: 99px; background: rgba(255,255,255,.55); transition: width .3s; }
    .hw-slider .puntos i.on { width: 22px; background: #fff; }
    .hw-slider .puntos i { cursor: pointer; }
    /* Flechas anterior / siguiente */
    .hw-slider .flecha { position: absolute; top: 50%; transform: translateY(-50%); z-index: 3; width: 44px; height: 44px; border-radius: 50%; border: 0; cursor: pointer;
                         display: grid; place-items: center; font-size: 20px; color: #fff; background: rgba(11,18,21,.55); backdrop-filter: blur(6px); transition: background .2s, transform .2s; }
    .hw-slider .flecha:hover, .hw-slider .flecha:focus-visible { background: rgba(11,18,21,.85); transform: translateY(-50%) scale(1.06); }
    .hw-slider .flecha.ant { left: 12px; }
    .hw-slider .flecha.sig { right: 12px; }
    /* En pantallas angostas el slider es bajito: flechas abajo en las esquinas para no tapar "Editar carrusel" */
    @@media (max-width: 700px) { .hw-slider .flecha { width: 32px; height: 32px; font-size: 15px; top: auto; bottom: 6px; transform: none; } .hw-slider .flecha:hover, .hw-slider .flecha:focus-visible { transform: scale(1.06); } .hw-slider .flecha.ant { left: 8px; } .hw-slider .flecha.sig { right: 8px; } }
    .hw-slider .precio { position: absolute; right: 14px; top: 14px; z-index: 2; padding: 8px 12px; border-radius: 14px; background: rgba(11,18,21,.82); color: #fff; font-weight: 800; font-size: 13px; backdrop-filter: blur(6px); }
    .hw-slider .precio b { color: var(--ev-aqua); font-size: 17px; }
    /* Botón "Editar carrusel": siempre visible (antes solo al pasar el ratón; en táctil no se veía) */
    .hw-slider .editar { position: absolute; left: 14px; top: 14px; z-index: 2; display: inline-flex; align-items: center; gap: 6px; padding: 8px 13px; border-radius: 12px; border: 0; cursor: pointer;
                         background: rgba(11,18,21,.82); color: #fff; font: 800 12.5px var(--ev-font); box-shadow: 0 6px 18px -8px rgba(0,0,0,.5); transition: background .2s, transform .2s; }
    .hw-slider .editar i { color: var(--ev-aqua); }
    .hw-slider:hover .editar, .hw-slider .editar:focus-visible { background: #0B1215; transform: translateY(-1px); }

    .hw-sec { margin-top: 18px; border-radius: 22px; border: 1.5px solid transparent; padding: 12px; transition: border-color .2s, background .2s, opacity .2s; }
    .hw-sec:hover { border-color: var(--ev-line); }
    .hw-sec.oculta { opacity: .55; }
    .hw-sec.arrastrando { opacity: .4; }
    .hw-sec.sobre { border-color: var(--ev-teal); background: var(--ev-grad-soft); }
    .hw-sec-h { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
    .hw-sec-h .asa { cursor: grab; color: var(--ev-muted); font-size: 18px; padding: 4px; border-radius: 8px; }
    .hw-sec-h .asa:hover { background: var(--ev-surface-2); color: var(--ev-text); }
    .hw-sec-h h3 { margin: 0; font-size: 17px; font-weight: 800; letter-spacing: -.3px; text-transform: uppercase; }
    .hw-sec-h .n { font: 800 11px var(--ev-font); padding: 3px 9px; border-radius: 99px; background: var(--ev-surface-2); color: var(--ev-muted); }
    .hw-sec-h .sp { flex: 1; }
    .hw-sec-h .ui-ibtn { opacity: 1; transition: opacity .2s, background .2s; }
    .hw-sec:hover .hw-sec-h .ui-ibtn, .hw-sec-h .ui-ibtn:focus { opacity: 1; }
    .hw-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 12px; min-height: 70px; border-radius: 16px; transition: background .2s; }
    .hw-marco[data-dev="movil"] .hw-cards { grid-template-columns: 1fr 1fr; gap: 8px; }
    .hw-cards.sobre { background: color-mix(in srgb, var(--ev-aqua) 18%, transparent); outline: 2px dashed var(--ev-teal); outline-offset: 4px; }
    .hw-card { position: relative; border-radius: 18px; overflow: hidden; background: var(--ev-surface); border: 1px solid var(--ev-line); cursor: grab; transition: transform .25s var(--ev-ease), box-shadow .25s, opacity .2s; user-select: none; }
    .hw-card:hover { transform: translateY(-3px); box-shadow: var(--ev-shadow); }
    .hw-card.arrastrando { opacity: .35; transform: scale(.97); }
    .hw-card.oculta .img, .hw-card.oculta .tx { opacity: .45; filter: grayscale(.8); }
    .hw-card .img { aspect-ratio: 4 / 3; background: var(--ev-grad); position: relative; display: grid; place-items: center; font-size: 26px; font-weight: 800; color: rgba(11,18,21,.45); }
    .hw-card .img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .hw-card .chips { position: absolute; left: 8px; top: 8px; display: flex; gap: 4px; flex-wrap: wrap; z-index: 1; }
    .hw-card .chips span { font: 800 10px var(--ev-font); padding: 3px 7px; border-radius: 8px; background: rgba(11,18,21,.78); color: #fff; }
    .hw-card .chips span.mal { background: #D92D20; }
    .hw-card .chips span.oc { background: #475467; }
    /* Botones de la tarjeta (editar y ocultar): siempre visibles, también en táctil */
    .hw-card .acc { position: absolute; right: 8px; top: 8px; z-index: 1; display: flex; gap: 6px; }
    .hw-card .ojo, .hw-card .edt { width: 32px; height: 32px; border-radius: 10px; border: 0; background: rgba(255,255,255,.94); color: #0B1215; display: grid; place-items: center; cursor: pointer;
                                   box-shadow: 0 4px 12px -6px rgba(0,0,0,.45); transition: background .2s, transform .2s; }
    .hw-card .ojo:hover, .hw-card .edt:hover { background: var(--ev-aqua); transform: translateY(-1px); }
    .hw-card .tx { padding: 10px 12px 12px; }
    .hw-card .tx b { display: block; font-size: 14px; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .hw-card .tx small { display: block; color: var(--ev-muted); font-weight: 600; font-size: 11.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .hw-card .tx .pr { margin-top: 6px; font-size: 12px; color: var(--ev-muted); font-weight: 600; }
    .hw-card .tx .pr b { display: inline; font-size: 17px; color: var(--ev-text); }
    .hw-add { border: 2px dashed var(--ev-line); border-radius: 18px; background: transparent; min-height: 150px; display: grid; place-items: center; color: var(--ev-muted); font: 800 13px var(--ev-font); cursor: pointer; transition: all .2s; }
    .hw-add:hover { border-color: var(--ev-teal); color: var(--ev-deep); background: var(--ev-grad-soft); }
    .hw-add i { font-size: 22px; display: block; margin-bottom: 4px; }
    .hw-sin { margin-top: 22px; border-radius: 22px; padding: 14px; background: repeating-linear-gradient(135deg, var(--ev-surface-2) 0 12px, var(--ev-surface) 12px 24px); border: 1.5px dashed var(--ev-line); }
    .hw-nueva-sec { width: 100%; margin-top: 16px; padding: 16px; border-radius: 20px; border: 2px dashed var(--ev-line); background: transparent; font: 800 14px var(--ev-font); color: var(--ev-muted); cursor: pointer; }
    .hw-nueva-sec:hover { border-color: var(--ev-teal); color: var(--ev-deep); background: var(--ev-grad-soft); }
    .hw-tip { display: flex; gap: 8px; align-items: center; color: var(--ev-muted); font-weight: 600; font-size: 13px; }

    /* ---------- carrusel ---------- */
    .cr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
    .cr-card { border-radius: 22px; overflow: hidden; background: var(--ev-surface); border: 1px solid var(--ev-line); transition: transform .25s var(--ev-ease), box-shadow .25s, opacity .2s; }
    .cr-card[draggable="true"] { cursor: grab; }
    .cr-card:hover { transform: translateY(-3px); box-shadow: var(--ev-shadow); }
    .cr-card.arrastrando { opacity: .35; }
    .cr-card.sobre { outline: 3px solid var(--ev-teal); }
    .cr-card.inactivo .cr-img { filter: grayscale(.9); opacity: .55; }
    .cr-img { position: relative; aspect-ratio: 16 / 7; background: var(--ev-grad-soft); }
    .cr-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .cr-img .ord { position: absolute; left: 10px; top: 10px; width: 34px; height: 34px; border-radius: 11px; background: var(--ev-ink); color: var(--ev-aqua); display: grid; place-items: center; font-weight: 800; }
    .cr-img .ori { position: absolute; right: 10px; top: 10px; font: 800 11px var(--ev-font); padding: 4px 8px; border-radius: 8px; background: rgba(255,255,255,.92); }
    .cr-body { padding: 12px 14px 14px; }
    .cr-body .nombre { font-weight: 800; font-size: 13.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cr-fmt { display: flex; gap: 6px; margin: 8px 0; flex-wrap: wrap; }
    .cr-fmt span { font: 700 11px var(--ev-font); padding: 3px 8px; border-radius: 8px; background: #DCFCE7; color: #166534; }
    .cr-fmt span.no { background: #FEE4E2; color: #B42318; }
    .cr-precios { display: flex; gap: 6px; flex-wrap: wrap; min-height: 26px; }
    .cr-precios span { font: 700 11.5px var(--ev-font); padding: 4px 9px; border-radius: 9px; background: var(--ev-surface-2); border: 1px solid var(--ev-line); }
    .cr-precios span.mal { background: #FEF3C7; border-color: #FDE68A; color: #92400E; }
    .cr-pie { display: flex; align-items: center; gap: 8px; margin-top: 10px; }
    .cr-pie .sp { flex: 1; }
    .cr-mover { display: inline-flex; border: 1px solid var(--ev-line); border-radius: 11px; overflow: hidden; }
    .cr-mover button { border: 0; background: var(--ev-surface); width: 34px; height: 32px; cursor: pointer; color: var(--ev-text); font-size: 14px; }
    .cr-mover button + button { border-left: 1px solid var(--ev-line); }
    .cr-mover button:hover:not(:disabled) { background: var(--ev-ink); color: var(--ev-aqua); }
    .cr-mover button:disabled { opacity: .35; cursor: default; }
    .cr-nuevo { border: 2px dashed var(--ev-line); border-radius: 22px; background: transparent; min-height: 230px; display: grid; place-items: center; color: var(--ev-muted); font: 800 14px var(--ev-font); cursor: pointer; }
    .cr-nuevo:hover { border-color: var(--ev-teal); color: var(--ev-deep); background: var(--ev-grad-soft); }
    .cr-nuevo i { font-size: 30px; display: block; margin-bottom: 6px; }
    .cr-vistas { display: grid; grid-template-columns: 2fr 1.2fr .8fr; gap: 10px; align-items: end; }
    .cr-vista { text-align: center; }
    .cr-vista .im { border-radius: 14px; overflow: hidden; background: var(--ev-surface-2); border: 1px solid var(--ev-line); display: grid; place-items: center; color: var(--ev-muted); font-size: 12px; font-weight: 700; position: relative; }
    .cr-vista .im img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .cr-vista:nth-child(1) .im { aspect-ratio: 16 / 6; }
    .cr-vista:nth-child(2) .im { aspect-ratio: 4 / 3; }
    .cr-vista:nth-child(3) .im { aspect-ratio: 3 / 4; }
    .cr-vista small { display: block; margin: 6px 0; font-weight: 800; font-size: 12px; }
    .cr-vista label { font: 700 12px var(--ev-font); color: var(--ev-deep); cursor: pointer; }
    .cr-drop { border: 2px dashed var(--ev-line); cursor: pointer; transition: all .2s; }
    .cr-drop:hover, .cr-drop.over { border-color: var(--ev-teal); background: var(--ev-grad-soft); }
    .cr-dest { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr 120px auto; gap: 8px; align-items: end; }
    .cr-dest .ui-f { margin: 0; }

    /* ---------- tabla ---------- */
    .hw-mini { width: 54px; height: 38px; border-radius: 9px; object-fit: cover; background: var(--ev-grad-soft); display: block; }
    @@media (max-width: 1000px) { .cr-dest { grid-template-columns: 1fr 1fr; } .cr-vistas { grid-template-columns: 1fr 1fr 1fr; } }
</style>
}

@Html.AntiForgeryToken()

<section class="hw-hero ev-rise">
    <div>
        <h1><i class="bi bi-window-sidebar" style="color:var(--ev-aqua)"></i> Home de la web</h1>
        <p>Así ve la Home el cliente. Arrastra para ordenar el carrusel, las secciones y las tarjetas. Con el ojo ocultas sin borrar.</p>
    </div>
    <span class="sp"></span>
    <div class="acts">
        <button type="button" class="ev-btn light sm" id="hwAjustes"><i class="bi bi-sliders"></i> Ajustes</button>
        <button type="button" class="ev-btn light sm" id="hwRecalc"><i class="bi bi-arrow-repeat"></i> Recalcular precios del carrusel</button>
        <button type="button" class="ev-btn aqua sm" id="hwTraer"><i class="bi bi-magic"></i> Traer ofertas a la Home</button>
    </div>
    <div class="hw-kpis" id="hwKpis"></div>
</section>

<!-- Lo que está cargado pero NO sale en la Home, con el motivo -->
<div id="hwFuera"></div>

<div class="hw-barra">
    <div class="ui-tabs" id="hwTabs" style="margin:0">
        <button type="button" data-tab="pVista" class="on"><i class="bi bi-eye"></i> Vista de la Home</button>
        <button type="button" data-tab="pCarrusel"><i class="bi bi-images"></i> Carrusel <span class="n" id="nSlides">0</span></button>
        <button type="button" data-tab="pTabla"><i class="bi bi-table"></i> Todas las tarjetas <span class="n" id="nTarjetas">0</span></button>
    </div>
    <span class="sp"></span>
    <div class="hw-dev" id="hwDev" role="group" aria-label="Dispositivo">
        <button type="button" class="on" data-dev="web"><i class="bi bi-display"></i> Web</button>
        <button type="button" data-dev="tablet"><i class="bi bi-tablet"></i> Tablet</button>
        <button type="button" data-dev="movil"><i class="bi bi-phone"></i> Móvil</button>
    </div>
</div>

<!-- ============ VISTA ============ -->
<section class="ui-pane on" id="pVista">
    <div class="hw-marco" id="hwMarco" data-dev="web">
        <div class="hw-slider" id="hwSlider" title="Editar carrusel"></div>
        <div id="hwSecciones"><div class="ui-skel" style="height:300px;margin-top:18px"></div></div>
        <button type="button" class="hw-nueva-sec" id="hwNuevaSec"><i class="bi bi-plus-circle"></i> Nueva sección</button>
        <div class="hw-sin" id="hwSin"></div>
    </div>
    <p class="hw-tip" style="justify-content:center;margin-top:12px"><i class="bi bi-hand-index"></i> Arrastra las tarjetas entre secciones · arrastra <i class="bi bi-grip-vertical"></i> para mover una sección · clic en una tarjeta para editarla</p>
</section>

<!-- ============ CARRUSEL ============ -->
<section class="ui-pane" id="pCarrusel">
    <div class="ui-toolbar" style="margin-top:0">
        <div class="ui-chips" id="crFiltro">
            <button type="button" class="ui-pick on" data-v="1"><i class="bi bi-play-circle"></i> Activos</button>
            <button type="button" class="ui-pick" data-v="0"><i class="bi bi-pause-circle"></i> Inactivos</button>
            <button type="button" class="ui-pick" data-v=""><i class="bi bi-collection"></i> Todos</button>
        </div>
        <span style="flex:1"></span>
        <span class="hw-tip"><i class="bi bi-arrows-move"></i> Arrastra los activos para cambiar el orden</span>
    </div>
    <div class="cr-grid" id="crGrid"></div>
</section>

<!-- ============ TABLA ============ -->
<section class="ui-pane" id="pTabla">
    <div class="ui-toolbar" style="margin-top:0">
        <label class="ui-search"><i class="bi bi-search"></i><input id="tQ" type="search" placeholder="Buscar destino, origen, descripción, nº de servicio…"></label>
        <select class="ui-select" id="tTipo"><option value="">Todos los tipos</option><option>OFERTA</option><option>CIRCUITO</option><option>HOTEL</option><option>EXCURSION</option><option>TRASLADO</option><option>COMBINADO</option></select>
        <select class="ui-select" id="tSec"><option value="">Todas las secciones</option><option value="-1">Sin sección</option></select>
        <select class="ui-select" id="tEst"><option value="">Visibles y ocultas</option><option value="1">Visibles</option><option value="0">Ocultas</option><option value="v">Ya no se venden</option></select>
        <button type="button" class="ev-btn sm" onclick="HW.nuevaTarjeta()"><i class="bi bi-plus-lg"></i> Nueva tarjeta</button>
    </div>
    <div id="tLista"></div>
</section>

<!-- ============ PANEL: TARJETA ============ -->
<aside class="ui-drawer" id="dTarjeta" aria-hidden="true">
    <div class="ui-dh">
        <div class="ev-module-icon" style="width:46px;height:46px"><i class="bi bi-postcard"></i></div>
        <div style="min-width:0"><h2 id="tdTitulo">Tarjeta</h2><small id="tdSub"></small></div>
        <button class="ui-ibtn x" type="button" data-cerrar aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="ui-db" id="tdForm"></div>
    <div class="ui-df">
        <button class="ev-btn ghost" type="button" id="tdEliminar"><i class="bi bi-trash3"></i> Quitar de la Home</button>
        <span class="hint"><kbd>Ctrl</kbd> + <kbd>Enter</kbd> para guardar</span>
        <button class="ev-btn ghost" type="button" data-cerrar>Cancelar</button>
        <button class="ev-btn" type="button" id="tdGuardar"><i class="bi bi-check2-circle"></i> Guardar</button>
    </div>
</aside>

<!-- ============ PANEL: SLIDE ============ -->
<aside class="ui-drawer" id="dSlide" aria-hidden="true">
    <div class="ui-dh">
        <div class="ev-module-icon" style="width:46px;height:46px"><i class="bi bi-image"></i></div>
        <div style="min-width:0"><h2 id="sdTitulo">Slide</h2><small id="sdSub"></small></div>
        <button class="ui-ibtn x" type="button" data-cerrar aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="ui-db" id="sdForm"></div>
    <div class="ui-df">
        <button class="ev-btn ghost" type="button" id="sdEliminar"><i class="bi bi-trash3"></i> Eliminar slide</button>
        <span style="flex:1"></span>
        <button class="ev-btn ghost" type="button" data-cerrar>Cerrar</button>
        <button class="ev-btn" type="button" id="sdGuardar"><i class="bi bi-check2-circle"></i> Guardar</button>
    </div>
</aside>

@section Scripts {
<script src="~/js/eurovip-ui.js" asp-append-version="true"></script>
<script src="~/js/eurovip-carga.js" asp-append-version="true"></script>
<script>
const HW = (() => {
    const $ = (s, el = document) => el.querySelector(s);
    const $$ = (s, el = document) => [...el.querySelectorAll(s)];
    const esc = EV.esc;
    let D = null, cat = null, dev = 'web', crFiltro = '1', rot = null, slideActual = null, tarjetaActual = null;
    const dT = EV.drawer($('#dTarjeta')), dS = EV.drawer($('#dSlide'));
    const tabs = EV.tabs($('#hwTabs'));
    const PRECIO_ALERTA = 400;   // como BackTiTan: precio de slide menor a esto se marca

    const todas = () => [...D.contenedores.flatMap(c => c.tarjetas), ...D.sinContenedor];
    const img = (ruta, d = dev) => !ruta ? '' : `${{ web: D.imagenes.web, tablet: D.imagenes.tablet, movil: D.imagenes.movil }[d]}/${encodeURIComponent(ruta)}`;
    // t.imagen la calcula el servidor desde las carpetas del proyecto (fotos de Hoteles y portadas de Circuitos)
    const carat = t => t.imagen || (t.caratulaDestino && (EV.esUrl(t.caratulaDestino) || t.caratulaDestino.startsWith('/')) ? t.caratulaDestino : null);
    const tipoChip = { OFERTA: 'Oferta', CIRCUITO: 'Circuito', HOTEL: 'Hotel', EXCURSION: 'Excursiones', TRASLADO: 'Traslados', COMBINADO: 'Combinado' };

    async function cargar() {
        D = await EV.api('/HomeWeb/Datos');
        pintarTodo();
    }

    /** Aviso: circuitos y destinos de ofertas que no salen en la Home y por qué (para no tener que adivinarlo). */
    function pintarFuera() {
        const f = D.fuera || [];
        const sinVenta = f.filter(x => !x.proxima);   // incluye hoteles ocultos o sin sección
        if (!f.length) { $('#hwFuera').innerHTML = ''; return; }
        // Desplegable cerrado de entrada (solo el resumen); dentro, un grupo desplegable por tipo
        const grupos = [['CIRCUITO', 'Circuitos', 'bi-signpost-split'], ['OFERTA', 'Ofertas de hotel', 'bi-building'], ['HOTEL', 'Hoteles', 'bi-house-heart']]
            .map(([t, n, i]) => ({ t, n, i, l: f.filter(x => (['CIRCUITO', 'HOTEL'].includes(x.tipo) ? x.tipo : 'OFERTA') === t) })).filter(g => g.l.length);
        let abierto = false; try { abierto = localStorage.getItem('ev.homeweb.fuera') === '1'; } catch { }
        const item = x => `
                    <div class="it">
                        <span class="ic ${x.proxima ? '' : 'mal'}"><i class="bi ${x.tipo === 'CIRCUITO' ? 'bi-signpost-split' : x.tipo === 'HOTEL' ? 'bi-house-heart' : 'bi-building'}"></i></span>
                        <div class="tx"><b>${esc(x.nombre)} <small>${x.tipo === 'CIRCUITO' ? 'Circuito' : x.tipo === 'HOTEL' ? 'Hotel' : 'Ofertas de hotel'}</small></b><span>${esc(x.motivo)}</span></div>
                        ${x.url ? `<a class="ev-btn sm" href="${esc(x.url)}"><i class="bi ${x.tipo === 'HOTEL' ? 'bi-pencil' : 'bi-plus-lg'}"></i> ${esc(x.accion)}</a>` : ''}
                    </div>`;
        $('#hwFuera').innerHTML = `
            <details class="hw-fuera ${sinVenta.length ? 'mal' : ''}" ${abierto ? 'open' : ''}>
                <summary><i class="bi ${sinVenta.length ? 'bi-exclamation-triangle-fill' : 'bi-info-circle-fill'}"></i>
                    <b>${f.length} ${f.length === 1 ? 'cosa cargada no sale' : 'cosas cargadas no salen'} en la Home</b>
                    <span class="chips">${grupos.map(g => `<em>${g.l.length} ${g.n.toLowerCase()}</em>`).join('')}</span>
                    <span>${sinVenta.length ? `${sinVenta.length} sin fechas a la venta · ` : ''}toca para ver por qué</span><i class="bi bi-chevron-down fl"></i></summary>
                <div class="hw-fuera-l">${grupos.map(g => `
                    <details class="hw-fuera-g" ${grupos.length === 1 ? 'open' : ''}>
                        <summary><i class="bi ${g.i}"></i> ${g.n} <span class="n">${g.l.length}</span><i class="bi bi-chevron-down fl"></i></summary>
                        <div class="hw-fuera-l">${g.l.map(item).join('')}</div>
                    </details>`).join('')}
                </div>
            </details>`;
        $('#hwFuera .hw-fuera').addEventListener('toggle', e => { try { localStorage.setItem('ev.homeweb.fuera', e.target.open ? '1' : '0'); } catch { } });
    }

    function pintarTodo() {
        pintarFuera();
        const ts = todas(), vencidas = ts.filter(t => t.vigente === false && t.estado).length, ocultas = ts.filter(t => !t.estado).length;
        const activos = D.slides.filter(s => s.activo).length;
        $('#hwKpis').innerHTML = [
            [activos, 'slides activos en el carrusel'], [D.contenedores.filter(c => c.estado).length, 'secciones visibles'],
            [ts.filter(t => t.estado).length, 'tarjetas visibles'], [ocultas, 'tarjetas ocultas'],
            ...(vencidas ? [[vencidas, 'ya no se venden', 'alerta']] : [])
        ].map(([n, t, c]) => `<div class="hw-kpi ${c || ''}"><b>${EV.fmt(n)}</b><small>${t}</small></div>`).join('');
        $('#nSlides').textContent = D.slides.length; $('#nTarjetas').textContent = ts.length;
        $('#tSec').innerHTML = '<option value="">Todas las secciones</option><option value="-1">Sin sección</option>' + D.contenedores.map(c => `<option value="${c.id_Contenedor}">${esc(c.nombre)}</option>`).join('');
        pintarSlider(); pintarSecciones(); pintarCarrusel(); pintarTabla();
    }

    // ===================== VISTA: slider =====================
    function pintarSlider() {
        clearInterval(rot);
        const act = D.slides.filter(s => s.activo).sort((a, b) => a.orden - b.orden);
        const s = $('#hwSlider');
        if (!act.length) { s.innerHTML = '<div class="vacio"><div><i class="bi bi-images" style="font-size:30px;display:block"></i>No hay slides activos. Clic para ir al carrusel.</div></div>'; return; }
        s.innerHTML = act.map((x, i) => `<img src="${esc(img(x.ruta))}" data-i="${i}" class="${i === 0 ? 'on' : ''}" alt="" onerror="this.style.display='none'">`).join('') +
            `<button type="button" class="editar" aria-label="Editar carrusel"><i class="bi bi-pencil"></i> Editar carrusel</button><span class="precio" id="hwPrecio" hidden></span><div class="puntos">${act.map((_, i) => `<i class="${i === 0 ? 'on' : ''}" data-ir="${i}" title="Slide ${i + 1}"></i>`).join('')}</div>` +
            (act.length > 1 ? `<button type="button" class="flecha ant" data-paso="-1" aria-label="Slide anterior" title="Anterior"><i class="bi bi-chevron-left"></i></button>
                              <button type="button" class="flecha sig" data-paso="1" aria-label="Slide siguiente" title="Siguiente"><i class="bi bi-chevron-right"></i></button>` : '');
        let i = 0;
        const mostrar = k => {
            $$('#hwSlider img').forEach((im, j) => im.classList.toggle('on', j === k)); $$('#hwSlider .puntos i').forEach((p, j) => p.classList.toggle('on', j === k));
            const pr = act[k].destinos.filter(d => d.precio > 0).sort((a, b) => a.precio - b.precio)[0];
            const el = $('#hwPrecio'); el.hidden = !pr; if (pr) el.innerHTML = `${esc(pr.destino)} desde <b>${EV.dinero(pr.precio)}</b>`;
        };
        const automatico = () => { clearInterval(rot); if (act.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) rot = setInterval(() => { i = (i + 1) % act.length; mostrar(i); }, 3800); };
        // Flechas y puntos: van al slide y el paso automático vuelve a empezar desde ahí
        s.onclick = e => {
            const p = e.target.closest('[data-paso]'), d = e.target.closest('[data-ir]');
            if (!p && !d) return tabs.ir('pCarrusel');
            e.stopPropagation();
            i = p ? (i + +p.dataset.paso + act.length) % act.length : +d.dataset.ir;
            mostrar(i); automatico();
        };
        s.onkeydown = e => { if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') { e.preventDefault(); i = (i + (e.key === 'ArrowLeft' ? -1 : 1) + act.length) % act.length; mostrar(i); automatico(); } };
        mostrar(0); automatico();
    }

    // ===================== VISTA: secciones y tarjetas =====================
    /** Sin sección (o de una sección que ya no existe): la base la deja oculta (trigger trInicioSinSeccion). */
    const sinSeccion = t => !D.contenedores.some(c => c.id_Contenedor === t.id_Contenedor);
    const cardHtml = t => {
        const c = carat(t), sin = sinSeccion(t);
        return `<div class="hw-card ${t.estado ? '' : 'oculta'}" draggable="true" data-t="${t.id}" title="Clic para editar · arrastra para mover">
            <div class="img">${c ? `<img src="${esc(c)}" alt="" loading="lazy" onerror="this.remove()">` : esc(EV.iniciales(t.id_Destino))}
                <div class="chips"><span>${tipoChip[t.tipo_Servicio] || esc(t.tipo_Servicio)}</span>${t.vigente === false ? '<span class="mal">Ya no se vende</span>' : ''}${t.estado ? '' : `<span class="oc">${sin ? 'Oculta · sin sección' : 'Oculta'}</span>`}</div>
                <div class="acc"><button type="button" class="edt" title="Editar tarjeta" aria-label="Editar tarjeta"><i class="bi bi-pencil"></i></button>
                    <button type="button" class="ojo" data-ojo="${t.id}" title="${sin ? 'Sin sección: arrástrala a una sección para que salga en la web' : t.estado ? 'Ocultar en la web' : 'Mostrar en la web'}" aria-label="${t.estado ? 'Ocultar en la web' : 'Mostrar en la web'}"><i class="bi ${t.estado ? 'bi-eye-slash' : 'bi-eye'}"></i></button></div></div>
            <div class="tx"><b>${esc(t.descripcion && ['CIRCUITO', 'EXCURSION', 'TRASLADO'].includes(t.tipo_Servicio) ? t.descripcion : t.id_Destino)}</b><small>${esc(t.origen)} · ${esc(t.campanya || '#' + t.id_Campanya)}${t.noches ? ` · ${t.noches} noches` : ''}</small>
                <div class="pr">${t.precioWeb ? `desde <b>${EV.dinero(t.precioWeb)}</b>` : 'sin precio'}</div></div></div>`;
    };

    function pintarSecciones() {
        $('#hwSecciones').innerHTML = D.contenedores.map(c => `
            <section class="hw-sec ${c.estado ? '' : 'oculta'}" data-sec="${c.id_Contenedor}">
                <div class="hw-sec-h">
                    <span class="asa" draggable="true" data-asa="${c.id_Contenedor}" title="Arrastra para mover la sección"><i class="bi bi-grip-vertical"></i></span>
                    <h3>${esc(c.nombre)}</h3><span class="n">${c.tarjetas.length}</span>${c.estado ? '' : '<span class="ui-chip ghost" style="padding:2px 9px">Oculta</span>'}
                    <span class="sp"></span>
                    <button type="button" class="ui-ibtn" data-secojo="${c.id_Contenedor}" title="${c.estado ? 'Ocultar sección' : 'Mostrar sección'}"><i class="bi ${c.estado ? 'bi-eye-slash' : 'bi-eye'}"></i></button>
                    <button type="button" class="ui-ibtn" data-secren="${c.id_Contenedor}" title="Cambiar nombre"><i class="bi bi-pencil"></i></button>
                    <button type="button" class="ui-ibtn danger" data-secdel="${c.id_Contenedor}" title="Eliminar sección"><i class="bi bi-trash3"></i></button>
                </div>
                <div class="hw-cards" data-cards="${c.id_Contenedor}">${c.tarjetas.map(cardHtml).join('')}<button type="button" class="hw-add" data-addsec="${c.id_Contenedor}"><span><i class="bi bi-plus-circle"></i>Agregar tarjeta</span></button></div>
            </section>`).join('') || '<div class="ui-empty"><p>No hay secciones. Crea la primera.</p></div>';
        $('#hwSin').innerHTML = `<div class="hw-sec-h"><i class="bi bi-inbox" style="font-size:18px;color:var(--ev-muted)"></i><h3 style="font-size:14px">Sin sección</h3><span class="n">${D.sinContenedor.length}</span>
                <span class="hw-tip" style="margin-left:8px"><i class="bi bi-eye-slash"></i> ocultas en la web hasta que las pongas en una sección</span></div>
            <div class="hw-cards" data-cards="">${D.sinContenedor.map(cardHtml).join('') || '<span class="hw-tip" style="padding:10px">Vacío. Puedes soltar aquí una tarjeta para sacarla de su sección.</span>'}</div>`;
    }

    // ---------- arrastrar y soltar ----------
    let arrastre = null;   // { tipo: 'card'|'sec'|'slide', id, el }
    function destinoAntes(cont, y, x, sel) {
        const items = $$(sel, cont).filter(e => !e.classList.contains('arrastrando'));
        return items.find(e => { const r = e.getBoundingClientRect(); return y < r.top + r.height / 2 && (x < r.left + r.width / 2 || y < r.top); });
    }
    document.addEventListener('dragstart', e => {
        const card = e.target.closest?.('.hw-card'), asa = e.target.closest?.('[data-asa]'), sl = e.target.closest?.('.cr-card[draggable="true"]');
        if (asa) { arrastre = { tipo: 'sec', el: asa.closest('.hw-sec') }; }
        else if (card) arrastre = { tipo: 'card', el: card, origen: card.parentElement };
        else if (sl) arrastre = { tipo: 'slide', el: sl };
        else return;
        arrastre.el.classList.add('arrastrando');
        e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', '');
    });
    document.addEventListener('dragover', e => {
        if (!arrastre) return;
        if (arrastre.tipo === 'card') {
            const cont = e.target.closest('.hw-cards'); if (!cont) return;
            e.preventDefault();
            $$('.hw-cards.sobre').forEach(c => c !== cont && c.classList.remove('sobre')); cont.classList.add('sobre');
            const antes = destinoAntes(cont, e.clientY, e.clientX, '.hw-card') || $('.hw-add', cont);
            antes ? cont.insertBefore(arrastre.el, antes) : cont.appendChild(arrastre.el);
        } else if (arrastre.tipo === 'sec') {
            const cont = $('#hwSecciones'); if (!e.target.closest('#hwSecciones')) return;
            e.preventDefault();
            const antes = $$('.hw-sec', cont).filter(s => s !== arrastre.el).find(s => e.clientY < s.getBoundingClientRect().top + s.getBoundingClientRect().height / 2);
            antes ? cont.insertBefore(arrastre.el, antes) : cont.appendChild(arrastre.el);
        } else if (arrastre.tipo === 'slide') {
            const cont = $('#crGrid'), sobre = e.target.closest('.cr-card[draggable="true"]'); if (!sobre || sobre === arrastre.el) { if (e.target.closest('#crGrid')) e.preventDefault(); return; }
            e.preventDefault();
            const r = sobre.getBoundingClientRect();
            cont.insertBefore(arrastre.el, e.clientX < r.left + r.width / 2 ? sobre : sobre.nextSibling);
        }
    });
    document.addEventListener('drop', e => { if (arrastre) e.preventDefault(); });
    document.addEventListener('dragend', async () => {
        if (!arrastre) return;
        const a = arrastre; arrastre = null;
        a.el.classList.remove('arrastrando'); $$('.sobre').forEach(x => x.classList.remove('sobre'));
        try {
            if (a.tipo === 'card') {
                const cont = a.el.parentElement, sec = cont.dataset.cards;
                const ids = $$('.hw-card', cont).map(c => +c.dataset.t);
                await EV.post('/HomeWeb/OrdenTarjetas', { Id_Contenedor: sec === '' ? null : +sec, Ids: ids });
                if (a.origen !== cont) EV.toast(sec === '' ? 'Tarjeta sacada de la sección.' : `Tarjeta movida a ${D.contenedores.find(c => c.id_Contenedor === +sec)?.nombre}.`);
                await cargar();
            } else if (a.tipo === 'sec') {
                await EV.post('/HomeWeb/OrdenSecciones', $$('#hwSecciones .hw-sec').map(s => +s.dataset.sec));
                EV.toast('Orden de secciones guardado.'); await cargar();
            } else if (a.tipo === 'slide') {
                await EV.post('/HomeWeb/OrdenSlides', $$('#crGrid .cr-card[draggable="true"]').map(s => +s.dataset.s));
                EV.toast('Orden del carrusel guardado.'); await cargar();
            }
        } catch (err) { EV.toast(err.message, 'err'); cargar(); }
    });

    // ===================== CARRUSEL =====================
    function pintarCarrusel() {
        const lista = D.slides.filter(s => crFiltro === '' || String(+s.activo) === crFiltro).sort((a, b) => (b.activo - a.activo) || a.orden - b.orden);
        const activosOrden = D.slides.filter(x => x.activo).sort((a, b) => a.orden - b.orden).map(x => x.id_Carrusel);
        $('#crGrid').innerHTML = `<button type="button" class="cr-nuevo" onclick="HW.nuevoSlide()"><span><i class="bi bi-plus-circle"></i>Nuevo slide</span></button>` + lista.map(s => {
            const pos = activosOrden.indexOf(s.id_Carrusel);
            const malos = s.destinos.filter(d => d.precio > 0 && d.precio < PRECIO_ALERTA).length;
            return `<article class="cr-card ${s.activo ? '' : 'inactivo'}" data-s="${s.id_Carrusel}" ${s.activo ? 'draggable="true"' : ''}>
                <div class="cr-img"><img src="${esc(img(s.ruta, 'web'))}" alt="" loading="lazy" onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'ui-empty',style:'padding:30px 10px;margin:0',textContent:'Imagen no disponible'}))">
                    ${s.activo ? `<span class="ord">${s.orden}</span>` : ''}<span class="ori">${s.orientacion === 'V' ? '▯ Vertical' : '▭ Horizontal'}</span></div>
                <div class="cr-body"><div class="nombre" title="${esc(s.ruta)}">${esc(s.ruta)}</div>
                    <div class="cr-fmt"><span>Web</span><span class="${s.tieneTablet ? '' : 'no'}">Tablet</span><span class="${s.tieneMovil ? '' : 'no'}">Móvil</span>${s.url ? '<span style="background:var(--ev-surface-2);color:var(--ev-text)"><i class="bi bi-link-45deg"></i> enlace</span>' : ''}</div>
                    <div class="cr-precios">${s.destinos.length ? s.destinos.slice(0, 3).map(d => `<span class="${d.precio > 0 && d.precio < PRECIO_ALERTA ? 'mal' : ''}" title="${esc(d.origen)} → ${esc(d.destino)} · campaña ${d.id_Campanya}">${esc(d.destino)} ${d.precio > 0 ? EV.dinero(d.precio) : 'sin precio'}</span>`).join('') + (s.destinos.length > 3 ? `<span>+${s.destinos.length - 3}</span>` : '') : '<span style="color:var(--ev-muted)">Sin precio "desde"</span>'}</div>
                    ${malos ? `<div class="ui-help" style="color:#B54708;margin-top:6px"><i class="bi bi-exclamation-triangle"></i> ${malos} precio(s) menores a ${EV.dinero(PRECIO_ALERTA)}: revísalos</div>` : ''}
                    <div class="cr-pie"><label class="ui-switch" title="Activo en la web"><input type="checkbox" data-sact="${s.id_Carrusel}" ${s.activo ? 'checked' : ''}><span class="tr"></span> ${s.activo ? 'Activo' : 'Inactivo'}</label>
                        <span class="sp"></span>${s.activo ? `<span class="cr-mover" role="group" aria-label="Mover en el carrusel">
                            <button type="button" data-smover="${s.id_Carrusel}" data-paso="-1" ${pos <= 0 ? 'disabled' : ''} title="Mover hacia atrás (antes)" aria-label="Mover hacia atrás"><i class="bi bi-chevron-left"></i></button>
                            <button type="button" data-smover="${s.id_Carrusel}" data-paso="1" ${pos >= activosOrden.length - 1 ? 'disabled' : ''} title="Mover hacia delante (después)" aria-label="Mover hacia delante"><i class="bi bi-chevron-right"></i></button></span>` : ''}<button type="button" class="ev-btn ghost sm" data-sed="${s.id_Carrusel}"><i class="bi bi-pencil"></i> Editar</button></div></div></article>`;
        }).join('');
    }

    /** Flechas del carrusel: cambia el slide de lugar con el de al lado y guarda el orden (igual que arrastrar). */
    async function moverSlide(id, paso) {
        const orden = D.slides.filter(x => x.activo).sort((a, b) => a.orden - b.orden).map(x => x.id_Carrusel);
        const i = orden.indexOf(id), j = i + paso;
        if (i < 0 || j < 0 || j >= orden.length) return;
        [orden[i], orden[j]] = [orden[j], orden[i]];
        try {
            await EV.post('/HomeWeb/OrdenSlides', orden);
            await cargar();
            EV.toast(`Slide movido a la posición ${j + 1}.`);
            const el = document.querySelector(`#crGrid .cr-card[data-s="${id}"] [data-smover][data-paso="${paso}"]:not(:disabled)`)
                    || document.querySelector(`#crGrid .cr-card[data-s="${id}"] [data-smover]:not(:disabled)`);
            el?.focus();
        } catch (e) { EV.toast(e.message, 'err'); }
    }

    async function abrirSlide(id) {
        const s = D.slides.find(x => x.id_Carrusel === id); if (!s) return;
        slideActual = s; cat ??= await EVC.catalogos();
        $('#sdTitulo').textContent = s.ruta; $('#sdSub').textContent = s.activo ? `Posición ${s.orden} del carrusel` : 'Inactivo (no sale en la web)';
        $('#sdEliminar').hidden = false; $('#sdGuardar').hidden = false;
