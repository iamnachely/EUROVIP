@{
    ViewData["Title"] = "Excursiones";
}

@section Styles {
<link rel="stylesheet" href="~/css/eurovip-ui.css" asp-append-version="true" />
<style>
    /* Indicadores que también filtran */
    .ex-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 18px 0 4px; }
    .ex-kpi { text-align: left; border: 1px solid var(--ev-line); background: var(--ev-surface); border-radius: 18px; padding: 14px 16px; cursor: pointer; font: inherit; color: inherit;
              transition: border-color .2s, transform .2s, box-shadow .2s; }
    .ex-kpi:hover { transform: translateY(-2px); box-shadow: var(--ev-shadow); }
    .ex-kpi.on { border-color: var(--ev-teal); box-shadow: 0 0 0 4px rgba(116,242,230,.3); }
    .ex-kpi b { display: block; font-size: 26px; font-weight: 800; letter-spacing: -.6px; }
    .ex-kpi small { color: var(--ev-muted); font-weight: 700; font-size: 12.5px; display: flex; align-items: center; gap: 6px; }
    .ex-kpi.mal b { color: #B54708; }
    .ex-vista { display: inline-flex; border: 1px solid var(--ev-line); border-radius: 12px; overflow: hidden; }
    .ex-vista button { border: 0; background: var(--ev-surface); padding: 9px 12px; cursor: pointer; color: var(--ev-muted); font-size: 15px; }
    .ex-vista button.on { background: var(--ev-ink); color: var(--ev-aqua); }
    .ex-cuenta { color: var(--ev-muted); font-weight: 700; font-size: 13px; margin: 6px 0 12px; }

    /* Tarjetas */
    .ex-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 18px; }
    .ex-card { display: flex; flex-direction: column; border-radius: 22px; overflow: hidden; background: var(--ev-surface); border: 1px solid var(--ev-line);
               transition: transform .3s var(--ev-ease), box-shadow .3s, border-color .3s; animation: uiFade .4s var(--ev-ease) both; animation-delay: calc(var(--n,0) * 25ms); }
    .ex-card:hover { transform: translateY(-4px); box-shadow: var(--ev-shadow); border-color: var(--ev-aqua); }
    .ex-foto { position: relative; aspect-ratio: 16/10; background: var(--ev-grad); overflow: hidden; cursor: pointer; }
    .ex-foto img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s var(--ev-ease); display: block; }
    .ex-card:hover .ex-foto img { transform: scale(1.05); }
    .ex-foto .sin { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; color: var(--ev-ink); font-weight: 800; font-size: 13px; padding: 12px; }
    .ex-foto .sin i { font-size: 30px; display: block; margin-bottom: 4px; opacity: .7; }
    .ex-foto.sobre { outline: 3px dashed var(--ev-teal); outline-offset: -8px; }
    .ex-foto .subiendo { position: absolute; inset: 0; background: rgba(11,18,21,.55); color: #fff; display: grid; place-items: center; font-weight: 800; }
    .ex-precio { position: absolute; right: 10px; bottom: 10px; background: var(--ev-ink); color: var(--ev-aqua); border-radius: 12px; padding: 6px 10px; font-weight: 800; font-size: 15px; }
    .ex-cuerpo { padding: 14px 16px 12px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
    .ex-cuerpo h3 { margin: 0; font-size: 16px; font-weight: 800; line-height: 1.3; }
    .ex-chips { display: flex; gap: 6px; flex-wrap: wrap; }
    .ex-chip { font: 700 11.5px var(--ev-font); padding: 4px 9px; border-radius: 9px; background: var(--ev-surface-2); border: 1px solid var(--ev-line); display: inline-flex; gap: 5px; align-items: center; }
    .ex-chip.ok { background: #ECFDF3; color: #067647; border-color: #ABEFC6; }
    .ex-chip.no { background: #FEF3F2; color: #B42318; border-color: #FECDCA; }
    .ex-chip.av { background: #FFFAEB; color: #93370D; border-color: #FEDF89; }
    .ex-desc { color: var(--ev-muted); font-size: 13px; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .ex-pie { display: flex; gap: 6px; margin-top: auto; padding-top: 6px; align-items: center; }
    .ex-pie .sp { flex: 1; }
    .ex-pie .n { color: var(--ev-muted); font: 700 11.5px var(--ev-font); }
    /* Barra de destinos */
    .ex-dests { display: flex; gap: 10px; overflow-x: auto; padding: 4px 2px 12px; margin: 4px 0 6px; scroll-snap-type: x proximity; }
    .ex-dest { flex: 0 0 auto; display: flex; align-items: center; gap: 10px; padding: 7px 14px 7px 7px; border-radius: 16px; border: 1px solid var(--ev-line);
               background: var(--ev-surface); cursor: pointer; font: inherit; color: inherit; text-align: left; scroll-snap-align: start; transition: border-color .2s, box-shadow .2s, transform .2s; }
    .ex-dest:hover { transform: translateY(-2px); box-shadow: var(--ev-shadow); }
    .ex-dest.on { border-color: var(--ev-teal); box-shadow: 0 0 0 4px rgba(116,242,230,.3); }
    .ex-dest .ico { width: 42px; height: 42px; border-radius: 12px; overflow: hidden; background: var(--ev-grad); display: grid; place-items: center; font-size: 18px; flex-shrink: 0; }
    .ex-dest .ico img { width: 100%; height: 100%; object-fit: cover; }
    .ex-dest b { display: block; font-size: 14px; }
    .ex-dest small { color: var(--ev-muted); font-weight: 600; font-size: 12px; }

    /* Sección de un destino */
    .ex-sec { margin-bottom: 28px; scroll-margin-top: 90px; }
    .ex-sec-h { position: relative; min-height: 170px; border-radius: 26px; overflow: hidden; display: flex; align-items: flex-end; gap: 16px; padding: 22px 24px;
                background: linear-gradient(135deg, #0E8F86, #2BD4C4 55%, #74F2E6); color: #fff; margin-bottom: 16px; isolation: isolate; }
    .ex-sec-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transform: scale(1.02); transition: transform 1.2s var(--ev-ease); }
    .ex-sec-h:hover .ex-sec-img { transform: scale(1.07); }
    .ex-sec-h::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(11,18,21,.78) 0%, rgba(11,18,21,.45) 55%, rgba(11,18,21,.12) 100%); }
    .ex-sec-h.sinfoto::before { background: linear-gradient(90deg, rgba(11,18,21,.35), transparent); }
    .ex-sec-txt { flex: 1; min-width: 0; }
    .ex-sec-pais { display: inline-flex; gap: 6px; align-items: center; font: 800 11.5px var(--ev-font); letter-spacing: .08em; text-transform: uppercase; background: rgba(255,255,255,.18);
                   border: 1px solid rgba(255,255,255,.35); padding: 4px 10px; border-radius: 99px; backdrop-filter: blur(6px); }
    .ex-sec-h h2 { margin: 8px 0 2px; font-size: clamp(26px, 3.2vw, 38px); font-weight: 800; letter-spacing: -1px; line-height: 1.05; text-shadow: 0 2px 14px rgba(0,0,0,.35); }
    .ex-sec-h p { margin: 0; font-weight: 600; opacity: .95; }
    .ex-sec-avisos { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
    .ex-sec-avisos span { font: 700 12px var(--ev-font); padding: 4px 10px; border-radius: 99px; background: rgba(255,250,235,.95); color: #93370D; display: inline-flex; gap: 5px; align-items: center; }
    .ex-sec-avisos span.ok { background: rgba(236,253,243,.95); color: #067647; }
    .ex-sec-acc { display: flex; gap: 8px; align-items: center; flex-shrink: 0; }
    .ex-sec-pleg { width: 42px; height: 42px; border-radius: 14px; border: 1px solid rgba(255,255,255,.45); background: rgba(255,255,255,.15); color: #fff; cursor: pointer;
                   font-size: 18px; backdrop-filter: blur(6px); transition: transform .3s; }
    .ex-sec.plegada .ex-sec-pleg { transform: rotate(-90deg); }
    .ex-sec.plegada .ex-sec-cuerpo { display: none; }
    .ex-sec.plegada .ex-sec-h { margin-bottom: 0; }
    @@media (max-width: 700px) { .ex-sec-h { flex-direction: column; align-items: flex-start; } }
    .ex-tabla td.img { width: 70px; }
    .ex-tabla td.img img, .ex-tabla td.img span { width: 60px; height: 40px; border-radius: 8px; object-fit: cover; display: block; background: var(--ev-grad); }
    .ex-tabla tbody tr { cursor: pointer; }

    /* Editor */
    .ex-zona { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 16px; align-items: center; padding: 12px; border-radius: 18px; border: 2px dashed var(--ev-line);
               background: var(--ev-surface-2); margin-bottom: 18px; transition: border-color .2s, background .2s; }
    .ex-zona.sobre { border-color: var(--ev-teal); background: var(--ev-mint); }
    .ex-zona-prev { aspect-ratio: 16/10; border-radius: 12px; overflow: hidden; background: var(--ev-grad); display: grid; place-items: center; position: relative; }
    .ex-zona-prev img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .ex-zona-prev .sin { color: var(--ev-ink); font-weight: 700; font-size: 12.5px; opacity: .75; text-align: center; padding: 8px; }
    .ex-zona-prev .barra { position: absolute; left: 10px; right: 10px; bottom: 10px; height: 8px; border-radius: 9px; background: rgba(255,255,255,.6); overflow: hidden; }
    .ex-zona-prev .barra i { display: block; height: 100%; width: 0; background: var(--ev-teal); transition: width .2s; }
    .ex-zona-acc { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .ex-zona-acc small { flex-basis: 100%; color: var(--ev-muted); font-weight: 600; }
    .ex-money { display: flex; align-items: center; border: 1px solid var(--ev-line); border-radius: 14px; background: var(--ev-surface); overflow: hidden; }
    .ex-money b { padding: 0 12px; color: var(--ev-muted); font-weight: 800; }
    .ex-money input { border: 0 !important; box-shadow: none !important; flex: 1; min-width: 0; }
    .ex-herr { display: flex; gap: 6px; margin-bottom: 6px; flex-wrap: wrap; }
    .ex-herr button { border: 1px solid var(--ev-line); background: var(--ev-surface); border-radius: 10px; padding: 6px 10px; cursor: pointer; font: 700 12.5px var(--ev-font); color: var(--ev-text); }
    .ex-herr button:hover { background: var(--ev-aqua); color: var(--ev-ink); }
    .ex-prev-desc { border: 1px solid var(--ev-line); border-radius: 14px; padding: 12px 14px; background: var(--ev-surface-2); font-size: 14px; line-height: 1.55; max-height: 240px; overflow: auto; }
    .ex-prev-desc :first-child { margin-top: 0; }
    .ex-prev-desc :last-child { margin-bottom: 0; }
    .ex-ver-img { width: 100%; aspect-ratio: 16/9; object-fit: cover; border-radius: 16px; background: var(--ev-grad); display: block; margin-bottom: 14px; }
    .ex-busc { position: absolute; left: 0; right: 0; top: 100%; z-index: 30; background: var(--ev-surface); border: 1px solid var(--ev-line); border-radius: 14px; box-shadow: var(--ev-shadow); margin-top: 4px; max-height: 260px; overflow: auto; }
    .ex-busc button { display: flex; width: 100%; justify-content: space-between; gap: 8px; border: 0; background: none; padding: 9px 12px; cursor: pointer; font: 600 13.5px var(--ev-font); color: var(--ev-text); text-align: left; }
    .ex-busc button:hover, .ex-busc button.on { background: var(--ev-surface-2); }
    .ex-busc small { color: var(--ev-muted); }
    @@media (max-width: 640px) { .ex-zona { grid-template-columns: 1fr; } }
</style>
}

@Html.AntiForgeryToken()

<section class="ui-hero ev-rise">
    <i class="bi bi-compass ui-hero-ico" aria-hidden="true"></i>
    <div>
        <span class="ev-chip dark"><i class="bi bi-compass"></i> Catálogo · Excursiones</span>
        <h1>Excursiones</h1>
        <p>Busca, carga y edita las excursiones de cada destino con su precio, si se puede cancelar, su descripción y su foto. Arrastra una foto encima de una tarjeta para ponérsela.</p>
    </div>
    <div class="ui-hero-acts">
        <a class="ev-btn light" href="/Excursiones/Plantilla"><i class="bi bi-download"></i> Descargar plantilla</a>
        <button class="ev-btn light" type="button" id="exExcel"><i class="bi bi-file-earmark-excel"></i> Cargar Excel</button>
        <button class="ev-btn" type="button" id="exNueva"><i class="bi bi-plus-lg"></i> Nueva excursión</button>
    </div>
    <svg class="ui-hero-waves" viewBox="0 0 600 40" preserveAspectRatio="none" aria-hidden="true">
        <g><path d="M-240 18 q30 -8 60 0 t60 0 q30 -8 60 0 t60 0 q30 -8 60 0 t60 0 q30 -8 60 0 t60 0 q30 -8 60 0 t60 0 q30 -8 60 0 t60 0 q30 -8 60 0 t60 0 L840 40 L-240 40 Z" fill="#fff" /></g>
        <g><path d="M-240 26 q30 -6 60 0 t60 0 q30 -6 60 0 t60 0 q30 -6 60 0 t60 0 q30 -6 60 0 t60 0 q30 -6 60 0 t60 0 q30 -6 60 0 t60 0 q30 -6 60 0 t60 0 L840 40 L-240 40 Z" fill="#fff" /></g>
    </svg>
</section>

<div class="ex-kpis" id="exKpis" aria-label="Resumen (pulsa para filtrar)"></div>

<div class="ui-toolbar">
    <label class="ui-search"><i class="bi bi-search"></i><input id="exQ" type="search" placeholder="Buscar por nombre o descripción…" autocomplete="off" /></label>
    <select class="ui-select" id="exDestino" title="Destino"><option value="">Todos los destinos</option></select>
    <select class="ui-select" id="exOrden" title="Ordenar">
        <option value="nombre">Nombre (A-Z)</option>
        <option value="prioridad">Prioridad (como en la web)</option>
        <option value="precio_asc">Precio: menor a mayor</option>
        <option value="precio_desc">Precio: mayor a menor</option>
        <option value="recientes">Más recientes</option>
    </select>
    <div class="ex-vista" role="group" aria-label="Vista">
        <button type="button" data-vista="tarjetas" class="on" title="Tarjetas"><i class="bi bi-grid-3x2-gap"></i></button>
        <button type="button" data-vista="lista" title="Lista"><i class="bi bi-list-ul"></i></button>
    </div>
</div>
<nav class="ex-dests" id="exDests" aria-label="Ir a un destino" hidden></nav>
<div class="ex-cuenta" id="exCuenta" aria-live="polite"></div>
<div id="exLista"><div class="ui-skel" style="height:320px"></div></div>

<!-- ===================== EDITOR ===================== -->
<aside class="ui-drawer" id="exEditor" aria-hidden="true">
    <div class="ui-dh">
        <div class="ev-module-icon" style="width:46px;height:46px"><i class="bi bi-compass"></i></div>
        <div style="min-width:0"><h2 id="edTitulo">Nueva excursión</h2><small id="edSub">Los campos con * son obligatorios.</small></div>
        <button class="ui-ibtn x" type="button" id="edCerrar" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="ui-db">
        <div class="ex-zona" id="edZona">
            <div class="ex-zona-prev" id="edPrev"><span class="sin"><i class="bi bi-image" style="font-size:26px;display:block"></i>Sin foto</span></div>
            <div class="ex-zona-acc">
                <b>Foto de la excursión</b>
                <small>Arrastra una imagen aquí o pulsa «Subir foto». JPG, PNG o WebP hasta 10 MB; se guarda optimizada.</small>
                <label class="ev-btn ghost sm" style="cursor:pointer"><i class="bi bi-upload"></i> <span id="edSubirTxt">Subir foto</span><input type="file" id="edArchivo" accept="image/jpeg,image/png,image/webp" hidden></label>
                <button type="button" class="ev-btn ghost sm" id="edQuitarFoto" hidden><i class="bi bi-trash3"></i> Quitar foto</button>
            </div>
        </div>

        <div class="ui-f"><label>Galería <em>más fotos para la ficha; se guardan al momento</em></label><div id="edGaleria"></div></div>

        <div class="ui-f"><label for="edNombre">Nombre de la excursión * <em id="edNombreN">0 / 500</em></label>
            <input id="edNombre" maxlength="500" placeholder="Ej. Excursión Isla Saona"><span class="msg"></span></div>
        <div class="ui-row">
            <div class="ui-f"><label for="edDestino">Destino *</label>
                <input id="edDestino" maxlength="50" placeholder="Escribe para buscar… ej. Punta Cana" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="edDestBusc">
                <div class="ex-busc" id="edDestBusc" hidden role="listbox"></div><span class="msg"></span></div>
            <div class="ui-f"><label for="edPrecio">Precio por persona *</label>
                <div class="ex-money"><b class="sim">RD$</b><input id="edPrecio" type="number" min="0" step="0.01" placeholder="0"></div><span class="msg"></span></div>
        </div>
        <div class="ui-f"><label class="ui-switch"><input type="checkbox" id="edCancelable"><span class="tr"></span> Se puede cancelar</label></div>
        <div class="ui-f" id="edPrio"></div>

        <div class="ui-f"><label for="edDesc">Descripción <em>se ve en la web</em></label>
            <div class="ex-herr" aria-label="Formato">
                <button type="button" data-fmt="p" title="Párrafo"><i class="bi bi-paragraph"></i> Párrafo</button>
                <button type="button" data-fmt="b" title="Negrita"><i class="bi bi-type-bold"></i> Negrita</button>
                <button type="button" data-fmt="ul" title="Lista con viñetas"><i class="bi bi-list-ul"></i> Lista</button>
            </div>
            <textarea id="edDesc" rows="7" placeholder="Cuenta qué incluye, horarios, qué llevar… Puedes escribir texto normal: cada línea en blanco separa un párrafo."></textarea>
        </div>
        <div class="ui-f"><label>Así se verá</label><div class="ex-prev-desc" id="edVista"><span style="color:var(--ev-muted)">Sin descripción.</span></div></div>
    </div>
    <div class="ui-df">
        <button class="ev-btn ghost" type="button" id="edEliminar"><i class="bi bi-trash3"></i> Eliminar</button>
        <span class="hint">Ctrl + Enter guarda</span>
        <button class="ev-btn ghost" type="button" id="edCancelar">Cancelar</button>
        <button class="ev-btn" type="button" id="edGuardar"><i class="bi bi-check2-circle"></i> Guardar</button>
    </div>
</aside>

<!-- ===================== VER ===================== -->
<aside class="ui-drawer" id="exVer" aria-hidden="true">
    <div class="ui-dh">
        <div class="ev-module-icon" style="width:46px;height:46px"><i class="bi bi-eye"></i></div>
        <div style="min-width:0"><h2 id="verTitulo">Excursión</h2><small id="verSub"></small></div>
        <button class="ui-ibtn x" type="button" id="verCerrar" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="ui-db" id="verCuerpo"></div>
    <div class="ui-df">
        <span class="hint">Así lo verá el cliente</span>
        <button class="ev-btn ghost" type="button" id="verDuplicar"><i class="bi bi-copy"></i> Duplicar</button>
        <button class="ev-btn" type="button" id="verEditar"><i class="bi bi-pencil"></i> Editar</button>
    </div>
</aside>

@section Scripts {
<script src="~/js/eurovip-ui.js" asp-append-version="true"></script>
<script src="~/js/eurovip-quien.js" asp-append-version="true"></script>
<script src="~/js/eurovip-multimedia.js" asp-append-version="true"></script>
<script src="~/js/eurovip-fotos.js" asp-append-version="true"></script>
<script src="~/js/eurovip-excel.js" asp-append-version="true"></script>
<script src="~/js/eurovip-prioridad.js" asp-append-version="true"></script>
<script>
const EX = (() => {
    const $ = (s, el = document) => el.querySelector(s);
    const $$ = (s, el = document) => [...el.querySelectorAll(s)];
    const esc = EV.esc;
    const editor = EV.drawer($('#exEditor'));
    let galeria = null;   // fotos extra (Eurovip.multimedia, uso GALERIA)
    const visor = EV.drawer($('#exVer'));
    let todas = [], infoDest = {}, actual = null, fotoNueva = null, quitarFoto = false, verId = null;
    // Destinos plegados (se recuerda en este navegador)
    let plegadas = new Set();
    try { plegadas = new Set(JSON.parse(localStorage.getItem('ev-excursiones-plegadas') || '[]')); } catch { }
    const guardarPlegadas = () => { try { localStorage.setItem('ev-excursiones-plegadas', JSON.stringify([...plegadas])); } catch { } };
    const st = { q: '', destino: '', filtro: '', orden: 'prioridad', vista: 'tarjetas' };
    try { st.vista = localStorage.getItem('ev-excursiones-vista') || 'tarjetas'; } catch { }

    const precio = v => v == null ? '—' : `${EV.simbolo()} ${EV.fmt(v, Number(v) % 1 ? 2 : 0)}`;
    const sinTexto = s => !s || !String(s).replace(/<[^>]*>/g, '').trim();

    // ---------------- descripción: solo etiquetas sencillas (lo demás se quita) ----------------
    const PERMITIDAS = new Set(['P', 'BR', 'B', 'STRONG', 'I', 'EM', 'U', 'UL', 'OL', 'LI', 'H3', 'H4']);
    function limpiarHtml(html) {
        const texto = (html || '').trim();
        if (!texto) return '';
        // Texto sin etiquetas: cada línea en blanco es un párrafo y cada salto de línea un <br>
        if (!/<[a-z][\s\S]*>/i.test(texto))
            return texto.split(/\n\s*\n/).map(p => `<p>${esc(p.trim()).replace(/\n/g, '<br>')}</p>`).join('');
        const doc = new DOMParser().parseFromString(`<div>${texto}</div>`, 'text/html');
        const limpiar = nodo => {
            [...nodo.childNodes].forEach(c => {
                if (c.nodeType === 1) {
                    limpiar(c);
                    if (!PERMITIDAS.has(c.tagName)) c.replaceWith(...c.childNodes);
                    else [...c.attributes].forEach(a => c.removeAttribute(a.name));
                } else if (c.nodeType !== 3) c.remove();
            });
        };
        const raiz = doc.body.firstElementChild;
        limpiar(raiz);
        return raiz.innerHTML;
    }

    // ---------------- datos ----------------
    async function cargar() {
        try { const r = await EV.api('/Excursiones/Listar'); todas = r.excursiones; infoDest = Object.fromEntries(r.destinos.map(d => [d.destino, d])); }
        catch (e) { $('#exLista').innerHTML = `<div class="ui-empty"><h3>No pudimos cargar las excursiones</h3><p>${esc(e.message)}</p></div>`; return; }
        const destinos = [...new Set(todas.map(x => x.id_Destino).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'es'));
        const sel = $('#exDestino'), antes = sel.value;
        sel.innerHTML = '<option value="">Todos los destinos</option>' + destinos.map(d => `<option ${d === antes ? 'selected' : ''}>${esc(d)}</option>`).join('');
        pintar();
    }

    function filtradas() {
        const q = st.q.toLowerCase();
        let l = todas.filter(x =>
            (!st.destino || x.id_Destino === st.destino) &&
            (!q || (x.nombre || '').toLowerCase().includes(q) || (x.descripcion || '').toLowerCase().includes(q) || String(x.id_Excursion) === q) &&
            (st.filtro === '' || (st.filtro === 'sinfoto' && !x.imagen) || (st.filtro === 'sindesc' && sinTexto(x.descripcion)) ||
             (st.filtro === 'cancelables' && x.cancelable) || (st.filtro === 'nocancel' && !x.cancelable)));
        const cmp = {
            nombre: (a, b) => (a.nombre || '').localeCompare(b.nombre || '', 'es'),
            prioridad: null,
            precio_asc: (a, b) => (a.precio ?? 0) - (b.precio ?? 0),
            precio_desc: (a, b) => (b.precio ?? 0) - (a.precio ?? 0),
            recientes: (a, b) => b.id_Excursion - a.id_Excursion
        }[st.orden];
        return cmp === null ? EVPrioridad.ordenar(l) : l.sort(cmp);
    }

    function pintarKpis() {
        const base = todas.filter(x => !st.destino || x.id_Destino === st.destino);
        const k = [
            ['', base.length, 'Excursiones', 'bi-compass'],
            ['sinfoto', base.filter(x => !x.imagen).length, 'Sin foto', 'bi-image', true],
            ['sindesc', base.filter(x => sinTexto(x.descripcion)).length, 'Sin descripción', 'bi-text-paragraph', true],
            ['cancelables', base.filter(x => x.cancelable).length, 'Cancelables', 'bi-check2-circle'],
            ['nocancel', base.filter(x => !x.cancelable).length, 'No cancelables', 'bi-x-circle']
        ];
        $('#exKpis').innerHTML = k.map(([f, n, t, i, alerta]) => `<button type="button" class="ex-kpi ${st.filtro === f ? 'on' : ''} ${alerta && n ? 'mal' : ''}" data-filtro="${f}" aria-pressed="${st.filtro === f}">
            <b>${EV.fmt(n)}</b><small><i class="bi ${i}"></i> ${t}</small></button>`).join('');
    }

    function pintar() {
        pintarKpis();
        pintarDestinos();
        $$('.ex-vista button').forEach(b => b.classList.toggle('on', b.dataset.vista === st.vista));
        const l = filtradas();
        $('#exCuenta').textContent = l.length === todas.length ? `${EV.fmt(l.length)} excursiones` : `Mostrando ${EV.fmt(l.length)} de ${EV.fmt(todas.length)}`;
        if (!todas.length) {
            $('#exLista').innerHTML = `<div class="ui-empty"><i class="bi bi-compass" style="font-size:40px"></i><h3>Todavía no hay excursiones</h3><p>Crea la primera con «Nueva excursión».</p></div>`;
            return;
        }
        if (!l.length) {
            $('#exLista').innerHTML = `<div class="ui-empty"><i class="bi bi-search" style="font-size:36px"></i><h3>No hay excursiones con ese filtro</h3><p>Prueba con otra palabra o <a href="#" id="exLimpiar">quita los filtros</a>.</p></div>`;
            return;
        }
        // Una sección por destino (las excursiones son por destino)
        const grupos = new Map();
        l.forEach(x => { const d = x.id_Destino || 'Sin destino'; if (!grupos.has(d)) grupos.set(d, []); grupos.get(d).push(x); });
        const orden = [...grupos.keys()].sort((a, b) => a === 'Sin destino' ? 1 : b === 'Sin destino' ? -1 : a.localeCompare(b, 'es'));
        let n = 0;
        $('#exLista').innerHTML = orden.map(d => seccion(d, grupos.get(d), () => n++)).join('');
    }

    /** Cabecera bonita del destino + sus excursiones (tarjetas o lista). */
    function seccion(destino, lista, sig) {
        const todasDest = todas.filter(x => (x.id_Destino || 'Sin destino') === destino);
        const info = infoDest[destino] || {};
        const portada = info.imagen || todasDest.find(x => x.imagen)?.imagen;
        const min = Math.min(...todasDest.map(x => x.precio ?? Infinity));
        const sinFoto = todasDest.filter(x => !x.imagen).length, sinDesc = todasDest.filter(x => sinTexto(x.descripcion)).length;
        const plegada = plegadas.has(destino) && !st.q && !st.filtro;
        const cuerpo = st.vista === 'lista'
            ? `<div class="ui-table-wrap"><table class="ui-table ex-tabla"><thead><tr><th></th><th>Excursión</th><th class="num">Precio</th><th>Cancelable</th><th style="width:150px"></th></tr></thead><tbody>
                ${lista.map(x => `<tr data-id="${x.id_Excursion}" data-accion="ver">
                    <td class="img">${x.imagen ? `<img src="${esc(x.imagen)}" alt="" loading="lazy">` : '<span></span>'}</td>
                    <td>${EVPrioridad.estrella(x.peso)} <b>${esc(x.nombre)}</b>${!x.imagen ? ' <span class="ex-chip av">Sin foto</span>' : ''}${sinTexto(x.descripcion) ? ' <span class="ex-chip av">Sin descripción</span>' : ''}</td>
                    <td class="num"><b>${precio(x.precio)}</b>${x.precio_Proveedor ? '<br>' + EVPrioridad.proveedor(x.precio, x.precio_Proveedor) : ''}</td>
                    <td>${x.cancelable ? '<span class="ex-chip ok">Sí</span>' : '<span class="ex-chip no">No</span>'}</td>
                    <td style="text-align:right;white-space:nowrap">${acciones(x)}</td></tr>`).join('')}
                </tbody></table></div>`
            : `<div class="ex-grid">${lista.map(x => `<article class="ex-card ${x.peso ? 'ev-con-prioridad' : ''}" style="--n:${Math.min(sig(), 20)}" data-id="${x.id_Excursion}">
                <div class="ex-foto" data-accion="ver" data-soltar="${x.id_Excursion}" title="Ver · arrastra una foto aquí para cambiarla">
                    ${x.imagen ? `<img src="${esc(x.imagen)}" alt="Foto de ${esc(x.nombre)}" loading="lazy">` : '<span class="sin"><span><i class="bi bi-image"></i>Sin foto<br><small>Arrastra una aquí</small></span></span>'}
                    <span class="ex-precio">${precio(x.precio)}</span>${x.peso ? `<span style="position:absolute;left:10px;top:10px;z-index:2">${EVPrioridad.estrella(x.peso, true)}</span>` : ''}</div>
                <div class="ex-cuerpo">
                    <h3>${esc(x.nombre)}</h3>
                    ${x.precio_Proveedor ? `<div>${EVPrioridad.proveedor(x.precio, x.precio_Proveedor)}</div>` : ''}
                    <div class="ex-chips">
                        ${x.cancelable ? '<span class="ex-chip ok"><i class="bi bi-check2"></i> Cancelable</span>' : '<span class="ex-chip no"><i class="bi bi-x"></i> No cancelable</span>'}
                        ${sinTexto(x.descripcion) ? '<span class="ex-chip av">Sin descripción</span>' : ''}</div>
                    ${sinTexto(x.descripcion) ? '' : `<div class="ex-desc">${esc(String(x.descripcion).replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim())}</div>`}
                    <div class="ex-pie"><span class="n">n.º ${x.id_Excursion}</span><span class="sp"></span>${acciones(x)}</div>
                </div></article>`).join('')}</div>`;
        return `<section class="ex-sec ${plegada ? 'plegada' : ''}" id="${idSeccion(destino)}" data-destino="${esc(destino)}">
            <header class="ex-sec-h ${portada ? '' : 'sinfoto'}">
                ${portada ? `<img class="ex-sec-img" src="${esc(portada)}" alt="" loading="lazy">` : ''}
                <div class="ex-sec-txt">
                    <span class="ex-sec-pais"><i class="bi bi-geo-alt-fill"></i> ${esc(info.pais || 'Destino')}</span>
                    <h2>${esc(destino)}</h2>
                    <p><b>${EV.fmt(todasDest.length)}</b> excursion${todasDest.length === 1 ? '' : 'es'}${isFinite(min) ? ` · desde <b>${precio(min)}</b>` : ''}
                       ${lista.length !== todasDest.length ? ` · mostrando ${EV.fmt(lista.length)}` : ''}</p>
                    <div class="ex-sec-avisos">${sinFoto ? `<span><i class="bi bi-image"></i> ${sinFoto} sin foto</span>` : ''}${sinDesc ? `<span><i class="bi bi-text-paragraph"></i> ${sinDesc} sin descripción</span>` : ''}${!sinFoto && !sinDesc ? '<span class="ok"><i class="bi bi-stars"></i> Todo completo</span>' : ''}</div>
                </div>
                <div class="ex-sec-acc">
                    ${destino !== 'Sin destino' ? `<button type="button" class="ev-btn sm" data-nueva-en="${esc(destino)}"><i class="bi bi-plus-lg"></i> Excursión en ${esc(destino)}</button>` : ''}
                    <button type="button" class="ex-sec-pleg" data-plegar="${esc(destino)}" aria-expanded="${!plegada}" title="${plegada ? 'Mostrar' : 'Ocultar'} las excursiones"><i class="bi bi-chevron-down"></i></button>
                </div>
            </header>
            <div class="ex-sec-cuerpo">${cuerpo}</div>
        </section>`;
    }

    const idSeccion = d => 'dest-' + d.normalize('NFD').replace(/[^\w]+/g, '-').toLowerCase();

    /** Barra de destinos: un botón por destino con su foto y cuántas tiene; lleva a su sección. */
    function pintarDestinos() {
        const destinos = [...new Set(todas.map(x => x.id_Destino || 'Sin destino'))].sort((a, b) => a === 'Sin destino' ? 1 : b === 'Sin destino' ? -1 : a.localeCompare(b, 'es'));
        $('#exDests').hidden = destinos.length < 1;
        $('#exDests').innerHTML = `<button type="button" class="ex-dest ${!st.destino ? 'on' : ''}" data-ir=""><span class="ico"><i class="bi bi-globe-americas"></i></span><span><b>Todos</b><small>${EV.fmt(todas.length)} excursiones</small></span></button>` +
            destinos.map(d => {
                const f = infoDest[d]?.imagen || todas.find(x => (x.id_Destino || 'Sin destino') === d && x.imagen)?.imagen;
                const c = todas.filter(x => (x.id_Destino || 'Sin destino') === d).length;
                return `<button type="button" class="ex-dest ${st.destino === d ? 'on' : ''}" data-ir="${esc(d)}">
                    <span class="ico">${f ? `<img src="${esc(f)}" alt="">` : '<i class="bi bi-geo-alt"></i>'}</span><span><b>${esc(d)}</b><small>${EV.fmt(c)} excursion${c === 1 ? '' : 'es'}</small></span></button>`;
            }).join('');
    }

    const acciones = x => `<button type="button" class="ui-ibtn" data-accion="ver" title="Ver"><i class="bi bi-eye"></i></button>
        <button type="button" class="ui-ibtn" data-accion="fotos" title="Fotos (se guardan al momento)"><i class="bi bi-images"></i></button>
        <button type="button" class="ui-ibtn" data-accion="editar" title="Editar"><i class="bi bi-pencil"></i></button>
        <button type="button" class="ui-ibtn" data-accion="duplicar" title="Duplicar"><i class="bi bi-copy"></i></button>
        <button type="button" class="ui-ibtn danger" data-accion="eliminar" title="Eliminar"><i class="bi bi-trash3"></i></button>`;

    // ---------------- ver ----------------
    function ver(id) {
        const x = todas.find(e => e.id_Excursion === id); if (!x) return;
        verId = id;
        $('#verTitulo').textContent = x.nombre;
        $('#verSub').textContent = `n.º ${x.id_Excursion} · ${x.id_Destino || 'sin destino'}`;
        $('#verCuerpo').innerHTML = `${x.imagen ? `<img class="ex-ver-img" src="${esc(x.imagen)}" alt="Foto de ${esc(x.nombre)}">` : '<div class="ex-ver-img" style="display:grid;place-items:center;font-weight:800">Sin foto</div>'}
            <div class="ex-chips" style="margin-bottom:14px"><span class="ex-chip"><i class="bi bi-geo-alt"></i> ${esc(x.id_Destino || '—')}</span>
                <span class="ex-chip" style="font-size:14px"><b>${precio(x.precio)}</b>&nbsp;por persona</span>
                ${x.cancelable ? '<span class="ex-chip ok">Se puede cancelar</span>' : '<span class="ex-chip no">No se puede cancelar</span>'}</div>
            <div class="ex-prev-desc" style="max-height:none">${sinTexto(x.descripcion) ? '<span style="color:var(--ev-muted)">Esta excursión no tiene descripción todavía.</span>' : limpiarHtml(x.descripcion)}</div>`;
        visor.abrir();
    }

    // ---------------- editor ----------------
    function pintarFoto(url) {
        $('#edPrev').innerHTML = url ? `<img src="${esc(url)}" alt="Foto">` : '<span class="sin"><i class="bi bi-image" style="font-size:26px;display:block"></i>Sin foto</span>';
        $('#edQuitarFoto').hidden = !url;
        $('#edSubirTxt').textContent = url ? 'Cambiar foto' : 'Subir foto';
    }

    function abrir(x, destinoInicial) {
        actual = x || null; fotoNueva = null; quitarFoto = false;
        $('#edTitulo').textContent = x ? 'Editar excursión' : 'Nueva excursión';
        $('#edSub').textContent = x ? `n.º ${x.id_Excursion} · los cambios se guardan al pulsar Guardar` : 'Los campos con * son obligatorios.';
        if (x?.id_Excursion) EVQuien.pintar($('#edSub'), 'excursion', x.id_Excursion); else EVQuien.quitar($('#edSub'));
        $('#edNombre').value = x?.nombre || '';
        $('#edDestino').value = x?.id_Destino || destinoInicial || st.destino || (todas[0]?.id_Destino ?? '');
        $('#edPrecio').value = x?.precio ?? '';
        $('#edCancelable').checked = !!x?.cancelable;
        $('#edPrio').innerHTML = EVPrioridad.campos({ peso: x?.peso, proveedor: x?.precio_Proveedor, precio: x?.precio, contexto: { que: 'excursion', id: x?.id_Excursion, destino: $('#edDestino').value } });
        $('#edDestino').onchange = () => EVPrioridad.contexto($('#pPeso'), { que: 'excursion', id: x?.id_Excursion, destino: $('#edDestino').value });   // los puestos son por destino
        EVPrioridad.vivo($('#edPrio'), () => $('#edPrecio').value);
        $('#edDesc').value = x?.descripcion || '';
        $('#edEliminar').hidden = !x;
        $$('#exEditor .ui-f').forEach(f => f.classList.remove('err'));
        $$('#exEditor .msg').forEach(m => m.textContent = '');
        pintarFoto(x?.imagen);
        contar(); vistaPrevia();
        galeria ??= EVMultimedia.montar($('#edGaleria'), { tipo: 'EXCURSION', portada: false, nombre: 'la excursión' });
        galeria.cambiar(x?.id_Excursion ?? null);
        editor.abrir();
        setTimeout(() => $('#edNombre').focus(), 80);
    }

    const contar = () => $('#edNombreN').textContent = `${$('#edNombre').value.length} / 500`;
    const vistaPrevia = () => $('#edVista').innerHTML = sinTexto($('#edDesc').value) ? '<span style="color:var(--ev-muted)">Sin descripción.</span>' : limpiarHtml($('#edDesc').value);

    function marcar(campo, msg) {
        const el = { Nombre: '#edNombre', Id_Destino: '#edDestino', Precio: '#edPrecio' }[campo.replace(/^\$\./, '')];
        if (!el) return;
        const f = $(el).closest('.ui-f'); f.classList.add('err'); $('.msg', f).textContent = msg;
    }

    function elegirFoto(archivo) {
        if (!archivo) return;
        if (!/^image\/(jpeg|png|webp)$/.test(archivo.type)) { EV.toast('Usa una imagen JPG, PNG o WebP.', 'err'); return; }
        if (archivo.size > 10_000_000) { EV.toast('La imagen pesa más de 10 MB.', 'err'); return; }
        fotoNueva = archivo; quitarFoto = false;
        pintarFoto(URL.createObjectURL(archivo));
        $('#exEditor').dispatchEvent(new Event('ev-cambio'));
    }

    async function subirFoto(id, archivo, alAvanzar) {
        const fd = new FormData(); fd.append('id', id); fd.append('archivo', archivo);
        return EVProgreso.subir('/Excursiones/SubirImagen', fd, alAvanzar);
    }

    async function guardar() {
        $$('#exEditor .ui-f').forEach(f => f.classList.remove('err'));
        $$('#exEditor .msg').forEach(m => m.textContent = '');
        const dto = {
            Id_Excursion: actual?.id_Excursion ?? null,
            Nombre: $('#edNombre').value.trim(), Id_Destino: $('#edDestino').value.trim(),
            Precio: $('#edPrecio').value === '' ? null : Number($('#edPrecio').value),
            Cancelable: $('#edCancelable').checked,
            Descripcion: limpiarHtml($('#edDesc').value) || null,
            ...EVPrioridad.leer($('#exEditor'))
        };
        const faltan = [];
        if (!dto.Nombre) faltan.push(['Nombre', 'Escribe el nombre']);
        if (!dto.Id_Destino) faltan.push(['Id_Destino', 'Elige el destino']);
        if (dto.Precio == null || dto.Precio < 0) faltan.push(['Precio', 'Escribe un precio (0 o más)']);
        if (faltan.length) { faltan.forEach(([c, m]) => marcar(c, m)); EV.toast('Revisa los campos marcados.', 'err'); return; }

        const b = $('#edGuardar'), html = b.innerHTML; b.disabled = true; b.innerHTML = '<span class="ui-spin"></span> Guardando…';
        const barra = EVProgreso.abrir(actual ? 'Guardando la excursión' : 'Cargando la excursión');
        try {
            barra.poner(20, 'Guardando los datos…');
            const r = await EV.post('/Excursiones/Guardar', dto);
            let aviso = '';
            if (fotoNueva) {
                barra.poner(40, 'Subiendo la foto…');
                try { await subirFoto(r.id, fotoNueva, p => barra.poner(40 + p * 0.5, `Subiendo la foto… ${Math.round(p)}%`)); }
                catch (ef) { aviso = ' La foto no se pudo subir: ' + ef.message; }
            } else if (quitarFoto && actual) {
                try { await EV.post('/Excursiones/QuitarImagen?id=' + actual.id_Excursion); } catch { }
            }
            barra.poner(95, 'Actualizando la lista…');
            editor.cerrar(true);
            await cargar();
            barra.poner(100, '¡Listo!');
            EV.toast(r.mensaje + aviso, aviso ? 'err' : 'ok');
            EV.resaltar(document.querySelector(`[data-id="${r.id}"]`));
        } catch (e) {
            Object.entries(e.data?.errores || {}).forEach(([c, m]) => marcar(c, m));
            EV.toast(e.message, 'err');
        } finally { barra.cerrar(); b.disabled = false; b.innerHTML = html; }
    }

    async function eliminar(id) {
        const x = todas.find(e => e.id_Excursion === id); if (!x) return;
        if (!await EV.confirmar({ titulo: '¿Eliminar la excursión?', peligro: true, si: 'Sí, eliminar',
            texto: `Se eliminará <b>${esc(x.nombre)}</b>${x.imagen ? ' con su foto' : ''}. No se puede deshacer.` })) return;
        try { const r = await EV.post('/Excursiones/Eliminar?id=' + id); EV.toast(r.mensaje); editor.cerrar(true); visor.cerrar(true); await cargar(); }
        catch (e) { EV.toast(e.message, 'err'); }
    }

    async function duplicar(id) {
        try { const r = await EV.post('/Excursiones/Duplicar?id=' + id); EV.toast(r.mensaje); visor.cerrar(true); await cargar(); abrir(todas.find(e => e.id_Excursion === r.id)); }
        catch (e) { EV.toast(e.message, 'err'); }
    }

    // Arrastrar una foto directamente sobre una tarjeta
    async function soltarEnTarjeta(id, archivo, zona) {
        if (!/^image\/(jpeg|png|webp)$/.test(archivo.type)) { EV.toast('Usa una imagen JPG, PNG o WebP.', 'err'); return; }
        const capa = document.createElement('div'); capa.className = 'subiendo'; capa.textContent = 'Subiendo… 0%'; zona.appendChild(capa);
        try { const r = await subirFoto(id, archivo, p => capa.textContent = `Subiendo… ${Math.round(p)}%`); EV.toast(r.mensaje); await cargar(); }
        catch (e) { EV.toast(e.message, 'err'); capa.remove(); }
    }

    // ---------------- buscador de destino ----------------
    let destReq = 0;
    const buscarDestinos = EV.debounce(async () => {
        const q = $('#edDestino').value.trim(), n = ++destReq;
        let l = [];
        try { l = await EV.api('/Excursiones/Destinos?q=' + encodeURIComponent(q)); } catch { }
        if (n !== destReq) return;
        const caja = $('#edDestBusc');
        caja.innerHTML = l.map(o => `<button type="button" role="option" data-v="${esc(o.valor)}">${esc(o.texto)}<small>${esc(o.extra || '')}</small></button>`).join('');
        caja.hidden = !l.length || document.activeElement !== $('#edDestino');
        $('#edDestino').setAttribute('aria-expanded', String(!caja.hidden));
    }, 200);

    // ---------------- inicio ----------------
    function iniciar() {
        $('#exNueva').onclick = () => abrir(null);
        $('#exExcel').onclick = () => EVExcel.abrir({ titulo: 'Cargar excursiones con Excel', plantilla: '/Excursiones/Plantilla', url: '/Excursiones/CargarExcel', uno: 'excursión', varios: 'excursiones', alTerminar: cargar });
        $('#exQ').addEventListener('input', EV.debounce(e => { st.q = e.target.value.trim(); pintar(); }, 200));
        $('#exDestino').onchange = e => { st.destino = e.target.value; pintar(); };
        $('#exOrden').onchange = e => { st.orden = e.target.value; pintar(); };
        $$('.ex-vista button').forEach(b => b.onclick = () => { st.vista = b.dataset.vista; try { localStorage.setItem('ev-excursiones-vista', st.vista); } catch { } pintar(); });
        $('#exKpis').addEventListener('click', e => { const k = e.target.closest('[data-filtro]'); if (!k) return; st.filtro = st.filtro === k.dataset.filtro ? '' : k.dataset.filtro; pintar(); });
        // Barra de destinos: muestra solo ese destino (o todos) y sube a su sección
        $('#exDests').addEventListener('click', e => {
            const b = e.target.closest('[data-ir]'); if (!b) return;
            st.destino = b.dataset.ir === 'Sin destino' ? '' : b.dataset.ir;
            $('#exDestino').value = st.destino;
            pintar();
            const sec = st.destino ? document.getElementById(idSeccion(st.destino)) : null;
            (sec || $('#exLista')).scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        $('#exLista').addEventListener('click', e => {
            if (e.target.id === 'exLimpiar') { e.preventDefault(); st.q = ''; st.destino = ''; st.filtro = ''; $('#exQ').value = ''; $('#exDestino').value = ''; pintar(); return; }
            const nuevaEn = e.target.closest('[data-nueva-en]');
            if (nuevaEn) { abrir(null, nuevaEn.dataset.nuevaEn); return; }
            const pleg = e.target.closest('[data-plegar]');
            if (pleg) {
                const d = pleg.dataset.plegar, sec = pleg.closest('.ex-sec');
                if (plegadas.has(d)) plegadas.delete(d); else plegadas.add(d);
                guardarPlegadas();
                sec.classList.toggle('plegada', plegadas.has(d));
                pleg.setAttribute('aria-expanded', String(!plegadas.has(d)));
                return;
            }
            const fila = e.target.closest('[data-id]'); if (!fila) return;
            const id = +fila.dataset.id, acc = e.target.closest('[data-accion]')?.dataset.accion;
            if (acc === 'editar') abrir(todas.find(x => x.id_Excursion === id));
            else if (acc === 'duplicar') duplicar(id);
            else if (acc === 'eliminar') eliminar(id);
            else if (acc === 'ver') ver(id);
            else if (acc === 'fotos') EVFotos.abrir({ tipo: 'EXCURSION', clave: id, titulo: todas.find(x => x.id_Excursion === id)?.nombre, alCambiar: EV.debounce(cargar, 400) });
        });
        // Soltar fotos en las tarjetas
        $('#exLista').addEventListener('dragover', e => { const z = e.target.closest('[data-soltar]'); if (z && e.dataTransfer.types.includes('Files')) { e.preventDefault(); z.classList.add('sobre'); } });
        $('#exLista').addEventListener('dragleave', e => e.target.closest('[data-soltar]')?.classList.remove('sobre'));
        $('#exLista').addEventListener('drop', e => {
            const z = e.target.closest('[data-soltar]'); if (!z) return;
            e.preventDefault(); z.classList.remove('sobre');
            const f = e.dataTransfer.files[0]; if (f) soltarEnTarjeta(+z.dataset.soltar, f, z);
        });

        // Editor
        $('#edNombre').addEventListener('input', contar);
        $('#edDesc').addEventListener('input', EV.debounce(vistaPrevia, 150));
        $('#edArchivo').onchange = e => { elegirFoto(e.target.files[0]); e.target.value = ''; };
        $('#edQuitarFoto').onclick = () => { fotoNueva = null; quitarFoto = true; pintarFoto(null); $('#exEditor').dispatchEvent(new Event('ev-cambio')); };
        const zona = $('#edZona');
        zona.addEventListener('dragover', e => { e.preventDefault(); zona.classList.add('sobre'); });
        zona.addEventListener('dragleave', () => zona.classList.remove('sobre'));
        zona.addEventListener('drop', e => { e.preventDefault(); zona.classList.remove('sobre'); elegirFoto(e.dataTransfer.files[0]); });
        $$('.ex-herr [data-fmt]').forEach(b => b.onclick = () => {
            const t = $('#edDesc'), [i, f] = [t.selectionStart, t.selectionEnd], sel = t.value.slice(i, f) || 'texto';
            const nuevo = { p: `<p>${sel}</p>`, b: `<b>${sel}</b>`, ul: `<ul>\n${sel.split('\n').map(l => `<li>${l}</li>`).join('\n')}\n</ul>` }[b.dataset.fmt];
            t.setRangeText(nuevo, i, f, 'end'); t.focus(); vistaPrevia(); $('#exEditor').dispatchEvent(new Event('ev-cambio'));
        });
        $('#edDestino').addEventListener('input', buscarDestinos);
        $('#edDestino').addEventListener('focus', buscarDestinos);
        $('#edDestino').addEventListener('blur', () => setTimeout(() => { $('#edDestBusc').hidden = true; $('#edDestino').setAttribute('aria-expanded', 'false'); }, 150));
        $('#edDestBusc').addEventListener('mousedown', e => { const o = e.target.closest('[data-v]'); if (!o) return; e.preventDefault(); $('#edDestino').value = o.dataset.v; $('#edDestBusc').hidden = true; $('#exEditor').dispatchEvent(new Event('ev-cambio')); });
        $('#edGuardar').onclick = guardar;
        $('#edCancelar').onclick = $('#edCerrar').onclick = () => editor.cerrar();
        $('#edEliminar').onclick = () => actual && eliminar(actual.id_Excursion);
        $('#verCerrar').onclick = () => visor.cerrar();
        $('#verEditar').onclick = () => { const x = todas.find(e => e.id_Excursion === verId); visor.cerrar(true); abrir(x); };
        $('#verDuplicar').onclick = () => verId && duplicar(verId);
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') { editor.cerrar(); visor.cerrar(); }
            if (editor.abierto() && e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); guardar(); }
        });
        cargar();
    }
    document.addEventListener('DOMContentLoaded', iniciar);
    return { nueva: () => abrir(null) };
})();
</script>
}
