@* Link del editor de agencia que no existe, se desactivó o venció (copia de BackTiTan con la marca de Eurovip). *@
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Link no válido</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body { background: #0f1923; min-height: 100vh; display: flex; align-items: center; justify-content: center; font-family: Arial, sans-serif; }
        .box { background: #16202c; border-radius: 16px; padding: 48px 40px; text-align: center; max-width: 400px; border: 1px solid #2d3f52; }
        .ico { font-size: 3.5rem; color: #e76f51; margin-bottom: 20px; display: block; }
        h2 { color: #f8fafc; font-size: 1.4rem; margin-bottom: 10px; }
        p { color: #94a3b8; font-size: .9rem; line-height: 1.6; }
    </style>
</head>
<body>
    <div class="box">
        <i class="bi bi-link-45deg ico"></i>
        <h2>Link no válido o expirado</h2>
        <p>Este link de flyer no existe, ya fue revocado, o su fecha de expiración ha pasado.<br>
           Pide un nuevo link a tu contacto en Eurovip Travel.</p>
    </div>
</body>
</html>
