{
  // Copiar este archivo como appsettings.Local.json (ignorado por git) y poner servidor, usuario y contraseña reales.
  "ConnectionStrings": {
    "DefaultConnection": "data source=IP_SERVIDOR_93;initial catalog=TropitoursVDT;user id=TU_USUARIO;password=TU_PASSWORD;Encrypt=False;TrustServerCertificate=True"
  },
  // Integración Yourttoo (Circuitos por el mundo): staging https://api-staging.yourttoo.com · producción https://api.yourttoo.com
  "Yourttoo": { "Url": "https://api-staging.yourttoo.com", "Usuario": "TU_EMAIL_YOURTTOO", "Clave": "TU_CLAVE_YOURTTOO" },
  // Booking Motor (Hoteles: elegir país/destino/hotel desde su API de maestros). La clave va aquí y en el servidor, NUNCA en git.
  "BookingMotor": { "Url": "https://api.bookingmotor.com", "Token": "TU_CLAVE_BOOKINGMOTOR" },
  // CAMBIO 140: clave compartida de la API de proveedores (Gestión llama a /api/proveedor con la cabecera X-Eurovip-Clave). Mínimo 16 caracteres.
  "Eurovip": { "Proveedores": { "ClaveApi": "CLAVE_LARGA_ALEATORIA" } }
}
